#!/bin/sh
# aidev ランタイムガード CLI（POSIX sh のみ・Node 非依存）
#
# 役割: aidev ハーネスの state.yml / metrics.yml 更新を「単一の検証済み経路」に集約し、
#       工程の前提・不変条件を決定的に検査する（散文規約=ソフト / この CLI=ハードの二層）。
# 正典: .claude/skills/aidev-00-start/protocol.md（§6 state / §8 metrics / §4.1 命名 / §2.7 依存）。
# Windows 版は同ディレクトリの aidev.ps1（挙動を一致させること）。
#
# 使い方:
#   aidev new <slug> [--mode interactive|autonomous] [--profile full|light] [--light] [--ticket ID]
#                    [--depends a,b,#N] [--parent <親work>] [--backlog <file>]
#     --parent 指定時は親 work 配下に subtask（<NN>-<subslug>・date prefix なし・current=plan）を作る
#     --backlog は backlog 項目から起こした work に出自を刻む（deliver での消し込みを verify が強制する）
#     --profile/--light は「どこまで工程を回すか」（protocol.md「11.」）。mode（誰が承認するか）と直交
#   aidev escalate [slug]                      # profile を light -> full に昇格（片方向。full からは戻せない）
#   aidev event <phase> <start|approved|sent_back> [key=value ...]
#   aidev approve <phase> [key=value ...]      # approved 追記 + current 更新 + approved イベント
#   aidev unapprove <phase> [--slug <work>]    # 差し戻しで後工程の承認を取り消す（記録は消さない）
#   aidev guard <phase>                        # 前提成果物 + dependsOn の充足を検査（exit!=0で未充足）
#   aidev verify [slug] [--strict]             # 現在(or指定)workの不変条件を version-aware に検査
#     --strict は**記録漏れ(event の start 欠落)だけ**を致命(exit 5)にする。機械ゲート（Claude Code の
#     Stop フック等）から使う想定。light の逸脱 WARN は人間の判断なので strict でも致命にしない
#   aidev doctor                               # 全 work を横断検査（legacy は免除）＋ backlog ファイル検査（WARN）
#   aidev use [<slug>]                         # 継続する作業を切り替える（引数なしで現在値を表示）
#   aidev backlog new <name> --kind standing|split|topic [--parent <p>] [--priority <n>]
#     frontmatter 付きで backlog ファイルを起こす（kind 欠落を構造的に防ぐ）
#   aidev backlog archive [<file>...] [--force]  # 消化しきった backlog を archive/ へ退避（mv のみ・git は触らない）
#   aidev convention new <id> --hypothesis <text> --baseline <text> [--source <path>] [--verify-after <n>]
#     PJ規約の条項を docs/aidev/ に起こす。--hypothesis と --baseline が必須＝検証できない条項を作らせない入口ゲート
#     （baseline: 導入前にこの観点の指摘が何件あったか。id 別の件数は 0->N と増えるだけで前後比較にならないため）
#   aidev convention confirm <id> [--result <text>]     # 効果あり -> PJ ドキュメントへ移送待ちになる
#   aidev convention retire  <id> --status ineffective|superseded [--note <text>]  # 効果なし/置換で退役
#   aidev convention promote <id> --to <path#anchor>    # 本文を PJ docs へ移した後、tombstone 化して退避
#   aidev convention status [--format table|tsv]        # 条項の状態・母集団件数・判定可否を一覧
#   aidev status [--format table|tsv]          # works横断＋backlog未着手の状況サマリ（読み取り専用）
#   aidev metrics [slug] [--all] [--phases] [--format table|tsv]  # metrics.yml から派生指標を集計（読み取り専用）
#   aidev worktree add <slug> [--branch n] [--base ref] [--path dir] [--mode m] [--ticket id] [--depends list]
#                                              # work 専用の git worktree+ブランチを作る（ユーザー責任の並行 on-ramp）
#   aidev worktree list [--format table|tsv]   # aidev 管理 worktree を一覧（読み取り専用）
#   aidev worktree rm <slug|path> [--force] [--delete-branch]     # worktree を安全に撤去（未コミットは既定で拒否）
#   aidev help
#
# 終了コード: 0=OK / 1=使用法・環境エラー / 2=前提成果物の不足 / 3=依存(dependsOn)未充足 / 4=不変条件違反
#             5=記録漏れ（verify --strict のときのみ。既定の verify では WARN 止まりで 0）

set -eu

# オプション値の取り出し口。`--opt) v=$2; shift 2` を裸で書くと、値が欠けたときに
# 「shift: can't shift that many」「parameter not set」という**シェルの内部エラー**が
# rc=2 で漏れる。何が悪いのか読めないうえ、ps1 側は $null を拾って素通りし別の rc で終わる
#（同じ入力で OS ごとに違う挙動＝この CLI が一番やってはいけないこと）。使い方エラーは
# 他と同じ die(rc=1) に揃える。呼び方: `--opt) need_arg "$1" $#; v=$2; shift 2 ;;`
need_arg() { # opt残り引数数
  [ "$2" -ge 2 ] || die "$1 には値が必要です"
}

CURRENT_SCHEMA=5   # 現行スキーマ版。new がこの値を刻む。schema 3=subtask 層(subtasks/activeSubtask/parent)導入。schema 4=harnessRev 刻印（効果検証の母集団特定）導入。schema 5=承認済み工程の成果物実在検査を導入。schema<=2 は legacy として subtask 不変条件を免除。

PHASES="requirement research spec design plan coding test review walkthrough deliver retro"

die()  { printf 'aidev: %s\n' "$*" >&2; exit 1; }
warn() { printf 'aidev: %s\n' "$*" >&2; }
now()  { date -u +%Y-%m-%dT%H:%M:%SZ; }

# --- ルート/作業ディレクトリ解決 -------------------------------------------------
find_root() {
  d=$(pwd)
  while [ "$d" != "/" ]; do
    [ -d "$d/.aidev" ] && { printf '%s\n' "$d"; return 0; }
    d=$(dirname "$d")
  done
  [ -d "/.aidev" ] && { printf '%s\n' "/"; return 0; }
  return 1
}

ROOT=$(find_root) || die ".aidev が見つかりません（リポジトリ内で実行してください）"
AIDEV="$ROOT/.aidev"

resolve_work() { # [slug]
  # slug は top-level work（dated 名）か subtask のネストパス（<dated>/<NN>-<subslug>）。
  # works/<slug> へ素直に連結するためネストもそのまま解決できる（subtask 層の単一経路）。
  slug=${1:-}
  if [ -z "$slug" ]; then
    slug=${AIDEV_WORK:-}
  fi
  if [ -z "$slug" ]; then
    [ -f "$AIDEV/current" ] || die "対象作業が不明です（.aidev/current 無し）。aidev new か slug 指定を。"
    slug=$(head -n1 "$AIDEV/current" | tr -d '\r\n')
  fi
  WORK="$AIDEV/works/$slug"
  [ -d "$WORK" ] || die "work が存在しません: $slug"
  SLUG=$slug
}

# state.yml の key 行を差し替え、無ければ末尾に追記（subtasks/activeSubtask の冪等更新用）。
set_or_append() { # file key newline
  if grep -q "^$2:" "$1"; then replace_line "$1" "$2" "$3"; else printf '%s\n' "$3" >> "$1"; fi
}

is_phase() { for p in $PHASES; do [ "$p" = "$1" ] && return 0; done; return 1; }

# --- 最小 YAML 読み取り（フロー形式前提） ------------------------------------------
# scalar: 'key: value' -> value（前後空白と囲み二重引用符を除去）。
# 注意: inline コメント(#)は除去しない。state.yml/metrics.yml は機械生成でコメントを含まず、
#       逆に ticket/dependsOn は '#18' 等 '#' 始まりの値を持つため（'#' をコメント扱いすると消える）。
yget() {
  sed -n "s/^$2:[[:space:]]*//p" "$1" 2>/dev/null | head -n1 \
    | sed 's/[[:space:]]*$//; s/^"//; s/"$//'
}
# flow list: "key: [a, b]" -> "a b"（カンマ/角括弧除去・クォート除去）
ylist() {
  v=$(yget "$1" "$2")
  v=${v#[}; v=${v%]}
  printf '%s' "$v" | tr ',' ' ' | tr -d '"'
}
approved_has() { ylist "$WORK/state.yml" approved | grep -qw "$1"; }

# 1行を丸ごと差し替え（awk で sed エスケープ事故を回避）
replace_line() { # file key newline
  awk -v key="^$2:" -v repl="$3" '$0 ~ key {print repl; next} {print}' "$1" > "$1.tmp" && mv "$1.tmp" "$1"
}

# --- metrics.yml 追記 ---------------------------------------------------------
ensure_events() {
  f="$WORK/metrics.yml"
  if [ ! -f "$f" ]; then printf 'events:\n' > "$f"; return; fi
  # events: [] を block 形式に変換（block item を足すため）
  if grep -q '^events:[[:space:]]*\[\][[:space:]]*$' "$f"; then
    awk '/^events:[[:space:]]*\[\][[:space:]]*$/{print "events:"; next}{print}' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  fi
  grep -q '^events:' "$f" || printf 'events:\n' >> "$f"
}

build_entry() { # phase event [key=value ...]
  ph=$1; ev=$2; shift 2
  m=""
  for kv in "$@"; do
    k=${kv%%=*}; val=${kv#*=}
    if [ -z "$m" ]; then m="$k: $val"; else m="$m, $k: $val"; fi
  done
  if [ -n "$m" ]; then
    printf '{ ts: %s, phase: %s, event: %s, metrics: { %s } }' "$(now)" "$ph" "$ev" "$m"
  else
    printf '{ ts: %s, phase: %s, event: %s }' "$(now)" "$ph" "$ev"
  fi
}

append_event() { # phase event [key=value ...]
  ensure_events
  entry=$(build_entry "$@")
  printf '  - %s\n' "$entry" >> "$WORK/metrics.yml"
}

# --- ハーネス版（効果検証の母集団特定） -------------------------------------------
# ハーネス自身の改修が効いたかを後から判定するには、その work が**どの版のハーネスで回されたか**が
# 要る。刻印を手書きに任せると忘れられ、忘れられた work は母集団から静かに漏れる（schema: を new に
# 一本化したのと同じ理由）。そこで new が自動で刻む。
# 版の実体は「ハーネス・ディレクトリを最後に触ったコミット」。git が無い/取れない環境では捏造せず
# 'unknown' を刻む（protocol.md「8.」の「過去分は捏造しない」と同じ態度）。
BIN_DIR=$(cd "$(dirname "$0")" && pwd)
HARNESS=$(dirname "$(dirname "$BIN_DIR")")   # <skills>/aidev-docs/bin -> <skills>

harness_rev() {
  command -v git >/dev/null 2>&1 || { printf 'unknown'; return 0; }
  # 見る範囲は **aidev-* の skill だけ**。<skills> 全体を見ると、同居する無関係な skill
  # （md-to-doc など）の変更でも版が上がり、その間に走った work が全部「またがり」に見える。
  # またがり判定は母集団からの除外なので、誤検知はそのまま**効果検証の母集団を痩せさせる**。
  set --
  for _d in "$HARNESS"/aidev-*; do [ -d "$_d" ] && set -- "$@" "$_d"; done
  [ "$#" -gt 0 ] || { printf 'unknown'; return 0; }
  r=$(git -C "$HARNESS" log -1 --format=%h -- "$@" 2>/dev/null || true)
  [ -n "$r" ] || r=unknown
  printf '%s' "$r"
}

# --- 条項（docs/aidev の PJ規約）---------------------------------------------------
# ハーネスが生成した規約は **PJ 所有の AGENTS.md / CLAUDE.md に書き込まない**（protocol.md「12.」）。
# docs/aidev/ は終着点ではなく**検証中の待避所**で、条項は必ずここから出ていく:
#   効果あり -> PJ ドキュメントへ移送(promote) / 効果なし・置換 -> 退役(retire)
# 本文の在処を常に1箇所に保つことで二重管理を構造的に防ぐ（移送後は tombstone＝リンクのみ）。
CV_TERMINAL="promoted ineffective superseded"

cv_dir() {
  d=$(yget "$AIDEV/config.yml" conventionsDir)
  [ -n "$d" ] || d="docs/aidev"
  case "$d" in /*) printf '%s' "$d" ;; *) printf '%s/%s' "$ROOT" "$d" ;; esac
}

# 条項ファイル先頭 frontmatter から key を読む（bl_kind の汎用版）。
cv_get() { # file key
  awk -v k="$2" '
    NR==1 && $0 !~ /^---[[:space:]]*$/ {exit}
    NR==1 {next}
    /^---[[:space:]]*$/ {exit}
    index($0, k ":")==1 { sub("^" k ":[[:space:]]*",""); sub(/[[:space:]]*$/,""); print; exit }' "$1" 2>/dev/null
}

# frontmatter 内の key を差し替え、無ければ frontmatter 末尾に足す（冪等）。
cv_set() { # file key value
  awk -v k="$2" -v v="$3" '
    BEGIN{fm=0; done=0}
    NR==1 && /^---[[:space:]]*$/ {print; fm=1; next}
    fm==1 && /^---[[:space:]]*$/ { if(!done) print k": "v; print; fm=2; next }
    fm==1 && index($0, k ":")==1 { print k": "v; done=1; next }
    {print}' "$1" > "$1.tmp" && mv "$1.tmp" "$1"
}

# 本文を捨てて tombstone にする。**本文が2箇所に存在する瞬間を作らない**のが移送の要点。
cv_tombstone() { # file text
  awk -v msg="$2" '
    BEGIN{fm=0}
    NR==1 && /^---[[:space:]]*$/ {print; fm=1; next}
    fm==1 && /^---[[:space:]]*$/ {print; print ""; print msg; fm=2; next}
    fm==1 {print; next}
    {next}' "$1" > "$1.tmp" && mv "$1.tmp" "$1"
}

# id からパスを解決する。**id は必ずここで潰す**——`../foo` のような値をそのまま連結すると、
# 条項ディレクトリの外のファイルを confirm/retire/promote が破壊・移動できてしまう
#（cv_new だけが basename を通しており、他3つが素通しだった）。
cv_id() { # 生の id -> 安全な id（パス成分とスラッシュを落とす）
  _i=$(basename -- "$1" .md)
  case "$_i" in ''|.|..) die "id が不正です: $1" ;; esac
  printf '%s' "$_i"
}

cv_find() { # id -> パスを出力（active 優先、無ければ archive）。見つからなければ 1
  _d=$(cv_dir)
  _id=$(cv_id "$1")
  if [ -f "$_d/$_id.md" ]; then printf '%s' "$_d/$_id.md"; return 0; fi
  if [ -f "$_d/archive/$_id.md" ]; then printf '%s' "$_d/archive/$_id.md"; return 0; fi
  return 1
}

# 条項ファイルであることを確かめる。**frontmatter が無いものを触らせない**——
# cv_tombstone は「frontmatter 内の行だけ残す」実装なので、frontmatter が無いファイルに
# かけると本文が丸ごと消える（README を条項ディレクトリに置いただけで 0 バイトになった）。
cv_require() { # path id
  if [ "$(head -n1 "$1" 2>/dev/null | tr -d '\r')" != "---" ]; then
    die "条項ファイルではありません（frontmatter が無い）: $1"
  fi
  if [ -z "$(cv_get "$1" convention)" ] && [ -z "$(cv_get "$1" status)" ]; then
    die "条項ファイルではありません（convention / status がどちらも無い）: $1"
  fi
}

# 母集団＝その条項の導入日以降に着手し、**かつ deliver 済み**の work の件数。
#
# 条件が2つある理由:
#  - **導入日以降に着手**: 導入前から走っていた work は条項の効果を半分しか受けていない
#    （またがり work を入れると効果が薄まる方向にバイアスがかかる）。
#  - **deliver 済み**: 着手しただけの work は review を通っていない＝**判定材料を1つも産んでいない**。
#    着手だけで数えると、レビュー記録がまだ無いのに ready=yes が立ち、insights が
#    空の材料で判定してしまう。母集団の増える瞬間は `approve deliver` の1点になる。
cv_pop() { # introduced(YYYY-MM-DD) -> 件数
  n=0
  [ -d "$AIDEV/works" ] || { printf '0'; return 0; }
  _b=$(printf '%s' "$1" | tr -d '-')
  case "$_b" in ''|*[!0-9]*) printf '0'; return 0 ;; esac
  for d in "$AIDEV/works"/*/; do
    [ -d "$d" ] || continue
    f="${d}metrics.yml"
    [ -f "$f" ] || continue
    ylist "${d}state.yml" approved | grep -qw deliver || continue
    # `.*ts:` は貪欲で、行内の**最後の** ts: を拾う。metrics キーが ts で終わる
    # （defects / commits / tests / artifacts …）と、その数値を着手日として読んでしまう。
    # イベント行の形 `- { ts: … }` に合わせて、最初の `{` の直後にアンカーする。
    ts=$(sed -n 's/^[^{]*{[[:space:]]*ts:[[:space:]]*\([0-9][0-9-]*\).*/\1/p' "$f" | head -n1)
    [ -n "$ts" ] || continue
    _a=$(printf '%s' "${ts%%T*}" | tr -d '-')
    case "$_a" in ''|*[!0-9]*) continue ;; esac
    if [ "$_a" -ge "$_b" ]; then n=$((n+1)); fi
  done
  printf '%s' "$n"
}

# 判定可能になった条項の通知。**works が母集団に加わる唯一の瞬間＝`approve deliver`** に鳴らす。
# doctor にも同じ検査があるが、doctor の WARN は retro/insights を叩いた人にしか見えない
#（＝既に見に行った人にしか届かない）。判定できる状態になったことは、その瞬間に知らせる。
cv_ready_notice() {
  d=$(cv_dir)
  [ -d "$d" ] || return 0
  for f in "$d"/*.md; do
    [ -f "$f" ] || continue
    [ "$(cv_get "$f" status)" = pending ] || continue
    intro=$(cv_get "$f" introduced); [ -n "$intro" ] || continue
    va=$(cv_get "$f" verify_after)
    case "$va" in ''|*[!0-9]*) continue ;; esac
    [ "$va" -gt 0 ] || continue
    pop=$(cv_pop "$intro")
    if [ "$pop" -ge "$va" ]; then
      printf 'note: 条項 %s の母集団が揃いました(%s/%s)。insights で効果を判定してください\n' \
        "$(basename "$f" .md)" "$pop" "$va"
    fi
  done
}

# --- コマンド: new ------------------------------------------------------------
cmd_new() {
  slug=""; mode=""; profile=""; ticket=""; depends=""; parent=""; backlog=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --mode) need_arg "$1" $#; mode=$2; shift 2 ;;
      --profile) need_arg "$1" $#; profile=$2; shift 2 ;;
      --light) profile=light; shift ;;
      --ticket) need_arg "$1" $#; ticket=$2; shift 2 ;;
      --depends) need_arg "$1" $#; depends=$2; shift 2 ;;
      --parent) need_arg "$1" $#; parent=$2; shift 2 ;;
      # `--` を付けないと、値が `-` で始まるとき basename 自身の使い方エラーが
      # `aidev:` 前置なしで漏れる（need_arg を入れた動機と同じ穴）
      --backlog) need_arg "$1" $#; backlog=$(basename -- "$2"); shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$slug" ] && slug=$1 || die "slug は1つだけ"; shift ;;
    esac
  done
  [ -n "$slug" ] || die "使用法: aidev new <slug> [--mode ..] [--profile ..|--light] [--ticket ..] [--depends ..] [--parent <親work>] [--backlog <file>]"
  # backlog 出自は「消し込み忘れ」を verify で捕まえるための刻印。存在しないファイルを
  # 指したまま進むと deliver 直前まで気づけないので、この場で弾く
  if [ -n "$backlog" ] && [ ! -f "$AIDEV/backlog/$backlog" ]; then
    die "backlog ファイルが無い: .aidev/backlog/$backlog"
  fi

  deps_yaml="[]"
  if [ -n "$depends" ]; then
    list=""
    old_ifs=$IFS; IFS=,
    for d in $depends; do
      d=$(printf '%s' "$d" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
      [ -z "$d" ] && continue
      if [ -z "$list" ]; then list="$d"; else list="$list, $d"; fi
    done
    IFS=$old_ifs
    deps_yaml="[$list]"
  fi

  # 子は backlog 出自を持たない設計（出自は親が持つ）。受理して黙って捨てると、
  # 「刻んだつもり」の状態が state に残らないまま進む
  if [ -n "$parent" ] && [ -n "$backlog" ]; then
    die "--parent と --backlog は併用できません（backlog 出自は親 work に刻む）"
  fi
  if [ -n "$parent" ]; then
    # --- subtask 生成: 親 work 配下に <slug>(=NN-subslug) で作る（date prefix なし）。current は plan 開始 ---
    pdir="$AIDEV/works/$parent"
    [ -d "$pdir" ] || die "親 work が存在しません: $parent"
    [ -f "$pdir/state.yml" ] || die "親 state.yml がありません: $parent"
    # C: 多段ネスト禁止（単層のみ）。親が既に subtask なら拒否（doctor 横断・依存解決・activeSubtask は1段前提）
    [ -n "$(yget "$pdir/state.yml" parent)" ] && die "親が既に subtask です。多段ネストは不可（subtask は単層のみ）: $parent"
    case "$slug" in */*) die "subtask slug にスラッシュは使えません: $slug" ;; esac
    name="$parent/$slug"
    WORK="$AIDEV/works/$name"
    [ -d "$WORK" ] && die "subtask が既に存在します: $name"
    # mode 未指定なら親から継承
    [ -n "$mode" ] || mode=$(yget "$pdir/state.yml" mode)
    [ -n "$mode" ] || mode=interactive
    case "$mode" in interactive|autonomous) ;; *) die "mode は interactive|autonomous" ;; esac
    # profile も mode と同様に親から継承する（省略時）。light 親は本来分割しないが、
    # 継承しておけば「親 light / 子 full」という食い違いが構造的に起きない
    [ -n "$profile" ] || profile=$(yget "$pdir/state.yml" profile)
    [ -n "$profile" ] || profile=full
    case "$profile" in full|light) ;; *) die "profile は full|light" ;; esac
    mkdir -p "$WORK"

    {
      printf 'schema: %s\n' "$CURRENT_SCHEMA"
      printf 'slug: %s\n' "$slug"
      printf 'parent: %s\n' "$parent"
      [ -n "$ticket" ] && printf 'ticket: %s\n' "$ticket"
      printf 'current: plan\n'
      printf 'approved: []\n'
      printf 'mode: %s\n' "$mode"
      printf 'profile: %s\n' "$profile"
      printf 'humanGates: []\n'
      printf 'maxSendBacks: 3\n'
      printf 'dependsOn: %s\n' "$deps_yaml"
      printf 'harnessRev: %s\n' "$(harness_rev)"

    } > "$WORK/state.yml"
    printf 'events:\n' > "$WORK/metrics.yml"

    # 親 state.yml の subtasks に追記し、activeSubtask が未設定なら本 subtask を活性にする
    pst="$pdir/state.yml"
    cur=$(ylist "$pst" subtasks)
    # 既存の subtasks を保持し、未登録なら slug を末尾に足す（冪等。ps1 の -notcontains と一致）
    plist=""
    for s in $cur; do [ -z "$plist" ] && plist="$s" || plist="$plist, $s"; done
    case " $cur " in *" $slug "*) ;; *) [ -z "$plist" ] && plist="$slug" || plist="$plist, $slug" ;; esac
    set_or_append "$pst" subtasks "subtasks: [$plist]"
    act=$(yget "$pst" activeSubtask)
    if [ -z "$act" ] || [ "$act" = "done" ]; then
      set_or_append "$pst" activeSubtask "activeSubtask: $slug"
      act=$slug
    fi

    # カーソルは**活性の子**に合わせる。無条件に「今作った子」へ動かすと、親 plan で子を
    # まとめて起こしたとき（30-plan の手順どおり）activeSubtask=先頭 / current=最後 になり、
    # 「冗長コピー」の定義（protocol.md「6.」）が生成直後から破れる。しかも current の指す先は
    # 兄弟依存で塞がっていることが多く、そのまま工程に入ると exit 3 になる
    printf '%s/%s\n' "$parent" "$act" > "$AIDEV/current"
    printf 'created subtask: %s (parent %s, schema %s, mode %s, profile %s)\n' "$WORK" "$parent" "$CURRENT_SCHEMA" "$mode" "$profile"
    return 0
  fi

  # --- 通常(top-level) work ---
  [ -n "$mode" ] || mode=interactive
  case "$mode" in interactive|autonomous) ;; *) die "mode は interactive|autonomous" ;; esac
  [ -n "$profile" ] || profile=full
  case "$profile" in full|light) ;; *) die "profile は full|light" ;; esac

  date_p=$(date -u +%Y%m%d)
  base="$date_p-$slug"; name="$base"; n=2
  while [ -d "$AIDEV/works/$name" ]; do name="$base-$n"; n=$((n+1)); done
  WORK="$AIDEV/works/$name"
  mkdir -p "$WORK"

  {
    printf 'schema: %s\n' "$CURRENT_SCHEMA"
    printf 'slug: %s\n' "$slug"
    [ -n "$ticket" ] && printf 'ticket: %s\n' "$ticket"
    printf 'current: requirement\n'
    printf 'approved: []\n'
    printf 'mode: %s\n' "$mode"
    printf 'profile: %s\n' "$profile"
    printf 'humanGates: []\n'
    printf 'maxSendBacks: 3\n'
    printf 'dependsOn: %s\n' "$deps_yaml"
    printf 'harnessRev: %s\n' "$(harness_rev)"
    # `[ … ] && printf` にしない（set -eu 下で group の戻り値が 1 になる形を避ける。下の注記と同じ理由）
    if [ -n "$backlog" ]; then printf 'backlog: %s\n' "$backlog"; fi
  } > "$WORK/state.yml"

  printf 'events:\n' > "$WORK/metrics.yml"
  printf '%s\n' "$name" > "$AIDEV/current"
  printf 'created: %s (schema %s, mode %s, profile %s)\n' "$WORK" "$CURRENT_SCHEMA" "$mode" "$profile"
  if [ "$profile" = light ]; then
    printf 'note: profile=light。上流3工程は requirement 1ゲートに畳む（protocol.md「11.」）\n'
  fi
  # 注意: ここを `[ -n "$backlog" ] && printf …` と書くと、backlog 未指定時に
  # **関数の戻り値が 1 になる**（末尾コマンドの終了状態がそのまま返る）。
  # worktree add は cmd_new の戻り値を見るので、それだけで add が失敗する
  if [ -n "$backlog" ]; then
    printf 'backlog: %s（deliver で該当行を [x] にすること。verify が検査する）\n' "$backlog"
  fi
}

# --- コマンド: event ----------------------------------------------------------
cmd_event() {
  [ $# -ge 2 ] || die "使用法: aidev event <phase> <start|sent_back> [k=v ...]"
  ph=$1; ev=$2; shift 2
  is_phase "$ph" || die "未知の phase: $ph"
  case "$ev" in
    start|sent_back) ;;
    # `event <phase> approved` は metrics にだけ approved を書き、state.yml の approved は
    # 更新しない。両者が乖離した work は verify も検知できない（イベント対は壊れないため）。
    # approved の記録は approve の役割（state 更新 + イベント追記を一括で行う）
    approved) die "approved は aidev approve <phase> で記録すること（event では state.yml が更新されず、metrics と乖離する）" ;;
    *) die "event は start|sent_back（approved は approve コマンド）" ;;
  esac
  resolve_work
  append_event "$ph" "$ev" "$@"
  printf 'recorded: %s/%s/%s\n' "$SLUG" "$ph" "$ev"
}

# --- コマンド: approve --------------------------------------------------------
cmd_approve() {
  [ $# -ge 1 ] || die "使用法: aidev approve <phase> [k=v ...]"
  ph=$1; shift
  is_phase "$ph" || die "未知の phase: $ph"
  resolve_work
  st="$WORK/state.yml"
  [ -f "$st" ] || die "state.yml がありません: $SLUG"

  if approved_has "$ph"; then
    : # 既に承認済み（冪等）
  else
    cur=$(ylist "$st" approved)
    if [ -z "$cur" ]; then newl="[$ph]"; else
      list=""
      for p in $cur; do if [ -z "$list" ]; then list="$p"; else list="$list, $p"; fi; done
      newl="[$list, $ph]"
    fi
    replace_line "$st" approved "approved: $newl"
  fi
  replace_line "$st" current "current: $ph"
  append_event "$ph" approved "$@"
  printf 'approved: %s @ %s\n' "$ph" "$SLUG"

  # deliver 時のハーネス版も刻む。new 時と食い違う work は**改修をまたいで走った**ので、
  # 前半を旧版・後半を新版で回している。どちらかに帰属させると効果が薄まるため、
  # 効果検証の母集団からは除外する（判定は insights、検知は verify の WARN）。
  if [ "$ph" = deliver ]; then
    _hr=$(harness_rev)
    set_or_append "$st" harnessRevDelivered "harnessRevDelivered: $_hr"
    _hr0=$(yget "$st" harnessRev)
    if [ -n "$_hr0" ] && [ "$_hr0" != "$_hr" ] && [ "$_hr0" != unknown ] && [ "$_hr" != unknown ]; then
      printf 'note: ハーネス版が着手時(%s)と着地時(%s)で異なる＝またがり work。効果検証の母集団からは除外される\n' "$_hr0" "$_hr"
    fi
    # この deliver で母集団が揃った条項があれば、その場で知らせる（下の cv_ready_notice の注記参照）
    cv_ready_notice
  fi


  # D: subtask の review 承認でカーソルを前進させる（散文の手動カーソル操作を排除）。
  # 親 subtasks を順に見て review 未承認の最初の子を次の active にする。無ければ done（→親の統合 test へ）。
  if [ "$ph" = review ]; then
    par=$(yget "$st" parent)
    if [ -n "$par" ] && [ -d "$AIDEV/works/$par" ]; then
      pst="$AIDEV/works/$par/state.yml"
      nextsub=""
      for s in $(ylist "$pst" subtasks); do
        sap=$(ylist "$AIDEV/works/$par/$s/state.yml" approved)
        case " $sap " in *" review "*) ;; *) nextsub="$s"; break ;; esac
      done
      if [ -n "$nextsub" ]; then
        set_or_append "$pst" activeSubtask "activeSubtask: $nextsub"
        printf '%s\n' "$par/$nextsub" > "$AIDEV/current"
        printf 'cursor: activeSubtask=%s（次の subtask へ自動前進）\n' "$nextsub"
      else
        set_or_append "$pst" activeSubtask "activeSubtask: done"
        printf '%s\n' "$par" > "$AIDEV/current"
        printf 'cursor: 全 subtask 完了 → activeSubtask=done。親 %s の統合 test へ\n' "$par"
      fi
    fi
  fi
}

# --- コマンド: guard ----------------------------------------------------------
# subtask は上流成果物(requirement/spec/design)のみ親から継承する。plan.md/tasks.md は subtask 固有なので継承しない。
need_file() {
  [ -f "$WORK/$1" ] && return 0
  case "$1" in
    requirement.md|spec.md|design.md) [ -n "${PARENT_DIR:-}" ] && [ -f "$PARENT_DIR/$1" ] && return 0 ;;
  esac
  GMISS="$GMISS $1"; return 1
}
need_approved(){ approved_has "$1" || { GUNAPP="$GUNAPP $1"; return 1; }; return 0; }

# 依存(dependsOn)の充足を読み取り専用で評価（state は変更しない）。
# 結果を EVAL_UNMET（works 由来の未充足・exit に影響）/ EVAL_ADVISORY（外部チケット #N の生トークン）に格納。
eval_depends() { # work_dir
  _wd=$1
  EVAL_UNMET=""; EVAL_ADVISORY=""
  deps=$(ylist "$_wd/state.yml" dependsOn)
  # subtask は同一親配下の兄弟 subtask を bare 名（NN-subslug）で依存指定できる。
  _par=$(yget "$_wd/state.yml" parent)
  for d in $deps; do
    [ -z "$d" ] && continue
    case "$d" in
      \#*) # 外部チケット(#N): 自動判定不可＝advisory（手動確認）
        EVAL_ADVISORY="$EVAL_ADVISORY $d" ;;
      *) # それ以外は works slug とみなす。top-level に無く親配下にあれば兄弟 subtask として解決
        _dep="$AIDEV/works/$d"
        if [ ! -d "$_dep" ] && [ -n "$_par" ] && [ -d "$AIDEV/works/$_par/$d" ]; then
          _dep="$AIDEV/works/$_par/$d"
        fi
        if [ -d "$_dep" ]; then
          da=$(ylist "$_dep/state.yml" approved)
          # 完了判定: subtask(=parent あり)は review 承認、top-level work は deliver 承認
          if [ -n "$(yget "$_dep/state.yml" parent)" ]; then
            printf '%s' "$da" | grep -qw review || EVAL_UNMET="$EVAL_UNMET $d(未review)"
          else
            printf '%s' "$da" | grep -qw deliver || EVAL_UNMET="$EVAL_UNMET $d(未deliver)"
          fi
        else
          EVAL_UNMET="$EVAL_UNMET $d(work不明)"
        fi ;;
    esac
  done
}

check_depends() {
  eval_depends "$WORK"
  GDEP=$EVAL_UNMET
  for a in $EVAL_ADVISORY; do
    warn "依存(外部チケット $a): 自動判定不可＝advisory（手動確認）"
  done
}

cmd_guard() {
  [ $# -ge 1 ] || die "使用法: aidev guard <phase>"
  ph=$1
  is_phase "$ph" || die "未知の phase: $ph"
  resolve_work
  GMISS=""; GUNAPP=""
  # subtask なら上流成果物の継承元として親 work dir を立てる（need_file の fallback）
  PARENT_DIR=""
  _par=$(yget "$WORK/state.yml" parent)
  [ -n "$_par" ] && [ -d "$AIDEV/works/$_par" ] && PARENT_DIR="$AIDEV/works/$_par"
  # B: 親専用工程は subtask で実行不可（subtask の工程は plan/coding/test/review のみ）
  if [ -n "$_par" ]; then
    case "$ph" in
      requirement|research|spec|design|walkthrough|deliver|retro)
        printf 'NG %s は親 work 専用です（subtask では実行不可。subtask の工程は plan/coding/test/review）: %s\n' "$ph" "$SLUG" >&2
        return 2 ;;
    esac
  fi
  case "$ph" in
    requirement) : ;;
    research|spec) need_file requirement.md || : ;;
    design) need_file spec.md || : ;;
    plan) need_file spec.md || : ;;  # tasks.md は plan の産物なので前提にしない
    coding) need_file plan.md || : ; need_file tasks.md || : ;;
    # 分割 work の親は tasks.md を持たない（各 subtask の plan が作る。aidev-30-plan「4.」）。
    # ここを一律に要求すると、書いてあるとおりに plan を書いた親の統合 test が必ず塞がる。
    # 親の前提は「plan.md があり、全 subtask が review 承認済み」
    test)
      if [ -n "$(ylist "$WORK/state.yml" subtasks)" ]; then
        need_file plan.md || :
        for _s in $(ylist "$WORK/state.yml" subtasks); do
          case " $(ylist "$WORK/$_s/state.yml" approved) " in
            *" review "*) ;;
            *) GMISS="$GMISS $_s(未review)" ;;
          esac
        done
      else
        need_file tasks.md || :
      fi ;;
    # 60-review の前提「test 工程を通過していること」に経路を与える。
    # 宣言だけで検査が無いと、protocol.md「2.」の「前提工程の承認を機械的に検査する」が嘘になる
    review) need_file spec.md || : ; need_approved test || : ;;
    walkthrough|deliver) need_approved review || : ;;
    retro) need_approved deliver || : ;;
  esac
  check_depends

  rc=0
  if [ -n "$GMISS" ]; then printf 'NG 前提成果物が不足:%s\n' "$GMISS" >&2; rc=2; fi
  if [ -n "$GUNAPP" ]; then printf 'NG 前提工程が未承認:%s\n' "$GUNAPP" >&2; rc=2; fi
  if [ -n "$GDEP" ]; then printf 'NG 依存(dependsOn)が未充足:%s\n' "$GDEP" >&2; [ $rc -eq 0 ] && rc=3; fi
  if [ $rc -eq 0 ]; then
    printf 'OK guard %s @ %s\n' "$ph" "$SLUG"
    # guard は「入ってよいか」の判定で、start の記録は別コマンド。
    # 分かれているため記録を忘れる事故が実際に起きた（review の start が両ラウンドとも欠落）。
    # start を自動記録はしない（skill 側の event start と二重になり、手戻り回数を
    # 誤って数えるため）。代わりに、まだ必要な場合だけ促す。
    if needs_start "$ph"; then
      printf '   → 忘れずに: aidev event %s start\n' "$ph"
    fi
  fi
  return $rc
}

# その工程に新しい start の記録が要るか（start 回数 <= approved 回数なら要る）。
needs_start() { # phase
  [ -f "$WORK/metrics.yml" ] || return 0
  awk -v p="$1" '
    match($0, /phase:[[:space:]]*[a-z]+/) {
      ph = substr($0, RSTART, RLENGTH); sub(/phase:[[:space:]]*/, "", ph)
      if (ph != p) next
      if ($0 ~ /event:[[:space:]]*start/)    s++
      if ($0 ~ /event:[[:space:]]*approved/) a++
    }
    END { exit (s <= a) ? 0 : 1 }
  ' "$WORK/metrics.yml"
}

# --- コマンド: verify（version-aware） -----------------------------------------
verify_work() { # WORK already set; prints lines; returns 0 ok / 4 fail / 5 strict時の記録漏れ
  st="$WORK/state.yml"
  VF=""; EPW=""
  if [ ! -f "$st" ]; then printf '  FAIL state.yml なし\n'; return 4; fi
  for k in slug current approved; do
    grep -q "^$k:" "$st" || VF="$VF state.yml:$k欠落"
  done

  schema=$(yget "$st" schema)
  if [ -z "$schema" ]; then
    printf '  SKIP legacy (schema 未記載・metrics導入前の作業として免除)\n'
  else
    # schema >= 2 の不変条件
    if [ "$schema" -ge 2 ] 2>/dev/null; then
      [ -f "$WORK/metrics.yml" ] || VF="$VF metrics.yml欠落"
      if approved_has review; then [ -f "$WORK/review.md" ] || VF="$VF review.md欠落(review承認済)"; fi
      # 承認済み工程の成果物が実在するか（protocol.md「7.」の成果物列）。
      # ここを見ないと、**成果物を1つも作らずに全工程 approve した work が
      # 「deliver 済み・verify OK」になる**。deliver の着地前ゲートが verify なので、
      # SDD の最低限の前提（各工程が成果物を残す）が誰にも守られていなかった。
      # 親（subtasks を持つ）は plan.md までで、tasks.md は子が持つ（aidev-30-plan「4.」）
      _issub=$(yget "$st" parent)
      _hassub=$(ylist "$st" subtasks)
      if [ "$schema" -ge 5 ] 2>/dev/null; then
      for _pf in requirement:requirement.md spec:spec.md plan:plan.md; do
        _ph=${_pf%%:*}; _pfile=${_pf#*:}
        approved_has "$_ph" || continue
        # subtask は親の requirement/spec/design を継承する（aidev:need_file と同じ規則）
        if [ -f "$WORK/$_pfile" ]; then continue; fi
        if [ -n "$_issub" ] && [ -f "$AIDEV/works/$_issub/$_pfile" ]; then continue; fi
        VF="$VF $_pfile欠落($_ph承認済)"
      done
      if approved_has plan && [ -z "$_hassub" ] && [ ! -f "$WORK/tasks.md" ]; then
        VF="$VF tasks.md欠落(plan承認済)"
      fi
      fi
      if approved_has deliver; then
        grep -Eq 'phase:[[:space:]]*deliver.*event:[[:space:]]*approved|event:[[:space:]]*approved.*phase:[[:space:]]*deliver' "$WORK/metrics.yml" 2>/dev/null \
          || VF="$VF deliver承認イベントがmetricsに無い"
        # backlog 出自の消し込み（DESIGN「2.5」: backlog 行は deliver で [x]）。
        # 直接入口（aidev-00-start で backlog 項目を選ぶ）は batch と違い自動で [x] にしないため、
        # 閉じ忘れると「完了済みの項目を次の人が選ぶ」（2026-08-01 に実際に発生）。
        # 行の同定は諦め、**backlog ファイルに自分の slug が現れるか**で見る
        #（消し込みの根拠に works slug を併記する規約と同じものを検査対象にしている）。
        bl=$(yget "$st" backlog)
        if [ -n "$bl" ]; then
          blf="$AIDEV/backlog/$bl"
          [ -f "$blf" ] || blf="$AIDEV/backlog/archive/$bl"
          if [ ! -f "$blf" ]; then
            VF="$VF backlog:${bl}が見つからない"
          elif ! grep -q "$SLUG" "$blf" 2>/dev/null; then
            VF="$VF backlog:${bl}に${SLUG}の消し込みが無い"
          fi
        fi
      fi
    fi
  fi

  # イベント対の検査（WARN。既存 work を壊さないよう終了コードは変えない）
  #
  # guard と event start が別コマンドなので、guard だけ実行して工程に入り
  # start を記録し忘れる事故が起きる（実際に review の start が両ラウンドとも
  # 欠落し、所要時間が導出できなくなった）。記録漏れは後から気付けないので、
  # deliver 前に verify が知らせる。
  if [ -f "$WORK/metrics.yml" ]; then
    EPW=$(event_pair_warnings "$WORK/metrics.yml")
    if [ -n "$EPW" ]; then printf '%s\n' "$EPW"; fi
  fi

  # profile: light の逸脱検査（WARN）
  light_warnings

  # またがり work の検知（WARN）。schema 4 以降のみ＝旧 work を遡って違反扱いしない。
  # 着手時と着地時でハーネス版が違う work は、改修の効果を半分しか受けていない。
  # 気付かずに母集団へ入れると効果検証が鈍るので、ここで見えるようにしておく。
  vsc=$(yget "$WORK/state.yml" schema)
  case "$vsc" in ''|*[!0-9]*) vsc=0 ;; esac
  if [ "$vsc" -ge 4 ]; then
    hr0=$(yget "$WORK/state.yml" harnessRev)
    hr1=$(yget "$WORK/state.yml" harnessRevDelivered)
    # `harnessRevDelivered` を書くのは **approve deliver**、verify が走るのは **その前**。
    # 着地時の刻印を待つ書き方だと、この検査は通常の順序では一度も発火しない。
    # まだ無いときは**今の版**と比べる（このまま deliver すればそれが着地時の版になる）。
    hrw=着地時
    if [ -z "$hr1" ]; then hr1=$(harness_rev); hrw=現在; fi
    if [ -z "$hr0" ]; then
      printf '  WARN harnessRev が無い: 効果検証の母集団から漏れる（aidev new で刻まれる）\n'
    elif [ -n "$hr1" ] && [ "$hr0" != "$hr1" ] && [ "$hr0" != unknown ] && [ "$hr1" != unknown ]; then
      # WARN ではなく note。またがりは**事後に取り消せない事実**で、人が直せることが無い。
      # verify の WARN（記録漏れ・light 逸脱）はどれも「いま直せる」もので、そこに直せない
      # 事実を毎回混ぜると——ハーネスを1回コミットしただけで in-flight 全 work が鳴き続ける——
      # 直せる WARN がノイズに埋もれる。事実の通知は approve deliver の note: と同じ扱いにする
      printf '  note: またがり work: ハーネス版が着手時(%s)と%s(%s)で異なる。効果検証の母集団からは除外される\n' "$hr0" "$hrw" "$hr1"
    fi
  fi


  if [ -n "$VF" ]; then printf '  FAIL%s\n' "$VF"; return 4; fi
  # --strict: **記録漏れだけ**を致命扱いにする（Stop フック等の機械ゲート用）。
  # 記録漏れは「今しか直せない」（metrics は追記のみで、当時の時刻は復元できない）。
  # 対して light の逸脱は人間の判断（昇格するか）なので strict でも致命にしない。
  if [ "${STRICT:-no}" = yes ] && [ -n "$EPW" ]; then
    printf '  FAIL(strict) 記録漏れ: 上記 WARN を解消してから終えること（timestamp は後から復元できません）\n'
    return 5
  fi
  printf '  OK\n'; return 0
}

# profile=light の条件逸脱を WARN で知らせる（終了コードには影響しない）。
#
# light は「振る舞い不変・小規模」を前提にした軽量プロファイル（protocol.md「11.」）。
# 条件を外れたら full へ昇格するのが正だが、**昇格漏れは後から気付けない**
# （light のまま着地すると、insights の「light の手戻り率」が実態より良く見える）。
# 判定は事後なので WARN 止まりにし、硬いゲートは既存の verify の判定に任せる。
light_warnings() { # WORK/SLUG は解決済み
  [ -f "$WORK/state.yml" ] || return 0
  [ "$(yget "$WORK/state.yml" profile)" = light ] || return 0
  mf="$WORK/metrics.yml"
  [ -f "$mf" ] || return 0

  # 任意工程を使った＝「小規模」の前提を外れている（protocol.md「11.」任意工程）
  for p in research design walkthrough; do
    if grep -Eq "phase:[[:space:]]*$p," "$mf" 2>/dev/null; then
      printf '  WARN profile=light だが任意工程 %s を実施（aidev escalate で full へ）\n' "$p"
    fi
  done

  # 変更規模が上限超過（deliver の files_changed。上限は .aidev/config.yml の lightMaxFiles、既定 3）
  max=$(yget "$AIDEV/config.yml" lightMaxFiles)
  case "$max" in ''|*[!0-9]*) max=3 ;; esac
  fc=$(grep -E 'phase:[[:space:]]*deliver,' "$mf" 2>/dev/null | grep -E 'event:[[:space:]]*approved' \
        | sed -n 's/.*files_changed:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | tail -n1)
  if [ -n "$fc" ] && [ "$fc" -gt "$max" ] 2>/dev/null; then
    printf '  WARN profile=light だが変更 %s ファイル（上限 %s）。aidev escalate で full へ\n' "$fc" "$max"
  fi
  return 0
}

# metrics.yml のイベント対を検査し、WARN 行を出す（終了コードには影響しない）。
event_pair_warnings() { # metrics_file
  awk -v phases="$PHASES" '
    match($0, /phase:[[:space:]]*[a-z]+/) {
      p = substr($0, RSTART, RLENGTH); sub(/phase:[[:space:]]*/, "", p)
      if (!(p in seen)) { seen[p] = ++nseen; order[nseen] = p }
      if ($0 ~ /event:[[:space:]]*start/)    starts[p]++
      if ($0 ~ /event:[[:space:]]*approved/) approved[p]++
    }
    function emit(p) {
      if (starts[p] == 0)
        printf "  WARN %s: approved があるのに start が無い（所要時間が導出できません）\n", p
      else if (starts[p] < approved[p])
        # 原因は2つある。start の記録漏れ「または」二重 approve で、後者は start を足しても
        # 直らない。一律に「start の記録漏れ」と言うと、指示どおり直しても解消しない
        printf "  WARN %s: start %d 回に対し approved %d 回（start の記録漏れ、または approve の重複）\n", p, starts[p], approved[p]
    }
    END {
      # 出力順は PHASES 順（未知の phase は初出順で後ろに）。ハッシュの列挙順（for (p in ...)）に
      # 任せると awk と PowerShell で並びが変わり「出力を一致させる」契約が破れる。
      n = split(phases, ord, " ")
      for (i = 1; i <= n; i++) { p = ord[i]; if (p in approved) { emit(p); known[p] = 1 } }
      for (i = 1; i <= nseen; i++) { p = order[i]; if ((p in approved) && !(p in known)) emit(p) }
    }
  ' "$1"
  return 0
}

cmd_verify() {
  STRICT=no; vslug=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --strict) STRICT=yes; shift ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$vslug" ] && vslug=$1 || die "slug は1つだけ"; shift ;;
    esac
  done
  resolve_work "$vslug"
  _vroot=$WORK; _vrslug=$SLUG
  printf 'verify: %s\n' "$SLUG"
  verify_work; rc=$?
  # 分割 work の親を verify するときは**子も見る**。着地するのは親1本の PR なので、
  # 子だけ記録が欠けていても素通りしてしまう（protocol.md「6.」は metrics/review を
  # 子にも必須と定めている）。数え方を doctor と揃える
  for _sd in "$_vroot"/*/; do
    [ -d "$_sd" ] || continue
    [ -f "${_sd}state.yml" ] || continue
    WORK=${_sd%/}; SLUG="$_vrslug/$(basename "$WORK")"
    printf 'verify: %s\n' "$SLUG"
    verify_work || { _vc=$?; [ "$rc" -eq 0 ] && rc=$_vc; }
  done
  WORK=$_vroot; SLUG=$_vrslug
  STRICT=no
  return $rc
}

# --- コマンド: escalate（profile: light -> full。片方向） -------------------------
# state.yml の更新を CLI に集約するための経路（この CLI の役割定義。冒頭コメント参照）。
# 手編集を許すと「どの work がいつ昇格したか」が state だけ見ても分からなくなる。
cmd_escalate() {
  resolve_work "${1:-}"
  st="$WORK/state.yml"
  cur=$(yget "$st" profile)
  [ -n "$cur" ] || cur=full   # 未記載 = full（profile 導入前の work）
  case "$cur" in
    light) ;;
    full)  die "既に profile=full です（昇格は片方向。full -> light は不可）: $SLUG" ;;
    *)     die "未知の profile: $cur" ;;
  esac
  set_or_append "$st" profile "profile: full"
  printf 'escalated: %s (light -> full)\n' "$SLUG"
  printf 'next: 省略していた節を各文書に足す / decisions.md に経緯を残す /\n'
  printf '      該当工程の承認に escalated_from_light=1 を付ける（protocol.md「11.」）\n'
}

# --- コマンド: unapprove ------------------------------------------------------
# 差し戻しで無効化される後工程の承認を取り消す。**なぜ CLI に置くか**: 元は
# 「approved から手で除く（CLI に削除は設けていない）」だったが、それは escalate を
# 作った理由（state.yml の更新を CLI に集約する。手編集を許すと state だけ見ても
# 経緯が分からなくなる）と正面から矛盾する。しかも 60-review の統合差し戻し手順は
# 「子の approved から review を外す」を要求しており、**手段が無いまま手順だけがあった**。
#
# 取り消しは**記録を消さない**。metrics の approved イベントはそのまま残し、
# 取り消し自体を `sent_back` イベントとして刻む（手戻りは実際に起きた事実なので、
# 消すと `reworks` / `sent_backs` が過小になる。protocol.md「8.」）。
cmd_unapprove() {
  uslug=""; uph=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug) need_arg "$1" $#; uslug=$2; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$uph" ] && uph=$1 || die "工程は1つだけ"; shift ;;
    esac
  done
  [ -n "$uph" ] || die "使用法: aidev unapprove <phase> [--slug <work>]"
  is_phase "$uph" || die "未知の工程: $uph"
  resolve_work "$uslug"
  st="$WORK/state.yml"
  approved_has "$uph" || die "承認されていません: $uph @ $SLUG"

  # approved から当該工程だけを外す（順序は保つ）
  newl=""
  for p in $(ylist "$st" approved); do
    [ "$p" = "$uph" ] && continue
    if [ -z "$newl" ]; then newl="$p"; else newl="$newl, $p"; fi
  done
  replace_line "$st" approved "approved: [$newl]"
  # カーソルは取り消した工程へ戻す（そこからやり直すのが差し戻しの意味）
  replace_line "$st" current "current: $uph"
  # 取り消しは手戻りの事実。イベントとして刻む（消さない）
  append_event "$uph" sent_back
  printf 'unapproved: %s @ %s\n' "$uph" "$SLUG"
  printf 'next: aidev event %s start を記録してからやり直すこと\n' "$uph"

  # 子の review を外したら、親のカーソルもその子へ戻す（60-review の統合差し戻し手順）
  par=$(yget "$st" parent)
  if [ -n "$par" ] && [ "$uph" = review ] && [ -d "$AIDEV/works/$par" ]; then
    set_or_append "$AIDEV/works/$par/state.yml" activeSubtask "activeSubtask: $(basename "$WORK")"
    printf 'cursor: 親 %s の activeSubtask を %s に戻した\n' "$par" "$(basename "$WORK")"
  fi
}

# --- backlog ファイル横断検査（doctor の一部） ------------------------------------
# verify の消し込み検査は **work にぶら下がる**（自分が刻んだファイルに自分の slug があるか）。
# 対して退避・frontmatter・項目の書式は **ファイル自身の一生**の話で、持ち主の work がいない。
# そのため誰も見ておらず、「入口が2つあって片方だけ自動」（2026-08-01 の穴）がファイル単位で
# 再発する形になっていた（batch は split を退避するが、直接入口は退避しない）。
# ここは事後検知なので WARN 止まりにし、exit code は works の fail だけで決める（硬ゲートは verify）。
bl_kind() { # file -> 先頭 frontmatter の kind（frontmatter 自体が無ければ空）
  awk 'NR==1 && $0 !~ /^---[[:space:]]*$/ {exit}
       NR==1 {next}
       /^---[[:space:]]*$/ {exit}
       /^kind:[[:space:]]*/ {sub(/^kind:[[:space:]]*/,""); sub(/[[:space:]]*$/,""); print; exit}' "$1" 2>/dev/null
}

# backlog ファイル1件の数え上げ。**status と同じ glob** を使う（status に見えている姿を検査対象にする）。
bl_stat() { # file -> BL_TODO / BL_DN / BL_HID / BL_KIND
  BL_TODO=$(grep -c '^[[:space:]]*- \[ \]' "$1" 2>/dev/null || true); BL_TODO=${BL_TODO:-0}
  BL_DN=$(grep -c '^[[:space:]]*- \[[xX]\]' "$1" 2>/dev/null || true); BL_DN=${BL_DN:-0}
  BL_HID=$(grep -cE '^(#+[[:space:]]*- |[[:space:]]*[*+][[:space:]]*)\[[ xX]\]' "$1" 2>/dev/null || true); BL_HID=${BL_HID:-0}
  BL_KIND=$(bl_kind "$1")
}

# 退避してよいか＝**消化しきったら終わるキュー**（split/topic）で全項目 [x]。
# doctor の WARN と backlog archive の実行が**同じ判定**を通るようにここに集約する
#（検査だけあって実行が無い、という形を作らないため）。
bl_archivable() { # file -> 0=退避可 / 1=不可（BL_* も設定する）
  bl_stat "$1"
  case "$BL_KIND" in split|topic) ;; *) return 1 ;; esac
  [ "$BL_TODO" -eq 0 ] && [ "$BL_DN" -gt 0 ]
}

doctor_backlog() {
  [ -d "$AIDEV/backlog" ] || return 0
  bfiles=0; barch=0; bwarn=0; bout=""
  for f in "$AIDEV/backlog"/*.md "$AIDEV/backlog/archive"/*.md; do
    [ -f "$f" ] || continue
    case "$f" in
      "$AIDEV/backlog/archive/"*) arch=yes; label="archive/$(basename "$f")"; barch=$((barch+1)) ;;
      *)                          arch=no;  label=$(basename "$f");          bfiles=$((bfiles+1)) ;;
    esac
    bl_stat "$f"; todo=$BL_TODO; dn=$BL_DN; hid=$BL_HID; kind=$BL_KIND
    w=""
    if [ "$arch" = no ]; then
      # kind は**ファイルの一生の宣言**。無いと退避の要否が決まらず、毎回人が判断し直すことになる。
      # standing=また積まれる（退避しない） / split・topic=消化しきったら終わる（退避する）。
      case "$kind" in
        "")
          w="$w    WARN frontmatter(kind)が無い: standing/split/topic を判定できず退避の要否が決まらない
" ;;
        standing) : ;;
        split|topic)
          if [ "$todo" -eq 0 ] && [ "$dn" -gt 0 ]; then
            w="$w    WARN 全消化($kind)だが未退避: .aidev/backlog/archive/ へ移す
"
          fi ;;
        *)
          # 誤記を黙って standing 扱いにしない（退避検査がまるごと効かなくなるため）
          w="$w    WARN 未知の kind: $kind（standing/split/topic のいずれか）
" ;;
      esac
    elif [ "$todo" -gt 0 ]; then
      # archive/ は status の *.md グロブから外れる＝ここに残った未着手は誰の目にも入らない
      w="$w    WARN archive 済だが未消化が ${todo} 件: status から外れて見えない未着手になっている
"
    fi
    if [ "$hid" -gt 0 ]; then
      w="$w    WARN status が数えない書式の項目が ${hid} 件（見出し '## - [ ]' や '*' 箇条書き）: 未着手が status から漏れる
"
    fi
    if [ -n "$w" ]; then
      bwarn=$((bwarn+1))
      bout="$bout- $label (todo=$todo done=$dn kind=${kind:--})
$w"
    fi
  done
  printf 'backlog: ファイル横断検査\n'
  if [ -n "$bout" ]; then printf '%s' "$bout"; fi
  printf 'backlog-summary: files=%s archived=%s warn=%s\n' "$bfiles" "$barch" "$bwarn"
}

# --- コマンド: doctor ---------------------------------------------------------
cmd_doctor() {
  [ -d "$AIDEV/works" ] || die "works がありません"
  total=0; fail=0; legacy=0
  printf 'doctor: 全 work 横断検査\n'
  for d in "$AIDEV/works"/*/; do
    [ -d "$d" ] || continue
    WORK=${d%/}; SLUG=$(basename "$WORK")
    total=$((total+1))
    printf '%s\n' "- $SLUG"
    sc=$(yget "$WORK/state.yml" schema 2>/dev/null || true)
    [ -z "$sc" ] && legacy=$((legacy+1))
    if ! verify_work; then fail=$((fail+1)); fi
    # subtask（ネスト1段）も横断検査する
    for sd in "$d"*/; do
      [ -d "$sd" ] || continue
      [ -f "${sd}state.yml" ] || continue
      WORK=${sd%/}; SLUG="$(basename "$d")/$(basename "$WORK")"
      total=$((total+1))
      printf '%s\n' "  - $SLUG"
      ssc=$(yget "$WORK/state.yml" schema 2>/dev/null || true)
      [ -z "$ssc" ] && legacy=$((legacy+1))
      if ! verify_work; then fail=$((fail+1)); fi
    done
  done
  printf 'summary: works=%s fail=%s legacy(免除)=%s\n' "$total" "$fail" "$legacy"
  doctor_backlog
  doctor_conventions
  # exit code は 4（不変条件違反）に揃える。1 は「使用法・環境エラー」に割り当てられているので、
  # exit code で分岐する機械ゲートが「ドリフト検知」を「環境が壊れている」と誤読する
  [ "$fail" -eq 0 ] || return 4
  return 0
}

# --- コマンド: status（読み取り専用・works横断＋backlog未着手） ---------------------
STD_PIPELINE="requirement spec plan coding test review deliver"

# タブ区切り行（先頭にヘッダ含む）を列幅で揃えて出力
fmt_table() {
  awk -F'\t' '
    { for(i=1;i<=NF;i++){ cell[NR,i]=$i; if(length($i)>w[i])w[i]=length($i) }
      if(NF>maxnf)maxnf=NF; nr=NR }
    END{ for(r=1;r<=nr;r++){ line=""
        for(i=1;i<=maxnf;i++){ c=cell[r,i]
          if(i<maxnf){ pad=w[i]-length(c); s=c; while(pad-->0)s=s" "; line=line s"  " }
          else line=line c }
        print line } }'
}

# 親 work dir の subtask 進捗を "N M"（N=review承認済の子数 / M=総数）で返す。subtasks 無しは空。
subtask_progress() { # work_dir
  _subs=$(ylist "$1/state.yml" subtasks)
  [ -z "$_subs" ] && return 0
  _m=0; _n=0
  for _s in $_subs; do
    _m=$((_m+1))
    case " $(ylist "$1/$_s/state.yml" approved) " in *" review "*) _n=$((_n+1)) ;; esac
  done
  printf '%s %s' "$_n" "$_m"
  return 0
}

cmd_status() {
  fmt=table; subflag=no
  while [ $# -gt 0 ]; do
    case "$1" in
      --format) need_arg "$1" $#; fmt=${2:-}; shift 2 ;;
      --subtasks) subflag=yes; shift ;;
      -*) die "未知のオプション: $1" ;;
      *) die "status は位置引数を取りません: $1" ;;
    esac
  done
  case "$fmt" in table|tsv) ;; *) die "--format は table|tsv" ;; esac

  # ---- works 収集（rows は型タグ付き: W=work 行 / S=subtask 子行） ----
  wn=0; wrows=""
  if [ -d "$AIDEV/works" ]; then
    for d in "$AIDEV/works"/*/; do
      [ -d "$d" ] || continue
      dir=${d%/}; name=$(basename "$dir"); st="$dir/state.yml"
      [ -f "$st" ] || continue
      ticket=$(yget "$st" ticket);   [ -z "$ticket" ]  && ticket=-
      mode=$(yget "$st" mode);       [ -z "$mode" ]     && mode=-
      current=$(yget "$st" current); [ -z "$current" ]  && current=-
      appr=$(ylist "$st" approved)
      case " $appr " in *" deliver "*) wdone=yes ;; *) wdone=no ;; esac
      next=-
      if [ "$wdone" = no ]; then
        # profile: light は spec/plan を畳む（protocol.md「11.」＝承認されないのが正常）。
        # 素通しすると next が永久に spec を指し、20-spec 自身が「light では起動しない」と
        # 書いている工程を案内し続けることになる
        _pipe=$STD_PIPELINE
        if [ "$(yget "$st" profile)" = light ]; then
          _pipe="requirement coding test review deliver"
        fi
        for p in $_pipe; do
          case " $appr " in *" $p "*) ;; *) next=$p; break ;; esac
        done
      fi
      # subtask を持つ親は next を subtask 進捗に差し替える（未完=sub N/M、全完了=統合工程の次）
      sp=$(subtask_progress "$dir")
      if [ -n "$sp" ] && [ "$wdone" = no ]; then
        spn=${sp% *}; spm=${sp#* }
        if [ "$spn" -lt "$spm" ]; then
          next="sub $spn/$spm"
        else
          next=-   # 全 subtask 完了 → coding は子が実施済。統合工程(test/review/deliver)の次を示す
          for p in test review deliver; do
            case " $appr " in *" $p "*) ;; *) next=$p; break ;; esac
          done
        fi
      fi
      eval_depends "$dir"
      deps=""
      for u in $EVAL_UNMET; do deps="$deps,$u"; done
      for a in $EVAL_ADVISORY; do deps="$deps,$a(advisory)"; done
      deps=${deps#,}; [ -z "$deps" ] && deps=ok
      wn=$((wn+1))
      wrows="${wrows}W	$name	$ticket	$mode	$current	$next	$wdone	$deps
"
      # --subtasks: 親直下に子を列挙（S 行。current=子の工程 / done=子の review 承認）
      if [ "$subflag" = yes ] && [ -n "$sp" ]; then
        for cs in $(ylist "$st" subtasks); do
          cst="$dir/$cs/state.yml"
          ccur=$(yget "$cst" current); [ -z "$ccur" ] && ccur=-
          case " $(ylist "$cst" approved) " in *" review "*) cdone=yes ;; *) cdone=no ;; esac
          wrows="${wrows}S	$name	$cs	$ccur	$cdone
"
        done
      fi
    done
  fi

  # ---- in-flight 収集: backlog 刻印を持ち、まだ deliver していない work ----
  # backlog 行が [x] になるのは deliver（`aidev-70-deliver`「3.5」）なので、着手から着地までの間、
  # backlog 側は**掴まれている項目と素の未着手を区別できない**。新規セッションがそこで同じ項目を
  # 二重に選ぶのが 2026-08-01 の事故の再発経路なので、件数を status に出して着手前に見せる。
  inflight=""
  if [ -d "$AIDEV/works" ]; then
    for d in "$AIDEV/works"/*/; do
      [ -d "$d" ] || continue
      _ist="${d}state.yml"; [ -f "$_ist" ] || continue
      _ibl=$(yget "$_ist" backlog); [ -n "$_ibl" ] || continue
      case " $(ylist "$_ist" approved) " in *" deliver "*) continue ;; esac
      inflight="$inflight$_ibl
"
    done
  fi

  # ---- backlog 収集（archive/ はサブディレクトリのため *.md グロブで自動除外） ----
  bf=0; bn=0; brows=""
  if [ -d "$AIDEV/backlog" ]; then
    for f in "$AIDEV/backlog"/*.md; do
      [ -f "$f" ] || continue
      fname=$(basename "$f")
      todo=$(grep -c '^[[:space:]]*- \[ \]' "$f" 2>/dev/null || true); todo=${todo:-0}
      needs=$(grep '^[[:space:]]*- \[ \]' "$f" 2>/dev/null | grep -c '(needs:' || true); needs=${needs:-0}
      # -xF: ファイル名の '.' を正規表現として解釈させない
      inf=$(printf '%s' "$inflight" | grep -cxF "$fname" 2>/dev/null || true); inf=${inf:-0}
      bf=$((bf+1)); bn=$((bn+todo))
      brows="$brows$fname	$todo	$needs	$inf
"
    done
  fi

  if [ "$fmt" = tsv ]; then
    printf '%s' "$wrows" | while IFS='	' read -r ty a b c e f g h; do
      [ -z "$ty" ] && continue
      if [ "$ty" = W ]; then
        printf 'work\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$a" "$b" "$c" "$e" "$f" "$g" "$h"
      else  # S: a=親 b=子 c=current e=done
        printf 'subtask\t%s/%s\t%s\t%s\n' "$a" "$b" "$c" "$e"
      fi
    done
    printf '%s' "$brows" | while IFS='	' read -r a b c e; do
      [ -z "$a" ] && continue
      printf 'backlog\t%s\t%s\t%s\t%s\n' "$a" "$b" "$c" "$e"
    done
    return 0
  fi

  printf 'WORKS (%s)\n' "$wn"
  if [ "$wn" -gt 0 ]; then
    {
      printf 'work\tticket\tmode\tcurrent\tnext\tdone\tdeps\n'
      printf '%s' "$wrows" | while IFS='	' read -r ty a b c e f g h; do
        [ -z "$ty" ] && continue
        if [ "$ty" = W ]; then
          printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$a" "$b" "$c" "$e" "$f" "$g" "$h"
        else  # S: 子をインデント行で（a=親 b=子 c=current e=done）
          printf '  ↳ %s\t-\t-\t%s\t-\t%s\t-\n' "$b" "$c" "$e"
        fi
      done
    } | fmt_table
  fi
  printf '\n'
  printf 'BACKLOG (未着手 %s 件)\n' "$bn"
  if [ "$bf" -gt 0 ]; then
    { printf 'file\ttodo\tneeds\tinflight\n'; printf '%s' "$brows"; } | fmt_table
  fi
}

# --- コマンド: metrics（読み取り専用・metrics.yml から派生指標を集計） ----------------
metrics_awk='
function dse(y,m,d,   yy,era,yoe,doy,doe){
  yy=y-(m<=2); era=int((yy>=0?yy:yy-399)/400); yoe=yy-era*400
  doy=int((153*(m+(m>2?-3:9))+2)/5)+d-1
  doe=yoe*365+int(yoe/4)-int(yoe/100)+doy
  return era*146097+doe-719468
}
function epoch(ts,   y,mo,d,h,mi,s){
  sub(/Z$/,"",ts); sub(/UTC$/,"",ts)
  if(length(ts)<19 || substr(ts,11,1)!="T") return -1
  y=substr(ts,1,4)+0; mo=substr(ts,6,2)+0; d=substr(ts,9,2)+0
  h=substr(ts,12,2)+0; mi=substr(ts,15,2)+0; s=substr(ts,18,2)+0
  return dse(y,mo,d)*86400 + h*3600 + mi*60 + s
}
BEGIN{ first=-1; delivered_e=-1; delivered_flag=0; sback=0 }
/event:/{
  ts=""; ph=""; ev=""
  if(match($0,/ts:[ ]*[^,}]+/)){ ts=substr($0,RSTART+3,RLENGTH-3); gsub(/[ ]/,"",ts) }
  if(match($0,/phase:[ ]*[A-Za-z_]+/)){ ph=substr($0,RSTART+6,RLENGTH-6); gsub(/[ ]/,"",ph) }
  if(match($0,/event:[ ]*[A-Za-z_]+/)){ ev=substr($0,RSTART+6,RLENGTH-6); gsub(/[ ]/,"",ev) }
  if(ph=="" || ev=="") next
  e=epoch(ts)
  if(ev=="start"){
    scount[ph]++
    if(e>=0){ if(first<0||e<first){first=e; firstts=ts}
              if(!(ph in laststart)||e>laststart[ph]){laststart[ph]=e; laststart_ts[ph]=ts} }
  } else if(ev=="approved"){
    if(e>=0){ appat[ph]=e; appat_ts[ph]=ts }
    if(ph=="deliver"){ delivered_flag=1; if(e>=0) delivered_e=e }
  } else if(ev=="sent_back"){ sback++ }
}
END{
  if(phases=="yes"){
    n=split(PH,arr," ")
    for(i=1;i<=n;i++){ p=arr[i]
      if((p in laststart)||(p in appat)){
        st=(p in laststart_ts)?laststart_ts[p]:"-"
        ap=(p in appat_ts)?appat_ts[p]:"-"
        el="-"; if((p in laststart)&&(p in appat)) el=appat[p]-laststart[p]
        printf "%s\t%s\t%s\t%s\t%s\n", name, p, st, ap, el
      }
    }
  } else {
    fs=(first>=0)?firstts:"-"
    dv=(delivered_flag>0)?"yes":"no"
    lead="-"; if(delivered_flag>0 && first>=0 && delivered_e>=0) lead=delivered_e-first
    # 「手戻り回数」（protocol-analysis.md「1.」）＝ **やり直した回数**。工程数で数えると
    # 上限が工程数で飽和し、「規模あたりの手戻り」の分子が頭打ちになる
    rw=0; for(p in scount) if(scount[p]>=2) rw+=scount[p]-1
    printf "%s\t%s\t%s\t%s\t%s\t%s\n", name, fs, dv, lead, rw, sback+0
  }
}'

cmd_metrics() {
  fmt=table; allf=no; phasesf=no; mslug=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) allf=yes; shift ;;
      --phases) phasesf=yes; shift ;;
      --format) need_arg "$1" $#; fmt=${2:-}; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$mslug" ] && mslug=$1 || die "slug は1つだけ"; shift ;;
    esac
  done
  case "$fmt" in table|tsv) ;; *) die "--format は table|tsv" ;; esac

  dirs=""
  if [ "$allf" = yes ]; then
    # ネスト1段（subtask）まで拾う。top-level だけだと、子の手戻り・差し戻しが
    # 横断集計から丸ごと消える（doctor は既に1段辿っている。数え方を揃える）
    for d in "$AIDEV/works"/*/; do
      [ -d "$d" ] || continue
      dirs="$dirs ${d%/}"
      for sd in "$d"*/; do
        [ -d "$sd" ] && [ -f "${sd}state.yml" ] && dirs="$dirs ${sd%/}"
      done
    done
  elif [ -n "$mslug" ]; then
    [ -d "$AIDEV/works/$mslug" ] || die "work が存在しません: $mslug"
    dirs="$AIDEV/works/$mslug"
  else
    [ -f "$AIDEV/current" ] || die "対象作業が不明です（.aidev/current 無し）。slug 指定か --all を。"
    cur=$(head -n1 "$AIDEV/current" | tr -d '\r\n')
    [ -d "$AIDEV/works/$cur" ] || die "work が存在しません: $cur"
    dirs="$AIDEV/works/$cur"
  fi

  rows=""
  for wd in $dirs; do
    # subtask は <親>/<子> で出す。basename だけだと親の違う同名 subtask が同一に見える
    case "$wd" in
      "$AIDEV/works"/*/*) name="$(basename "$(dirname "$wd")")/$(basename "$wd")" ;;
      *) name=$(basename "$wd") ;;
    esac
    mf="$wd/metrics.yml"
    [ -f "$mf" ] || mf=/dev/null
    out=$(awk -v name="$name" -v phases="$phasesf" -v PH="$PHASES" "$metrics_awk" "$mf")
    [ -n "$out" ] && rows="$rows$out
"
  done

  if [ "$phasesf" = yes ]; then hdr='work	phase	start	approved	elapsed_sec'
  else hdr='work	first_start	delivered	lead_sec	reworks	sent_backs'; fi

  if [ "$fmt" = tsv ]; then
    printf '%s' "$rows" | sed '/^[[:space:]]*$/d'
  else
    { printf '%s\n' "$hdr"; printf '%s' "$rows" | sed '/^[[:space:]]*$/d'; } | fmt_table
  fi
}

# --- コマンド: worktree（ユーザー責任の並行作業 on-ramp） ----------------------------
# 前提（research.md で実証）: .aidev/current は gitignore 対象＝worktree ローカルで main と非干渉。
# よって worktree 操作は main tree の current を絶対に書き換えない（INV-1）。git は実 exit code を直接判定する。
git_present() { command -v git >/dev/null 2>&1 || die "git が見つかりません"; }

# 既定 worktree パス: <親>/<repo名>-wt/<slug>（リポジトリ外の兄弟）
default_wt_path() { printf '%s/%s-wt/%s' "$(dirname "$ROOT")" "$(basename "$ROOT")" "$1"; }

# worktree 内で state.yml の slug が一致する work dir 名（dated）を列挙（改行区切り）
works_matching_slug() { # path slug
  _p=$1; _s=$2
  [ -d "$_p/.aidev/works" ] || return 0
  for _d in "$_p/.aidev/works"/*/; do
    [ -d "$_d" ] || continue
    [ -f "${_d}state.yml" ] || continue
    [ "$(yget "${_d}state.yml" slug)" = "$_s" ] && basename "${_d%/}"
  done
  return 0  # 最終比較の偽値で関数が非0終了し、set -e で $(...) 代入が落ちるのを防ぐ
}

# git worktree list --porcelain を "path<TAB>branch" 行に整形
wt_porcelain() {
  git worktree list --porcelain | awk '
    function flush(){ if(p!=""){ print p"\t"(b==""?"-":b); p="";b="" } }
    /^worktree /{ flush(); p=substr($0,10) }
    /^branch /{ b=$2; sub(/^refs\/heads\//,"",b) }
    /^detached/{ b="detached" }
    END{ flush() }'
}

# 共有ファイル警告。PJ 固有のファイル名は CLI に埋めず .aidev/config.yml の sharedFiles から生成する
# （基盤は PJ 非依存＝DESIGN「1.」「2.」。機械が言えるのは config にある事実だけで、検証義務のような
#  PJ 規約は散文＝AGENTS.md / protocol-worktree.md の担当。DESIGN「2.6」の線引きと同じ）。
wt_shared_warn() {
  _sh=$(ylist "$AIDEV/config.yml" sharedFiles | sed 's/^ *//; s/ *$//; s/  */, /g')
  if [ -n "$_sh" ]; then
    printf '⚠ この work が共有ファイル（%s）に触るなら、他 worktree と\n' "$_sh"
    printf '  波及・マージ衝突が起きうる（PJ 規約は AGENTS.md）。並行可否はユーザー判断。\n'
  else
    printf '⚠ この work が他 worktree と共有するもの（ビルド設定・登録テーブル・共有モジュール等）に触るなら、\n'
    printf '  波及・マージ衝突が起きうる（PJ 規約は AGENTS.md。config.yml の sharedFiles で名指しできる）。並行可否はユーザー判断。\n'
  fi
}

wt_add() {
  slug=""; branch=""; base="HEAD"; wpath=""; mode=interactive; ticket=""; depends=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --branch)  need_arg "$1" $#; branch=$2; shift 2 ;;
      --base)    need_arg "$1" $#; base=$2; shift 2 ;;
      --path)    need_arg "$1" $#; wpath=$2; shift 2 ;;
      --mode)    need_arg "$1" $#; mode=$2; shift 2 ;;
      --ticket)  need_arg "$1" $#; ticket=$2; shift 2 ;;
      --depends) need_arg "$1" $#; depends=$2; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$slug" ] && slug=$1 || die "slug は1つだけ"; shift ;;
    esac
  done
  [ -n "$slug" ] || die "使用法: aidev worktree add <slug> [--branch ..] [--base ..] [--path ..] [--mode ..] [--ticket ..] [--depends ..]"
  git_present
  [ -n "$branch" ] || branch="feature/$slug"
  [ -n "$wpath" ] || wpath=$(default_wt_path "$slug")
  [ -e "$wpath" ] && die "path が既に存在します: $wpath"

  # ブランチ存在で分岐（既存→checkout / 新規→-b で base から作成）。branch は必ず明示（git の basename 自動命名に委ねない）。
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    _wt_newbranch=no
    git worktree add "$wpath" "$branch" || die "git worktree add に失敗（branch=$branch）"
  else
    _wt_newbranch=yes
    git worktree add -b "$branch" "$wpath" "$base" || die "git worktree add に失敗（branch=$branch base=$base）"
  fi
  wpath=$(cd "$wpath" && pwd)  # 以降は絶対パスで扱う

  # ここから先の die は**worktree を作った後**に起きる。ロールバックしないと、
  # 失敗したのに worktree とブランチだけが残り、次の add が「既にある」で弾かれる。
  # 作ったブランチは自分のものなので、この経路でだけ消してよい（既存 branch 指定時は消さない）
  _wt_rollback() { # メッセージ
    git worktree remove --force "$wpath" >/dev/null 2>&1 || true
    if [ "$_wt_newbranch" = yes ]; then git branch -D "$branch" >/dev/null 2>&1 || true; fi
    git worktree prune >/dev/null 2>&1 || true
    # 既定のコンテナ（<repo>-wt/）も空なら掃除する。rm と同じ後始末（非空なら rmdir が失敗して何もしない）
    rmdir "$(dirname "$wpath")" 2>/dev/null || true
    die "$1（作りかけの worktree とブランチは撤去した）"
  }

  # worktree 内で work を確定（main tree の .aidev/current には触れない＝INV-1）
  matches=$(works_matching_slug "$wpath" "$slug")
  mcount=$(printf '%s' "$matches" | grep -c . || true)
  if [ "$mcount" -gt 1 ]; then
    _wt_rollback "worktree 内に slug=$slug の work が複数あります。曖昧なため中断（手動で current 設定を）"
  elif [ "$mcount" -eq 1 ]; then
    printf '%s\n' "$matches" > "$wpath/.aidev/current"
    work_note="既存 work をリンク: $matches（current 設定のみ）"
  else
    # add 内で new: worktree をカレントにして既存 new ロジックに委譲（単一検証経路の維持・DRY）
    set -- new "$slug" --mode "$mode"
    [ -n "$ticket" ]  && set -- "$@" --ticket "$ticket"
    [ -n "$depends" ] && set -- "$@" --depends "$depends"
    # 先に CLI の実在を見る。無いまま委譲すると「コマンドが無い」というシェルのエラーが出て、
    # 本当の原因（skills が worktree に持ち込まれていない＝未追跡・未コミット）が読めない。
    # ps1 側にも同じ事前検査がある（メッセージを揃える）
    _wtbin="$wpath/.claude/skills/aidev-docs/bin/aidev"
    [ -f "$_wtbin" ] || _wt_rollback "worktree 内に CLI がありません: $_wtbin（skills が追跡・コミット済みか確認）"
    ( cd "$wpath" && "$_wtbin" "$@" ) || _wt_rollback "worktree 内の new に失敗"
    work_note="新規 work を作成（add 内で new）"
  fi

  printf 'worktree 追加: %s\n' "$wpath"
  printf '  branch: %s / base: %s\n' "$branch" "$base"
  printf '  work:   %s\n' "$work_note"
  wt_shared_warn
  printf '次: cd %s して各工程 skill を実行。\n' "$wpath"
}

wt_list() {
  fmt=table
  while [ $# -gt 0 ]; do
    case "$1" in
      --format) need_arg "$1" $#; fmt=${2:-}; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) die "list は位置引数を取りません: $1" ;;
    esac
  done
  case "$fmt" in table|tsv) ;; *) die "--format は table|tsv" ;; esac
  git_present

  rows=""; wtinfo=$(wt_porcelain)
  oldifs=$IFS; IFS='
'
  for line in $wtinfo; do
    path=${line%%	*}; branch=${line#*	}
    # 判定キー: worktree ローカル .aidev/current の有無（branch 名ではない）
    [ -f "$path/.aidev/current" ] || continue
    work=$(head -n1 "$path/.aidev/current" | tr -d '\r\n'); [ -z "$work" ] && work=-
    phase=-
    if [ "$work" != - ] && [ -f "$path/.aidev/works/$work/state.yml" ]; then
      phase=$(yget "$path/.aidev/works/$work/state.yml" current); [ -z "$phase" ] && phase=-
    fi
    rows="$rows$path	$branch	$work	$phase
"
  done
  IFS=$oldifs

  if [ "$fmt" = tsv ]; then
    printf '%s' "$rows" | while IFS='	' read -r a b c d; do
      [ -z "$a" ] && continue
      printf 'worktree\t%s\t%s\t%s\t%s\n' "$a" "$b" "$c" "$d"
    done
    return 0
  fi
  n=$(printf '%s' "$rows" | grep -c . || true)
  printf 'WORKTREES (%s)\n' "$n"
  if [ "$n" -gt 0 ]; then
    { printf 'path\tbranch\twork\tphase\n'; printf '%s' "$rows"; } | fmt_table
  fi
}

wt_rm() {
  target=""; force=no; delbranch=no
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=yes; shift ;;
      --delete-branch) delbranch=yes; shift ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$target" ] && target=$1 || die "対象は1つだけ"; shift ;;
    esac
  done
  [ -n "$target" ] || die "使用法: aidev worktree rm <slug|path> [--force] [--delete-branch]"
  git_present

  # git worktree list は Windows で `C:/Users/...` を返すが MSYS の pwd は `/c/Users/...` を返す。
  # 素の文字列比較だと必ず外れるので、比較する両辺を同じ手（cd && pwd）で正規化する。
  abst=""; [ -d "$target" ] && abst=$(cd "$target" && pwd)
  wtinfo=$(wt_porcelain)
  main_wt=$(printf '%s\n' "$wtinfo" | head -n1 | cut -f1)  # porcelain 先頭＝main worktree（rm 対象外）
  rpath=""; rbranch=""; hit_main=no
  oldifs=$IFS; IFS='
'
  for line in $wtinfo; do
    p=${line%%	*}; b=${line#*	}
    if [ -n "$abst" ]; then
      pn=$(cd "$p" 2>/dev/null && pwd); [ -n "$pn" ] || pn=$p
      [ "$pn" = "$abst" ] && { rpath=$p; rbranch=$b; break; }
    else
      if [ "$(basename "$p")" = "$target" ] || [ "$b" = "feature/$target" ] || [ "$b" = "$target" ]; then
        if [ "$p" = "$main_wt" ]; then hit_main=yes; continue; fi  # slug が main worktree に一致しても対象にしない
        [ -n "$rpath" ] && { IFS=$oldifs; die "対象が複数該当します（path を明示してください）: $target"; }
        rpath=$p; rbranch=$b
      fi
    fi
  done
  IFS=$oldifs
  if [ -z "$rpath" ]; then
    [ "$hit_main" = yes ] && die "'$target' は main worktree（$main_wt）に該当します。main worktree は rm できません（worktree のみ対象）。"
    die "対象 worktree が見つかりません: $target"
  fi

  # 未コミット差分チェック（--force 無しなら拒否）
  if [ "$force" = no ] && [ -n "$(git -C "$rpath" status --porcelain 2>/dev/null)" ]; then
    die "未コミットの変更があります（--force で強制削除）: $rpath"
  fi
  if [ "$force" = yes ]; then
    git worktree remove --force "$rpath" || die "git worktree remove に失敗: $rpath"
  else
    git worktree remove "$rpath" || die "git worktree remove に失敗: $rpath"
  fi
  printf 'worktree 撤去: %s\n' "$rpath"
  rmdir "$(dirname "$rpath")" 2>/dev/null || true  # 既定の <repo>-wt/ コンテナが空なら掃除（非空なら何もしない）

  if [ "$delbranch" = yes ] && [ "$rbranch" != - ] && [ "$rbranch" != detached ]; then
    git branch -D "$rbranch" && printf '  branch 削除: %s\n' "$rbranch" || warn "branch 削除に失敗: $rbranch"
  fi
}

# --- コマンド: use（継続する作業の切り替え） --------------------------------------
# `.aidev/current` を書くのは new と approve(subtask 前進) だけで、**「続きから」で切り替える
# 手段が無かった**（`aidev-00-start`「3.」は current を更新せよと書くが、手で書く前提だった）。
# 存在しない slug を書き込む事故を resolve_work で弾く。
cmd_use() {
  if [ $# -eq 0 ]; then
    [ -f "$AIDEV/current" ] || die "対象作業が不明です（.aidev/current 無し）"
    head -n1 "$AIDEV/current" | tr -d '\r\n'; printf '\n'
    return 0
  fi
  [ $# -eq 1 ] || die "使用法: aidev use [<slug>]"
  resolve_work "$1"
  printf '%s\n' "$SLUG" > "$AIDEV/current"
  printf 'current: %s (%s)\n' "$SLUG" "$(yget "$WORK/state.yml" current)"
  # subtask に切り替えたら親の activeSubtask も合わせる。protocol.md「6.」が
  # 「activeSubtask は .aidev/current の冗長コピー」と定義しているので、片方だけ動かすと
  # その定義が破れる（60-review の差し戻し手順が要求する「親 activeSubtask を戻す」も、
  # これが無いと手段が無い）
  _upar=$(yget "$WORK/state.yml" parent)
  if [ -n "$_upar" ] && [ -d "$AIDEV/works/$_upar" ]; then
    set_or_append "$AIDEV/works/$_upar/state.yml" activeSubtask "activeSubtask: $(basename "$WORK")"
    printf 'cursor: 親 %s の activeSubtask を %s に同期\n' "$_upar" "$(basename "$WORK")"
  fi
}

# --- コマンド: backlog --------------------------------------------------------
# **積む/退避する**だけを持たせる。消し込み（[x] 化と根拠の併記）は行の同定と文面の判断が
# 要るので CLI にしない（verify 自身が「行の同定は諦める」と割り切っている。protocol「2.9」）。
cmd_backlog() {
  [ $# -ge 1 ] || die "使用法: aidev backlog <new|archive> ..."
  sub=$1; shift
  case "$sub" in
    new)     bl_new "$@" ;;
    archive) bl_do_archive "$@" ;;
    *) die "未知の backlog サブコマンド: $sub（new|archive）" ;;
  esac
}

bl_new() {
  name=""; kind=""; parent=""; priority=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --kind)     need_arg "$1" $#; kind=${2:-}; shift 2 ;;
      --parent)   need_arg "$1" $#; parent=${2:-}; shift 2 ;;
      --priority) need_arg "$1" $#; priority=${2:-}; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) if [ -z "$name" ]; then name=$1; else die "名前は1つだけ"; fi; shift ;;
    esac
  done
  [ -n "$name" ] || die "使用法: aidev backlog new <name> --kind standing|split|topic [--parent <slug>] [--priority <n>]"
  name=$(basename "$name" .md)
  # kind はファイルの一生の宣言。ここで必須にして「後で書く」を無くす（欠落が常態化していた）
  case "$kind" in
    standing|topic) ;;
    split) [ -n "$parent" ] || die "kind: split には --parent が要ります（親 work slug / チケット）" ;;
    "") die "--kind は必須です（standing|split|topic）" ;;
    *) die "未知の kind: $kind（standing|split|topic）" ;;
  esac
  mkdir -p "$AIDEV/backlog"
  f="$AIDEV/backlog/$name.md"
  if [ -e "$f" ]; then die "すでにあります: .aidev/backlog/$name.md"; fi
  {
    printf '%s\n' '---'
    printf 'backlog: %s\n' "$name"
    printf 'kind: %s\n' "$kind"
    if [ -n "$parent" ];   then printf 'parent: %s\n' "$parent"; fi
    if [ -n "$priority" ]; then printf 'priority: %s\n' "$priority"; fi
    printf '%s\n\n' '---'
    printf '# %s\n\n' "$name"
    printf '%s\n' '<!-- 項目は行頭の `- [ ]` で書く（見出しに書くと aidev status の未着手件数から漏れる） -->'
  } > "$f"
  printf 'created: .aidev/backlog/%s.md (kind %s)\n' "$name" "$kind"
}

bl_do_archive() {
  force=no; targets=""; explicit=yes
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=yes; shift ;;
      -*) die "未知のオプション: $1" ;;
      *) targets="$targets $(basename "$1")"; shift ;;
    esac
  done
  [ -d "$AIDEV/backlog" ] || die "backlog がありません"
  # 無指定なら**退避条件を満たすものだけ**を対象にする（満たさないものを skip 報告しない）
  if [ -z "$targets" ]; then
    explicit=no
    for f in "$AIDEV/backlog"/*.md; do
      [ -f "$f" ] || continue
      if bl_archivable "$f"; then targets="$targets $(basename "$f")"; fi
    done
  fi

  moved=0; skipped=0
  for t in $targets; do
    f="$AIDEV/backlog/$t"
    if [ ! -f "$f" ]; then
      printf 'skip %s: active にありません\n' "$t"; skipped=$((skipped+1)); continue
    fi
    if [ "$force" = no ] && ! bl_archivable "$f"; then
      if [ "$explicit" = yes ]; then
        printf 'skip %s: 退避条件を満たしません (kind=%s todo=%s done=%s)\n' \
          "$t" "${BL_KIND:--}" "$BL_TODO" "$BL_DN"
      fi
      skipped=$((skipped+1)); continue
    fi
    mkdir -p "$AIDEV/backlog/archive"
    if [ -e "$AIDEV/backlog/archive/$t" ]; then
      printf 'skip %s: archive/ に同名があります\n' "$t"; skipped=$((skipped+1)); continue
    fi
    mv "$f" "$AIDEV/backlog/archive/$t"
    printf 'archived: %s\n' "$t"; moved=$((moved+1))
  done
  printf 'summary: archived=%s skipped=%s\n' "$moved" "$skipped"
  # git は触らない（破壊的 git 操作は CLI に持たせない。DESIGN「2.6」の verify && commit 方針）
  if [ "$moved" -gt 0 ]; then
    printf 'note: git 未反映（`git add -A .aidev/backlog` でリネームとして拾われる）\n'
  fi
}

# --- 索引（AGENTS.md の aidev:conventions ブロック）------------------------------
# AGENTS.md / CLAUDE.md は**自動読込**されるが `docs/aidev/` はされない。索引に載っていない条項は
# **読まれないまま**works が流れ、効果検証で「効かなかった」と誤判定される——条項の内容の問題ではなく
# 単に届いていないだけなのに。CLI が「索引に足せ」と言うだけで誰も見ていないと、この誤判定が
# 静かに積み上がる。そこで doctor が索引を突き合わせる。
CV_IDX_OPEN='<!-- aidev:conventions -->'
CV_IDX_CLOSE='<!-- /aidev:conventions -->'

# 索引ファイルの決定。PJ 固有ファイル名を CLI に埋めないため config を優先し、
# 未設定のときだけ慣行（AGENTS.md → CLAUDE.md）にフォールバックする。
cv_index_file() {
  f=$(yget "$AIDEV/config.yml" conventionsIndex)
  if [ -n "$f" ]; then
    case "$f" in /*) printf '%s' "$f" ;; *) printf '%s/%s' "$ROOT" "$f" ;; esac
    return 0
  fi
  for c in AGENTS.md CLAUDE.md; do
    [ -f "$ROOT/$c" ] && { printf '%s' "$ROOT/$c"; return 0; }
  done
  printf ''
}

# 索引ファイルの**表示名**。config も慣行も外れている PJ に「AGENTS.md に足せ」と言うと、
# 存在しないファイルを名指しすることになる。決まっていないなら決まっていないと言い、
# どこで決めるか（conventionsIndex）を示す。
cv_index_label() {
  _f=$(cv_index_file)
  if [ -n "$_f" ]; then
    basename "$_f"
  else
    printf '索引ファイル（.aidev/config.yml の conventionsIndex。未設定なら AGENTS.md → CLAUDE.md を探す）'
  fi
}

# 索引ブロックの中身だけを取り出す（マーカー外は PJ のもので、harness は見ない）。
cv_index_block() { # file
  [ -f "$1" ] || return 0
  awk -v o="$CV_IDX_OPEN" -v c="$CV_IDX_CLOSE" '
    index($0,o) {inb=1; next}
    index($0,c) {inb=0; next}
    inb {print}' "$1" 2>/dev/null
}

# 条項ディレクトリの ROOT 相対表記（索引に書かれるリンクの形）。
cv_dir_rel() {
  d=$(cv_dir)
  case "$d" in "$ROOT"/*) printf '%s' "${d#"$ROOT"/}" ;; *) printf '%s' "$d" ;; esac
}

# --- コマンド: convention -----------------------------------------------------
# **起こす／状態を進める／退避する**だけを持たせる。本文を PJ ドキュメントへ実際に移す作業は
# 文体・配置・既存章との統合という判断なので CLI にしない（backlog の消し込み本体と同じ線引き）。
cmd_convention() {
  [ $# -ge 1 ] || die "使用法: aidev convention <new|confirm|retire|promote|status> ..."
  sub=$1; shift
  case "$sub" in
    new)     cv_new "$@" ;;
    confirm) cv_confirm "$@" ;;
    retire)  cv_retire "$@" ;;
    promote) cv_promote "$@" ;;
    status)  cv_do_status "$@" ;;
    *) die "未知の convention サブコマンド: $sub（new|confirm|retire|promote|status）" ;;
  esac
}

cv_new() {
  id=""; hyp=""; src=""; va=""; base=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --hypothesis)   need_arg "$1" $#; hyp=${2:-}; shift 2 ;;
      --baseline)     need_arg "$1" $#; base=${2:-}; shift 2 ;;
      --source)       need_arg "$1" $#; src=${2:-}; shift 2 ;;
      --verify-after) need_arg "$1" $#; va=${2:-}; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) if [ -z "$id" ]; then id=$1; else die "id は1つだけ"; fi; shift ;;
    esac
  done
  [ -n "$id" ] || die "使用法: aidev convention new <id> --hypothesis <text> --baseline <text> [--source <path>] [--verify-after <n>]"
  id=$(basename "$id" .md)
  # 仮説を必須にするのが**この層の入口ゲート**。「どの指標がどう動けば成功か」を書けない条項は
  # 後から検証できず、事後の物語作りにしかならない。書けないなら条項にすべきでない
  [ -n "$hyp" ] || die "--hypothesis は必須です（何がどう動けば効果ありと判定するか。書けない条項は検証できない）"
  # baseline も必須。**条項 id は今この瞬間に生まれる**ので、導入前の review.md にその id は
  # 決して現れない。id 別の件数は 0 -> N と増える方向にしか動かず、前後比較にならない。
  # 「前」を作れるのは、起票時に**観点で**数えて刻んでおく道だけ。変更前に書くから事後の物語作りにならない。
  # 履歴が無くて数えられないなら、その事実を値として書く（捏造も空欄も不可。protocol.md「8.」）
  [ -n "$base" ] || die "--baseline は必須です（導入前にこの観点の指摘が何件あったか。数えられないならその事実を書く。例: '直近10 works で must 2 / should 5' / '0件（review.md が無く前を作れない）'）"
  [ -n "$va" ] || va=5
  case "$va" in ''|*[!0-9]*) die "--verify-after は整数（母集団の最低件数）" ;; esac
  d=$(cv_dir)
  mkdir -p "$d"
  f="$d/$id.md"
  [ -e "$f" ] && die "すでにあります: $f"
  if [ -f "$d/archive/$id.md" ]; then
    die "同じ id が archive にあります（$d/archive/$id.md）。移送済み条項の再提案は重複です"
  fi
  {
    printf '%s\n' '---'
    printf 'convention: %s\n' "$id"
    printf 'status: pending\n'
    printf 'introduced: %s\n' "$(date -u +%F)"
    if [ -n "$src" ]; then printf 'source: %s\n' "$src"; fi
    printf 'hypothesis: %s\n' "$hyp"
    printf 'baseline: %s\n' "$base"
    printf 'verify_after: %s\n' "$va"
    printf '%s\n\n' '---'
    printf '# %s\n\n' "$id"
    printf '%s\n\n' '<!-- 条項の本文。PJ ドキュメントへ移送(promote)するまではここが唯一の在処。 -->'
    printf '%s\n\n' '## 規約'
    printf '%s\n\n' '<!-- 何を守るか。レビューで指摘するときの根拠になる粒度で書く。 -->'
    printf '%s\n\n' '## 背景'
    printf '%s\n' '<!-- どのレビュー指摘/分析から起こしたか（source を人間向けに補足）。 -->'
  } > "$f"
  printf 'created: %s (status pending, verify_after %s)\n' "$f" "$va"
  # 索引に載せないと自動読込されない＝読まれない。doctor も見るが、まずここで促す
  _rel="$(cv_dir_rel)/$id.md"
  _idxl=$(cv_index_label)
  printf 'next: %s の索引ブロックに1行足すこと（読む条件つき。無いと読まれない。protocol.md「12.」）\n' "$_idxl"
  printf '      - <いつ参照するか> → %s\n' "$_rel"
  # 入口の重複排除。どこを見るかは PJ が config で申告する（探索範囲の決定は判断なので CLI はしない）
  _dr=$(ylist "$AIDEV/config.yml" docsRoots | sed 's/^ *//; s/ *$//; s/  */, /g')
  if [ -n "$_dr" ]; then
    printf 'check: 同じ規約が既存 docs に無いか確認すること（docsRoots: %s）\n' "$_dr"
  else
    printf 'check: .aidev/config.yml に docsRoots が未設定です。既存 docs との重複を機械的に絞れないので、\n'
    printf '       確認していない旨を retro/insights に明記すること（捏造で埋めない。protocol.md「8.」）\n'
  fi
}

cv_confirm() {
  id=""; result=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --result) need_arg "$1" $#; result=${2:-}; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) if [ -z "$id" ]; then id=$1; else die "id は1つだけ"; fi; shift ;;
    esac
  done
  [ -n "$id" ] || die "使用法: aidev convention confirm <id> [--result <text>]"
  f=$(cv_find "$id") || die "条項がありません: $id"
  case "$f" in *"/archive/"*) die "退避済みの条項は変更できません: $id" ;; esac
  cv_require "$f" "$id"
  cv_set "$f" status confirmed
  if [ -n "$result" ]; then cv_set "$f" result "$result"; fi
  printf 'confirmed: %s\n' "$id"
  printf 'next: 本文を PJ ドキュメントへ移し、`aidev convention promote %s --to <path#anchor>` で tombstone 化する\n' "$id"
}

cv_retire() {
  id=""; st=""; note=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --status) need_arg "$1" $#; st=${2:-}; shift 2 ;;
      --note)   need_arg "$1" $#; note=${2:-}; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) if [ -z "$id" ]; then id=$1; else die "id は1つだけ"; fi; shift ;;
    esac
  done
  [ -n "$id" ] || die "使用法: aidev convention retire <id> --status ineffective|superseded [--note <text>]"
  case "$st" in
    ineffective|superseded) ;;
    "") die "--status は必須です（ineffective|superseded）" ;;
    *) die "未知の status: $st（ineffective|superseded）" ;;
  esac
  f=$(cv_find "$id") || die "条項がありません: $id"
  case "$f" in *"/archive/"*) die "すでに退避済みです: $id" ;; esac
  cv_require "$f" "$id"
  cv_set "$f" status "$st"
  if [ -n "$note" ]; then cv_set "$f" note "$note"; fi
  cv_archive_file "$f"
  printf 'retired: %s (%s)\n' "$id" "$st"
  if [ "$st" = ineffective ]; then
    printf 'note: 「効かなかった」は「条項が誤り」とは限らない。散文層の限界なら CLI/フック層へ寄せることを検討（DESIGN「2.6」）\n'
  fi
}

cv_promote() {
  id=""; to=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) need_arg "$1" $#; to=${2:-}; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) if [ -z "$id" ]; then id=$1; else die "id は1つだけ"; fi; shift ;;
    esac
  done
  [ -n "$id" ] || die "使用法: aidev convention promote <id> --to <path#anchor>"
  [ -n "$to" ] || die "--to は必須です（移送先の PJ ドキュメント。例 docs/coding-standards.md#naming）"
  f=$(cv_find "$id") || die "条項がありません: $id"
  case "$f" in *"/archive/"*) die "すでに退避済みです: $id" ;; esac
  cv_require "$f" "$id"
  # 移送先の実在を確かめる。dangling な promoted_to を作ると索引が壊れ、
  # 「本文がどこにも無い」という二重管理より悪い状態になる（アンカーまでは見ない）
  tgt=${to%%#*}
  case "$tgt" in /*) tpath=$tgt ;; *) tpath="$ROOT/$tgt" ;; esac
  [ -f "$tpath" ] || die "移送先が見つかりません: $tgt（先に本文を移してから promote する）"
  # **破壊の前に**退避先の衝突を見る。後ろで見ると、本文を捨てた後に失敗して
  # 「tombstone だけが active に残る」という直せない状態になる
  cv_archive_free "$f"
  cv_set "$f" status promoted
  cv_set "$f" promoted_to "$to"
  cv_set "$f" promoted_at "$(date -u +%F)"
  cv_tombstone "$f" "本文は promoted_to へ移送済み。ここには置かない（本文の在処は常に1箇所）。"
  cv_archive_file "$f"
  printf 'promoted: %s -> %s\n' "$id" "$to"
  printf 'next: %s の索引ブロックのリンク先を %s に張り替えること\n' "$(cv_index_label)" "$to"
}

# 退避先が空いているか。**破壊的な操作の前に**呼べるよう、移動本体と分けてある。
cv_archive_free() { # path
  _d=$(cv_dir)
  _b=$(basename "$1")
  if [ -e "$_d/archive/$_b" ]; then die "archive に同名があります: $_d/archive/$_b"; fi
}

cv_archive_file() { # path
  d=$(cv_dir)
  cv_archive_free "$1"
  mkdir -p "$d/archive"
  b=$(basename "$1")
  mv "$1" "$d/archive/$b"
  printf 'archived: %s\n' "$d/archive/$b"
}

cv_do_status() {
  fmt=table
  while [ $# -gt 0 ]; do
    case "$1" in
      --format) need_arg "$1" $#; fmt=${2:-}; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) die "余分な引数: $1" ;;
    esac
  done
  case "$fmt" in table|tsv) ;; *) die "--format は table|tsv" ;; esac
  d=$(cv_dir)
  [ -d "$d" ] || die "条項ディレクトリがありません: $d（aidev convention new で起こす）"
  # 行は status と同じく「タブ区切り文字列を積んで最後に fmt_table へ流す」形にする
  # （command substitution は末尾改行を落とすので、行の組み立てに $( ) を使わない）
  CV_IDXF=$(cv_index_file)
  CV_IDXB=""
  if [ -n "$CV_IDXF" ]; then CV_IDXB=$(cv_index_block "$CV_IDXF"); fi
  CV_REL=$(cv_dir_rel)
  rows=""; npend=0; nready=0; nconf=0; nidx=0
  for f in "$d"/*.md "$d/archive"/*.md; do
    [ -f "$f" ] || continue
    id=$(basename "$f" .md)
    st=$(cv_get "$f" status); [ -n "$st" ] || st="-"
    intro=$(cv_get "$f" introduced); [ -n "$intro" ] || intro="-"
    va=$(cv_get "$f" verify_after)
    case "$va" in ''|*[!0-9]*) va=0 ;; esac
    pt=$(cv_get "$f" promoted_to); [ -n "$pt" ] || pt="-"
    if [ "$intro" = "-" ]; then pop=0; else pop=$(cv_pop "$intro"); fi
    ready="-"
    if [ "$st" = pending ]; then
      npend=$((npend+1))
      if [ "$va" -gt 0 ] && [ "$pop" -ge "$va" ]; then ready=yes; nready=$((nready+1)); else ready=no; fi
    fi
    if [ "$st" = confirmed ]; then nconf=$((nconf+1)); fi
    # index 列: active な条項が索引に載っているか。載っていない＝自動読込されない＝読まれない。
    # 読まれていないだけの条項を「効かなかった」と判定しないための可視化。
    idx="-"
    case "$f" in
      "$d/archive/"*) ;;
      *) case "$st" in
           pending|confirmed)
             if [ -n "$CV_IDXF" ] && printf '%s' "$CV_IDXB" | grep -qF "$CV_REL/$(basename "$f")"; then
               idx=yes
             else
               idx=no; nidx=$((nidx+1))
             fi ;;
         esac ;;
    esac
    rows="${rows}${id}	${st}	${intro}	${pop}	${va}	${ready}	${idx}	${pt}
"
  done
  if [ "$fmt" = tsv ]; then
    printf '%s' "$rows" | while IFS='	' read -r a b c e f g h i; do
      [ -n "$a" ] || continue
      printf 'convention	%s	%s	%s	%s	%s	%s	%s	%s\n' "$a" "$b" "$c" "$e" "$f" "$g" "$h" "$i"
    done
  else
    { printf 'id	status	introduced	pop	need	ready	index	promoted_to\n'; printf '%s' "$rows"; } | fmt_table
  fi
  printf 'convention-summary: pending=%s ready=%s confirmed(未移送)=%s 索引漏れ=%s\n' \
    "$npend" "$nready" "$nconf" "$nidx"
}

# 条項ファイルの一生を見る（backlog と同じく**持ち主の work がいない**ので verify では硬ゲートにできない）。
# 見るのは4つ: frontmatter の欠落・未知 status / 判定可能なのに未判定 / confirmed の移送漏れ / 終状態の退避漏れ。
doctor_conventions() {
  d=$(cv_dir)
  [ -d "$d" ] || return 0
  # 索引はファイル単位で1回だけ読む（条項ごとに読み直さない）
  CV_IDXF=$(cv_index_file)
  CV_IDXB=""
  CV_IDXL="-"
  if [ -n "$CV_IDXF" ]; then
    CV_IDXB=$(cv_index_block "$CV_IDXF")
    CV_IDXL=$(basename "$CV_IDXF")
  fi
  cfiles=0; carch=0; cwarn=0; cout=""
  for f in "$d"/*.md "$d/archive"/*.md; do
    [ -f "$f" ] || continue
    case "$f" in
      "$d/archive/"*) arch=yes; label="archive/$(basename "$f")"; carch=$((carch+1)) ;;
      *)              arch=no;  label=$(basename "$f");           cfiles=$((cfiles+1)) ;;
    esac
    st=$(cv_get "$f" status)
    intro=$(cv_get "$f" introduced)
    va=$(cv_get "$f" verify_after)
    w=""
    case "$st" in
      "")
        w="$w    WARN frontmatter(status)が無い: 検証の進み方が決まらない（pending/confirmed/promoted/ineffective/superseded）
" ;;
      pending)
        if [ "$arch" = yes ]; then
          w="$w    WARN 退避済みだが status=pending: 判定前に退避されている
"
        else
          case "$va" in ''|*[!0-9]*) va=0 ;; esac
          if [ -n "$intro" ] && [ "$va" -gt 0 ]; then
            pop=$(cv_pop "$intro")
            if [ "$pop" -ge "$va" ]; then
              w="$w    WARN 母集団が揃った(${pop}/${va})のに未判定: insights で効果を判定すること
"
            fi
          fi
        fi ;;
      confirmed)
        if [ "$arch" = no ]; then
          # 効果が確認された条項が docs/aidev に居座ると、PJ ドキュメントと二重管理になる
          w="$w    WARN confirmed だが未移送: PJ ドキュメントへ移して promote すること
"
        fi ;;
      promoted)
        if [ -z "$(cv_get "$f" promoted_to)" ]; then
          w="$w    WARN promoted だが promoted_to が無い: 本文の行き先が辿れない
"
        fi
        if [ "$arch" = no ]; then
          w="$w    WARN promoted だが未退避: active に残ると重複提案の検査対象からずれる
"
        fi ;;
      ineffective|superseded)
        if [ "$arch" = no ]; then
          w="$w    WARN $st だが未退避: archive/ へ移すこと
"
        fi ;;
      *)
        w="$w    WARN 未知の status: $st（pending/confirmed/promoted/ineffective/superseded）
" ;;
    esac
    # 索引の突き合わせ（active な条項＝読まれる必要があるもの、と移送済みの張り替え漏れ）
    _rel="$(cv_dir_rel)/$(basename "$f")"
    case "$st" in
      pending|confirmed)
        if [ "$arch" = no ]; then
          if [ -z "$CV_IDXF" ]; then
            w="$w    WARN 索引ファイルが無い: 条項が自動読込されず、読まれないまま「効かなかった」と誤判定される
"
          elif ! printf '%s' "$CV_IDXB" | grep -qF "$_rel"; then
            w="$w    WARN 索引に無い（$CV_IDXL）: 自動読込されないので読まれない。ブロック内に足すこと
"
            w="$w         例: - <いつ参照するか> → $_rel
"
          fi
        fi ;;
      promoted)
        pt=$(cv_get "$f" promoted_to)
        if [ -n "$CV_IDXF" ] && [ -n "$pt" ]; then
          if printf '%s' "$CV_IDXB" | grep -qF "$_rel"; then
            w="$w    WARN 索引が移送前を指したまま（$CV_IDXL）: $_rel → $pt に張り替えること
"
          fi
        fi ;;
    esac
    if [ -n "$w" ]; then
      cwarn=$((cwarn+1))
      cout="$cout- $label (status=${st:--})
$w"
    fi
  done
  printf 'convention: 条項ファイル横断検査\n'
  if [ -n "$cout" ]; then printf '%s' "$cout"; fi
  printf 'convention-summary: files=%s archived=%s warn=%s\n' "$cfiles" "$carch" "$cwarn"
}

cmd_worktree() {
  [ $# -ge 1 ] || die "使用法: aidev worktree <add|list|rm> ..."
  sub=$1; shift
  case "$sub" in
    add)  wt_add "$@" ;;
    list) wt_list "$@" ;;
    rm)   wt_rm "$@" ;;
    *) die "未知の worktree サブコマンド: $sub（add|list|rm）" ;;
  esac
}

usage() {
  # 先頭(2行目以降)の連続するコメント行のみを出力（コメント末尾で停止。範囲ズレに強い）
  awk 'NR==1{next} /^#/{sub(/^#[[:space:]]?/,"");print;next} {exit}' "$0"
}

[ $# -ge 1 ] || { usage; exit 1; }
cmd=$1; shift
case "$cmd" in
  new)     cmd_new "$@" ;;
  event)   cmd_event "$@" ;;
  approve) cmd_approve "$@" ;;
  unapprove) cmd_unapprove "$@" ;;
  guard)   cmd_guard "$@" ;;
  verify)  cmd_verify "$@" ;;
  escalate) cmd_escalate "$@" ;;
  doctor)  cmd_doctor "$@" ;;
  status)  cmd_status "$@" ;;
  metrics) cmd_metrics "$@" ;;
  use)     cmd_use "$@" ;;
  backlog) cmd_backlog "$@" ;;
  convention) cmd_convention "$@" ;;

  worktree) cmd_worktree "$@" ;;
  help|-h|--help) usage ;;
  *) die "未知のコマンド: $cmd（aidev help）" ;;
esac
