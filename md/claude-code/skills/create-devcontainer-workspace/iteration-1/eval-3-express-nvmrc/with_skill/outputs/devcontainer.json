{
  "name": "my-express-api",
  "image": "mcr.microsoft.com/devcontainers/node:18-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "forwardPorts": [3000],

  "portsAttributes": {
    "3000": { "label": "Express API Server", "onAutoForward": "notify" }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "remoteEnv": {
    // Add any secrets your app needs from the host environment, e.g.:
    // "DATABASE_URL": "${localEnv:DATABASE_URL}"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "christian-kohler.npm-intellisense",
        "ms-vscode.vscode-js-debug-companion"
      ],
      "settings": {
        "editor.formatOnSave": true
      }
    }
  }
}
