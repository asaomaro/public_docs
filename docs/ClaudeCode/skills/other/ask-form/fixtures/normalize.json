{
 "about": "定義の検査の、共通の試験データ。ask-form（ask.py の normalize()）と Sodashitsu（normalizeAskSpec）が同じこのファイルを読む。 expect.spec は「正規化後」の形で、部品 <ask-form> が受ける定義の形の正。比べるのは、ここに書いた項目だけ（実装が足す内部の項目——ask-form の _files など——は比べない）。 誤りは文言ではなく reason（分類）で比べる。実装ごとの差は、その実装の名前の欄（sodashitsu など）に expect を書いて上書きする（差を黙って飛ばさない）。",
 "reasons": {
  "questions_empty": "questions が無い・空",
  "id_label_required": "質問に id か label が無い",
  "id_duplicate": "質問の id の重複",
  "unknown_type": "知らない型",
  "unsupported_type": "型は知っているが、その実装では出せない",
  "options_empty": "選択肢（か表の行）が無い・空",
  "option_value_required": "選択肢に value が無い",
  "option_value_duplicate": "選択肢の value の重複",
  "showif_unknown_id": "表示条件が、無い質問を指す",
  "showif_invalid": "表示条件の形が違う",
  "paging_invalid": "paging の値が違う",
  "page_invalid": "page が文字列でない",
  "row_default_unknown": "表の行の既定が、選択肢に無い",
  "preview_invalid": "preview の値が違う",
  "code_invalid": "code が文字列でない",
  "media_type": "画像・音のファイルの種類が違う（ask-form だけ）",
  "media_missing": "画像・音のファイルが無い（ask-form だけ）",
  "too_large": "上限の超過（Sodashitsu だけ）"
 },
 "cases": [
  {
   "name": "最小の定義: 既定が埋まる",
   "spec": {
    "questions": [
     {
      "id": "a",
      "label": "A",
      "options": [
       "x",
       "y"
      ]
     }
    ]
   },
   "expect": {
    "ok": true,
    "spec": {
     "title": "質問",
     "submit": "決定",
     "note": true,
     "questions": [
      {
       "allowOther": false,
       "required": false,
       "multiline": false,
       "id": "a",
       "label": "A",
       "type": "single",
       "options": [
        {
         "value": "x",
         "label": "x"
        },
        {
         "value": "y",
         "label": "y"
        }
       ]
      }
     ]
    }
   }
  },
  {
   "name": "題・決定の文言・説明",
