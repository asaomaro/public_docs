#!/bin/sh
# aidev ランタイムガード CLI（POSIX sh のみ・Node 非依存）
#
# 役割: aidev ハーネスの state.yml / metrics.yml 更新を「単一の検証済み経路」に集約し、
#       工程の前提・不変条件を決定的に検査する（散文規約=ソフト / この CLI=ハードの二層）。
# 正典: .claude/skills/aidev-00-start/protocol.md（§6 state / §8 metrics / §4.1 命名 / §2.7 依存）。
# Windows 版は同ディレクトリの aidev.ps1（挙動を一致させること）。
#
# 使い方:
#   aidev new <slug> [--mode interactive|autonomous] [--profile full|light] [--light] [--ticket ID]
#                    [--depends a,b,#N] [--parent <親work>] [--backlog <file>] [--backlog-item <text>] [--human-gates <list>]
#     --parent 指定時は親 work 配下に subtask（<NN>-<subslug>・date prefix なし・current=tasks）を作る
#     --backlog は backlog 項目から起こした work に出自を刻む（deliver での消し込みを verify が強制する）
#     --profile/--light は「どこまで工程を回すか」（protocol.md「11.」）。mode（誰が承認するか）と直交
#   aidev escalate [slug]                      # profile を light -> full に昇格（片方向。full からは戻せない）
#   aidev event <phase> <start|sent_back> [key=value ...]     # approved は approve が刻む
#   aidev approve <phase> [key=value ...]      # approved 追記 + current 更新 + approved イベント
#   aidev unapprove <phase> [--slug <work>]    # 差し戻しで後工程の承認を取り消す（記録は消さない）
#   aidev guard <phase>                        # 前提成果物 + dependsOn の充足を検査（exit!=0で未充足）
#   aidev verify [slug] [--strict]             # 現在(or指定)workの不変条件を version-aware に検査
#     --strict は**記録漏れ(event の start 欠落)だけ**を致命(exit 5)にする。機械ゲート（Claude Code の
#     Stop フック等）から使う想定。light の逸脱 WARN は人間の判断なので strict でも致命にしない
#   aidev coverage [slug] [--format table|tsv] [--strict]
#     受け入れ基準(AC)の被覆率と tasks.md の整合（AC 行の欠落・未定義参照・依存の循環）を検査する。
#     対応付けの正典は tasks.md の `AC:` 行。--strict は gap があれば exit 4（tasks の承認前ゲート）
#   aidev debug [start|report|status] ...        # 詰まったときの原因究明を有限化する
#     start  [slug] [--phase p]                  # 新しいコンテキストへ委譲する前に打つ。ラウンド上限(既定2)を検査
#     report [slug] --root-cause <t> --category <c> --next-action <retry|block|stop_for_human>
#            [--confidence high|medium|low] [--fix-tasks <t>] [--verification <t>]
#     status [slug] [--format table|tsv]         # 工程ごとの差し戻し数・デバッグ回数・要否
#   aidev taskcheck <start|report|status> ...
#     タスク単位の独立点検を有限化する。start が maxTaskCheckRounds を検査し、超えていれば exit 4
#     start <task-id> --mode <delegated|same_session> [--slug s] / report <task-id> --findings <n> [--slug s]
#     status [--format table|tsv] [--slug s]   # 件数は approve coding が自動で刻む（手書きしない）
#   aidev doccheck <start|report|status> ...
#     上流4文書(requirements/design/architecture/plan)の独立点検を有限化する。start が maxDocCheckRounds を検査
#     start <phase> --mode <delegated|same_session> [--slug s] / report <phase> --findings <n> [--slug s]
#     status [--format table|tsv] [--slug s]   # 件数は approve <phase> が自動で刻む（手書きしない）
#   aidev limits [show|set <key> <n>|unset <key>] [--format table|tsv] [--slug <work>]
#     回数の上限を一覧・設定する。どこから来た値か（config / state / 既定）まで出す
#   aidev smoke [slug]
#     .aidev/config.yml の smokeCommand を実行し、結果を metrics に刻む（起動確認 GO/NO-GO）。
#     「テストが通ること」だけでは着地の根拠にしない。未設定は exit 2（黙って緑にしない）
#   aidev doctor [--quiet]                     # 全 work を横断検査（legacy は免除）＋ backlog/条項/ハーネス改修の検査（WARN）。--quiet は OK の work を出さない
#   aidev use [<slug>]                         # 継続する作業を切り替える（引数なしで現在値を表示）
#   aidev backlog new <name> --kind standing|split|topic [--parent <p>] [--priority <n>]
#     frontmatter 付きで backlog ファイルを起こす（kind 欠落を構造的に防ぐ）
#   aidev backlog archive [<file>...] [--force]  # 消化しきった backlog を archive/ へ退避（mv のみ・git は触らない）
#   aidev backlog compact [<file>...]          # [x] 行（と継続行）を archive/<name>-done.md へ移す（無指定は standing 全部）。verify はそこも見る
#   aidev convention new <id> --hypothesis <text> --baseline <text> [--scope <text>] [--source <path>] [--verify-after <n>]
#     PJ規約の条項を .aidev/conventions/ に起こす。--hypothesis と --baseline が必須＝検証できない条項を作らせない入口ゲート
#     （baseline: 導入前にこの観点の指摘が何件あったか。id 別の件数は 0->N と増えるだけで前後比較にならないため）
#   aidev convention confirm <id> --result <text> [--force]  # 効果あり -> 移送待ち。母集団が揃う前は --force（forced: true が残る）
#   aidev convention retire  <id> --status ineffective|superseded --note <text> [--force]  # 効果なし/置換で退役（ineffective は母集団が要る）
#   aidev convention defer   <id> --verify-after <n> --note <text>  # 判定を先送り（母集団の必要件数を積み増す。理由必須）
#   aidev convention promote <id> --to <path#anchor>    # 本文を PJ docs へ移した後、tombstone 化して退避
#   aidev convention status [--format table|tsv] [--members <id>]  # 条項の一覧。--members は母集団の work 一覧（分母と分子を同じ集合で見る）
#   aidev status [--format table|tsv] [--active] [--subtasks]  # works横断＋backlog未着手の状況サマリ（読み取り専用）。--active は deliver 済みを隠す
#   aidev metrics [slug] [--all] [--phases] [--format table|tsv]  # metrics.yml から派生指標を集計（読み取り専用）。--all は全 work を対象にする（列の増減はしない）（版で層別する）
#   aidev harness new <id> --hypothesis <text> --baseline <text> [--source <p>] [--verify-after <n>]
#     ハーネス改修の仮説を .aidev/harness/ に登録する（introduced_rev に今の版を刻む）。条項と同じ入口・出口ゲート
#   aidev harness confirm <id> --result <text> [--force] / retire <id> --status ineffective|superseded --note <text> [--force]
#   aidev harness status [--format table|tsv]   # 改修ごとの母集団（導入後に着手し、またがらずに deliver した work）と判定可否
#   aidev worktree add <slug> [--branch n] [--base ref] [--path dir] [--mode m] [--profile p|--light]
#                            [--ticket id] [--depends list] [--backlog <file>] [--backlog-item <text>] [--human-gates <list>]
#                                              # work 専用の git worktree+ブランチを作る（ユーザー責任の並行 on-ramp）
#     new へ委譲する引数は new と同じ意味（--backlog を落とすと deliver の消し込み強制が静かに外れる）
#   aidev worktree list [--format table|tsv]   # aidev 管理 worktree を一覧（読み取り専用）
#   aidev worktree files [--planned] [--all] [--format table|tsv]
#                                              # どのファイルを何本の worktree が触っているか（既定は
#                                              # 未着地 work の重なりだけ）。sharedFiles の宣言漏れも出す
#   aidev worktree rm <slug|path> [--force] [--delete-branch]     # worktree を安全に撤去（未コミットは既定で拒否）
#   aidev help
#
# 終了コード: 0=OK / 1=使用法・環境エラー / 2=前提成果物の不足 / 3=依存(dependsOn)未充足 / 4=不変条件違反
#             5=記録漏れ（verify --strict のときのみ。既定の verify では WARN 止まりで 0）

set -eu

# オプション値の取り出し口。`--opt) v=$2; shift 2` を裸で書くと、値が欠けたときに
# 「shift: can't shift that many」「parameter not set」という**シェルの内部エラー**が
# rc=2 で漏れる。何が悪いのか読めないうえ、ps1 側は $null を拾って素通りし別の rc で終わる
#（同じ入力で OS ごとに違う挙動＝この CLI が一番やってはいけないこと）。使い方エラーは
# 他と同じ die(rc=1) に揃える。呼び方: `--opt) need_arg "$1" $#; v=$2; shift 2 ;;`
need_arg() { # opt残り引数数
  [ "$2" -ge 2 ] || die "$1 には値が必要です"
}

CURRENT_SCHEMA=11  # 現行スキーマ版。new がこの値を刻む。schema 3=subtask 層(subtasks/activeSubtask/parent)導入。schema 4=harnessRev 刻印（効果検証の母集団特定）導入。schema 5=承認済み工程の成果物実在検査を導入。schema 6=AC カバレッジ / tasks.md 整合 / test-result.md の検査を導入。schema 7=起動確認(smoke)の記録検査を導入。schema 8=デバッグ（詰まりの原因究明）の記録検査を導入。schema 9=light の上流4文書の実在検査を導入。schema 10=autonomous の decisions.md と タスク点検の実施形態(task_check_mode) を記録漏れ扱いに。schema 11=autonomous の上流4文書の独立点検(doccheck)の記録を必須に。schema<=2 は legacy として subtask 不変条件を免除。

PHASES="requirements research design architecture tasks coding test review walkthrough deliver retro"

die()  { printf 'aidev: %s\n' "$*" >&2; exit 1; }
warn() { printf 'aidev: %s\n' "$*" >&2; }
now()  { date -u +%Y-%m-%dT%H:%M:%SZ; }

# --- ルート/作業ディレクトリ解決 -------------------------------------------------
find_root() {
  d=$(pwd)
  while [ "$d" != "/" ]; do
    [ -d "$d/.aidev" ] && { printf '%s\n' "$d"; return 0; }
    d=$(dirname "$d")
  done
  [ -d "/.aidev" ] && { printf '%s\n' "/"; return 0; }
  return 1
}

# `help` は `.aidev` を要らない。導入直後（.aidev をまだ作っていない時点）に
# 「入ったか確かめる」ために最初に打つのがこれで、そこでエラーにすると
# 「壊れている？」と思わせる。読み取りだけのコマンドに前提を課さない。
# usage() はこのファイルの末尾で定義されるので、ここでは**解決を飛ばすだけ**にして
# 実際の表示は dispatch に任せる
ROOT=""
case "${1:-}" in
  help|--help|-h|'') ;;
  *) ROOT=$(find_root) || die ".aidev が見つかりません（リポジトリ内で実行してください）" ;;
esac
AIDEV="$ROOT/.aidev"

resolve_work() { # [slug]
  # slug は top-level work（dated 名）か subtask のネストパス（<dated>/<NN>-<subslug>）。
  # works/<slug> へ素直に連結するためネストもそのまま解決できる（subtask 層の単一経路）。
  slug=${1:-}
  if [ -z "$slug" ]; then
    slug=${AIDEV_WORK:-}
  fi
  if [ -z "$slug" ]; then
    [ -f "$AIDEV/current" ] || die "対象作業が不明です（.aidev/current 無し）。aidev new か slug 指定を。"
    slug=$(head -n1 "$AIDEV/current" | tr -d '\r\n')
  fi
  WORK="$AIDEV/works/$slug"
  [ -d "$WORK" ] || die "work が存在しません: $slug"
  SLUG=$slug
}

# **die は exit する**ので `if resolve_work …; then` では受からない（プロセスごと落ち、
# `2>/dev/null` がメッセージまで消して「無言の exit 1」になる。`limits` で実際に起きた
# ——導入直後に上限値を確かめたい、まさにその瞬間に効かなかった）。
# 「work があれば使う、無ければ黙って続ける」用の落ちない版。
resolve_work_soft() { # [slug] -> 0=解決した / 1=解決できない（die しない）
  _rs=${1:-}
  [ -n "$_rs" ] || _rs=${AIDEV_WORK:-}
  if [ -z "$_rs" ]; then
    [ -f "$AIDEV/current" ] || return 1
    _rs=$(head -n1 "$AIDEV/current" | tr -d '\r\n')
  fi
  [ -n "$_rs" ] || return 1
  [ -d "$AIDEV/works/$_rs" ] || return 1
  WORK="$AIDEV/works/$_rs"; SLUG=$_rs
  return 0
}

# state.yml の key 行を差し替え、無ければ末尾に追記（subtasks/activeSubtask の冪等更新用）。
set_or_append() { # file key newline
  if grep -q "^$2:" "$1"; then replace_line "$1" "$2" "$3"; else printf '%s\n' "$3" >> "$1"; fi
}

is_phase() { for p in $PHASES; do [ "$p" = "$1" ] && return 0; done; return 1; }

# --- 最小 YAML 読み取り（フロー形式前提） ------------------------------------------
# scalar: 'key: value' -> value（前後空白と囲み二重引用符を除去）。
# 注意: inline コメント(#)は除去しない。state.yml/metrics.yml は機械生成でコメントを含まず、
#       逆に ticket/dependsOn は '#18' 等 '#' 始まりの値を持つため（'#' をコメント扱いすると消える）。
yget() {
  sed -n "s/^$2:[[:space:]]*//p" "$1" 2>/dev/null | head -n1 \
    | sed 's/[[:space:]]*$//; s/^"//; s/"$//'
}
# flow list: "key: [a, b]" -> "a b"（カンマ/角括弧除去・クォート除去）
ylist() {
  v=$(yget "$1" "$2")
  v=${v#[}; v=${v%]}
  printf '%s' "$v" | tr ',' ' ' | tr -d '"'
}
approved_has() { ylist "$WORK/state.yml" approved | grep -qw "$1"; }
# **この工程に人間の承認者がいるか**。`autonomous` でも `humanGates` に挙がっている工程には
# いる（`protocol-autonomous.md`「部分自律」）。「autonomous なら一律いない」で判定していた頃は、
# `humanGates: [design]` で回している work——他 PJ の retro が実績として報告している構成——で
# **承認者がいるのに承認前提の促しを止めていた**（実走で実測）。
# なお `humanGates` は `new` が書くだけで**どこからも読まれていなかった**（書いて忘れられた設定）
has_approver() { # phase
  if [ "$(yget "$WORK/state.yml" mode)" != autonomous ]; then return 0; fi
  case " $(ylist "$WORK/state.yml" humanGates) " in *" $1 "*) return 0 ;; esac
  return 1
}

# 1行を丸ごと差し替え（awk で sed エスケープ事故を回避）
replace_line() { # file key newline
  awk -v key="^$2:" -v repl="$3" '$0 ~ key {print repl; next} {print}' "$1" > "$1.tmp" && mv "$1.tmp" "$1"
}

# --- metrics.yml 追記 ---------------------------------------------------------
ensure_events() {
  f="$WORK/metrics.yml"
  if [ ! -f "$f" ]; then printf 'events:\n' > "$f"; return; fi
  # events: [] を block 形式に変換（block item を足すため）
  if grep -q '^events:[[:space:]]*\[\][[:space:]]*$' "$f"; then
    awk '/^events:[[:space:]]*\[\][[:space:]]*$/{print "events:"; next}{print}' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  fi
  grep -q '^events:' "$f" || printf 'events:\n' >> "$f"
}

build_entry() { # phase event [key=value ...]
  ph=$1; ev=$2; shift 2
  m=""
  for kv in "$@"; do
    k=${kv%%=*}; val=${kv#*=}
    if [ -z "$m" ]; then m="$k: $val"; else m="$m, $k: $val"; fi
  done
  if [ -n "$m" ]; then
    printf '{ ts: %s, phase: %s, event: %s, metrics: { %s } }' "$(now)" "$ph" "$ev" "$m"
  else
    printf '{ ts: %s, phase: %s, event: %s }' "$(now)" "$ph" "$ev"
  fi
}

append_event() { # phase event [key=value ...]
  ensure_events
  entry=$(build_entry "$@")
  printf '  - %s\n' "$entry" >> "$WORK/metrics.yml"
}

# --- ハーネス版（効果検証の母集団特定） -------------------------------------------
# ハーネス自身の改修が効いたかを後から判定するには、その work が**どの版のハーネスで回されたか**が
# 要る。刻印を手書きに任せると忘れられ、忘れられた work は母集団から静かに漏れる（schema: を new に
# 一本化したのと同じ理由）。そこで new が自動で刻む。
# 版の実体は「ハーネス・ディレクトリを最後に触ったコミット」。git が無い/取れない環境では捏造せず
# 'unknown' を刻む（protocol.md「8.」の「過去分は捏造しない」と同じ態度）。
BIN_DIR=$(cd "$(dirname "$0")" && pwd)
HARNESS=$(dirname "$(dirname "$BIN_DIR")")   # <skills>/aidev-docs/bin -> <skills>

harness_rev() {
  command -v git >/dev/null 2>&1 || { printf 'unknown'; return 0; }
  # 見る範囲は **aidev-* の skill だけ**。<skills> 全体を見ると、同居する無関係な skill
  # （md-to-doc など）の変更でも版が上がり、その間に走った work が全部「またがり」に見える。
  # またがり判定は母集団からの除外なので、誤検知はそのまま**効果検証の母集団を痩せさせる**。
  set --
  for _d in "$HARNESS"/aidev-*; do [ -d "$_d" ] && set -- "$@" "$_d"; done
  [ "$#" -gt 0 ] || { printf 'unknown'; return 0; }
  # 版の実体は**内容の tree hash**であってコミット SHA ではない。SHA だと squash / rebase で
  # 同一内容が別版になり、PR ブランチで回した work と main で回した work が常に別層に割れる
  # （GitHub 既定の squash 運用で必ず起きる）。tree hash は内容が同じなら同じ。
  # 未コミットの編集は版に出ない（従来どおり。またがり＝除外を増やさない側に倒す）
  # **`ls-tree` の出力が空なら、そこで unknown**（ハーネスが git 管理外／未コミット）。
  # パイプで繋いだままだと `git hash-object --stdin` が**空入力に空 blob のハッシュ**
  # （e69de29bb2d1…）を返すので `$r` が空にならず、unknown フォールバックが一度も効かない。
  # 結果として**全環境・全 work で同じ値**が刻まれ、母集団から外れるべき work が
  # 「同一版で回した仲間」に化ける（他 PJ の retro が実測で見つけた。ps1 には元から
  # このガードがあり、sh だけが落ちていた＝両実装を突き合わせる検査の穴でもあった）
  _hrt=$(git -C "$HARNESS" ls-tree -d HEAD -- "$@" 2>/dev/null | awk '{print $3}') || _hrt=""
  [ -n "$_hrt" ] || { printf 'unknown'; return 0; }
  r=$(printf '%s\n' "$_hrt" | git hash-object --stdin 2>/dev/null | cut -c1-12 || true)
  [ -n "$r" ] || r=unknown
  printf '%s' "$r"
}

# 空 blob のハッシュ（git の定数）。上のバグで**既に刻まれてしまった work** がある以上、
# 読む側でも unknown に寄せる——「全環境で同じ値」なので、そのまま比べると別 PJ・別版の
# work まで同一版に見え、またがり判定も効果検証の母集団も静かに壊れる。
HR_EMPTY=e69de29bb2d1
hr_get() { # state.yml [key] -> harnessRev（空 blob 値は unknown に正規化）
  _hv=$(yget "$1" "${2:-harnessRev}")
  if [ "$_hv" = "$HR_EMPTY" ]; then _hv=unknown; fi
  printf '%s' "$_hv"
}

# --- 条項（.aidev/conventions の PJ規約）---------------------------------------------------
# ハーネスが生成した規約は **PJ 所有の AGENTS.md / CLAUDE.md に書き込まない**（protocol.md「12.」）。
# 条項ディレクトリは終着点ではなく**検証中の待避所**で、条項は必ずここから出ていく:
#   効果あり -> PJ ドキュメントへ移送(promote) / 効果なし・置換 -> 退役(retire)
# 本文の在処を常に1箇所に保つことで二重管理を構造的に防ぐ（移送後は tombstone＝リンクのみ）。
CV_TERMINAL="promoted ineffective superseded"

# 条項の置き場。既定は `.aidev/conventions`（`conventionsDir` で変更可）。
# 条項は PJ 規約なので PJ 固有だが、`.aidev/` 自体が PJ 固有の実行時状態（works/backlog/insights/
# harness/charter）であって配布物ではない——配布されるのは `.claude/skills/aidev-*` だけ。
# 逆に `docs/` は PJ が所有する領域なので、そこにハーネスの構造（archive/ 付きのディレクトリ）を
# 作る方が越権になる。移送は「ハーネスの待避所 → PJ ドキュメント」で、領域をまたぐ形が正しい。
cv_dir() {
  d=$(yget "$AIDEV/config.yml" conventionsDir)
  [ -n "$d" ] || d=".aidev/conventions"
  case "$d" in /*) printf '%s' "$d" ;; *) printf '%s/%s' "$ROOT" "$d" ;; esac
}

# 条項ファイル先頭 frontmatter から key を読む（bl_kind の汎用版）。
cv_get() { # file key
  awk -v k="$2" '
    NR==1 && $0 !~ /^---[[:space:]]*$/ {exit}
    NR==1 {next}
    /^---[[:space:]]*$/ {exit}
    index($0, k ":")==1 { sub("^" k ":[[:space:]]*",""); sub(/[[:space:]]*$/,""); print; exit }' "$1" 2>/dev/null
}

# frontmatter 内の key を差し替え、無ければ frontmatter 末尾に足す（冪等）。
cv_set() { # file key value
  awk -v k="$2" -v v="$3" '
    BEGIN{fm=0; done=0}
    NR==1 && /^---[[:space:]]*$/ {print; fm=1; next}
    fm==1 && /^---[[:space:]]*$/ { if(!done) print k": "v; print; fm=2; next }
    fm==1 && index($0, k ":")==1 { print k": "v; done=1; next }
    {print}' "$1" > "$1.tmp" && mv "$1.tmp" "$1"
}

# 本文を捨てて tombstone にする。**本文が2箇所に存在する瞬間を作らない**のが移送の要点。
cv_tombstone() { # file text
  awk -v msg="$2" '
    BEGIN{fm=0}
    NR==1 && /^---[[:space:]]*$/ {print; fm=1; next}
    fm==1 && /^---[[:space:]]*$/ {print; print ""; print msg; fm=2; next}
    fm==1 {print; next}
    {next}' "$1" > "$1.tmp" && mv "$1.tmp" "$1"
}

# id からパスを解決する。**id は必ずここで潰す**——`../foo` のような値をそのまま連結すると、
# 条項ディレクトリの外のファイルを confirm/retire/promote が破壊・移動できてしまう
#（cv_new だけが basename を通しており、他3つが素通しだった）。
cv_id() { # 生の id -> 安全な id（パス成分とスラッシュを落とす）
  _i=$(basename -- "$1" .md)
  case "$_i" in ''|.|..) die "id が不正です: $1" ;; esac
  printf '%s' "$_i"
}

cv_find() { # id -> パスを出力（active 優先、無ければ archive）。見つからなければ 1
  _d=$(cv_dir)
  _id=$(cv_id "$1")
  if [ -f "$_d/$_id.md" ]; then printf '%s' "$_d/$_id.md"; return 0; fi
  if [ -f "$_d/archive/$_id.md" ]; then printf '%s' "$_d/archive/$_id.md"; return 0; fi
  return 1
}

# 条項ファイルであることを確かめる。**frontmatter が無いものを触らせない**——
# cv_tombstone は「frontmatter 内の行だけ残す」実装なので、frontmatter が無いファイルに
# かけると本文が丸ごと消える（README を条項ディレクトリに置いただけで 0 バイトになった）。
cv_require() { # path id
  if [ "$(head -n1 "$1" 2>/dev/null | tr -d '\r')" != "---" ]; then
    die "条項ファイルではありません（frontmatter が無い）: $1"
  fi
  if [ -z "$(cv_get "$1" convention)" ] && [ -z "$(cv_get "$1" status)" ]; then
    die "条項ファイルではありません（convention / status がどちらも無い）: $1"
  fi
}

# 母集団＝その条項の導入時刻以降に着手し、**かつ deliver 済み**の work の件数。
#
# 条件が2つある理由:
#  - **導入時刻以降に着手**: 導入前から走っていた work は条項の効果を半分しか受けていない
#    （またがり work を入れると効果が薄まる方向にバイアスがかかる）。日付粒度で比べると、条項が
#    生まれるきっかけになった「同じ日に先に着手していた work」がほぼ確実に混入するので時刻で比べる。
#  - **deliver 済み**: 着手しただけの work は review を通っていない＝**判定材料を1つも産んでいない**。
#    着手だけで数えると、レビュー記録がまだ無いのに ready=yes が立ち、insights が
#    空の材料で判定してしまう。母集団の増える瞬間は `approve deliver` の1点になる。
# 母集団の材料（deliver 済み top-level work の着手日）を **1 回だけ**走査して積む。
# 条項ごとに全 works を舐め直すと O(条項×works) で毎回 sed/tr/grep を spawn し、
# 100 works × 30 条項で convention status / doctor / approve deliver が 20 秒超になった。
# **注意**: `pop=$(cv_pop …)` はサブシェルなので、キャッシュは呼び出しループの**手前・親シェル**で
# prime すること（サブシェル内で積んでも親には残らない）
# ts（`YYYY-MM-DD` / `YYYY-MM-DDTHH:MM:SSZ`）→ 比較用の 14 桁 `YYYYMMDDHHMMSS`。
# 日付だけの値は 00:00:00 扱い（`introduced` が日付粒度だった旧条項の後方互換）。8 桁未満なら 1
cv_ts_key() {
  _k=$(printf '%s' "$1" | tr -cd '0-9')
  [ "${#_k}" -ge 8 ] || return 1
  printf '%s00000000000000' "$_k" | cut -c1-14
}
cv_pop_prime() {
  [ "${CV_TS_READY:-}" = yes ] && return 0
  CV_TS_READY=yes; CV_TS=""
  [ -d "$AIDEV/works" ] || return 0
  for _pd in "$AIDEV/works"/*/; do
    [ -d "$_pd" ] || continue
    _pf="${_pd}metrics.yml"
    [ -f "$_pf" ] || continue
    # 着手しただけの work は review を通っておらず判定材料が無いので数えない
    ylist "${_pd}state.yml" approved | grep -qw deliver || continue
    _pts=$(cv_first_ts "$_pf")
    [ -n "$_pts" ] || continue
    _a=$(cv_ts_key "$_pts") || continue
    CV_TS="$CV_TS $_a"
  done
}
# 先頭イベントの ts（行頭の `{ ts:` に固定。`metrics: { defects: 3 }` の 3 を日付と取り違えない）
cv_first_ts() { # metrics.yml
  sed -n 's/^[^{]*{[[:space:]]*ts:[[:space:]]*\([0-9][0-9:TZ.-]*\).*/\1/p' "$1" | head -n1
}
cv_pop() { # introduced(YYYY-MM-DD | YYYY-MM-DDTHH:MM:SSZ) -> 件数
  n=0
  _b=$(cv_ts_key "$1") || { printf '0'; return 0; }
  cv_pop_prime
  for _a in $CV_TS; do [ "$_a" -ge "$_b" ] && n=$((n+1)); done
  printf '%s' "$n"
}

# 判定可能になった条項の通知。**works が母集団に加わる唯一の瞬間＝`approve deliver`** に鳴らす。
# doctor にも同じ検査があるが、doctor の WARN は retro/insights を叩いた人にしか見えない
#（＝既に見に行った人にしか届かない）。判定できる状態になったことは、その瞬間に知らせる。
cv_ready_notice() {
  d=$(cv_dir)
  [ -d "$d" ] || return 0
  cv_pop_prime
  for f in "$d"/*.md; do
    [ -f "$f" ] || continue
    [ "$(cv_get "$f" status)" = pending ] || continue
    intro=$(cv_get "$f" introduced); [ -n "$intro" ] || continue
    va=$(cv_get "$f" verify_after)
    case "$va" in ''|*[!0-9]*) continue ;; esac
    [ "$va" -gt 0 ] || continue
    pop=$(cv_pop "$intro")
    # **未判定のあいだは鳴らし続ける**（`-ge`）。等号だけにしていたのは「全 deliver で
    # 全条項ぶん鳴り続ける」のを避けるためだったが、この関数は既に `status: pending` の
    # 条項しか見ていないので、鳴り続けるのは**まだ誰も判定していない条項**だけ。
    # 判定すれば止まる＝**直せる催促**であり、鳴らさない理由が無い。
    # 実走では、跨いだ後に着地した work に信号が一度も届かなかった（pop 5→6 で無音）。
    if [ "$pop" -ge "$va" ]; then
      printf 'note: 条項 %s の母集団が揃っています(%s/%s)。insights で効果を判定してください（判定するまで毎回出ます）\n' \
        "$(basename "$f" .md)" "$pop" "$va"
    fi
  done
}

# `humanGates` は「autonomous でもこの工程だけは人間が承認する」宣言。
# 設定口が無く state.yml の手編集しか手段が無かった——`escalate` / `unapprove` を作ったのと
# 同じ理由（state の更新は単一の検証済み経路に集約する）で口を設ける。値は工程名として検査する
emit_human_gates() {
  if [ -n "${humangates:-}" ]; then
    _hg=$(printf '%s' "$humangates" | tr ',' ' ')
    for _h in $_hg; do is_phase "$_h" || die "humanGates に未知の工程: $_h"; done
    printf 'humanGates: [%s]\n' "$(printf '%s' "$_hg" | tr -s ' ' | sed 's/^ *//; s/ *$//; s/ /, /g')"
  else
    printf 'humanGates: []\n'
  fi
}

# --- コマンド: new ------------------------------------------------------------
cmd_new() {
  slug=""; mode=""; profile=""; ticket=""; depends=""; parent=""; backlog=""; backlogitem=""; humangates=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --mode) need_arg "$1" $#; mode=$2; shift 2 ;;
      --profile) need_arg "$1" $#; profile=$2; shift 2 ;;
      --light) profile=light; shift ;;
      --ticket) need_arg "$1" $#; ticket=$2; shift 2 ;;
      --depends) need_arg "$1" $#; depends=$2; shift 2 ;;
      --parent) need_arg "$1" $#; parent=$2; shift 2 ;;
      # `--` を付けないと、値が `-` で始まるとき basename 自身の使い方エラーが
      # `aidev:` 前置なしで漏れる（need_arg を入れた動機と同じ穴）
      --backlog) need_arg "$1" $#; backlog=$(basename -- "$2"); shift 2 ;;
      --backlog-item) need_arg "$1" $#; backlogitem=$2; shift 2 ;;
      --human-gates) need_arg "$1" $#; humangates=$2; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$slug" ] && slug=$1 || die "slug は1つだけ"; shift ;;
    esac
  done
  [ -n "$slug" ] || die "使用法: aidev new <slug> [--mode ..] [--profile ..|--light] [--ticket ..] [--depends ..] [--parent <親work>] [--backlog <file>] [--backlog-item <text>] [--human-gates <list>]"
  # backlog 出自は「消し込み忘れ」を verify で捕まえるための刻印。存在しないファイルを
  # 指したまま進むと deliver 直前まで気づけないので、この場で弾く
  if [ -n "$backlog" ] && [ ! -f "$AIDEV/backlog/$backlog" ]; then
    die "backlog ファイルが無い: .aidev/backlog/$backlog"
  fi
  # 消化済み（todo=0）の backlog から着手できると、status が todo=0 / inflight=1 という自己矛盾を出し、
  # 何を掴んだのかも記録されない。項目を足してから着手する
  if [ -n "$backlog" ] && [ -z "$parent" ]; then
    _bt=$(grep -c '^[[:space:]]*- \[ \]' "$AIDEV/backlog/$backlog" 2>/dev/null || true); _bt=${_bt:-0}
    [ "$_bt" -gt 0 ] || die "backlog に未着手項目がありません（todo=0）: .aidev/backlog/$backlog。項目を足してから着手する"
  fi

  deps_yaml="[]"
  if [ -n "$depends" ]; then
    list=""
    old_ifs=$IFS; IFS=,
    for d in $depends; do
      d=$(printf '%s' "$d" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
      [ -z "$d" ] && continue
      if [ -z "$list" ]; then list="$d"; else list="$list, $d"; fi
    done
    IFS=$old_ifs
    deps_yaml="[$list]"
  fi

  # 子は backlog 出自を持たない設計（出自は親が持つ）。受理して黙って捨てると、
  # 「刻んだつもり」の状態が state に残らないまま進む
  if [ -n "$parent" ] && [ -n "$backlog" ]; then
    die "--parent と --backlog は併用できません（backlog 出自は親 work に刻む）"
  fi
  if [ -n "$parent" ]; then
    # --- subtask 生成: 親 work 配下に <slug>(=NN-subslug) で作る（date prefix なし）。current は tasks 開始 ---
    pdir="$AIDEV/works/$parent"
    [ -d "$pdir" ] || die "親 work が存在しません: $parent"
    [ -f "$pdir/state.yml" ] || die "親 state.yml がありません: $parent"
    # C: 多段ネスト禁止（単層のみ）。親が既に subtask なら拒否（doctor 横断・依存解決・activeSubtask は1段前提）
    [ -n "$(yget "$pdir/state.yml" parent)" ] && die "親が既に subtask です。多段ネストは不可（subtask は単層のみ）: $parent"
    case "$slug" in */*) die "subtask slug にスラッシュは使えません: $slug" ;; esac
    name="$parent/$slug"
    WORK="$AIDEV/works/$name"
    [ -d "$WORK" ] && die "subtask が既に存在します: $name"
    # mode 未指定なら親から継承
    [ -n "$mode" ] || mode=$(yget "$pdir/state.yml" mode)
    [ -n "$mode" ] || mode=interactive
    case "$mode" in interactive|autonomous) ;; *) die "mode は interactive|autonomous" ;; esac
    # profile も mode と同様に親から継承する（省略時）。light 親は本来分割しないが、
    # 継承しておけば「親 light / 子 full」という食い違いが構造的に起きない
    [ -n "$profile" ] || profile=$(yget "$pdir/state.yml" profile)
    [ -n "$profile" ] || profile=full
    case "$profile" in full|light) ;; *) die "profile は full|light" ;; esac
    mkdir -p "$WORK"

    {
      printf 'schema: %s\n' "$CURRENT_SCHEMA"
      printf 'slug: %s\n' "$slug"
      printf 'parent: %s\n' "$parent"
      [ -n "$ticket" ] && printf 'ticket: %s\n' "$ticket"
      printf 'current: tasks\n'
      printf 'approved: []\n'
      printf 'mode: %s\n' "$mode"
      printf 'profile: %s\n' "$profile"
      emit_human_gates
      printf 'maxSendBacks: 3\n'
      printf 'dependsOn: %s\n' "$deps_yaml"
      printf 'harnessRev: %s\n' "$(harness_rev)"

    } > "$WORK/state.yml"
    printf 'events:\n' > "$WORK/metrics.yml"

    # 親 state.yml の subtasks に追記し、activeSubtask が未設定なら本 subtask を活性にする
    pst="$pdir/state.yml"
    cur=$(ylist "$pst" subtasks)
    # 既存の subtasks を保持し、未登録なら slug を末尾に足す（冪等。ps1 の -notcontains と一致）
    plist=""
    for s in $cur; do [ -z "$plist" ] && plist="$s" || plist="$plist, $s"; done
    case " $cur " in *" $slug "*) ;; *) [ -z "$plist" ] && plist="$slug" || plist="$plist, $slug" ;; esac
    set_or_append "$pst" subtasks "subtasks: [$plist]"
    act=$(yget "$pst" activeSubtask)
    if [ -z "$act" ] || [ "$act" = "done" ]; then
      set_or_append "$pst" activeSubtask "activeSubtask: $slug"
      act=$slug
    fi

    # カーソルは**活性の子**に合わせる。無条件に「今作った子」へ動かすと、親 tasks で子を
    # まとめて起こしたとき（30-tasks の手順どおり）activeSubtask=先頭 / current=最後 になり、
    # 「冗長コピー」の定義（protocol.md「6.」）が生成直後から破れる。しかも current の指す先は
    # 兄弟依存で塞がっていることが多く、そのまま工程に入ると exit 3 になる
    printf '%s/%s\n' "$parent" "$act" > "$AIDEV/current"
    printf 'created subtask: %s (parent %s, schema %s, mode %s, profile %s)\n' "$WORK" "$parent" "$CURRENT_SCHEMA" "$mode" "$profile"
    return 0
  fi

  # --- 通常(top-level) work ---
  [ -n "$mode" ] || mode=interactive
  case "$mode" in interactive|autonomous) ;; *) die "mode は interactive|autonomous" ;; esac
  [ -n "$profile" ] || profile=full
  case "$profile" in full|light) ;; *) die "profile は full|light" ;; esac

  date_p=$(date -u +%Y%m%d)
  base="$date_p-$slug"; name="$base"; n=2
  while [ -d "$AIDEV/works/$name" ]; do name="$base-$n"; n=$((n+1)); done
  WORK="$AIDEV/works/$name"
  mkdir -p "$WORK"

  {
    printf 'schema: %s\n' "$CURRENT_SCHEMA"
    printf 'slug: %s\n' "$slug"
    [ -n "$ticket" ] && printf 'ticket: %s\n' "$ticket"
    printf 'current: requirements\n'
    printf 'approved: []\n'
    printf 'mode: %s\n' "$mode"
    printf 'profile: %s\n' "$profile"
    emit_human_gates
    printf 'maxSendBacks: 3\n'
    printf 'dependsOn: %s\n' "$deps_yaml"
    printf 'harnessRev: %s\n' "$(harness_rev)"
    # `[ … ] && printf` にしない（set -eu 下で group の戻り値が 1 になる形を避ける。下の注記と同じ理由）
    if [ -n "$backlog" ]; then printf 'backlog: %s\n' "$backlog"; fi
    # **どの行を掴んだか**。`backlog:` はファイル名までしか持たないので、
    # 並行 N 本が同じファイルの別項目を掴んでいると `inflight` は「3」としか言えず、
    # **どの行が空いているか**を機械が答えられない（実走で 4 体目が完了済みの項目を
    # 選びうる状態になった）。行の文言を刻んで、行単位で見えるようにする
    if [ -n "$backlogitem" ]; then printf 'backlogItem: %s\n' "$backlogitem"; fi
  } > "$WORK/state.yml"

  printf 'events:\n' > "$WORK/metrics.yml"
  printf '%s\n' "$name" > "$AIDEV/current"
  printf 'created: %s (schema %s, mode %s, profile %s)\n' "$WORK" "$CURRENT_SCHEMA" "$mode" "$profile"
  if [ "$profile" = light ]; then
    printf 'note: profile=light。上流3工程は requirements 1ゲートに畳む（protocol.md「11.」）\n'
  fi
  # **選択の帰結を、選択の場に出す**。autonomous を選んだ時点で上流4工程の独立点検が必須になるのに、
  # それは protocol-check.md「(a)」を読まないと分からなかった——付録は「該当する状況のときだけ読む」
  # 建付けなので、**該当条件（autonomous）を選ばせた側が知らせない限り読まれない**（retro が実測）
  if [ "$mode" = autonomous ] && [ "$profile" != light ]; then
    printf 'note: mode=autonomous。上流4工程は独立点検が必須（aidev doccheck start <phase> --mode <delegated|same_session>）\n'
    printf '      人間の目が入らないので、点検の要否を書いた本人の裁量に委ねない。記録が無いと verify が WARN\n'
  fi
  # 注意: ここを `[ -n "$backlog" ] && printf …` と書くと、backlog 未指定時に
  # **関数の戻り値が 1 になる**（末尾コマンドの終了状態がそのまま返る）。
  # worktree add は cmd_new の戻り値を見るので、それだけで add が失敗する
  if [ -n "$backlog" ]; then
    printf 'backlog: %s（deliver で該当行を [x] にすること。verify が検査する）\n' "$backlog"
  fi
}

# --- コマンド: event ----------------------------------------------------------
cmd_event() {
  [ $# -ge 2 ] || die "使用法: aidev event <phase> <start|sent_back> [k=v ...]"
  ph=$1; ev=$2; shift 2
  is_phase "$ph" || die "未知の phase: $ph"
  case "$ev" in
    start|sent_back) ;;
    # `event <phase> approved` は metrics にだけ approved を書き、state.yml の approved は
    # 更新しない。両者が乖離した work は verify も検知できない（イベント対は壊れないため）。
    # approved の記録は approve の役割（state 更新 + イベント追記を一括で行う）
    approved) die "approved は aidev approve <phase> で記録すること（event では state.yml が更新されず、metrics と乖離する）" ;;
    *) die "event は start|sent_back（approved は approve コマンド）" ;;
  esac
  resolve_work
  append_event "$ph" "$ev" "$@"
  printf 'recorded: %s/%s/%s\n' "$SLUG" "$ph" "$ev"
  # 差し戻しの上限到達を**その瞬間に**知らせる。`maxSendBacks` は長らく state.yml に
  # 書かれるだけで**どこも検査していなかった**（散文の第一層のまま）。上限は「止まれ」の合図で、
  # 気付くのが retro や insights では遅い——同じ穴を掘り続けた後になる
  if [ "$ev" = sent_back ]; then
    _esb=$(dbg_sent_backs "$WORK/metrics.yml" "$ph")
    _emax=$(dbg_max_send_backs)
    if [ "$_esb" -ge "$_emax" ] 2>/dev/null; then
      _edr=$(dbg_rounds "$WORK/metrics.yml" "$ph")
      if [ "$_edr" -eq 0 ]; then
        printf 'note: %s の差し戻しが %s 回（上限 %s）。**同じコンテキストで回し続けない** —— \n' "$ph" "$_esb" "$_emax"
        printf '      aidev debug start --phase %s で、新しいコンテキストへ原因究明を委譲すること\n' "$ph"
      fi
    fi
  fi
}

# --- コマンド: approve --------------------------------------------------------
cmd_approve() {
  [ $# -ge 1 ] || die "使用法: aidev approve <phase> [k=v ...]"
  ph=$1; shift
  is_phase "$ph" || die "未知の phase: $ph"
  resolve_work
  st="$WORK/state.yml"
  [ -f "$st" ] || die "state.yml がありません: $SLUG"

  if approved_has "$ph"; then
    : # 既に承認済み（冪等）
  else
    cur=$(ylist "$st" approved)
    if [ -z "$cur" ]; then newl="[$ph]"; else
      list=""
      for p in $cur; do if [ -z "$list" ]; then list="$p"; else list="$list, $p"; fi; done
      newl="[$list, $ph]"
    fi
    replace_line "$st" approved "approved: $newl"
  fi
  replace_line "$st" current "current: $ph"

  # 被覆の刻印（tasks / requirements / review）。**手書きの key=value に任せない**——
  # `harnessRev` や `schema` を new に一本化したのと同じ理由で、手書きの値は忘れられ、
  # 忘れられた work は静かに母集団から漏れる。ここは既存ファイルから機械的に出せる。
  # 刻む工程を3つに絞るのは、「tasks（または light の requirements）で決めた被覆」と
  # 「review 時点の被覆」の**2点**があれば乖離が読めるから（間を刻んでも量が増えるだけ）。
  # tasks.md がまだ無い工程（full の requirements・分割 work の親 tasks）は刻まない。
  # 実施形態は enum。タイポ（deligated 等）を通すと層別が静かに壊れる
  # **手渡しの `*_check_mode` は CLI の記録と突き合わせる**。突き合わせないと、
  # 点検を一度も打たずに `approve <phase> doc_check_mode=delegated` と書くだけで
  # `verify --strict` を通せた（実走で再現）。`protocol.md`「2.10」の
  # 「判定・不変条件は必ず CLI に置く」に反する——**件数と違って真実は CLI 側にある**
  # （`doccheck` / `taskcheck` のイベント）ので、名乗りだけを受け取らない。
  _akmode_doc=no; _akmode_task=no
  for _akv in "$@"; do
    case "$_akv" in
      task_check_mode=*)
        case "${_akv#task_check_mode=}" in
          delegated|same_session|mixed) ;;
          *) die "task_check_mode は delegated|same_session（taskcheck から自動で刻むときは、形態が割れていれば mixed）" ;;
        esac
        _akmode_task=yes ;;
      doc_check_mode=*)
        case "${_akv#doc_check_mode=}" in
          delegated|same_session|mixed) ;;
          *) die "doc_check_mode は delegated|same_session（doccheck から自動で刻むときは、形態が割れていれば mixed）" ;;
        esac
        _akmode_doc=yes ;;
    esac
  done
  if [ "$_akmode_task" = yes ]; then
    tc_totals "$WORK/metrics.yml"
    [ "$TC_TASKS" -gt 0 ] 2>/dev/null \
      || die "task_check_mode を手で渡せません: この work に taskcheck の記録がありません（aidev taskcheck start <task-id> --mode … から打つ。点検していないなら task_checks=0 だけを渡す）"
  fi
  if [ "$_akmode_doc" = yes ]; then
    dc_totals "$WORK/metrics.yml" "$ph"
    [ "$DC_ROUNDS" -gt 0 ] 2>/dev/null \
      || die "doc_check_mode を手で渡せません: $ph に doccheck の記録がありません（aidev doccheck start $ph --mode … から打つ）"
  fi
  # **同じラウンドの刻み直しは「訂正」であって新しいラウンドではない**。
  # 直近の approved のあとに start が無ければ訂正とみなし、`amend=yes` を付けて追記する。
  # 付けないと `verify` の対検査が「start 1 に approved 2」と鳴り、WARN が指示した
  # 直し方（approve を打ち直す）を実行すると別の FAIL に落ちる——出口の無い catch-22 になる。
  # **記録は消さない**（追記のみ）ので、訂正の履歴もそのまま残る。
  _amend=no
  if approved_has "$ph" && [ -f "$WORK/metrics.yml" ]; then
    _lastev=$(grep -n "phase:[[:space:]]*$ph," "$WORK/metrics.yml" 2>/dev/null \
      | grep -E 'event:[[:space:]]*(start|approved)' | tail -n1)
    case "$_lastev" in *"event: approved"*) _amend=yes ;; esac
  fi
  # `coding` の点検メトリクスは `taskcheck` の記録から**自動で刻む**（被覆・harnessRev と同じ理由
  # ——手書きの値は忘れられる／都合よく書かれる）。明示指定があればそちらを尊重する。
  # taskcheck を1回も打っていない work は刻まない（0 と書くと「点検していない」と
  # 「点検して 0 件」が区別できなくなる。従来どおり手で `task_checks=0` を渡す）
  if [ "$ph" = coding ]; then
    _tchas=no
    for _akv in "$@"; do case "$_akv" in task_checks=*|task_check_findings=*|task_check_mode=*) _tchas=yes ;; esac; done
    if [ "$_tchas" = no ]; then
      tc_totals "$WORK/metrics.yml"
      if [ "$TC_TASKS" -gt 0 ] 2>/dev/null; then
        set -- "$@" "task_checks=$TC_TASKS" "task_check_findings=$TC_FINDINGS"
        [ -n "$TC_MODE" ] && set -- "$@" "task_check_mode=$TC_MODE"
      fi
    fi
  fi
  # **remote が無い環境では `review.md` に「PR レビュー（人間）」節が生まれない**。
  # `protocol-autonomous.md` は「insights はその旨を明記する」と定めるが、
  # **その事実を機械が拾う印が state にも metrics にも無かった**（他 PJ の retro が実測）。
  # 人間由来の判定材料が 1 件も無い work を、insights が層別できるようにする。
  # **`append_event` より前**で足すこと——deliver 後のブロックで set -- しても刻まれない
  if [ "$ph" = deliver ] && command -v git >/dev/null 2>&1 \
     && [ -z "$(git -C "$ROOT" remote 2>/dev/null)" ]; then
    _hasrem=no
    for _akv in "$@"; do case "$_akv" in remote=*) _hasrem=yes ;; esac; done
    if [ "$_hasrem" = no ]; then set -- "$@" "remote=none"; fi
  fi
  # 上流4工程の点検メトリクスも `doccheck` の記録から自動で刻む（coding と同じ理由）
  if dc_valid_phase "$ph"; then
    _dchas=no
    for _akv in "$@"; do case "$_akv" in doc_check_rounds=*|doc_check_findings=*|doc_check_mode=*) _dchas=yes ;; esac; done
    if [ "$_dchas" = no ]; then
      dc_totals "$WORK/metrics.yml" "$ph"
      if [ "$DC_ROUNDS" -gt 0 ] 2>/dev/null; then
        set -- "$@" "doc_check_rounds=$DC_ROUNDS" "doc_check_findings=$DC_FINDINGS"
        [ -n "$DC_MODE" ] && set -- "$@" "doc_check_mode=$DC_MODE"
      fi
    fi
  fi
  case "$ph" in
    tasks|requirements|review)
      # 明示指定があれば尊重する（機械値で上書きしない）。判定は**引数ごとの先頭一致**——
      # 全引数を連結した文字列に部分一致を掛けると、`note=see ac_total=5` のような値でも
      # 分岐が変わり、ps1 側（先頭一致）と食い違う
      _achas=no
      for _akv in "$@"; do case "$_akv" in ac_total=*) _achas=yes ;; esac; done
      # 分割 work の subtask では刻まない。被覆は**家族単位**（親＋全 subtask）の値なので、
      # 子ごとに刻むと `metrics --all` を足し上げたとき分母が subtask 数だけ多重計上される
      if [ "$_achas" = no ] && [ -z "$(yget "$WORK/state.yml" parent)" ] && cov_analyze; then
        set -- "$@" "ac_total=$COV_AC" "ac_covered=$COV_TASK" \
                    "tasks_no_ac=$COV_TASKS_NOAC" "tasks_ac_none=$COV_TASKS_ACNONE"
      fi ;;
  esac
  if [ "$_amend" = yes ]; then append_event "$ph" approved "$@" amend=yes
  else append_event "$ph" approved "$@"; fi
  printf 'approved: %s @ %s\n' "$ph" "$SLUG"

  # deliver 時のハーネス版も刻む。new 時と食い違う work は**改修をまたいで走った**ので、
  # 前半を旧版・後半を新版で回している。どちらかに帰属させると効果が薄まるため、
  # 効果検証の母集団からは除外する（判定は insights、検知は verify の WARN）。
  if [ "$ph" = deliver ]; then
    _hr=$(harness_rev)
    set_or_append "$st" harnessRevDelivered "harnessRevDelivered: $_hr"
    _hr0=$(hr_get "$st")
    if [ -n "$_hr0" ] && [ "$_hr0" != "$_hr" ] && [ "$_hr0" != unknown ] && [ "$_hr" != unknown ]; then
      printf 'note: ハーネス版が着手時(%s)と着地時(%s)で異なる＝またがり work。効果検証の母集団からは除外される\n' "$_hr0" "$_hr"
    fi
    # この deliver で母集団が揃った条項があれば、その場で知らせる（下の cv_ready_notice の注記参照）
    cv_ready_notice
    hv_ready_notice
  fi


  # D: subtask の review 承認でカーソルを前進させる（散文の手動カーソル操作を排除）。
  # 親 subtasks を順に見て review 未承認の最初の子を次の active にする。無ければ done（→親の統合 test へ）。
  if [ "$ph" = review ]; then
    par=$(yget "$st" parent)
    if [ -n "$par" ] && [ -d "$AIDEV/works/$par" ]; then
      pst="$AIDEV/works/$par/state.yml"
      nextsub=""
      for s in $(ylist "$pst" subtasks); do
        sap=$(ylist "$AIDEV/works/$par/$s/state.yml" approved)
        case " $sap " in *" review "*) ;; *) nextsub="$s"; break ;; esac
      done
      if [ -n "$nextsub" ]; then
        set_or_append "$pst" activeSubtask "activeSubtask: $nextsub"
        printf '%s\n' "$par/$nextsub" > "$AIDEV/current"
        printf 'cursor: activeSubtask=%s（次の subtask へ自動前進）\n' "$nextsub"
      else
        set_or_append "$pst" activeSubtask "activeSubtask: done"
        printf '%s\n' "$par" > "$AIDEV/current"
        printf 'cursor: 全 subtask 完了 → activeSubtask=done。親 %s の統合 test へ\n' "$par"
      fi
    fi
  fi
}

# --- コマンド: guard ----------------------------------------------------------
# subtask は上流成果物(requirements/design/architecture)のみ親から継承する。tasks.md は subtask 固有なので継承しない。
need_file() {
  [ -f "$WORK/$1" ] && return 0
  case "$1" in
    requirements.md|design.md|architecture.md) [ -n "${PARENT_DIR:-}" ] && [ -f "$PARENT_DIR/$1" ] && return 0 ;;
  esac
  GMISS="$GMISS $1"; return 1
}
need_approved(){ approved_has "$1" || { GUNAPP="$GUNAPP $1"; return 1; }; return 0; }

# 依存(dependsOn)の充足を読み取り専用で評価（state は変更しない）。
# 結果を EVAL_UNMET（works 由来の未充足・exit に影響）/ EVAL_ADVISORY（外部チケット #N の生トークン）に格納。
eval_depends() { # work_dir
  _wd=$1
  EVAL_UNMET=""; EVAL_ADVISORY=""
  deps=$(ylist "$_wd/state.yml" dependsOn)
  # subtask は同一親配下の兄弟 subtask を bare 名（NN-subslug）で依存指定できる。
  _par=$(yget "$_wd/state.yml" parent)
  for d in $deps; do
    [ -z "$d" ] && continue
    case "$d" in
      \#*) # 外部チケット(#N): 自動判定不可＝advisory（手動確認）
        EVAL_ADVISORY="$EVAL_ADVISORY $d" ;;
      *) # works slug は日付/連番で始まる。英字始まり+数字終わり（PROJ-123 型）は外部チケット＝advisory
        if printf '%s' "$d" | grep -Eq '^[A-Za-z][A-Za-z0-9_]*-[0-9]+$'; then
          EVAL_ADVISORY="$EVAL_ADVISORY $d"; continue
        fi
        # それ以外は works slug とみなす。top-level に無く親配下にあれば兄弟 subtask として解決
        _dep="$AIDEV/works/$d"
        if [ ! -d "$_dep" ] && [ -n "$_par" ] && [ -d "$AIDEV/works/$_par/$d" ]; then
          _dep="$AIDEV/works/$_par/$d"
        fi
        if [ -d "$_dep" ]; then
          da=$(ylist "$_dep/state.yml" approved)
          # 完了判定: subtask(=parent あり)は review 承認、top-level work は deliver 承認
          if [ -n "$(yget "$_dep/state.yml" parent)" ]; then
            printf '%s' "$da" | grep -qw review || EVAL_UNMET="$EVAL_UNMET $d(未review)"
          else
            printf '%s' "$da" | grep -qw deliver || EVAL_UNMET="$EVAL_UNMET $d(未deliver)"
          fi
        else
          EVAL_UNMET="$EVAL_UNMET $d(work不明)"
        fi ;;
    esac
  done
}

check_depends() {
  eval_depends "$WORK"
  GDEP=$EVAL_UNMET
  for a in $EVAL_ADVISORY; do
    warn "依存(外部チケット $a): 自動判定不可＝advisory（手動確認）"
  done
}

cmd_guard() {
  [ $# -ge 1 ] || die "使用法: aidev guard <phase>"
  ph=$1
  # **余分な引数を黙って捨てない**。`taskcheck` / `doccheck` / `debug` が `--slug` を取るので、
  # その癖のまま `aidev guard design --slug X` と打てる。捨てていた頃は
  # **`.aidev/current` の別 work に対して緑を返していた**——工程入口の硬ゲートが
  # 打ち間違いを黙って通す形（実走で実測）。`verify --bogus` は既に exit 1 で弾いている
  shift
  [ $# -eq 0 ] || die "guard は phase 以外の引数を取りません: $* （対象 work は .aidev/current。切り替えは aidev use）"
  is_phase "$ph" || die "未知の phase: $ph"
  resolve_work
  GMISS=""; GUNAPP=""
  # subtask なら上流成果物の継承元として親 work dir を立てる（need_file の fallback）
  PARENT_DIR=""
  _par=$(yget "$WORK/state.yml" parent)
  [ -n "$_par" ] && [ -d "$AIDEV/works/$_par" ] && PARENT_DIR="$AIDEV/works/$_par"
  # B: 親専用工程は subtask で実行不可（subtask の工程は tasks/coding/test/review のみ）
  if [ -n "$_par" ]; then
    case "$ph" in
      requirements|research|design|architecture|walkthrough|deliver|retro)
        printf 'NG %s は親 work 専用です（subtask では実行不可。subtask の工程は tasks/coding/test/review）: %s\n' "$ph" "$SLUG" >&2
        return 2 ;;
    esac
  fi
  case "$ph" in
    requirements) : ;;
    research|design) need_file requirements.md || : ;;
    architecture) need_file design.md || : ;;
    tasks) need_file design.md || : ;;  # tasks.md は tasks の産物なので前提にしない
    coding) need_file tasks.md || : ;;
    # 分割 work の親は tasks.md を持たない（各 subtask の tasks が作る。aidev-30-tasks「4.」）。
    # ここを一律に要求すると、書いてあるとおりに tasks を書いた親の統合 test が必ず塞がる。
    # 親の前提は「tasks.md があり、全 subtask が review 承認済み」
    test)
      if [ -n "$(ylist "$WORK/state.yml" subtasks)" ]; then
        need_file tasks.md || :
        for _s in $(ylist "$WORK/state.yml" subtasks); do
          case " $(ylist "$WORK/$_s/state.yml" approved) " in
            *" review "*) ;;
            *) GMISS="$GMISS $_s(未review)" ;;
          esac
        done
      else
        need_file tasks.md || :
      fi ;;
    # 60-review の前提「test 工程を通過していること」に経路を与える。
    # 宣言だけで検査が無いと、protocol.md「2.」の「前提工程の承認を機械的に検査する」が嘘になる
    review) need_file design.md || : ; need_approved test || : ;;
    walkthrough|deliver) need_approved review || : ;;
    retro) need_approved deliver || : ;;
  esac
  check_depends

  rc=0
  if [ -n "$GMISS" ]; then printf 'NG 前提成果物が不足:%s\n' "$GMISS" >&2; rc=2; fi
  if [ -n "$GUNAPP" ]; then printf 'NG 前提工程が未承認:%s\n' "$GUNAPP" >&2; rc=2; fi
  if [ -n "$GDEP" ]; then printf 'NG 依存(dependsOn)が未充足:%s\n' "$GDEP" >&2; [ $rc -eq 0 ] && rc=3; fi
  if [ $rc -eq 0 ]; then
    printf 'OK guard %s @ %s\n' "$ph" "$SLUG"
    # guard は「入ってよいか」の判定で、start の記録は別コマンド。
    # 分かれているため記録を忘れる事故が実際に起きた（review の start が両ラウンドとも欠落）。
    # start を自動記録はしない（skill 側の event start と二重になり、手戻り回数を
    # 誤って数えるため）。代わりに、まだ必要な場合だけ促す。
    if needs_start "$ph"; then
      printf '   → 忘れずに: aidev event %s start\n' "$ph"
    fi
    # **plan モードが使える工程でだけ、名指しで促す**。散文（`protocol-autonomous.md`）に
    # 「この条件なら入れ」と書いてあっても、**打つ側は工程に入る瞬間には思い出さない**
    # ——`event start` の促しと同じ型で、CLI が散文を肩代わりする。
    # **「方針の合意を取る」のような役割だけの言い方にはしない**——それだと丁寧に計画するだけで
    # **モードは切り替わらない**。plan モードへ入るには明示の命令が要る（`EnterPlanMode` は
    # 主エージェントが持つツールで、定義自身が「proactively 使え」と言っている）。
    # 「plan モード」は Cursor / Copilot にもある**横断的な概念名**で、`Stop` フックや
    # `AskUserQuestion` のような製品固有 API 名とは別物なので、`protocol.md`「2.5」に抵触しない。
    # 持たない環境でのフォールバックは `aidev-docs/README.md` の表。
    # 条件は散文と同じ **`light` でない design / architecture / tasks で、その工程に承認者がいるとき**
    # （subtask の tasks は除く）。ここに至るまで**分類を 4 回発明して 4 回とも外した**（`DESIGN`「2.」）。
    # 正解は **`ExitPlanMode` の用途規定**——「planning the **implementation steps** of a task that
    # requires writing code」。**承認を出すのはこのツールだけ**なので、ここが実質の資格条件。
    # `EnterPlanMode`（入口）の WHEN TO USE を基準にしていた頃は `requirements` が入っていたが、
    # **出口の制約を見ていなかった**。`requirements`（何を・なぜ）は実装計画ではない。
    # `light` は往復を減らす趣旨に反する。承認者の有無で見るのは、**plan モードを抜けるのが
    # 人間の承認だから**——`autonomous` を一律で外すと `humanGates` の部分自律を取りこぼす。
    # 条件を外すと「使ってはいけない工程で勧める」ことになる
    _pmsub=no
    case "$ph" in tasks) [ -n "$(yget "$WORK/state.yml" parent)" ] && _pmsub=yes ;; esac
    case "$ph" in
      design|architecture|tasks)
        if [ "$_pmsub" = no ] && [ "$(yget "$WORK/state.yml" profile)" != light ] \
           && has_approver "$ph"; then
          printf '   → 有力案が複数あるなら **plan モードへ入ってから** 書く（承認を取り、解除してから成果物を書く）\n'
          printf '      抜けた先は承認時に選んだモードで、元のモードには戻らない（protocol-autonomous.md）\n'
        fi ;;
    esac
  fi
  return $rc
}

# その工程に新しい start の記録が要るか（start 回数 <= approved 回数なら要る）。
needs_start() { # phase
  [ -f "$WORK/metrics.yml" ] || return 0
  awk -v p="$1" '
    match($0, /phase:[[:space:]]*[a-z]+/) {
      ph = substr($0, RSTART, RLENGTH); sub(/phase:[[:space:]]*/, "", ph)
      if (ph != p) next
      if ($0 ~ /event:[[:space:]]*start/)    s++
      if ($0 ~ /event:[[:space:]]*approved/) a++
    }
    END { exit (s <= a) ? 0 : 1 }
  ' "$WORK/metrics.yml"
}

# --- AC カバレッジ / tasks.md の整合 ------------------------------------------
# 出所: spec-kit の `/analyze` が出す `Coverage % (requirements with >=1 task)`。
# aidev には「受け入れ基準(AC)が1件もタスクに落ちていない」を機械的に見る手段が無く、
# tasks の完了の目安「design の全範囲が tasks に漏れなく落ちている」は目視に委ねられていた。
# 同じ理由で、`aidev-30-tasks` が散文で要求している「存在しないタスク ID を指していない・
# 循環していない」も誰も検査していなかった（散文=ソフト層のまま）。ここでハード層に上げる。
#
# 対応付けの正典は tasks.md の `AC:` 行（`対象:` `依存:` と同じ継続行の形）。
# 本文（AC の文言）は requirements.md にしか置かない——ID で参照するだけなので二重管理にならない。

# ID の文法（sh/ps1 で同一。ここが唯一の定義）。
#   AC: `AC` の直後は**数字か `-`**（`AC1` `AC12` `AC-I1`）。`ACL` `ACCESS` のように
#       英字が続くものは AC ではない——これを許すと「見出しでも本文でもない普通の
#       チェックリスト行」が受け入れ基準として数えられ、消せない gap になる。
#   T : `T` の直後は数字。以降は英数と `-` `_` を許す（`T1` `T10` `T1-1`）。
#       `T[0-9]+` で切ると `T1-1` が `T1` に潰れ、**正しく書かれた依存が壊れた参照になる**。
COV_AC_RE='AC([0-9][A-Za-z0-9_]*|-[A-Za-z0-9][A-Za-z0-9_-]*)'
COV_T_RE='T[0-9][A-Za-z0-9_-]*'
# 「無い」を表す綴り（`AC:` `依存:` 共通）。ここに無い綴りは値として扱われる。
COV_NONE='なし none None NONE -'

# **空白は ASCII だけを空白として扱う**（`[ \t]`。`[[:space:]]` を使わない）。
# POSIX の空白クラスは**ロケール依存**で、UTF-8 ロケールの gawk は全角スペース(U+3000)を
# 空白とみなし、バイト志向の mawk はみなさない。ps1 の `\s`（.NET・Unicode）とも食い違う。
# 全角スペースで字下げした tasks.md が「実装 × ロケール」の組でだけ通る、という形になるので、
# **範囲の狭い側（ASCII）に全実装を揃える**（CI の gawk で発覚）。
#
# 入力行の正規化: BOM と行末 CR を落とす。
# **CR を落とさないと OS で判定が割れる**——ps1 の `ReadAllLines` は CRLF も BOM も自動で外すため、
# Windows でチェックアウトした tasks.md が Linux では `AC1\r` を未定義参照として FAIL、
# Windows では OK になる（deliver 前ゲートが OS で反転する）。この CLI の既存パーサ
# （`yget` の行末除去、`bl_done_has`）は元から CR 耐性があり、ここだけ規約から外れていた。
cov_lines() { # file
  [ -f "$1" ] || return 0
  awk -v bom="$(printf '\357\273\277')" '
    NR == 1 { sub("^" bom, "") }
    { sub(/\r$/, ""); print }
  ' "$1"
}

# 行頭パターンに続く AC の ID を1行1件で出す。
# requirements 側（`- [ ] AC1: …`）と design 側（`- AC1: …`）で**同じ ID 文法**を使う。
# 片方だけ「ID の直後にコロンが要る」にすると、`- [ ] AC-I1 開く / 閉じる:` という
# テンプレートどおりの相互作用 AC が design 側で永久に拾えなくなる。
#
# **行頭パターンを `-v` で渡さない**。awk は `-v` の値にもエスケープ処理をかけるが、
# その扱いが実装で割れる——mawk は `\[` をそのまま残し、gawk は `[` に潰して警告を出す。
# 潰れると `- \[[ xX]\]` が `- [[ xX]]`（角括弧式）に化けてチェックボックス行に当たらなくなり、
# **受け入れ基準が1件も取れなくなる**（CI の gawk で 57 件落ちて発覚。mawk の開発機では緑だった）。
# 正規表現リテラルとしてプログラム中に書けば、この差は出ない。
cov_req_acs() { # file
  cov_lines "$1" | awk -v idre="$COV_AC_RE" '
    match($0, /^[ \t]*- \[[ xX]\][ \t]*/) == 1 {
      s = substr($0, RLENGTH + 1)
      if (match(s, "^" idre) != 1) next
      print substr(s, 1, RLENGTH)
    }'
}
cov_spec_acs() { # file
  cov_lines "$1" | awk -v idre="$COV_AC_RE" '
    match($0, /^[ \t]*- /) == 1 {
      s = substr($0, RLENGTH + 1)
      if (match(s, "^" idre) != 1) next
      print substr(s, 1, RLENGTH)
    }'
}

# tasks.md を1タスク1行の TSV に畳む: "TID<TAB>AC参照<TAB>依存"
# 欄の値は3状態ある。`-`=その行が無い / 空=行はあるが値が空 / それ以外=値。
# 「書き忘れ」と「空で書いた」を潰すと、指摘の文言が実態と食い違う。
cov_task_rows() { # tasks.md
  cov_lines "$1" | awk -v tre="$COV_T_RE" '
    # 多バイト文字を**角括弧式に入れない**。awk/sed の角括弧式はバイト単位なので、
    # `[,、]` は「、」の構成バイト(E3 80 81)を1バイトずつ候補にしてしまい、
    # 同じ先頭バイトを持つ「なし」(E3 81 AA …) を空白に割ってしまう（実際に壊れた）。
    # 全角は必ず**リテラル1つ**として gsub/sub に渡す。
    function norm(s) {
      sub(/^：/, "", s); sub(/^:/, "", s)
      gsub(/、/, " ", s); gsub(/,/, " ", s)
      gsub(/[ \t]+/, " ", s)
      sub(/^ /, "", s); sub(/ $/, "", s)
      return s
    }
    function flush() {
      if (cur == "") return
      printf "%s\t%s\t%s\n", cur, (hasac ? acs : "-"), (hasdp ? dps : "-")
    }
    { s = $0 }
    match(s, "^[ \t]*- \\[[ xX]\\][ \t]*") == 1 {
      t = substr(s, RLENGTH + 1)
      if (match(t, "^" tre) == 1) {
        flush()
        cur = substr(t, 1, RLENGTH); acs = ""; dps = ""; hasac = 0; hasdp = 0
        next
      }
    }
    cur != "" && /^[ \t]*AC(:|：)/ {
      v = norm(substr(s, index(s, "AC") + 2))
      acs = (acs == "" ? v : acs " " v); hasac = 1; next
    }
    cur != "" && /^[ \t]*依存(:|：)/ {
      v = norm(substr(s, index(s, "依存") + length("依存")))
      dps = (dps == "" ? v : dps " " v); hasdp = 1; next
    }
    END { flush() }
  '
}

# 「無い」を表す値か（書式ゆれを1箇所に閉じ込める）
cov_is_none() {
  case " $COV_NONE " in *" $1 "*) return 0 ;; esac
  [ -z "$1" ] && return 0
  return 1
}

# 依存の循環を検出する（Kahn 法で剥がし切れなかったタスクを出す）。
# 入力は TSV。出力は循環に含まれるタスク ID をカンマ区切りで1行（無ければ無出力）。
cov_cycles() {
  awk -F'\t' '
    { id = $1; ids[++n] = id; exists[id] = 1; dep[id] = $3 }
    END {
      for (i = 1; i <= n; i++) {
        id = ids[i]; c = 0; m = split(dep[id], d, " ")
        for (j = 1; j <= m; j++) if (d[j] != id && (d[j] in exists)) { c++; rev[d[j]] = rev[d[j]] " " id }
        indeg[id] = c
      }
      removed = 0; changed = 1
      while (changed) {
        changed = 0
        for (i = 1; i <= n; i++) {
          id = ids[i]
          if (!done[id] && indeg[id] == 0) {
            done[id] = 1; removed++; changed = 1
            m = split(rev[id], r, " ")
            for (j = 1; j <= m; j++) if (r[j] != "") indeg[r[j]]--
          }
        }
      }
      if (removed < n) {
        s = ""
        for (i = 1; i <= n; i++) if (!done[ids[i]]) s = s (s == "" ? "" : ",") ids[i]
        print s
      }
    }'
}

# 不整合を1件積む。**標準出力に直接書かない**——呼び側が `$(...)` で受けるとサブシェルになり、
# 同じ関数が設定する COV_* の集計が呼び側に届かなくなる。
# 第1引数は種別: struct=書式・参照の壊れ（機械的に誤り）/ cover=被覆の穴（人の判断が要る）。
# verify はこの2つを違う強さで扱う（struct=FAIL / cover=WARN）ので、数え分けておく。
cov_gap() { _k=$1; shift
  COV_GAPLINES="${COV_GAPLINES}  gap: $*
"; COV_GAPS=$((COV_GAPS+1))
  case "$_k" in struct) COV_GAPS_S=$((COV_GAPS_S+1)) ;; *) COV_GAPS_C=$((COV_GAPS_C+1)) ;; esac
}

# 被覆は **work 全体（親＋全 subtask）** で見る。
# subtask は親の requirements.md を継承するので、自分の slice だけを見ると
# 兄弟が担当する AC が必ず「タスクが無い」になり、**誰にも直せない gap** が恒久的に残る
# （`DESIGN.md`「12.」の「直せない事実を毎回混ぜると、直せる WARN が埋もれる」に反する）。
# 着地するのは親1本の PR なので、被覆の単位も親1本に揃えるのが正しい。
cov_root() { # -> 家族の根の work ディレクトリ
  _cp=$(yget "$WORK/state.yml" parent)
  if [ -n "$_cp" ] && [ -d "$AIDEV/works/$_cp" ]; then printf '%s' "$AIDEV/works/$_cp"
  else printf '%s' "$WORK"; fi
}

# 検査本体。WORK/SLUG 解決済みが前提。**現在のシェルで呼ぶこと**（結果は COV_* に入る）。
# 戻り値: 0=tasks.md を見られた / 1=どこにも tasks.md が無く検査対象外
cov_analyze() {
  COV_AC=0; COV_SPEC=0; COV_TASK=0; COV_ROWS=""; COV_GAPS=0; COV_GAPS_S=0; COV_GAPS_C=0
  COV_GAPLINES=""; COV_TASKS=0; COV_TASKS_NOAC=0; COV_TASKS_ACNONE=0; COV_PENDING=no
  _cvr0=$(cov_root)

  # 走査するタスク表を集める（"prefix<TAB>path"）。親自身 → 各 subtask の順。
  _cvfiles=""
  [ -f "$_cvr0/tasks.md" ] && _cvfiles="	$_cvr0/tasks.md
"
  for _sd in "$_cvr0"/*/; do
    [ -d "$_sd" ] || continue
    [ -f "${_sd}state.yml" ] || continue
    _sn=$(basename "${_sd%/}")
    if [ -f "${_sd}tasks.md" ]; then _cvfiles="${_cvfiles}${_sn}/	${_sd}tasks.md
"
    else COV_PENDING=yes; fi   # tasks 未実施の subtask がある＝被覆はまだ完成しない
  done
  [ -n "$_cvfiles" ] || return 1

  # `AC: *` のような値が cwd のファイル名に展開されるのを防ぐ（gap 件数が cwd 依存になる）
  case $- in *f*) _cvglob=off ;; *) _cvglob=on ;; esac
  set -f

  _acs=$(cov_req_acs "$_cvr0/requirements.md" | awk '!seen[$0]++')
  _sacs=" $(cov_spec_acs "$_cvr0/design.md" | awk '!seen[$0]++' | tr '\n' ' ') "

  # 行を集める（子の ID には subslug を前置し、兄弟間の T1 衝突を避ける）
  _rows=""
  _oldifs=$IFS
  IFS='
'
  for _fl in $_cvfiles; do
    [ -n "$_fl" ] || continue
    _pfx=${_fl%%	*}; _fp=${_fl#*	}
    _rows="${_rows}$(cov_task_rows "$_fp" | awk -F'\t' -v p="$_pfx" -v none="$COV_NONE" '
      BEGIN { nn = split(none, nl, " "); for (i = 1; i <= nn; i++) isnone[nl[i]] = 1 }
      { dd = $3
        if (dd != "-" && dd != "") {
          m = split(dd, d, " "); dd = ""
          for (i = 1; i <= m; i++) if (d[i] != "")
            dd = dd (dd == "" ? "" : " ") ((d[i] in isnone) ? d[i] : p d[i])
        }
        printf "%s%s\t%s\t%s\n", p, $1, $2, dd }')
"
  done
  IFS=$_oldifs

  # タスク側の走査（AC 行の欠落・未定義 AC 参照・未定義依存・自己依存・ID 重複）
  _defined=" $(printf '%s\n' "$_acs" | tr '\n' ' ') "
  _tids=" $(printf '%s\n' "$_rows" | cut -f1 | tr '\n' ' ') "
  _seen=" "
  _pairs=""   # "AC<TAB>TID" の集合
  IFS='
'
  for _r in $_rows; do
    [ -n "$_r" ] || continue
    _tid=$(printf '%s' "$_r" | cut -f1)
    _tac=$(printf '%s' "$_r" | cut -f2)
    _tdp=$(printf '%s' "$_r" | cut -f3)
    COV_TASKS=$((COV_TASKS+1))
    case "$_seen" in
      *" $_tid "*) cov_gap struct "タスク ID が重複している: $_tid" ;;
      *) _seen="$_seen$_tid " ;;
    esac
    if [ "$_tac" = "-" ]; then
      COV_TASKS_NOAC=$((COV_TASKS_NOAC+1))
      cov_gap cover "$_tid に AC 行が無い（対応する AC が無いなら \`AC: なし\` と明示する）"
    elif [ -z "$_tac" ]; then
      COV_TASKS_NOAC=$((COV_TASKS_NOAC+1))
      cov_gap cover "$_tid の AC 行が空（対応する AC が無いなら \`AC: なし\` と明示する）"
    elif cov_is_none "$_tac"; then
      # 明示的に「対応する AC が無い」と書かれたタスク。書き忘れ（上）とは別に数える——
      # **受け入れ基準に紐づかない作業の割合**は、スコープクリープか要件の書き漏れの目印になる。
      COV_TASKS_ACNONE=$((COV_TASKS_ACNONE+1))
    else
      IFS=' '
      _acseen=" "
      for _a in $_tac; do
        cov_is_none "$_a" && continue
        case "$_acseen" in *" $_a "*) continue ;; *) _acseen="$_acseen$_a " ;; esac
        case "$_defined" in
          *" $_a "*) _pairs="$_pairs$_a	$_tid
" ;;
          *) cov_gap struct "$_tid が未定義の AC を参照: $_a" ;;
        esac
      done
      IFS='
'
    fi
    if [ "$_tdp" != "-" ] && ! cov_is_none "$_tdp"; then
      IFS=' '
      for _d in $_tdp; do
        cov_is_none "$_d" && continue
        if [ "$_d" = "$_tid" ]; then
          cov_gap struct "$_tid が自分自身に依存している"
          continue
        fi
        case "$_tids" in
          *" $_d "*) ;;
          *) cov_gap struct "$_tid の 依存 が未定義のタスクを指す: $_d" ;;
        esac
      done
      IFS='
'
    fi
  done
  IFS=$_oldifs

  _cyc=$(printf '%s\n' "$_rows" | cov_cycles)
  if [ -n "$_cyc" ]; then
    cov_gap struct "依存の循環に含まれるタスク: $_cyc"
  fi

  # AC 側の走査（design 対応・タスク対応）
  for _a in $_acs; do
    [ -n "$_a" ] || continue
    COV_AC=$((COV_AC+1))
    case "$_sacs" in *" $_a "*) _sp=yes; COV_SPEC=$((COV_SPEC+1)) ;; *) _sp=no ;; esac
    _ts=$(printf '%s' "$_pairs" | awk -F'\t' -v a="$_a" '$1==a{printf "%s%s", (n++?",":""), $2}')
    if [ -n "$_ts" ]; then COV_TASK=$((COV_TASK+1)); else
      _ts="-"
      cov_gap cover "$_a に対応するタスクが無い"
    fi
    COV_ROWS="${COV_ROWS}${_a}	${_sp}	${_ts}
"
  done
  # 受け入れ基準が1件も無いのは「被覆 100%」ではなく**測れていない**。ここを素通りさせると、
  # ID を書かなかった work（と light の1ゲート）で、唯一の機械的な歯止めが空振りする。
  if [ "$COV_AC" -eq 0 ]; then
    cov_gap cover "requirements.md に受け入れ基準が1件もありません（\`- [ ] AC1: …\` の形で書きます）"
  fi

  if [ "$_cvglob" = on ]; then set +f; fi
  return 0
}

cov_pct() { # 分子 分母
  [ "$2" -gt 0 ] 2>/dev/null || { printf '0'; return; }
  printf '%s' $(( $1 * 100 / $2 ))
}

# --strict / verify が cover を致命扱いしてよいか。
# tasks 未実施の subtask が残っている間は「まだ埋まっていない」だけなので、致命にしない
# （最初の subtask の tasks が、兄弟の担当ぶんまで背負って通らなくなる）。
cov_cover_enforced() { [ "$COV_PENDING" = no ]; }

cmd_coverage() {
  fmt=table; STRICTC=no; cslug=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --format) need_arg "$1" $#; fmt=$2; shift 2 ;;
      --strict) STRICTC=yes; shift ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$cslug" ] && cslug=$1 || die "slug は1つだけ"; shift ;;
    esac
  done
  case "$fmt" in table|tsv) ;; *) die "--format は table|tsv" ;; esac
  resolve_work "$cslug"
  # 読み取り専用コマンドなので、対象がまだ無い状態は**正常な空**として 0 で返す
  # （`convention status` と同じ扱い。tasks 前に打たれてエラー経路を踏ませない）
  if ! cov_analyze; then
    printf 'coverage: %s\n' "$SLUG"
    printf 'note: tasks.md がまだありません（tasks 工程で作られます）\n'
    return 0
  fi
  printf 'coverage: %s\n' "$SLUG"
  if [ "$fmt" = tsv ]; then
    printf '%s' "$COV_ROWS"
  else
    { printf 'ac	design	tasks\n'; printf '%s' "$COV_ROWS"; } | fmt_table
  fi
  if [ -n "$COV_GAPLINES" ]; then printf '%s' "$COV_GAPLINES"; fi
  printf 'coverage-summary: ac=%s design=%s/%s(%s%%) tasks=%s/%s(%s%%) task_rows=%s no_ac=%s ac_none=%s gaps=%s\n' \
    "$COV_AC" "$COV_SPEC" "$COV_AC" "$(cov_pct "$COV_SPEC" "$COV_AC")" \
    "$COV_TASK" "$COV_AC" "$(cov_pct "$COV_TASK" "$COV_AC")" \
    "$COV_TASKS" "$COV_TASKS_NOAC" "$COV_TASKS_ACNONE" "$COV_GAPS"
  printf 'coverage-gaps: struct=%s cover=%s\n' "$COV_GAPS_S" "$COV_GAPS_C"
  if ! cov_cover_enforced; then
    printf 'note: tasks 未実施の subtask があります。cover の gap は全 subtask の tasks が済むまで致命にしません\n'
  fi
  if [ "$STRICTC" = yes ]; then
    _cvfail=$COV_GAPS_S
    if cov_cover_enforced; then _cvfail=$((_cvfail + COV_GAPS_C)); fi
    if [ "$_cvfail" -gt 0 ]; then
      printf 'FAIL(strict) 未解消の gap が %s 件あります\n' "$_cvfail"
      return 4
    fi
  fi
  return 0
}

# --- コマンド: debug（詰まったときの原因究明を有限化する） ------------------------
# 出所: cc-sdd の `kiro-impl` が持つ debug subagent。発火は「BLOCKED / NEEDS_CONTEXT 未解決 /
# レビュアーが2ラウンド連続で REJECTED」で、要点は **fresh context** ——
#   "The debug subagent runs in a fresh context — it receives only the error information,
#    not the failed implementation history. This avoids the context pollution that causes
#    infinite retry loops."
# 失敗した試行の履歴を渡さない。渡すと同じ穴を掘り続ける。
#
# aidev はループの上限（`maxSendBacks`・`maxTaskCheckRounds`）は持っていたが、
# **上限に達したときにやることが「decisions.md に残して次へ」だけ**で、
# 「同じコンテキストが同じ失敗を繰り返している」状態を断ち切る手が無かった。
# しかも `maxSendBacks` は `new` が書き込むだけで**どこも検査していなかった**（散文の第一層のまま）。
#
# CLI の役割は3つに絞る（委譲そのものは環境依存なので CLI にはできない）:
#   1. 発火を見逃さない（`event sent_back` が上限到達をその場で知らせる）
#   2. ラウンドを数えて**有限化**する（`maxDebugRounds`、既定 2）
#   3. 返却を構造で受け、**上限に達したのに何もせず着地した work** を verify が捕まえる
# 手順・渡すもの/渡さないものは `protocol-debug.md`（散文）。
DBG_CATEGORIES='dependency environment config logic spec_conflict test_defect external'
DBG_ACTIONS='retry block stop_for_human'
DBG_CONFIDENCE='high medium low'

dbg_max() {
  _m=$(yget "$AIDEV/config.yml" maxDebugRounds)
  case "$_m" in ''|*[!0-9]*) _m=2 ;; esac
  # **下限は 1**。0 を許すと `debug start` が必ず止め、案内された出口の `debug report` は
  # 「start が無い」と弾くので、どちらにも進めなくなる
  [ "$_m" -ge 1 ] 2>/dev/null || _m=1
  printf '%s' "$_m"
}
# 同一工程の sent_back 回数
# 注意: `grep -c` は**一致 0 件でも "0" を出して exit 1** する。`|| printf 0` を足すと
# "0" が2回出て値が2行になる（実際にやった）。フォールバックは代入側で受ける
# `by: unapprove` の行は数えない（差し戻しの結果であって原因ではない。cmd_unapprove の注記）。
dbg_sent_backs() { # metrics_file phase
  [ -f "$1" ] || { printf '0'; return; }
  _n=$(grep "phase:[[:space:]]*$2,.*event:[[:space:]]*sent_back" "$1" 2>/dev/null \
        | grep -vc 'by:[[:space:]]*unapprove') || _n=0
  case "$_n" in ''|*[!0-9]*) _n=0 ;; esac
  printf '%s' "$_n"
}
# その work の maxSendBacks（state.yml。未記載は 3）
dbg_max_send_backs() {
  _s=$(yget "$WORK/state.yml" maxSendBacks)
  case "$_s" in ''|*[!0-9]*) _s=3 ;; esac
  printf '%s' "$_s"
}
# debug の開始ラウンド数（工程ごと）
dbg_rounds() { # metrics_file phase
  [ -f "$1" ] || { printf '0'; return; }
  _n=$(grep "phase:[[:space:]]*$2," "$1" 2>/dev/null | grep 'event:[[:space:]]*debug' \
        | grep -c 'stage:[[:space:]]*start') || _n=0
  case "$_n" in ''|*[!0-9]*) _n=0 ;; esac
  printf '%s' "$_n"
}
# 直近の debug 報告の next_action（無ければ空）
dbg_last_action() { # metrics_file
  [ -f "$1" ] || return 0
  grep 'event:[[:space:]]*debug' "$1" 2>/dev/null | grep 'stage:[[:space:]]*report' | tail -n1 \
    | sed -n 's/.*next_action:[[:space:]]*\([a-z_][a-z_]*\).*/\1/p'
}
in_list() { for _i in $2; do [ "$1" = "$_i" ] && return 0; done; return 1; }

dbg_start() {
  dslug=""; dph=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --phase) need_arg "$1" $#; dph=$2; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$dslug" ] && dslug=$1 || die "slug は1つだけ"; shift ;;
    esac
  done
  resolve_work "$dslug"
  [ -n "$dph" ] || dph=$(yget "$WORK/state.yml" current)
  is_phase "$dph" || die "未知の phase: $dph（--phase で指定するか state.yml の current を直す）"
  _dm=$(dbg_max)
  _dr=$(dbg_rounds "$WORK/metrics.yml" "$dph")
  if [ "$_dr" -ge "$_dm" ] 2>/dev/null; then
    # **ここで止めるのが目的**。無限に粘らせないための上限で、
    # 超えたら「原因究明を続ける」ではなく「詰まったことを記録して人に返す」へ倒す
    printf 'debug: %s/%s\n' "$SLUG" "$dph"
    printf 'FAIL デバッグは %s ラウンドまでです（実施済み %s）。これ以上粘らない\n' "$_dm" "$_dr" >&2
    printf 'next: aidev debug report --next-action block（このタスクを止めて次へ）か\n' >&2
    printf '      --next-action stop_for_human（人の判断が要る）で締めること\n' >&2
    return 4
  fi
  _dr=$((_dr+1))
  append_event "$dph" debug "stage=start" "round=$_dr"
  printf 'debug: %s/%s round %s/%s\n' "$SLUG" "$dph" "$_dr" "$_dm"
  printf 'note: **新しいコンテキスト**に原因究明だけを委譲する（protocol-debug.md）\n'
  _dw=".aidev/works/$SLUG"
  printf '渡すもの:\n'
  printf '  - 失敗の生出力（%s/test-result.md の「失敗の証跡」）\n' "$_dw"
  printf '  - いまの差分（git diff。コミット前の変更）\n'
  printf '  - 対象タスクの行（%s/tasks.md）と、その AC の本文（requirements.md）\n' "$_dw"
  printf '  - review の直近ラウンドの指摘（%s/review.md）\n' "$_dw"
  printf '**渡さないもの: これまでの修正の試行履歴**（渡すと同じ穴を掘り続ける。これがこの手順の要）\n'
  printf 'next: aidev debug report --root-cause <t> --category <c> --next-action <a>\n'
  return 0
}

dbg_report() {
  dslug=""; dph=""; drc=""; dcat=""; dact=""; dconf=""; dfix=""; dver=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --phase)       need_arg "$1" $#; dph=$2;   shift 2 ;;
      --root-cause)  need_arg "$1" $#; drc=$2;   shift 2 ;;
      --category)    need_arg "$1" $#; dcat=$2;  shift 2 ;;
      --next-action) need_arg "$1" $#; dact=$2;  shift 2 ;;
      --confidence)  need_arg "$1" $#; dconf=$2; shift 2 ;;
      --fix-tasks)    need_arg "$1" $#; dfix=$2;  shift 2 ;;
      --verification) need_arg "$1" $#; dver=$2; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$dslug" ] && dslug=$1 || die "slug は1つだけ"; shift ;;
    esac
  done
  resolve_work "$dslug"
  [ -n "$dph" ] || dph=$(yget "$WORK/state.yml" current)
  is_phase "$dph" || die "未知の phase: $dph"
  # **必須フィールドを CLI が強制する**（`convention new` の --hypothesis/--baseline と同じ入口ゲート）。
  # 散文の講評だけ返して終わると、何が原因だったのかが後から誰にも読めない
  [ -n "$drc" ]  || die "--root-cause は必須です（何が根本原因だったか。1〜2文）"
  [ -n "$dcat" ] || die "--category は必須です（$DBG_CATEGORIES）"
  [ -n "$dact" ] || die "--next-action は必須です（$DBG_ACTIONS）"
  in_list "$dcat" "$DBG_CATEGORIES" || die "未知の --category: $dcat（$DBG_CATEGORIES）"
  in_list "$dact" "$DBG_ACTIONS"    || die "未知の --next-action: $dact（$DBG_ACTIONS）"
  if [ -n "$dconf" ]; then
    in_list "$dconf" "$DBG_CONFIDENCE" || die "未知の --confidence: $dconf（$DBG_CONFIDENCE）"
  fi
  _dr=$(dbg_rounds "$WORK/metrics.yml" "$dph")
  [ "$_dr" -ge 1 ] 2>/dev/null || die "この工程で aidev debug start が記録されていません（先に start を打つこと）"

  # **本文は decisions.md、列挙値は metrics** に分ける。metrics はフロー形式の1行なので
  # 自由文（カンマを含む）を入れると壊れる。文章は文章の置き場へ送る
  _df="$WORK/decisions.md"
  _dn=$(grep -c '^## デバッグ D' "$_df" 2>/dev/null) || _dn=0
  case "$_dn" in ''|*[!0-9]*) _dn=0 ;; esac
  _dn=$((_dn+1))
  if [ ! -f "$_df" ]; then printf '# 判断の記録: %s\n' "$SLUG" > "$_df"
  elif [ -n "$(tail -c 1 "$_df" 2>/dev/null)" ]; then printf '\n' >> "$_df"; fi
  {
    printf '\n## デバッグ D%s: %s / %s（%s round %s・%s）\n' "$_dn" "$dcat" "$dact" "$dph" "$_dr" "$(now)"
    printf -- '- 根本原因: %s\n' "$drc"
    [ -n "$dfix" ]  && printf -- '- 修正方針: %s\n' "$dfix"
    [ -n "$dver" ]  && printf -- '- 確認方法: %s\n' "$dver"
    [ -n "$dconf" ] && printf -- '- 確度: %s\n' "$dconf"
    printf -- '- 次の行動: %s\n' "$dact"
  } >> "$_df"

  set -- "$dph" debug "stage=report" "round=$_dr" "category=$dcat" "next_action=$dact"
  [ -n "$dconf" ] && set -- "$@" "confidence=$dconf"
  append_event "$@"

  printf 'debug: %s/%s round %s -> %s (%s)\n' "$SLUG" "$dph" "$_dr" "$dact" "$dcat"
  printf 'recorded: .aidev/works/%s/decisions.md の「デバッグ D%s」\n' "$SLUG" "$_dn"
  case "$dact" in
    retry)
      printf 'next: **新しい実装コンテキスト**に修正方針を渡してやり直す（同じコンテキストに戻さない）。\n'
      printf '      再開時は aidev event %s start を忘れないこと\n' "$dph" ;;
    block)
      printf 'next: このタスクは止めて次へ進む。判断は review 工程に委ねる\n' ;;
    stop_for_human)
      printf 'next: **ここで停止して人に返す**（autonomous でも待つ。リポジトリの外の判断が要る場合の出口）\n' ;;
  esac
  return 0
}

dbg_status() {
  dslug=""; fmt=table
  while [ $# -gt 0 ]; do
    case "$1" in
      --format) need_arg "$1" $#; fmt=$2; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$dslug" ] && dslug=$1 || die "slug は1つだけ"; shift ;;
    esac
  done
  case "$fmt" in table|tsv) ;; *) die "--format は table|tsv" ;; esac
  resolve_work "$dslug"
  _dm=$(dbg_max); _dsb=$(dbg_max_send_backs)
  rows=""
  for p in $PHASES; do
    _sb=$(dbg_sent_backs "$WORK/metrics.yml" "$p")
    _rd=$(dbg_rounds "$WORK/metrics.yml" "$p")
    [ "$_sb" -eq 0 ] && [ "$_rd" -eq 0 ] && continue
    if [ "$_sb" -ge "$_dsb" ] 2>/dev/null && [ "$_rd" -eq 0 ]; then _due=yes; else _due=no; fi
    rows="${rows}${p}	${_sb}	${_rd}	${_due}
"
  done
  printf 'debug: %s\n' "$SLUG"
  if [ "$fmt" = tsv ]; then printf '%s' "$rows"
  else { printf 'phase	sent_backs	debug_rounds	due\n'; printf '%s' "$rows"; } | fmt_table; fi
  _dla=$(dbg_last_action "$WORK/metrics.yml"); [ -n "$_dla" ] || _dla=-
  printf 'debug-summary: maxSendBacks=%s maxDebugRounds=%s last_action=%s\n' "$_dsb" "$_dm" "$_dla"
  return 0
}

cmd_debug() {
  [ $# -ge 1 ] || { dbg_status; return $?; }
  case "$1" in
    start)  shift; dbg_start "$@" ;;
    report) shift; dbg_report "$@" ;;
    status) shift; dbg_status "$@" ;;
    *) die "未知の debug サブコマンド: $1（start|report|status）" ;;
  esac
}

# --- コマンド: limits（回数の上限を一覧・設定する） --------------------------------
# 上限は 3 箇所に散っていた——`state.yml`（work ごと）／`.aidev/config.yml`（PJ ごと）／
# frontmatter（条項ごと）。**どれも設定口が無く手編集しかなかった**（`escalate` / `unapprove` /
# `--human-gates` を作ったのと同じ矛盾で、「state の更新は単一の検証済み経路に集約する」に反する）。
# しかも「いまいくつが効いているか」を一望する手段が無く、既定値は各所のコードにしか無かった。
#
# 一覧は**どこから来た値か**（config / state / 既定）まで出す。効いている値と、それを変える口を
# 同じコマンドに置くのが要点——見えない設定は忘れられる。
# 条項の `verify_after` はここに含めない（上限ではなく母集団の**下限**で、項目ごとに違うため
# `convention new --verify-after` / `convention defer` が正しい口）。
#
# key:scope:min:default（scope=work は state.yml、pj は config.yml）
LIMIT_KEYS='maxSendBacks:work:0:3
maxDebugRounds:pj:1:2
maxTaskCheckRounds:pj:1:2
maxDocCheckRounds:pj:1:2
lightMaxFiles:pj:1:3
smokeStaleAfter:pj:0:5
smokeTimeoutSec:pj:1:300
sharedFilesWindow:pj:0:20'

lm_spec() { # key -> "scope min default"（未知なら空）
  # **loop body の最後を `cmd && …` にしない**。最後の反復でキーが一致しないと body が 1 を返し、
  # while → pipeline が 1 になる。`set -e` は**その場で subshell を落とす**ので、後ろに置いた
  # `return 0` には到達しない（command substitution 越しに呼び出し側まで伝わる）。
  # このリポジトリで繰り返し踏んでいる形——if で受ければ body は常に 0 を返す
  printf '%s\n' "$LIMIT_KEYS" | while IFS=: read -r k sc mn df; do
    if [ "$k" = "$1" ]; then printf '%s %s %s' "$sc" "$mn" "$df"; fi
  done
  return 0
}

lm_show() {
  _fmt=table; _lslug=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --format) need_arg "$1" $#; _fmt=${2:-}; shift 2 ;;
      --slug) need_arg "$1" $#; _lslug=$2; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) die "limits は位置引数を取りません: $1" ;;
    esac
  done
  case "$_fmt" in table|tsv) ;; *) die "--format は table|tsv" ;; esac
  # work が無くても PJ 側は見せる（導入直後に効いている値を確かめられるように）
  _lst=""
  if resolve_work_soft "$_lslug"; then _lst="$WORK/state.yml"; fi
  _rows=""
  _oi=$IFS; IFS='
'
  for _spec in $LIMIT_KEYS; do
    IFS=: read -r _k _sc _mn _df <<EOF2
$_spec
EOF2
    IFS='
'
    _src=default; _val=""   # 表の列は ASCII に保つ（多バイトだと sh/ps1 で桁揃えが割れる）
    if [ "$_sc" = work ]; then
      [ -n "$_lst" ] && _val=$(yget "$_lst" "$_k")
      [ -n "$_val" ] && _src=state
    else
      _val=$(yget "$AIDEV/config.yml" "$_k")
      [ -n "$_val" ] && _src=config
    fi
    case "$_val" in ''|*[!0-9]*) _val=$_df; _src=default ;; esac
    _rows="$_rows$_k	$_val	$_src	$_sc	$_df
"
  done
  IFS=$_oi
  if [ "$_fmt" = tsv ]; then
    printf '%s' "$_rows" | while IFS='	' read -r a b c d e; do
      [ -n "$a" ] && printf 'limit\t%s\t%s\t%s\t%s\t%s\n' "$a" "$b" "$c" "$d" "$e"
    done
    return 0
  fi
  printf 'LIMITS（回数の上限。scope=pj は .aidev/config.yml、work は state.yml）\n'
  { printf 'key\tvalue\tsource\tscope\tdefault\n'; printf '%s' "$_rows"; } | fmt_table
  [ -z "$_lst" ] && printf 'note: work が未選択なので scope=work は既定値を表示しています\n'
  printf '変更: aidev limits set <key> <n> [--slug <work>]（既定へ戻す: aidev limits unset <key>）\n'
  return 0
}

lm_set() {
  _k=""; _v=""; _lslug=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug) need_arg "$1" $#; _lslug=$2; shift 2 ;;
      # `-1` を**オプションとして先に食わない**。負値は「未知のオプション」ではなく
      # 下限違反として弾かれるべき（実走で「未知のオプション: -1」と出て誤誘導した）
      -[0-9]*) if [ -z "$_k" ]; then die "使用法: aidev limits set <key> <n>"; fi
               if [ -z "$_v" ]; then _v=$1; else die "引数が多すぎます: $1"; fi; shift ;;
      -*) die "未知のオプション: $1" ;;
      *) if [ -z "$_k" ]; then _k=$1; elif [ -z "$_v" ]; then _v=$1; else die "引数が多すぎます: $1"; fi; shift ;;
    esac
  done
  [ -n "$_k" ] && [ -n "$_v" ] || die "使用法: aidev limits set <key> <n> [--slug <work>]（key は aidev limits で一覧）"
  _sp=$(lm_spec "$_k")
  [ -n "$_sp" ] || die "未知の上限キー: $_k（設定できるのは $(printf '%s\n' "$LIMIT_KEYS" | cut -d: -f1 | tr '\n' ' ')）"
  set -- $_sp
  _sc=$1; _mn=$2; _df=$3
  # scope=pj のキーに --slug を渡されたら**黙って無視しない**。work ごとの上限は
  # 原理的に持てない（読む側が config.yml しか見ない）ので、効いたつもりが一番危ない
  if [ "$_sc" != work ] && [ -n "$_lslug" ]; then
    die "$_k は PJ 全体の上限なので --slug は使えません（work ごとに変えられるのは scope=work のキーだけ。aidev limits で確認）"
  fi
  case "$_v" in ''|*[!0-9]*) die "値は 0 以上の整数: $_v" ;; esac
  [ "$_v" -ge "$_mn" ] 2>/dev/null || die "$_k の下限は $_mn です（$_v は指定できない）"
  if [ "$_sc" = work ]; then
    resolve_work "$_lslug"
    set_or_append "$WORK/state.yml" "$_k" "$_k: $_v"
    printf 'set: %s = %s（%s の state.yml）\n' "$_k" "$_v" "$SLUG"
  else
    [ -f "$AIDEV/config.yml" ] || : > "$AIDEV/config.yml"
    set_or_append "$AIDEV/config.yml" "$_k" "$_k: $_v"
    printf 'set: %s = %s（.aidev/config.yml。PJ 全体に効く）\n' "$_k" "$_v"
  fi
  [ "$_v" = "$_df" ] && printf 'note: 既定値と同じ値です（既定へ戻すなら aidev limits unset %s）\n' "$_k"
  return 0
}

# 一時的に上限を緩めて戻す運用（検証・緊急対応）で、`set <既定値>` だと行が残り
# source が config のままになる。「既定に戻した」と「たまたま既定と同じ値を書いた」は別物
lm_unset() {
  _k=""; _lslug=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug) need_arg "$1" $#; _lslug=$2; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) if [ -z "$_k" ]; then _k=$1; else die "引数が多すぎます: $1"; fi; shift ;;
    esac
  done
  [ -n "$_k" ] || die "使用法: aidev limits unset <key> [--slug <work>]"
  _sp=$(lm_spec "$_k")
  [ -n "$_sp" ] || die "未知の上限キー: $_k（設定できるのは $(printf '%s\n' "$LIMIT_KEYS" | cut -d: -f1 | tr '\n' ' ')）"
  set -- $_sp
  _sc=$1; _mn=$2; _df=$3
  if [ "$_sc" != work ] && [ -n "$_lslug" ]; then
    die "$_k は PJ 全体の上限なので --slug は使えません"
  fi
  if [ "$_sc" = work ]; then
    resolve_work "$_lslug"; _lf="$WORK/state.yml"; _lw=$SLUG
  else
    _lf="$AIDEV/config.yml"; _lw="PJ 全体"
  fi
  if [ ! -f "$_lf" ] || ! grep -q "^[[:space:]]*$_k:" "$_lf"; then
    printf 'unset: %s は書かれていません（既定 %s のまま）\n' "$_k" "$_df"
    return 0
  fi
  # `grep -v` は**全行落ちると exit 1**。`&& mv` にすると「唯一の行を消したときだけ消えない」
  # という一番踏みやすい形になる（`grep -c` が 0 で 1 を返すのと同じ罠）
  _lt="$_lf.tmp.$$"
  grep -v "^[[:space:]]*$_k:" "$_lf" > "$_lt" || :
  mv "$_lt" "$_lf"
  printf 'unset: %s を削除しました（%s。既定 %s に戻ります）\n' "$_k" "$_lw" "$_df"
  return 0
}

cmd_limits() {
  [ $# -ge 1 ] || { lm_show; return $?; }
  case "$1" in
    set)   shift; lm_set "$@" ;;
    unset) shift; lm_unset "$@" ;;
    show)  shift; lm_show "$@" ;;
    -*)   lm_show "$@" ;;
    *) die "未知の limits サブコマンド: $1（show|set|unset）" ;;
  esac
}

# --- コマンド: taskcheck（タスク単位の独立点検を有限化する） ----------------------
# `maxTaskCheckRounds` は長らく**散文にしか無い上限**だった——`protocol-check.md` が
# 「config.yml のキー」と書くのに CLI は読まず、`0` を書いても `999` を書いても挙動が変わらない。
# `DESIGN`「3.5」の分類 G（散文にしか無い規約）そのもの。
#
# 読めなかった理由は「観測できない」ではなく**観測する口が無かった**こと。`maxSendBacks` は
# `event <工程> sent_back`、`maxDebugRounds` は `debug start` という「1ラウンド = 1 コマンド」の
# 形があるから数えられる。タスク点検は `approve coding` 時の**合計**しか CLI に届かず、
# 「タスク T の点検が何回目か」が残らなかった。ここで同じ形を与える。
#
# 副産物として `task_checks` / `task_check_findings` / `task_check_mode` を**手書きさせずに済む**
# （被覆・harnessRev・schema を自動化したのと同じ理由。手書きの値は忘れられる）。
TC_MODES='delegated same_session'

tc_max() {
  _m=$(yget "$AIDEV/config.yml" maxTaskCheckRounds)
  case "$_m" in ''|*[!0-9]*) _m=2 ;; esac
  # 下限 1（`maxDebugRounds` と同じ理由。0 だと start が必ず止まり出口が無い）
  [ "$_m" -ge 1 ] 2>/dev/null || _m=1
  printf '%s' "$_m"
}
# タスク ID の書式（tasks.md の `T<数字>` に揃える。coverage の COV_T_RE と同じ文法）
tc_valid_id() { # id
  case "$1" in
    T[0-9]*) printf '%s' "$1" | grep -Eq '^T[0-9][A-Za-z0-9_-]*$' ;;
    *) return 1 ;;
  esac
}
# tasks.md にそのタスクが実在するか。tasks.md がまだ無ければ判定不能として通す
# （書式だけ見ていた頃は `T1` を `T11` と打ち間違えると、上限判定が別カウンタになり
#  `task_checks` も 1 増える——**打ち間違いが「点検した」に化ける**）
tc_known_id() { # task
  [ -f "$WORK/tasks.md" ] || return 0
  if cov_task_rows "$WORK/tasks.md" | cut -f1 | grep -qx "$1"; then return 0; fi
  return 1
}
# そのタスクの点検ラウンド数（start の回数）
# 点検イベントの共通カウンタ。**数え方を 1 箇所に置く**——taskcheck と doccheck は
# どちらも「1ラウンド = 1 対（start と report）」で有限化するので、片方だけ数え方が
# ずれると上限が効いているつもりで効かない（taskcheck で実際にその穴を作った）
ck_count() { # metrics_file event stage key target
  [ -f "$1" ] || { printf '0'; return; }
  _n=$(grep "event:[[:space:]]*$2" "$1" 2>/dev/null | grep "stage:[[:space:]]*$3" \
        | grep -c "$4:[[:space:]]*$5[,}]") || _n=0
  case "$_n" in ''|*[!0-9]*) _n=0 ;; esac
  printf '%s' "$_n"
}
# 断念が `decisions.md` に残っているか（`protocol-check.md`「(b)」の締めが求めている 1 行）。
# **文面は求めず、ID か工程名を含む行が 1 本あれば「記録済み」とみなす**
# （backlog の消し込み検査が slug の出現で見るのと同じ強さ）。
# これが無かった頃は、規約どおり断念しても WARN を消す手段が
# 「**規約が禁じている `report` を打つ**」しか無かった（実走で実測）
# **「点検して 0 件」と「start だけで終わった」を見分けられるようにする**。
# taskcheck と doccheck で**同じ文言**を出す（同じ規約の同じ出口なので、片方だけ言い方が違うと
# 「別の話だ」と読まれる）
ck_unreported_note() { # list unit
  [ -n "$1" ] || return 0
  printf 'note: report が無い start が %s 件あります（%s）。委譲の出し忘れか、形式不正で断念したもの\n' \
    "$(printf '%s\n' "$1" | grep -c .)" "$(printf '%s' "$1" | tr '\n' ' ' | sed 's/ *$//')"
  printf '      断念なら decisions.md に「断念」と%s名を含む1行を残す（残せばこの note は消えます）\n' "$2"
  return 0
}

# verify 側の同じ通知。**WARN 止まりで `--strict` でも致命にしない**——記録漏れ（`event` の start）が
# 致命なのは「そのとき書かなければ二度と書けない」からだが、点検の断念は
# `protocol-check.md`「(b)」が**認めた出口**で、`decisions.md` に残せばここは消える
ck_unreported_warn() { # name unit list
  [ -n "$3" ] || return 0
  printf '  WARN %s の start に report が追いついていないものが %s 件あります（%s）: 委譲の出し忘れか断念。断念なら decisions.md に「断念」と%s名を含む1行を残す\n' \
    "$1" "$(printf '%s\n' "$3" | grep -c .)" "$(printf '%s' "$3" | tr '\n' ' ' | sed 's/ *$//')" "$2"
  return 0
}

ck_recorded() { # metrics_file id
  _ckd=$(dirname "$1")/decisions.md
  [ -f "$_ckd" ] || return 1
  grep -Eq "(^|[^0-9A-Za-z_])$2([^0-9A-Za-z_]|\$)" "$_ckd" 2>/dev/null
}

tc_rounds()  { ck_count "$1" taskcheck start  task "$2"; }
# そのタスクの report 回数（start と対になっているかの判定に使う）
tc_reports() { ck_count "$1" taskcheck report task "$2"; }
# 点検したタスクの数（重複を除く）と findings 合計。TC_TASKS / TC_FINDINGS / TC_MODE に入れる。
# **数えるのは `report` まで届いたタスクだけ**。`start` で数えていた頃は、
# `protocol-check.md` が「形式不正なら**点検しなかったものとして扱う**（`task_checks` に数えない）」と
# 定めているのに CLI は数えており、**散文と CLI が食い違っていた**。委譲を出し忘れたまま
# `start` だけ残った work も「点検して 0 件」と区別が付かなかった（他 PJ の retro が実測）
tc_totals() { # metrics_file
  TC_TASKS=0; TC_FINDINGS=0; TC_MODE=""
  [ -f "$1" ] || return 0
  TC_TASKS=$(grep 'event:[[:space:]]*taskcheck' "$1" 2>/dev/null | grep 'stage:[[:space:]]*report' \
    | sed -n 's/.*task:[[:space:]]*\([^,}]*\).*/\1/p' | sed 's/[[:space:]]*$//' \
    | LC_ALL=C sort -u | grep -c .) || TC_TASKS=0
  case "$TC_TASKS" in ''|*[!0-9]*) TC_TASKS=0 ;; esac
  TC_FINDINGS=$(grep 'event:[[:space:]]*taskcheck' "$1" 2>/dev/null | grep 'stage:[[:space:]]*report' \
    | sed -n 's/.*findings:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
    | awk '{t+=$1} END{print t+0}') || TC_FINDINGS=0
  case "$TC_FINDINGS" in ''|*[!0-9]*) TC_FINDINGS=0 ;; esac
  # 実施形態は start に刻む。全部同じならその値、混ざっていれば mixed
  _tcm=$(grep 'event:[[:space:]]*taskcheck' "$1" 2>/dev/null | grep 'stage:[[:space:]]*start' \
    | sed -n 's/.*mode:[[:space:]]*\([a-z_]*\).*/\1/p' | LC_ALL=C sort -u)
  _tcn=$(printf '%s\n' "$_tcm" | grep -c .) || _tcn=0
  if [ "$_tcn" -eq 1 ] 2>/dev/null; then TC_MODE=$_tcm
  elif [ "$_tcn" -gt 1 ] 2>/dev/null; then TC_MODE=mixed; fi
  return 0
}

# `start` に `report` が追いついていないタスク（改行区切り）。委譲の出し忘れ・形式不正で断念、の跡。
# **判定は `report` 数 < `start` 数**——`tc_status` の `unreported` 列と同じ式にする。
# 「`report` が 1 度も無い」だけで見ていた頃は、`protocol-check.md`「(b)」が明示的に認めている
# 「1 ラウンド目は成功・2 ラウンド目を断念」がまるごと網から落ちていた（表は `yes` と出すのに
# 同じコマンドの `note:` と `verify` が黙る、という自己矛盾つき。実走で実測）
tc_unreported() { # metrics_file
  [ -f "$1" ] || return 0
  _tur=$(grep 'event:[[:space:]]*taskcheck' "$1" 2>/dev/null | grep 'stage:[[:space:]]*start' \
    | sed -n 's/.*task:[[:space:]]*\([^,}]*\).*/\1/p' | sed 's/[[:space:]]*$//' | LC_ALL=C sort -u)
  for _t in $_tur; do
    [ -n "$_t" ] || continue
    [ "$(tc_reports "$1" "$_t")" -lt "$(tc_rounds "$1" "$_t")" ] 2>/dev/null || continue
    ck_recorded "$1" "$_t" && continue
    printf '%s\n' "$_t"
  done
  return 0
}

tc_start() {
  _tid=""; _tslug=""; _tmode=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug) need_arg "$1" $#; _tslug=$2; shift 2 ;;
      --mode) need_arg "$1" $#; _tmode=$2; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$_tid" ] && _tid=$1 || die "タスク ID は1つだけ"; shift ;;
    esac
  done
  [ -n "$_tid" ] || die "使用法: aidev taskcheck start <task-id> --mode <delegated|same_session> [--slug <work>]"
  tc_valid_id "$_tid" || die "タスク ID の書式が違います: $_tid（tasks.md と同じ T<数字> 形式）"
  [ -n "$_tmode" ] || die "--mode は必須（delegated=別コンテキストへ委譲 / same_session=同一セッションで読み直し）。点検が効く理由はコンテキスト分離なので、どちらで行ったかを残さないと効果を測れない"
  case " $TC_MODES " in *" $_tmode "*) ;; *) die "--mode は delegated|same_session" ;; esac
  resolve_work "$_tslug"
  tc_known_id "$_tid" || die "tasks.md にそのタスクがありません: $_tid（打ち間違いか、tasks.md へ足し忘れ。足したなら AC: も書く）"
  _tmax=$(tc_max)
  _tr=$(tc_rounds "$WORK/metrics.yml" "$_tid")
  printf 'taskcheck: %s / %s\n' "$SLUG" "$_tid"
  if [ "$_tr" -ge "$_tmax" ] 2>/dev/null; then
    printf 'FAIL 点検ラウンドが上限に達しています（%s/%s。maxTaskCheckRounds）\n' "$_tr" "$_tmax" >&2
    printf 'next: 深追いせず decisions.md に経緯を残して次のタスクへ進み、判断は 60 review に委ねる\n' >&2
    printf '      それでも詰まっているなら aidev debug start で原因究明へ倒す（試行履歴は渡さない）\n' >&2
    return 4
  fi
  append_event coding taskcheck stage=start "task=$_tid" "mode=$_tmode"
  printf 'round: %s/%s\n' "$((_tr + 1))" "$_tmax"
  printf '渡すもの: そのタスクの差分だけ\n'
  printf '観点: **正確性・規約適合の2つだけ**（要件適合・価値適合は work 全体の文脈が要るので 60 review）\n'
  printf '規約は3つとも見る: AGENTS.md 本体 / 索引に載っている条項 / PJ ドキュメント\n'
  printf '返却形式（これ以外は解釈しない）:\n'
  printf '  CHECK: <ok|findings>\n'
  printf '  FINDINGS: <件数>\n'
  printf '  - [<must|should|nit>] <指摘> — 根拠: <file:line または 節名> [conv:<id>]\n'
  printf '次: 結果を aidev taskcheck report %s --findings <件数> で記録する\n' "$_tid"
  return 0
}

tc_report() {
  _tid=""; _tslug=""; _tf=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug) need_arg "$1" $#; _tslug=$2; shift 2 ;;
      --findings) need_arg "$1" $#; _tf=$2; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$_tid" ] && _tid=$1 || die "タスク ID は1つだけ"; shift ;;
    esac
  done
  [ -n "$_tid" ] || die "使用法: aidev taskcheck report <task-id> --findings <n> [--slug <work>]"
  tc_valid_id "$_tid" || die "タスク ID の書式が違います: $_tid"
  case "$_tf" in
    ''|*[!0-9]*) die "--findings は必須（0 以上の整数）。**崩れた返答から数字を拾わない**——件数が読めないなら点検しなかったものとして扱い、report を打たない" ;;
  esac
  resolve_work "$_tslug"
  # **start と対になっていない report は受けない**。start が 1 回以上あることだけを見ていた頃は、
  # 上限で start が止まったあとでも report を打てて findings が積み上がった——
  # `maxTaskCheckRounds` がラウンドは止めるのに件数は止めない、という穴（1ラウンド=1対）
  _trs=$(tc_rounds "$WORK/metrics.yml" "$_tid")
  _trr=$(tc_reports "$WORK/metrics.yml" "$_tid")
  if [ "$_trs" -le 0 ] 2>/dev/null; then
    die "そのタスクの taskcheck start がありません: $_tid（start を打たずに結果だけ記録しない）"
  fi
  if [ "$_trr" -ge "$_trs" ] 2>/dev/null; then
    printf 'taskcheck: %s / %s\n' "$SLUG" "$_tid"
    printf 'FAIL 対になる start がありません（start %s / report %s）\n' "$_trs" "$_trr" >&2
    printf 'next: 点検し直すなら aidev taskcheck start %s から。上限で止まっているならそこで打ち切る\n' "$_tid" >&2
    return 4
  fi
  append_event coding taskcheck stage=report "task=$_tid" "findings=$_tf"
  printf 'taskcheck: %s / %s（findings %s）\n' "$SLUG" "$_tid" "$_tf"
  if [ "$_tf" -gt 0 ] 2>/dev/null; then
    printf 'next: 指摘をその場で直し、内容を review.md の「タスク点検ログ」節に1件1行で追記する\n'
    printf '      直したあと再点検するなら aidev taskcheck start %s（上限は maxTaskCheckRounds）\n' "$_tid"
  fi
  return 0
}

tc_status() {
  _fmt=table; _tslug=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --format) need_arg "$1" $#; _fmt=${2:-}; shift 2 ;;
      --slug) need_arg "$1" $#; _tslug=$2; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) die "status は位置引数を取りません: $1" ;;
    esac
  done
  case "$_fmt" in table|tsv) ;; *) die "--format は table|tsv" ;; esac
  resolve_work "$_tslug"
  _tmax=$(tc_max)
  _rows=$(grep 'event:[[:space:]]*taskcheck' "$WORK/metrics.yml" 2>/dev/null \
    | sed -n 's/.*task:[[:space:]]*\([^,}]*\).*/\1/p' | sed 's/[[:space:]]*$//' \
    | LC_ALL=C sort -u | while read -r _t; do
        [ -n "$_t" ] || continue
        _r=$(tc_rounds "$WORK/metrics.yml" "$_t")
        _f=$(grep 'event:[[:space:]]*taskcheck' "$WORK/metrics.yml" 2>/dev/null \
              | grep 'stage:[[:space:]]*report' | grep "task:[[:space:]]*$_t[,}]" \
              | sed -n 's/.*findings:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | awk '{t+=$1} END{print t+0}')
        _atmax=no; [ "$_r" -ge "$_tmax" ] 2>/dev/null && _atmax=yes
        _rp=$(tc_reports "$WORK/metrics.yml" "$_t")
        _unrep=no; [ "$_rp" -lt "$_r" ] 2>/dev/null && _unrep=yes
        printf '%s\t%s\t%s\t%s\t%s\n' "$_t" "$_r" "$_f" "$_atmax" "$_unrep"
      done)
  if [ "$_fmt" = tsv ]; then
    printf '%s\n' "$_rows" | while IFS='	' read -r a b c d e; do
      [ -n "$a" ] && printf 'taskcheck\t%s\t%s\t%s\t%s\t%s\n' "$a" "$b" "$c" "$d" "$e"
    done
    tc_totals "$WORK/metrics.yml"
    printf 'taskcheck-summary\t%s\t%s\t%s\t%s\n' "$TC_TASKS" "$TC_FINDINGS" "${TC_MODE:--}" "$_tmax"
    return 0
  fi
  printf 'taskcheck: %s\n' "$SLUG"
  if [ -n "$_rows" ]; then
    { printf 'task\trounds\tfindings\tat_max\tunreported\n'; printf '%s\n' "$_rows"; } | fmt_table
  fi
  tc_totals "$WORK/metrics.yml"
  printf 'taskcheck-summary: tasks=%s findings=%s mode=%s maxTaskCheckRounds=%s\n' \
    "$TC_TASKS" "$TC_FINDINGS" "${TC_MODE:--}" "$_tmax"
  ck_unreported_note "$(tc_unreported "$WORK/metrics.yml")" タスク
  return 0
}

cmd_taskcheck() {
  [ $# -ge 1 ] || { tc_status; return $?; }
  case "$1" in
    start)  shift; tc_start "$@" ;;
    report) shift; tc_report "$@" ;;
    status) shift; tc_status "$@" ;;
    *) die "未知の taskcheck サブコマンド: $1（start|report|status）" ;;
  esac
}


# --- コマンド: doccheck（上流文書の独立点検を有限化する） ------------------------
# `protocol-check.md`「3.3」(a) は長く**観測点の無い規約**だった。coding は
# `mode: autonomous` なら全タスクの差分点検が必須なのに、上流4工程（requirements / design /
# architecture / tasks）の独立検証は「使わない場面: autonomous のゲート経路」に入っていた——
# **同じ文書が「手戻りの最大の源は方向 / design 誤り＝上流で最も効く」と書いているのに
# 優先順位が逆**という、プロトコル内部の非対称。他 PJ の retro が「4 工程すべてで
# 差し替えを提案せず、design の自己矛盾（同一文書内の 101 行目 vs 347 行目）を素通りさせた」と
# 実測で報告してきた。**書いた本人が「点検は要らない」と判断する構造**になっていた。
#
# taskcheck と同じ「1ラウンド = 1 コマンド」の形を与え、記録から approve が自動で刻む。
DC_PHASES='requirements design architecture tasks'

dc_max() {
  _m=$(yget "$AIDEV/config.yml" maxDocCheckRounds)
  case "$_m" in ''|*[!0-9]*) _m=2 ;; esac
  [ "$_m" -ge 1 ] 2>/dev/null || _m=1
  printf '%s' "$_m"
}
dc_valid_phase() { # phase
  case " $DC_PHASES " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}
dc_rounds()  { ck_count "$1" doccheck start  phase "$2"; }
dc_reports() { ck_count "$1" doccheck report phase "$2"; }
# その工程の点検ラウンド数 / findings 合計 / 実施形態。DC_ROUNDS / DC_FINDINGS / DC_MODE に入れる
# 点検に渡す文書の合計バイト数。**tasks は tasks.md の 2 つ**——
# `dc_start` の出力自身が「渡すもの: tasks.md」と言っているのに tasks.md しか見ておらず、
# `AC:` 行がある（＝tasks の点検で最も直しやすい）tasks.md だけを直して `report` を打っても
# 何も言わなかった（実走で実測）
dc_size() { # phase
  # **1 工程 1 ファイル**。tasks が 2 ファイル（方針と一覧）だった頃はここに特例があり、
  # 片方しか見ていなかったので `AC:` 行のあるほうを直しても検知できなかった。統合して特例が消えた
  _dsb=$(wc -c < "$WORK/$1.md" 2>/dev/null | tr -d ' ') || _dsb=0
  case "$_dsb" in ''|*[!0-9]*) _dsb=0 ;; esac
  printf '%s' "$_dsb"
}

# `start` に `report` が追いついていない工程（改行区切り）。**`tc_unreported` と同じ式・同じ出口**。
# `protocol-check.md` は (a) と (b) で「規律・禁止事項・フォールバックは共通」と宣言しているのに、
# 数え方だけ対称化して検知は (b) にしか無かった——上流文書の「委譲を出し忘れた点検」は
# どのコマンドを打っても一生表に出なかった（実走で実測）。
# 未 report の `start` も `maxDocCheckRounds` の枠は食うので、黙っていると
# 「静かに枠だけ減って次の start が exit 4」という詰まり方をする
dc_unreported() { # metrics_file
  [ -f "$1" ] || return 0
  for _dph in $DC_PHASES; do
    _dus=$(dc_rounds "$1" "$_dph"); [ "$_dus" -gt 0 ] 2>/dev/null || continue
    [ "$(dc_reports "$1" "$_dph")" -lt "$_dus" ] 2>/dev/null || continue
    ck_recorded "$1" "$_dph" && continue
    printf '%s\n' "$_dph"
  done
  return 0
}

dc_totals() { # metrics_file phase
  DC_ROUNDS=0; DC_FINDINGS=0; DC_MODE=""
  [ -f "$1" ] || return 0
  # taskcheck と同じ理由で **report まで届いたラウンドだけ**数える（start だけでは「点検した」に数えない）
  DC_ROUNDS=$(dc_reports "$1" "$2")
  DC_FINDINGS=$(grep 'event:[[:space:]]*doccheck' "$1" 2>/dev/null | grep 'stage:[[:space:]]*report' \
    | grep "phase:[[:space:]]*$2[,}]" \
    | sed -n 's/.*findings:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
    | awk '{t+=$1} END{print t+0}') || DC_FINDINGS=0
  case "$DC_FINDINGS" in ''|*[!0-9]*) DC_FINDINGS=0 ;; esac
  _dcm=$(grep 'event:[[:space:]]*doccheck' "$1" 2>/dev/null | grep 'stage:[[:space:]]*start' \
    | grep "phase:[[:space:]]*$2[,}]" \
    | sed -n 's/.*mode:[[:space:]]*\([a-z_]*\).*/\1/p' | LC_ALL=C sort -u)
  _dcn=$(printf '%s\n' "$_dcm" | grep -c .) || _dcn=0
  if [ "$_dcn" -eq 1 ] 2>/dev/null; then DC_MODE=$_dcm
  elif [ "$_dcn" -gt 1 ] 2>/dev/null; then DC_MODE=mixed; fi
  return 0
}

dc_start() {
  _dph=""; _dslug=""; _dmode=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug) need_arg "$1" $#; _dslug=$2; shift 2 ;;
      --mode) need_arg "$1" $#; _dmode=$2; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$_dph" ] && _dph=$1 || die "工程は1つだけ"; shift ;;
    esac
  done
  [ -n "$_dph" ] || die "使用法: aidev doccheck start <requirements|design|architecture|tasks> --mode <delegated|same_session> [--slug <work>]"
  dc_valid_phase "$_dph" || die "独立点検の対象は上流4工程だけ: $_dph（$DC_PHASES）。coding のタスク点検は aidev taskcheck"
  [ -n "$_dmode" ] || die "--mode は必須（delegated=別コンテキストへ委譲 / same_session=同一セッションで読み直し）。点検が効く理由はコンテキスト分離なので、どちらで行ったかを残さないと効果を測れない"
  case " $TC_MODES " in *" $_dmode "*) ;; *) die "--mode は delegated|same_session" ;; esac
  resolve_work "$_dslug"
  # 前提成果物の不足は exit 2（`guard` と同じ分類。使い方の誤り=1 と混ぜない）
  if [ ! -f "$WORK/$_dph.md" ]; then
    printf 'aidev: 点検する文書がありません: %s.md（その工程を先に書く）\n' "$_dph" >&2
    exit 2
  fi
  _dmax=$(dc_max)
  _dr=$(dc_rounds "$WORK/metrics.yml" "$_dph")
  if [ "$_dr" -ge "$_dmax" ] 2>/dev/null; then
    printf 'doccheck: %s / %s\n' "$SLUG" "$_dph" >&2
    printf 'FAIL 点検ラウンドが上限に達しています（%s/%s。maxDocCheckRounds）\n' "$_dr" "$_dmax" >&2
    printf 'next: 深追いせず、残った疑問を decisions.md に残して承認へ進む（判断は次工程・60 review に委ねる）\n' >&2
    return 4
  fi
  printf 'doccheck: %s / %s\n' "$SLUG" "$_dph"
  # **`report` は「直す前に」打つ**という規約は、破っても何も起きなかった（他 PJ の retro で 1 回発生）。
  # start 時点の大きさを刻んでおき、report で変わっていたら「直したあとに打った」と言う。
  # ハッシュでなくバイト数なのは、sh/ps1 で同じ値を出せる最も単純な量だから
  # （同じ大きさの書き換えは見逃す。WARN 止まりなのはそのため）
  _dsz=$(dc_size "$_dph")
  append_event "$_dph" doccheck stage=start "phase=$_dph" "mode=$_dmode" "size=$_dsz"
  printf 'round: %s/%s\n' "$((_dr + 1))" "$_dmax"
  # tasks 工程の成果物は tasks.md 1 つで、`AC:` 行もその中にある（旧 plan.md と統合済み）
  if [ "$_dph" = tasks ]; then
    printf '渡すもの: tasks.md（AC: 行は tasks.md にある。上流の元文書は渡さない）\n'
  else
    printf '渡すもの: %s.md だけ（上流の元文書は渡さない。内部一貫性を見るため）\n' "$_dph"
  fi
  printf '観点: **内部一貫性のみ**——AC の ID 対応漏れ / **AC の入力の出所が文書内で辿れるか** /\n'
  printf '      目的・ゴールが状態で書けているか / 対象範囲と方針・図と本文の食い違い / 節の欠落・前後の矛盾\n'
  printf '禁止: **外部ソース・一次資料との照合**（幻覚的な指摘を量産する。一次資料は主エージェントが直読）\n'
  printf '返却形式（これ以外は解釈しない）:\n'
  printf '  CHECK: <ok|findings>\n'
  printf '  FINDINGS: <件数>\n'
  printf '  - [<must|should|nit>] <指摘> — 根拠: <file:line または 節名>\n'
  printf '次: 結果を aidev doccheck report %s --findings <件数> で記録する（**直す前に打つ**。\n' "$_dph"
  printf '    直してから打つと、その件数が次のラウンドに寄る）\n'
  return 0
}

dc_report() {
  _dph=""; _dslug=""; _df=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug) need_arg "$1" $#; _dslug=$2; shift 2 ;;
      --findings) need_arg "$1" $#; _df=$2; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$_dph" ] && _dph=$1 || die "工程は1つだけ"; shift ;;
    esac
  done
  [ -n "$_dph" ] || die "使用法: aidev doccheck report <phase> --findings <n> [--slug <work>]"
  dc_valid_phase "$_dph" || die "独立点検の対象は上流4工程だけ: $_dph（$DC_PHASES）"
  case "$_df" in
    ''|*[!0-9]*) die "--findings は必須（0 以上の整数）。**崩れた返答から数字を拾わない**——件数が読めないなら点検しなかったものとして扱い、report を打たない" ;;
  esac
  resolve_work "$_dslug"
  # start と対になっていない report は受けない（taskcheck と同じ規則。理由もそちらに）
  _drs=$(dc_rounds "$WORK/metrics.yml" "$_dph")
  _drr=$(dc_reports "$WORK/metrics.yml" "$_dph")
  if [ "$_drs" -le 0 ] 2>/dev/null; then
    die "その工程の doccheck start がありません: $_dph（start を打たずに結果だけ記録しない）"
  fi
  if [ "$_drr" -ge "$_drs" ] 2>/dev/null; then
    printf 'doccheck: %s / %s\n' "$SLUG" "$_dph" >&2
    printf 'FAIL 対になる start がありません（start %s / report %s）\n' "$_drs" "$_drr" >&2
    printf 'next: 点検し直すなら aidev doccheck start %s から。上限で止まっているならそこで打ち切る\n' "$_dph" >&2
    return 4
  fi
  # 直前の start の大きさと比べる（変わっていれば「直したあとに report を打った」）
  _dsz0=$(grep 'event:[[:space:]]*doccheck' "$WORK/metrics.yml" 2>/dev/null \
    | grep 'stage:[[:space:]]*start' | grep "phase:[[:space:]]*$_dph[,}]" \
    | sed -n 's/.*size:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | tail -n1)
  _dsz1=$(dc_size "$_dph")
  _dsdoc=$_dph.md
  append_event "$_dph" doccheck stage=report "phase=$_dph" "findings=$_df"
  printf 'doccheck: %s / %s（findings %s）\n' "$SLUG" "$_dph" "$_df"
  if [ -n "$_dsz0" ] && [ "$_dsz0" != "$_dsz1" ] 2>/dev/null; then
    printf 'note: %s が start 時点から変わっています（%s→%s バイト）: **report は直す前に打つ**\n' \
      "$_dsdoc" "$_dsz0" "$_dsz1"
    printf '      直してから打つと、その件数が次のラウンドに寄ります\n'
  fi
  if [ "$_df" -gt 0 ] 2>/dev/null; then
    printf 'next: 指摘をその場で直して再提示するか、差し戻す（protocol.md「3.」の分岐に合流）\n'
    printf '      直したあと再点検するなら aidev doccheck start %s（上限は maxDocCheckRounds）\n' "$_dph"
  fi
  return 0
}

dc_status() {
  _fmt=table; _dslug=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --format) need_arg "$1" $#; _fmt=${2:-}; shift 2 ;;
      --slug) need_arg "$1" $#; _dslug=$2; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) die "status は位置引数を取りません: $1" ;;
    esac
  done
  case "$_fmt" in table|tsv) ;; *) die "--format は table|tsv" ;; esac
  resolve_work "$_dslug"
  _dmax=$(dc_max)
  _rows=""; _tr=0; _tf=0; _modes=""
  for _p in $DC_PHASES; do
    dc_totals "$WORK/metrics.yml" "$_p"
    _dst=$(dc_rounds "$WORK/metrics.yml" "$_p")
    [ "$DC_ROUNDS" -gt 0 ] 2>/dev/null || [ "$_dst" -gt 0 ] 2>/dev/null || continue
    # **上限に照らすのは `start` の数**（`dc_start` が検査しているのがそれ）。`rounds` 列に出す
    # `report` 数で判定すると、未 report の start がある工程で「まだ余裕がある」と出したそばから
    # 次の `start` が exit 4 になる
    _atmax=no; [ "$_dst" -ge "$_dmax" ] 2>/dev/null && _atmax=yes
    _unrep=no; [ "$DC_ROUNDS" -lt "$_dst" ] 2>/dev/null && _unrep=yes
    _rows="$_rows$_p	$DC_ROUNDS	$DC_FINDINGS	${DC_MODE:--}	$_atmax	$_unrep
"
    _tr=$((_tr + DC_ROUNDS)); _tf=$((_tf + DC_FINDINGS))
    _modes="$_modes $DC_MODE"
  done
  _um=$(printf '%s\n' $_modes | grep -c . 2>/dev/null || true)
  _uu=$(printf '%s\n' $_modes | LC_ALL=C sort -u | grep -c . 2>/dev/null || true)
  _amode=-
  if [ "${_uu:-0}" -eq 1 ] 2>/dev/null; then _amode=$(printf '%s\n' $_modes | LC_ALL=C sort -u)
  elif [ "${_uu:-0}" -gt 1 ] 2>/dev/null; then _amode=mixed; fi
  if [ "$_fmt" = tsv ]; then
    printf '%s' "$_rows" | while IFS='	' read -r a b c d e f; do
      [ -n "$a" ] && printf 'doccheck\t%s\t%s\t%s\t%s\t%s\t%s\n' "$a" "$b" "$c" "$d" "$e" "$f"
    done
    printf 'doccheck-summary\t%s\t%s\t%s\t%s\n' "$_tr" "$_tf" "$_amode" "$_dmax"
    return 0
  fi
  printf 'doccheck: %s\n' "$SLUG"
  if [ -n "$_rows" ]; then
    { printf 'phase\trounds\tfindings\tmode\tat_max\tunreported\n'; printf '%s' "$_rows"; } | fmt_table
  fi
  printf 'doccheck-summary: rounds=%s findings=%s mode=%s maxDocCheckRounds=%s\n' \
    "$_tr" "$_tf" "$_amode" "$_dmax"
  ck_unreported_note "$(dc_unreported "$WORK/metrics.yml")" 工程
  return 0
}

cmd_doccheck() {
  [ $# -ge 1 ] || { dc_status; return $?; }
  case "$1" in
    start)  shift; dc_start "$@" ;;
    report) shift; dc_report "$@" ;;
    status) shift; dc_status "$@" ;;
    *) die "未知の doccheck サブコマンド: $1（start|report|status）" ;;
  esac
}

# --- コマンド: smoke（起動確認 GO/NO-GO） --------------------------------------
# 出所: cc-sdd の `kiro-verify-completion`。`FEATURE_GO` の条件に
# 「runtime smoke boot result showing the built artifact reaches its first usable state」を置き、
# **"A passing test suite alone is not enough for FEATURE_GO."** と明記している。
#
# aidev には「ビルドした成果物が起動して最初の使える状態まで行くか」を見る場所が無かった。
# 単体テストが全部緑でも、配線が壊れていてアプリが立ち上がらないことは普通に起きる。
# 実際、テストPJの実走では担当エージェントがこれを**受け入れ基準として自分で書いた**——
# つまり**人が AC に書いたときだけ偶然発火する**状態だった。
#
# **なぜ CLI が実行するのか**: 結果を `--result pass` のように自己申告させると、
# 「手書きの値は忘れられる・都合よく書かれる」という、この harness が繰り返し退けてきた形になる
# （`harnessRev` を `new` に、被覆を `approve` に一本化したのと同じ理由）。exit code は CLI が取る。
# 実行するコマンドは `.aidev/config.yml` の `smokeCommand`（コミット済み＝レビュー対象）に限る。
# **`yget` を使わない**。`yget` は値の前後の `"` を一律で剥がすので、
# `smokeCommand: echo "booted"` のようなシェルコマンドは**末尾のクォートだけ落ちて壊れる**。
# ここで剥がすのは「値の全体が1組の `"..."` で囲まれているとき」だけ。
smoke_cmd() {
  _v=$(sed -n 's/^smokeCommand:[[:space:]]*//p' "$AIDEV/config.yml" 2>/dev/null \
        | head -n1 | sed 's/[[:space:]]*$//')
  case "$_v" in
    '"'*'"') _v=${_v#\"}; _v=${_v%\"} ;;
  esac
  printf '%s' "$_v"
}

# 起動確認は**成果物と一緒に育つ**もの。1 本の固定コマンドだと、work が足した表面を
# 一度も起動しないまま `smoke: pass` になる（実走で `stats` / `rename-tag` / `--json` の
# どれも smoke を通らなかった）。`protocol.md`「主張は証拠の範囲を超えない」に照らすと、
# 起動確認の記録が現在の成果物を代表していない。複数行で積めるようにして、
# 表面を足した work がその場で 1 行足せる形にする:
#   smokeCommands:
#     - cmd one && cmd two
#     - cmd three
# 値は `smokeCommand` と同じく**行をそのまま**読む（YAML のエスケープを解釈しない。
# 配列リテラル `[a, b]` にしないのは、コマンドに含まれるカンマで壊れるため）
# 宣言の中身を**任意のテキスト**から取り出す（履歴の版と現在版を比べるために要る）
smoke_decl_of() { # file
  awk '
    /^smokeCommand:[ \t]*/ { sub(/^smokeCommand:[ \t]*/, ""); sub(/[ \t]+$/, ""); if ($0 != "") print "1:" $0; next }
    /^smokeCommands:[ \t]*$/ { inblk = 1; next }
    inblk {
      if (match($0, /^[ \t]+-[ \t]+/)) { s = substr($0, RLENGTH + 1); sub(/[ \t]+$/, "", s); if (s != "") print "N:" s; next }
      if ($0 ~ /^[ \t]*$/) next
      inblk = 0
    }
  ' "$1" 2>/dev/null || true
  return 0
}

smoke_cmds() {
  awk '
    /^smokeCommands:[ \t]*$/ { inblk = 1; next }
    inblk {
      if (match($0, /^[ \t]+-[ \t]+/)) { s = substr($0, RLENGTH + 1); sub(/[ \t]+$/, "", s); if (s != "") print s; next }
      if ($0 ~ /^[ \t]*$/) next
      inblk = 0
    }
  ' "$AIDEV/config.yml" 2>/dev/null || true
  # ↑ config.yml が無いと awk が非ゼロで返り、**関数の最後のコマンド**なので set -e が
  #   呼び出し側で発火する（このリポジトリで何度も踏んだ形）。必ず 0 で返す
  return 0
}
# 実行するコマンド一覧（smokeCommands があればそれ、無ければ smokeCommand 1 本）
smoke_list() {
  _sl=$(smoke_cmds)
  if [ -n "$_sl" ]; then printf '%s\n' "$_sl"; return 0; fi
  _s1=$(smoke_cmd)
  [ -n "$_s1" ] && printf '%s\n' "$_s1"
  return 0
}

# 起動確認は **work 全体（親＋全 subtask）の性質**なので、記録も家族の根に一本化する。
# 子の metrics に刻むと、着地する親の verify から見えず「記録が無い」と誤 FAIL する
# （被覆を `cov_root()` で家族単位にしたのと同じ理由。片方だけ work 単位だと非対称になる）。
smoke_root() { # -> 家族の根の work ディレクトリ
  _sp=$(yget "$WORK/state.yml" parent)
  if [ -n "$_sp" ] && [ -d "$AIDEV/works/$_sp" ]; then printf '%s' "$AIDEV/works/$_sp"
  else printf '%s' "$WORK"; fi
}
# smoke に許す最長秒数（`timeout` があるときだけ効く）
smoke_timeout() {
  _t=$(yget "$AIDEV/config.yml" smokeTimeoutSec)
  case "$_t" in ''|*[!0-9]*) _t=300 ;; esac
  [ "$_t" -ge 1 ] 2>/dev/null || _t=300
  printf '%s' "$_t"
}

# metrics.yml に残っている最後の smoke 結果（pass|fail|skip。無ければ空）
smoke_last() { # metrics_file
  [ -f "$1" ] || return 0
  grep 'event:[[:space:]]*smoke' "$1" 2>/dev/null | tail -n1 \
    | sed -n 's/.*result:[[:space:]]*\([a-z][a-z]*\).*/\1/p'
}

cmd_smoke() {
  sslug=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$sslug" ] && sslug=$1 || die "slug は1つだけ"; shift ;;
    esac
  done
  resolve_work "$sslug"
  _sc=$(smoke_cmd)
  _scl=$(smoke_list)
  [ -n "$_scl" ] && _sc=$(printf '%s\n' "$_scl" | head -n1)
  printf 'smoke: %s\n' "$SLUG"

  if [ -z "$_sc" ]; then
    # **黙って緑にしない**。検証していないことは「合格」ではない
    # （cc-sdd が `MANUAL_VERIFY_REQUIRED` を pass と分けているのと同じ）。
    printf 'FAIL smokeCommand が .aidev/config.yml にありません（起動確認を誰も見ていない状態です）\n' >&2
    printf 'next: 「成果物が最初の使える状態まで到達する」ことを確かめる**終了するコマンド**を書く\n' >&2
    printf '      （常駐するサーバなら health check を叩いて終わる形にする。起動しっぱなしにしない）\n' >&2
    printf '      起動確認の対象が無い PJ（純粋なライブラリ等）は smokeCommand: none と**明示**する\n' >&2
    printf '書式: 値は**行をそのまま**読む（YAML のエスケープもブロックスカラー `|` も解釈しない）。\n' >&2
    printf '      クォートで囲まないのが基本（全体を "…" で囲んだときだけ1組だけ外す）\n' >&2
    return 2
  fi
  # 記録先は家族の根（下記 smoke_root の注記）。WORK を一時的に差し替えて append_event に渡す
  _sw=$WORK; _ssl=$SLUG
  WORK=$(smoke_root)
  if [ "$WORK" != "$_sw" ]; then
    SLUG=$(basename "$WORK")
    printf 'note: 起動確認は work 全体の性質なので、記録は親 %s に刻みます\n' "$SLUG"
  fi

  if [ "$_sc" = none ]; then
    append_event test smoke result=skip
    WORK=$_sw; SLUG=$_ssl
    printf 'skip: smokeCommand: none（この PJ は起動確認の対象外と宣言されています）\n'
    return 0
  fi

  # 出力は**捕まえずに素通しする**。test 工程が `test-result.md` に貼るのは生の出力で、
  # ここで要約や整形を挟むと「そのまま貼った」が成立しなくなる。
  # **時間上限を掛ける**——常駐コマンドを書かれると自律実行がそこで永久に止まる。
  # 「終了するコマンドを書け」を散文だけに任せない（この harness が繰り返し採ってきた線）。
  # `timeout` が無い環境では掛けられないので、**その事実を出力に残す**（黙って無制限にしない）。
  _sto=$(smoke_timeout)
  _src=0; _sidx=0; _sfail=0; _sn=0
  _sold=$IFS; IFS='
'
  for _s1 in $_scl; do
    _sn=$((_sn+1))
    [ "$_sfail" -eq 0 ] || continue    # 1 本落ちたらそれ以降は走らせない（原因を1つに絞る）
    _sidx=$_sn
    printf '$ %s\n' "$_s1"
    set +e
    if command -v timeout >/dev/null 2>&1; then
      ( cd "$ROOT" && timeout "$_sto" sh -c "$_s1" )
    else
      ( cd "$ROOT" && sh -c "$_s1" )
    fi
    _src=$?
    set -e
    if [ "$_src" -ne 0 ]; then _sfail=$_sidx; fi
    if [ "$_src" -eq 124 ]; then
      printf 'note: %s 秒で打ち切りました（smokeTimeoutSec）。**終了するコマンド**を書くこと\n' "$_sto"
    fi
  done
  IFS=$_sold
  if [ "$_sfail" -eq 0 ]; then _srr=pass; else _srr=fail; fi
  # **何本走ったか**を刻む。`smoke: pass` だけだと、その pass が成果物のどこを通ったのかが
  # 後から分からない（起動確認の主張が証拠の範囲を超える）。設定は git に載っているので、
  # 本数と版が分かれば「その時点で何を確かめたか」が復元できる
  # **deliver 承認後でも刻む**。実走の報告が「着地済み work の記録を静かに書き換える」と指摘したので
  # 一度止めてみたところ、テストが 3 本落ちた——`verify` は smoke が失敗のままなら deliver 済でも FAIL し、
  # **それを解く唯一の手段が「直して smoke を打ち直す」**（`smoke` の記録が deliver ゲートの入力）。
  # 事後の追記を止めると、失敗したまま着地した work を直す経路そのものが消える。
  # 追記が測定を動かす懸念は本物だが、対価が「直せない FAIL」では釣り合わない
  if [ "$_sfail" -eq 0 ]; then
    append_event test smoke "result=$_srr" "exit_code=$_src" "commands=$_sn"
  else
    append_event test smoke "result=$_srr" "exit_code=$_src" "commands=$_sn" "failed_index=$_sfail"
  fi
  WORK=$_sw; SLUG=$_ssl
  if [ "$_sn" -gt 1 ]; then printf 'smoke: %s (exit %s, %s 本)\n' "$_srr" "$_src" "$_sn"
  else printf 'smoke: %s (exit %s)\n' "$_srr" "$_src"; fi
  [ "$_srr" = pass ] || return 4
  return 0
}

# --- コマンド: verify（version-aware） -----------------------------------------
verify_work() { # WORK already set; prints lines; returns 0 ok / 4 fail / 5 strict時の記録漏れ
  st="$WORK/state.yml"
  VF=""; EPW=""
  if [ ! -f "$st" ]; then printf '  FAIL state.yml なし\n'; return 4; fi
  for k in slug current approved; do
    grep -q "^$k:" "$st" || VF="$VF state.yml:$k欠落"
  done

  schema=$(yget "$st" schema)
  if [ -z "$schema" ]; then
    printf '  SKIP legacy (schema 未記載・metrics導入前の作業として免除)\n'
  else
    # schema >= 2 の不変条件
    if [ "$schema" -ge 2 ] 2>/dev/null; then
      [ -f "$WORK/metrics.yml" ] || VF="$VF metrics.yml欠落"
      if approved_has review; then [ -f "$WORK/review.md" ] || VF="$VF review.md欠落(review承認済)"; fi
      # 承認済み工程の成果物が実在するか（protocol.md「7.」の成果物列）。
      # ここを見ないと、**成果物を1つも作らずに全工程 approve した work が
      # 「deliver 済み・verify OK」になる**。deliver の着地前ゲートが verify なので、
      # SDD の最低限の前提（各工程が成果物を残す）が誰にも守られていなかった。
      # 親（subtasks を持つ）は tasks.md までで、tasks.md は子が持つ（aidev-30-tasks「4.」）
      _issub=$(yget "$st" parent)
      _hassub=$(ylist "$st" subtasks)
      if [ "$schema" -ge 5 ] 2>/dev/null; then
      # schema 9: light は design/plan を approve しない（protocol-light.md「上流 1 ゲートの規約」）
      # ので、承認を条件にした下の実在検査が **light では構造的に一度も走らない**。
      # 結果 requirements.md だけ書いた light work が verify OK で着地できていた（2026-09-04 実測）。
      # light の「4つとも作る・スタブは作らない」は散文にしか無く、二層（散文=ソフト /
      # CLI=ハード）の CLI 側が丸ごと欠けていた。requirements の承認をもって 4 文書を要求する。
      _vlight=no
      if [ "$schema" -ge 9 ] 2>/dev/null && [ "$(yget "$st" profile)" = light ] \
         && approved_has requirements; then _vlight=yes; fi
      for _pf in requirements:requirements.md design:design.md tasks:tasks.md; do
        _ph=${_pf%%:*}; _pfile=${_pf#*:}
        if ! approved_has "$_ph" && [ "$_vlight" = no ]; then continue; fi
        # subtask は親の requirements/design/architecture を継承する（aidev:need_file と同じ規則）
        if [ -f "$WORK/$_pfile" ]; then continue; fi
        if [ -n "$_issub" ] && [ -f "$AIDEV/works/$_issub/$_pfile" ]; then continue; fi
        VF="$VF $_pfile欠落($_ph承認済)"
      done
      if { approved_has tasks || [ "$_vlight" = yes ]; } && [ -z "$_hassub" ] && [ ! -f "$WORK/tasks.md" ]; then
        VF="$VF tasks.md欠落(tasks承認済)"
      fi
      fi
      # schema 6: test の成果物と、AC カバレッジ / tasks.md の整合。
      # test-result.md は「置き場を決めておかないと work ごとに変わり後から突き合わせられない」
      # ため aidev-50-test が名前を固定したもの。実在検査が無いと名前を決めた意味が無い。
      if [ "$schema" -ge 6 ] 2>/dev/null; then
        if approved_has test && [ ! -f "$WORK/test-result.md" ]; then
          VF="$VF test-result.md欠落(test承認済)"
        fi
        # 失敗の生証跡（cc-sdd の RED_PHASE_OUTPUT 相当）。差し戻しがあった=失敗を観測した
        # のに、その出力が残っていなければ「何が落ちていたか」は誰も再現できない。
        # 証跡の質は人の判断なので WARN 止まりで、有無だけを見る（``` のブロック）。
        if [ -f "$WORK/test-result.md" ] \
           && grep -Eq 'phase:[[:space:]]*test,.*event:[[:space:]]*sent_back' "$WORK/metrics.yml" 2>/dev/null \
           && ! grep -q '^```' "$WORK/test-result.md"; then
          printf '  WARN test で差し戻しがあったのに test-result.md に失敗の生出力が無い（``` のブロックで残すこと）\n'
        fi
        # 被覆は work 全体（親＋全 subtask）で見るので、**家族の根でだけ**報告する。
        # subtask ごとに回すと同じ gap が子の数だけ重複して出る
        if [ -z "$_issub" ] && cov_analyze; then
          if [ "$COV_GAPS_S" -gt 0 ]; then
            VF="$VF tasks.mdの参照が壊れている(${COV_GAPS_S}件)"
          fi
          if [ "$COV_GAPS_C" -gt 0 ] && cov_cover_enforced; then
            printf '  WARN AC 被覆に穴があります（%s 件）。詳細は aidev coverage\n' "$COV_GAPS_C"
          fi
        fi
      fi
      # schema 7: 起動確認（smoke）の記録。**テストが緑なだけでは着地の根拠にしない**
      # （cc-sdd: "A passing test suite alone is not enough for FEATURE_GO."）。
      # 検査するのは `smokeCommand` を**設定している PJ** だけ——設定していない PJ に
      # 毎 work 鳴かせると「直せない WARN」になる。未設定は doctor が PJ 単位で1行知らせる。
      if [ "$schema" -ge 7 ] 2>/dev/null && approved_has deliver; then
        # `smoke_cmd`（単数キーだけ）で見ると、**`smokeCommands` だけの PJ でこのゲートが
        # 黙って外れる**（実測）。`smoke` と `doctor` は既に smoke_list を使っている
        _vsc=$(smoke_list | head -n1)
        if [ -n "$_vsc" ] && [ "$_vsc" != none ]; then
          case "$(smoke_last "$(smoke_root)/metrics.yml")" in
            pass|skip) ;;
            fail) VF="$VF 起動確認が失敗のまま(aidev smoke が fail)" ;;
            *)    VF="$VF 起動確認の記録が無い(smokeCommand 設定済。aidev smoke を通すこと)" ;;
          esac
        fi
      fi
      # schema 8: 詰まりの扱い。
      # (a) 差し戻しが上限に達しているのに原因究明を挟んでいない = **同じコンテキストで回し続けた**（WARN）
      # (b) デバッグが stop_for_human で終わっているのに着地している = **人の判断を待たずに通した**（FAIL）
      if [ "$schema" -ge 8 ] 2>/dev/null; then
        _vmsb=$(dbg_max_send_backs)
        for _vp in $PHASES; do
          _vsb=$(dbg_sent_backs "$WORK/metrics.yml" "$_vp")
          # 差し戻しが1回も無い工程は対象外（`maxSendBacks: 0` の PJ で全工程が鳴るのを防ぐ。
          # `debug status` の due 列も同じ条件で絞っている）
          [ "$_vsb" -ge 1 ] 2>/dev/null || continue
          [ "$_vsb" -ge "$_vmsb" ] 2>/dev/null || continue
          [ "$(dbg_rounds "$WORK/metrics.yml" "$_vp")" -eq 0 ] || continue
          printf '  WARN %s の差し戻しが %s 回（上限 %s）だが原因究明の記録が無い: aidev debug start\n' \
            "$_vp" "$_vsb" "$_vmsb"
        done
        if approved_has deliver && [ "$(dbg_last_action "$WORK/metrics.yml")" = stop_for_human ]; then
          VF="$VF デバッグが stop_for_human のまま着地している（人の判断を待つ出口を素通りした）"
        fi
      fi
      if approved_has deliver; then
        grep -Eq 'phase:[[:space:]]*deliver.*event:[[:space:]]*approved|event:[[:space:]]*approved.*phase:[[:space:]]*deliver' "$WORK/metrics.yml" 2>/dev/null \
          || VF="$VF deliver承認イベントがmetricsに無い"
        # backlog 出自の消し込み（DESIGN「2.5」: backlog 行は deliver で [x]）。
        # 直接入口（aidev-00-start で backlog 項目を選ぶ）は batch と違い自動で [x] にしないため、
        # 閉じ忘れると「完了済みの項目を次の人が選ぶ」（2026-08-01 に実際に発生）。
        # 見るのは **[x] 行とその継続行に自分の slug が現れるか**（消し込みの根拠に works slug を
        # 併記する規約と同じもの）。ファイルのどこかに slug があるだけで通すと、
        # `- [ ] 次の課題 (needs: <slug>)` の未着手行で消し込み無しに着地できてしまう。
        # `backlog compact` が退避した archive/<name>-done.md も見る
        bl=$(yget "$st" backlog)
        if [ -n "$bl" ]; then
          blf="$AIDEV/backlog/$bl"
          [ -f "$blf" ] || blf="$AIDEV/backlog/archive/$bl"
          _bld="$AIDEV/backlog/archive/${bl%.md}-done.md"
          if [ ! -f "$blf" ] && [ ! -f "$_bld" ]; then
            VF="$VF backlog:${bl}が見つからない"
          else
            _blok=no
            if [ -f "$blf" ] && bl_done_has "$blf" "$SLUG"; then _blok=yes; fi
            if [ "$_blok" = no ] && [ -f "$_bld" ] && bl_done_has "$_bld" "$SLUG"; then _blok=yes; fi
            if [ "$_blok" = no ]; then
              VF="$VF backlog:${bl}に${SLUG}の消し込みが無い（[x] 行かその継続行に slug が要る）"
            fi
          fi
        fi
      fi
    fi
  fi

  # イベント対の検査（WARN。既存 work を壊さないよう終了コードは変えない）
  #
  # guard と event start が別コマンドなので、guard だけ実行して工程に入り
  # start を記録し忘れる事故が起きる（実際に review の start が両ラウンドとも
  # 欠落し、所要時間が導出できなくなった）。記録漏れは後から気付けないので、
  # deliver 前に verify が知らせる。
  if [ -f "$WORK/metrics.yml" ]; then
    EPW=$(event_pair_warnings "$WORK/metrics.yml")
    if [ -n "$EPW" ]; then printf '%s\n' "$EPW"; fi
  fi

  # profile: light の逸脱検査（WARN）
  light_warnings

  # autonomous は「重要判断を decisions.md に残す」ことになっている（protocol-autonomous.md）。
  # 散文でしか守られておらず、実走では 1 本が decisions.md 無しで着地して doctor も素通りした。
  # 人間が承認していない判断の唯一の証跡なので、欠落を見えるようにする（WARN 止まり）
  VMISS=""
  if [ "$(yget "$st" mode)" = autonomous ] && approved_has deliver && [ ! -f "$WORK/decisions.md" ]; then
    printf '  WARN autonomous なのに decisions.md が無い: 人間が承認していない判断の証跡が残らない\n'
    VMISS="yes"
  fi
  # schema 10: タスク点検を**どう実施したか**。委譲機構が無い環境では同一セッションで
  # 読み直すフォールバックが認められている（protocol-check.md）が、metrics 上で区別が付かないと
  # 「別コンテキストが見て 0 件」と「本人が読み直して 0 件」が同じ数字として足し上がり、
  # 点検の効果（protocol.md「8.」）を横断で測れない。件数を刻むなら形態も刻む
  if [ "$schema" -ge 10 ] 2>/dev/null && approved_has coding; then
    _vtc=$(mt_last_metric "$WORK/metrics.yml" coding task_checks)
    case "$_vtc" in ''|0) ;; *)
      if [ -z "$(mt_last_metric "$WORK/metrics.yml" coding task_check_mode)" ]; then
        printf '  WARN task_checks=%s なのに task_check_mode が無い: 委譲したのか同一セッションで読み直したのかが残らない（approve coding に task_check_mode=delegated|same_session）\n' "$_vtc"
        VMISS="yes"
      fi ;;
    esac
  fi

  # autonomous の上流文書は**必ず**独立点検する（protocol-check.md「3.3」(a)）。
  # coding は autonomous なら全タスク点検が必須なのに、上流4工程は「使わない場面」に入っていた
  # ——同じ文書が「上流で最も効く」と書いているのに優先順位が逆だった（他 PJ の retro が実測）。
  # 人間の目が入らない以上、点検を入れるかどうかを**書いた本人の裁量に委ねない**。
  #
  # **schema 11 以降だけ**。旧 work にも WARN を出す案を一度入れたが撤回した——
  # 報告元の retro が「その時点のハーネスに doccheck が無かっただけで、規約違反ではない」と
  # 訂正してきたため。**承認済みの工程に後から点検は掛けられない**ので、旧 work では
  # この WARN は永久に鳴り続けて直せない。またがり検知を `note:` に落としたのと同じ判断
  # （直せない事実を毎回混ぜると、直せる WARN がノイズに埋もれる）。
  if [ "$schema" -ge 11 ] 2>/dev/null && [ "$(yget "$st" mode)" = autonomous ] \
     && [ "$(yget "$st" profile)" != light ]; then
    for _vdp in requirements design architecture tasks; do
      approved_has "$_vdp" || continue
      [ -f "$WORK/$_vdp.md" ] || continue
      if [ -z "$(mt_last_metric "$WORK/metrics.yml" "$_vdp" doc_check_mode)" ]; then
        printf '  WARN %s を autonomous で承認したのに独立点検の記録がありません（aidev doccheck start %s --mode <delegated|same_session>）\n' "$_vdp" "$_vdp"
        VMISS="yes"
      fi
    done
  fi

  # `start` を打ったのに `report` が無い＝「点検して 0 件」と見分けが付かない状態。
  # 断念は認められている（形式不正で 2 回崩れたら諦める）が、**その痕跡が残らない**のが問題。
  # 数え方は既に直してある（report まで届いたものだけ数える）ので、ここは事実の通知
  if [ -f "$WORK/metrics.yml" ]; then
    ck_unreported_warn taskcheck タスク "$(tc_unreported "$WORK/metrics.yml")"
    ck_unreported_warn doccheck  工程   "$(dc_unreported "$WORK/metrics.yml")"
  fi

  # 点検で見つけた件数を刻んだのに、**内容が review.md に残っていない**。
  # 件数だけでは「何を直したか」が辿れず、条項の効果判定（`[conv:…]` タグ）も拾えない。
  # 件数そのものの正しさは検査できない（1 指摘を 2 行に割る等は記録側の妥当な判断）ので、
  # **節が丸ごと無い**という明白な欠落だけを見る（retro の指摘を、誤検知しない形に絞った）
  if [ -f "$WORK/metrics.yml" ]; then
    _vtf=$(mt_last_metric "$WORK/metrics.yml" coding task_check_findings)
    case "$_vtf" in ''|0) ;; *)
      if [ ! -f "$WORK/review.md" ] || ! grep -q 'タスク点検ログ' "$WORK/review.md" 2>/dev/null; then
        printf '  WARN task_check_findings=%s なのに review.md に「タスク点検ログ」節がありません: 件数だけ残り、何を直したかが辿れない\n' "$_vtf"
      fi ;;
    esac
  fi

  # またがり work の検知（WARN）。schema 4 以降のみ＝旧 work を遡って違反扱いしない。
  # 着手時と着地時でハーネス版が違う work は、改修の効果を半分しか受けていない。
  # 気付かずに母集団へ入れると効果検証が鈍るので、ここで見えるようにしておく。
  vsc=$(yget "$WORK/state.yml" schema)
  case "$vsc" in ''|*[!0-9]*) vsc=0 ;; esac
  if [ "$vsc" -ge 4 ]; then
    hr0=$(hr_get "$WORK/state.yml")
    hr1=$(hr_get "$WORK/state.yml" harnessRevDelivered)
    # `harnessRevDelivered` を書くのは **approve deliver**、verify が走るのは **その前**。
    # 着地時の刻印を待つ書き方だと、この検査は通常の順序では一度も発火しない。
    # まだ無いときは**今の版**と比べる（このまま deliver すればそれが着地時の版になる）。
    hrw=着地時
    if [ -z "$hr1" ]; then hr1=$(harness_rev); hrw=現在; fi
    if [ -z "$hr0" ]; then
      printf '  WARN harnessRev が無い: 効果検証の母集団から漏れる（aidev new で刻まれる）\n'
    elif [ "$hrw" = 現在 ] && [ "$hr0" != "$hr1" ] && [ "$hr0" != unknown ] && [ "$hr1" != unknown ]; then
      # 鳴らすのは **deliver 前**（いま気付けば意味がある）だけ。deliver 済みのまたがりは事実として
      # state.yml に刻まれており `metrics --all` の straddle 列で層別できるので、doctor を回すたびに
      # 履歴 work ぶん永久に出し続けない（100 works で数十行のノイズになっていた）
      # WARN ではなく note。またがりは**事後に取り消せない事実**で、人が直せることが無い。
      # verify の WARN（記録漏れ・light 逸脱）はどれも「いま直せる」もので、そこに直せない
      # 事実を毎回混ぜると——ハーネスを1回コミットしただけで in-flight 全 work が鳴き続ける——
      # 直せる WARN がノイズに埋もれる。事実の通知は approve deliver の note: と同じ扱いにする
      printf '  note: またがり work: ハーネス版が着手時(%s)と%s(%s)で異なる。効果検証の母集団からは除外される\n' "$hr0" "$hrw" "$hr1"
    fi
  fi


  if [ -n "$VF" ]; then printf '  FAIL%s\n' "$VF"; return 4; fi
  # --strict: **記録漏れだけ**を致命扱いにする（Stop フック等の機械ゲート用）。
  # 記録漏れは「今しか直せない」（metrics は追記のみで、当時の時刻は復元できない）。
  # 対して light の逸脱は人間の判断（昇格するか）なので strict でも致命にしない。
  # 記録漏れは event の start だけではない。**そのとき書かなければ二度と書けない**ものは
  # 同じ扱いにする——decisions.md（当時どう判断したか）とタスク点検の実施形態がそれ。
  # どちらも schema 10 以降の work だけを対象にする（旧 work を遡って落とさない）
  if [ "${STRICT:-no}" = yes ] && { [ -n "$EPW" ] || { [ "$schema" -ge 10 ] 2>/dev/null && [ -n "$VMISS" ]; }; }; then
    printf '  FAIL(strict) 記録漏れ: 上記 WARN を解消してから終えること（timestamp は後から復元できません）\n'
    return 5
  fi
  printf '  OK\n'; return 0
}

# profile=light の条件逸脱を WARN で知らせる（終了コードには影響しない）。
#
# light は「振る舞い不変・小規模」を前提にした軽量プロファイル（protocol.md「11.」）。
# 条件を外れたら full へ昇格するのが正だが、**昇格漏れは後から気付けない**
# （light のまま着地すると、insights の「light の手戻り率」が実態より良く見える）。
# 判定は事後なので WARN 止まりにし、硬いゲートは既存の verify の判定に任せる。
light_warnings() { # WORK/SLUG は解決済み
  [ -f "$WORK/state.yml" ] || return 0
  [ "$(yget "$WORK/state.yml" profile)" = light ] || return 0
  mf="$WORK/metrics.yml"
  [ -f "$mf" ] || return 0

  # 任意工程を使った＝「小規模」の前提を外れている（protocol.md「11.」任意工程）
  for p in research architecture walkthrough; do
    if grep -Eq "phase:[[:space:]]*$p," "$mf" 2>/dev/null; then
      printf '  WARN profile=light だが任意工程 %s を実施（aidev escalate で full へ）\n' "$p"
    fi
  done

  # 上流を畳んでいない＝light の指紋（protocol-light.md「metrics 上は design / tasks の start が
  # 無いこと」）から外れている。定義しておいて機械が見ていないと、light を名乗ったまま
  # full の往復をした work が「light は速い」の母数に入る
  for p in design tasks; do
    if grep -Eq "phase:[[:space:]]*$p,.*event:[[:space:]]*start" "$mf" 2>/dev/null; then
      printf '  WARN profile=light だが %s を個別に起動（light は requirements 1ゲートに畳む）\n' "$p"
    fi
  done

  # 変更規模が上限超過（deliver の files_changed。上限は .aidev/config.yml の lightMaxFiles、既定 3）
  max=$(yget "$AIDEV/config.yml" lightMaxFiles)
  case "$max" in ''|*[!0-9]*) max=3 ;; esac
  fc=$(grep -E 'phase:[[:space:]]*deliver,' "$mf" 2>/dev/null | grep -E 'event:[[:space:]]*approved' \
        | sed -n 's/.*files_changed:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | tail -n1)
  if [ -n "$fc" ] && [ "$fc" -gt "$max" ] 2>/dev/null; then
    printf '  WARN profile=light だが変更 %s ファイル（上限 %s）。aidev escalate で full へ\n' "$fc" "$max"
  fi
  return 0
}

# metrics.yml のイベント対を検査し、WARN 行を出す（終了コードには影響しない）。
event_pair_warnings() { # metrics_file
  awk -v phases="$PHASES" '
    match($0, /phase:[[:space:]]*[a-z]+/) {
      p = substr($0, RSTART, RLENGTH); sub(/phase:[[:space:]]*/, "", p)
      if (!(p in seen)) { seen[p] = ++nseen; order[nseen] = p }
      if ($0 ~ /event:[[:space:]]*start/)    starts[p]++
      # `amend: yes` は**同じラウンドの刻み直し**（訂正）なので、ラウンドとして数えない。
      # 数えると「approve を打ち直せ」という WARN の指示が別の WARN を生む
      if ($0 ~ /event:[[:space:]]*approved/ && $0 !~ /amend:[ \t]*yes/) approved[p]++
    }
    function emit(p) {
      if (starts[p] == 0)
        printf "  WARN %s: approved があるのに start が無い（所要時間が導出できません）\n", p
      else if (starts[p] < approved[p])
        # 原因は2つある。start の記録漏れ「または」二重 approve で、後者は start を足しても
        # 直らない。一律に「start の記録漏れ」と言うと、指示どおり直しても解消しない
        printf "  WARN %s: start %d 回に対し approved %d 回（start の記録漏れ、または approve の重複）\n", p, starts[p], approved[p]
    }
    END {
      # 出力順は PHASES 順（未知の phase は初出順で後ろに）。ハッシュの列挙順（for (p in ...)）に
      # 任せると awk と PowerShell で並びが変わり「出力を一致させる」契約が破れる。
      n = split(phases, ord, " ")
      for (i = 1; i <= n; i++) { p = ord[i]; if (p in approved) { emit(p); known[p] = 1 } }
      for (i = 1; i <= nseen; i++) { p = order[i]; if ((p in approved) && !(p in known)) emit(p) }
    }
  ' "$1"
  return 0
}

cmd_verify() {
  STRICT=no; vslug=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --strict) STRICT=yes; shift ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$vslug" ] && vslug=$1 || die "slug は1つだけ"; shift ;;
    esac
  done
  resolve_work "$vslug"
  _vroot=$WORK; _vrslug=$SLUG
  printf 'verify: %s\n' "$SLUG"
  verify_work; rc=$?
  # 分割 work の親を verify するときは**子も見る**。着地するのは親1本の PR なので、
  # 子だけ記録が欠けていても素通りしてしまう（protocol.md「6.」は metrics/review を
  # 子にも必須と定めている）。数え方を doctor と揃える
  for _sd in "$_vroot"/*/; do
    [ -d "$_sd" ] || continue
    [ -f "${_sd}state.yml" ] || continue
    WORK=${_sd%/}; SLUG="$_vrslug/$(basename "$WORK")"
    printf 'verify: %s\n' "$SLUG"
    verify_work || { _vc=$?; [ "$rc" -eq 0 ] && rc=$_vc; }
  done
  WORK=$_vroot; SLUG=$_vrslug
  STRICT=no
  return $rc
}

# --- コマンド: escalate（profile: light -> full。片方向） -------------------------
# state.yml の更新を CLI に集約するための経路（この CLI の役割定義。冒頭コメント参照）。
# 手編集を許すと「どの work がいつ昇格したか」が state だけ見ても分からなくなる。
cmd_escalate() {
  resolve_work "${1:-}"
  st="$WORK/state.yml"
  cur=$(yget "$st" profile)
  [ -n "$cur" ] || cur=full   # 未記載 = full（profile 導入前の work）
  case "$cur" in
    light) ;;
    full)  die "既に profile=full です（昇格は片方向。full -> light は不可）: $SLUG" ;;
    *)     die "未知の profile: $cur" ;;
  esac
  set_or_append "$st" profile "profile: full"
  printf 'escalated: %s (light -> full)\n' "$SLUG"
  printf 'next: 省略していた節を各文書に足す / decisions.md に経緯を残す /\n'
  printf '      該当工程の承認に escalated_from_light=1 を付ける（protocol.md「11.」）\n'
}

# --- コマンド: unapprove ------------------------------------------------------
# 差し戻しで無効化される後工程の承認を取り消す。**なぜ CLI に置くか**: 元は
# 「approved から手で除く（CLI に削除は設けていない）」だったが、それは escalate を
# 作った理由（state.yml の更新を CLI に集約する。手編集を許すと state だけ見ても
# 経緯が分からなくなる）と正面から矛盾する。しかも 60-review の統合差し戻し手順は
# 「子の approved から review を外す」を要求しており、**手段が無いまま手順だけがあった**。
#
# 取り消しは**記録を消さない**。metrics の approved イベントはそのまま残し、
# 取り消し自体を `sent_back` イベントとして刻む（手戻りは実際に起きた事実なので、
# 消すと `reworks` / `sent_backs` が過小になる。protocol.md「8.」）。
cmd_unapprove() {
  uslug=""; uph=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug) need_arg "$1" $#; uslug=$2; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$uph" ] && uph=$1 || die "工程は1つだけ"; shift ;;
    esac
  done
  [ -n "$uph" ] || die "使用法: aidev unapprove <phase> [--slug <work>]"
  is_phase "$uph" || die "未知の工程: $uph"
  resolve_work "$uslug"
  st="$WORK/state.yml"
  approved_has "$uph" || die "承認されていません: $uph @ $SLUG"

  # approved から当該工程だけを外す（順序は保つ）
  newl=""
  for p in $(ylist "$st" approved); do
    [ "$p" = "$uph" ] && continue
    if [ -z "$newl" ]; then newl="$p"; else newl="$newl, $p"; fi
  done
  replace_line "$st" approved "approved: [$newl]"
  # カーソルは取り消した工程へ戻す（そこからやり直すのが差し戻しの意味）
  replace_line "$st" current "current: $uph"
  # 取り消しは手戻りの事実。イベントとして刻む（消さない）。
  # ただし `by: unapprove` を併記する——差し戻しの**原因**は指摘のあった 1 工程で、
  # 後工程の取り消しはその**結果**だから。区別しないと (a) 一度も失敗していない
  # coding/test が maxSendBacks の予算を消費し（review 3 往復で 3 工程が同時に上限到達）、
  # (b) 規約どおり unapprove した work だけ sent_backs が 1 でなく 3 になり、
  # work 間で比較できなくなる（2026-09-04 の実走で両方を実測）。
  append_event "$uph" sent_back by=unapprove
  printf 'unapproved: %s @ %s\n' "$uph" "$SLUG"
  printf 'next: やり直す工程で aidev event <phase> start を記録すること（統合 review からの差し戻しは coding）\n'

  # 子の review を外したら、親のカーソルもその子へ戻す（60-review の統合差し戻し手順）
  par=$(yget "$st" parent)
  if [ -n "$par" ] && [ "$uph" = review ] && [ -d "$AIDEV/works/$par" ]; then
    set_or_append "$AIDEV/works/$par/state.yml" activeSubtask "activeSubtask: $(basename "$WORK")"
    printf 'cursor: 親 %s の activeSubtask を %s に戻した\n' "$par" "$(basename "$WORK")"
  fi
}

# --- backlog ファイル横断検査（doctor の一部） ------------------------------------
# verify の消し込み検査は **work にぶら下がる**（自分が刻んだファイルに自分の slug があるか）。
# 対して退避・frontmatter・項目の書式は **ファイル自身の一生**の話で、持ち主の work がいない。
# そのため誰も見ておらず、「入口が2つあって片方だけ自動」（2026-08-01 の穴）がファイル単位で
# 再発する形になっていた（batch は split を退避するが、直接入口は退避しない）。
# ここは事後検知なので WARN 止まりにし、exit code は works の fail だけで決める（硬ゲートは verify）。
bl_kind() { # file -> 先頭 frontmatter の kind（frontmatter 自体が無ければ空）
  awk 'NR==1 && $0 !~ /^---[[:space:]]*$/ {exit}
       NR==1 {next}
       /^---[[:space:]]*$/ {exit}
       /^kind:[[:space:]]*/ {sub(/^kind:[[:space:]]*/,""); sub(/[[:space:]]*$/,""); print; exit}' "$1" 2>/dev/null
}

# 消し込み検査: **[x] 行とその継続行**（次の項目・見出し・空行まで）に slug があるか
bl_done_has() { # file slug -> 0=あり / 1=なし
  awk -v s="$2" '
    /^[[:space:]]*- \[[xX]\]/ { inx=1 }
    /^[[:space:]]*- \[[^xX]\]/ || /^#/ || /^[[:space:]]*$/ { inx=0 }
    inx && index($0, s) { found=1; exit }
    END { exit found ? 0 : 1 }' "$1" 2>/dev/null
}

# backlog ファイル1件の数え上げ。**status と同じ glob** を使う（status に見えている姿を検査対象にする）。
bl_stat() { # file -> BL_TODO / BL_DN / BL_HID / BL_KIND
  BL_TODO=$(grep -c '^[[:space:]]*- \[ \]' "$1" 2>/dev/null || true); BL_TODO=${BL_TODO:-0}
  BL_DN=$(grep -c '^[[:space:]]*- \[[xX]\]' "$1" 2>/dev/null || true); BL_DN=${BL_DN:-0}
  BL_HID=$(grep -cE '^(#+[[:space:]]*- |[[:space:]]*[*+][[:space:]]*)\[[ xX]\]' "$1" 2>/dev/null || true); BL_HID=${BL_HID:-0}
  BL_KIND=$(bl_kind "$1")
}

# 退避してよいか＝**消化しきったら終わるキュー**（split/topic）で全項目 [x]。
# doctor の WARN と backlog archive の実行が**同じ判定**を通るようにここに集約する
#（検査だけあって実行が無い、という形を作らないため）。
bl_archivable() { # file -> 0=退避可 / 1=不可（BL_* も設定する）
  bl_stat "$1"
  case "$BL_KIND" in split|topic) ;; *) return 1 ;; esac
  [ "$BL_TODO" -eq 0 ] && [ "$BL_DN" -gt 0 ]
}

doctor_backlog() {
  [ -d "$AIDEV/backlog" ] || return 0
  bfiles=0; barch=0; bwarn=0; bout=""
  for f in "$AIDEV/backlog"/*.md "$AIDEV/backlog/archive"/*.md; do
    [ -f "$f" ] || continue
    case "$f" in
      "$AIDEV/backlog/archive/"*) arch=yes; label="archive/$(basename "$f")"; barch=$((barch+1)) ;;
      *)                          arch=no;  label=$(basename "$f");          bfiles=$((bfiles+1)) ;;
    esac
    bl_stat "$f"; todo=$BL_TODO; dn=$BL_DN; hid=$BL_HID; kind=$BL_KIND
    w=""
    if [ "$arch" = no ]; then
      # kind は**ファイルの一生の宣言**。無いと退避の要否が決まらず、毎回人が判断し直すことになる。
      # standing=また積まれる（退避しない） / split・topic=消化しきったら終わる（退避する）。
      case "$kind" in
        "")
          w="$w    WARN frontmatter(kind)が無い: standing/split/topic を判定できず退避の要否が決まらない
" ;;
        standing) : ;;
        split|topic)
          if [ "$todo" -eq 0 ] && [ "$dn" -gt 0 ]; then
            w="$w    WARN 全消化($kind)だが未退避: .aidev/backlog/archive/ へ移す
"
          fi ;;
        *)
          # 誤記を黙って standing 扱いにしない（退避検査がまるごと効かなくなるため）
          w="$w    WARN 未知の kind: $kind（standing/split/topic のいずれか）
" ;;
      esac
    elif [ "$todo" -gt 0 ]; then
      # archive/ は status の *.md グロブから外れる＝ここに残った未着手は誰の目にも入らない
      w="$w    WARN archive 済だが未消化が ${todo} 件: status から外れて見えない未着手になっている
"
    fi
    if [ "$hid" -gt 0 ]; then
      w="$w    WARN status が数えない書式の項目が ${hid} 件（見出し '## - [ ]' や '*' 箇条書き）: 未着手が status から漏れる
"
    fi
    if [ -n "$w" ]; then
      bwarn=$((bwarn+1))
      bout="$bout- $label (todo=$todo done=$dn kind=${kind:--})
$w"
    fi
  done
  printf 'backlog: ファイル横断検査\n'
  if [ -n "$bout" ]; then printf '%s' "$bout"; fi
  printf 'backlog-summary: files=%s archived=%s warn=%s\n' "$bfiles" "$barch" "$bwarn"
}

# --- コマンド: doctor ---------------------------------------------------------
# 1 work ぶんの検査と出力。--quiet では「  OK」だけの work を行ごと出さない
# （100 works で 9 割が OK 行になり、直すべき WARN が埋もれる）
doctor_one() { # label
  _vo=$(verify_work) && _vr=0 || _vr=$?
  [ "$_vr" -eq 0 ] || fail=$((fail+1))
  if [ "$DQUIET" = yes ] && [ "$_vo" = "  OK" ]; then return 0; fi
  printf '%s\n' "$1"
  printf '%s\n' "$_vo"
}

cmd_doctor() {
  DQUIET=no
  while [ $# -gt 0 ]; do
    case "$1" in
      --quiet) DQUIET=yes; shift ;;
      -*) die "未知のオプション: $1" ;;
      *) die "doctor は位置引数を取りません: $1" ;;
    esac
  done
  # works が無いのは**導入直後の正常な状態**。ここで die すると、
  # backlog / 条項 / ハーネス改修 / 起動確認 / sharedFiles という **PJ 単位の検査が
  # 1 つも走らない**（bin/README「検査順」は works の有無と無関係のはずだった）。
  # 「導入が正しくできたか」を doctor で確かめられないのが実際に困った点なので、
  # works が無い場合は works 節だけ空で出して先へ進む
  if [ ! -d "$AIDEV/works" ]; then
    printf 'doctor: 全 work 横断検査\n'
    printf 'summary: works=0 fail=0 legacy(免除)=0\n'
    printf 'note: work がまだありません（.aidev/works 未作成）。aidev new で最初の work を起こす\n'
    doctor_backlog; doctor_conventions; doctor_harness; doctor_smoke; doctor_shared; doctor_gitignore; doctor_hrstraddle; doctor_hrsentinel; doctor_branch
    exit 0
  fi
  total=0; fail=0; legacy=0
  printf 'doctor: 全 work 横断検査%s\n' "$([ "$DQUIET" = yes ] && printf '（--quiet: OK は省略）' || true)"
  for d in "$AIDEV/works"/*/; do
    [ -d "$d" ] || continue
    WORK=${d%/}; SLUG=$(basename "$WORK")
    total=$((total+1))
    sc=$(yget "$WORK/state.yml" schema 2>/dev/null || true)
    [ -z "$sc" ] && legacy=$((legacy+1))
    doctor_one "- $SLUG"
    # subtask（ネスト1段）も横断検査する
    for sd in "$d"*/; do
      [ -d "$sd" ] || continue
      [ -f "${sd}state.yml" ] || continue
      WORK=${sd%/}; SLUG="$(basename "$d")/$(basename "$WORK")"
      total=$((total+1))
      ssc=$(yget "$WORK/state.yml" schema 2>/dev/null || true)
      [ -z "$ssc" ] && legacy=$((legacy+1))
      doctor_one "  - $SLUG"
    done
  done
  printf 'summary: works=%s fail=%s legacy(免除)=%s\n' "$total" "$fail" "$legacy"
  doctor_backlog
  doctor_conventions
  doctor_harness
  doctor_smoke
  doctor_shared
  doctor_gitignore
  doctor_hrstraddle
  doctor_hrsentinel
  doctor_branch
  # exit code は 4（不変条件違反）に揃える。1 は「使用法・環境エラー」に割り当てられているので、
  # exit code で分岐する機械ゲートが「ドリフト検知」を「環境が壊れている」と誤読する
  [ "$fail" -eq 0 ] || return 4
  return 0
}

# --- コマンド: status（読み取り専用・works横断＋backlog未着手） ---------------------
STD_PIPELINE="requirements design tasks coding test review deliver"

# タブ区切り行（先頭にヘッダ含む）を列幅で揃えて出力
fmt_table() {
  awk -F'\t' '
    { for(i=1;i<=NF;i++){ cell[NR,i]=$i; if(length($i)>w[i])w[i]=length($i) }
      if(NF>maxnf)maxnf=NF; nr=NR }
    END{ for(r=1;r<=nr;r++){ line=""
        for(i=1;i<=maxnf;i++){ c=cell[r,i]
          if(i<maxnf){ pad=w[i]-length(c); s=c; while(pad-->0)s=s" "; line=line s"  " }
          else line=line c }
        print line } }'
}

# 親 work dir の subtask 進捗を "N M"（N=review承認済の子数 / M=総数）で返す。subtasks 無しは空。
subtask_progress() { # work_dir
  _subs=$(ylist "$1/state.yml" subtasks)
  [ -z "$_subs" ] && return 0
  _m=0; _n=0
  for _s in $_subs; do
    _m=$((_m+1))
    case " $(ylist "$1/$_s/state.yml" approved) " in *" review "*) _n=$((_n+1)) ;; esac
  done
  printf '%s %s' "$_n" "$_m"
  return 0
}

cmd_status() {
  fmt=table; subflag=no; activef=no
  while [ $# -gt 0 ]; do
    case "$1" in
      --format) need_arg "$1" $#; fmt=${2:-}; shift 2 ;;
      --subtasks) subflag=yes; shift ;;
      --active) activef=yes; shift ;;
      -*) die "未知のオプション: $1" ;;
      *) die "status は位置引数を取りません: $1" ;;
    esac
  done
  case "$fmt" in table|tsv) ;; *) die "--format は table|tsv" ;; esac

  # ---- works 収集（rows は型タグ付き: W=work 行 / S=subtask 子行） ----
  wn=0; wrows=""
  if [ -d "$AIDEV/works" ]; then
    for d in "$AIDEV/works"/*/; do
      [ -d "$d" ] || continue
      dir=${d%/}; name=$(basename "$dir"); st="$dir/state.yml"
      [ -f "$st" ] || continue
      ticket=$(yget "$st" ticket);   [ -z "$ticket" ]  && ticket=-
      mode=$(yget "$st" mode);       [ -z "$mode" ]     && mode=-
      current=$(yget "$st" current); [ -z "$current" ]  && current=-
      appr=$(ylist "$st" approved)
      case " $appr " in *" deliver "*) wdone=yes ;; *) wdone=no ;; esac
      # --active: deliver 済みは出さない（100 works で 9 割が done=yes になり、進行中が埋もれる）
      if [ "$activef" = yes ] && [ "$wdone" = yes ]; then continue; fi
      next=-
      if [ "$wdone" = no ]; then
        # profile: light は design/plan を畳む（protocol.md「11.」＝承認されないのが正常）。
        # 素通しすると next が永久に design を指し、20-design 自身が「light では起動しない」と
        # 書いている工程を案内し続けることになる
        _pipe=$STD_PIPELINE
        if [ "$(yget "$st" profile)" = light ]; then
          _pipe="requirements coding test review deliver"
        fi
        for p in $_pipe; do
          case " $appr " in *" $p "*) ;; *) next=$p; break ;; esac
        done
      fi
      # subtask を持つ親は next を subtask 進捗に差し替える（未完=sub N/M、全完了=統合工程の次）
      sp=$(subtask_progress "$dir")
      if [ -n "$sp" ] && [ "$wdone" = no ]; then
        spn=${sp% *}; spm=${sp#* }
        if [ "$spn" -lt "$spm" ]; then
          next="sub $spn/$spm"
        else
          next=-   # 全 subtask 完了 → coding は子が実施済。統合工程(test/review/deliver)の次を示す
          for p in test review deliver; do
            case " $appr " in *" $p "*) ;; *) next=$p; break ;; esac
          done
        fi
      fi
      eval_depends "$dir"
      deps=""
      for u in $EVAL_UNMET; do deps="$deps,$u"; done
      for a in $EVAL_ADVISORY; do deps="$deps,$a(advisory)"; done
      deps=${deps#,}; [ -z "$deps" ] && deps=ok
      wn=$((wn+1))
      wrows="${wrows}W	$name	$ticket	$mode	$current	$next	$wdone	$deps
"
      # --subtasks: 親直下に子を列挙（S 行。current=子の工程 / done=子の review 承認）
      if [ "$subflag" = yes ] && [ -n "$sp" ]; then
        for cs in $(ylist "$st" subtasks); do
          cst="$dir/$cs/state.yml"
          ccur=$(yget "$cst" current); [ -z "$ccur" ] && ccur=-
          case " $(ylist "$cst" approved) " in *" review "*) cdone=yes ;; *) cdone=no ;; esac
          wrows="${wrows}S	$name	$cs	$ccur	$cdone
"
        done
      fi
    done
  fi

  # ---- in-flight 収集: backlog 刻印を持ち、まだ deliver していない work ----
  # backlog 行が [x] になるのは deliver（`aidev-70-deliver`「3.5」）なので、着手から着地までの間、
  # backlog 側は**掴まれている項目と素の未着手を区別できない**。新規セッションがそこで同じ項目を
  # 二重に選ぶのが 2026-08-01 の事故の再発経路なので、件数を status に出して着手前に見せる。
  inflight=""
  # **worktree を横断して数える**。work は自分のブランチ上にしか無いので、ここを現在の tree だけに
  # すると、並行 worktree で進行中の項目が 0 と出る——二重選択を防ぐための列が、
  # 並行作業という当の場面でだけ効かない（実走で確認）。git が無ければ現在の tree だけ見る。
  _iroots="$AIDEV/works"
  if command -v git >/dev/null 2>&1; then
    _iwt=$(wt_porcelain 2>/dev/null || true)
    if [ -n "$_iwt" ]; then
      _oi=$IFS; IFS='
'
      for _il in $_iwt; do
        _ip=${_il%%	*}
        [ -d "$_ip/.aidev/works" ] || continue
        case " $_iroots " in *" $_ip/.aidev/works "*) continue ;; esac
        # 同じ .aidev を指す tree（main tree 自身）を二重に数えない
        [ "$_ip/.aidev/works" = "$AIDEV/works" ] && continue
        _iroots="$_iroots $_ip/.aidev/works"
      done
      IFS=$_oi
    fi
  fi
  HELD_ROWS=""
  for _ir in $_iroots; do
    [ -d "$_ir" ] || continue
    for d in "$_ir"/*/; do
      [ -d "$d" ] || continue
      _ist="${d}state.yml"; [ -f "$_ist" ] || continue
      _ibl=$(yget "$_ist" backlog); [ -n "$_ibl" ] || continue
      _iitem=$(yget "$_ist" backlogItem)
      _islug=$(basename "${d%/}")
      case " $(ylist "$_ist" approved) " in
        *" deliver "*) _idone=着地済 ;;
        *)             _idone=作業中; inflight="$inflight$_ibl
" ;;
      esac
      # 行単位の保持状況。**deliver 済みも載せる**——deliver は PR 作成で終わりで、
      # マージするまで `[x]` は main tree に来ない。そこが `inflight` の死角だった
      # （`todo` に戻り `inflight` からは外れるので、台帳だけ見ると未着手に見える）
      [ -n "$_iitem" ] && HELD_ROWS="$HELD_ROWS$_iitem	$_islug	$_idone
"
    done
  done

  # ---- backlog 収集（archive/ はサブディレクトリのため *.md グロブで自動除外） ----
  bf=0; bn=0; brows=""
  if [ -d "$AIDEV/backlog" ]; then
    for f in "$AIDEV/backlog"/*.md; do
      [ -f "$f" ] || continue
      fname=$(basename "$f")
      todo=$(grep -c '^[[:space:]]*- \[ \]' "$f" 2>/dev/null || true); todo=${todo:-0}
      needs=$(grep '^[[:space:]]*- \[ \]' "$f" 2>/dev/null | grep -c '(needs:' || true); needs=${needs:-0}
      # -xF: ファイル名の '.' を正規表現として解釈させない
      inf=$(printf '%s' "$inflight" | grep -cxF "$fname" 2>/dev/null || true); inf=${inf:-0}
      bf=$((bf+1)); bn=$((bn+todo))
      brows="$brows$fname	$todo	$needs	$inf
"
    done
  fi

  if [ "$fmt" = tsv ]; then
    printf '%s' "$wrows" | while IFS='	' read -r ty a b c e f g h; do
      [ -z "$ty" ] && continue
      if [ "$ty" = W ]; then
        printf 'work\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$a" "$b" "$c" "$e" "$f" "$g" "$h"
      else  # S: a=親 b=子 c=current e=done
        printf 'subtask\t%s/%s\t%s\t%s\n' "$a" "$b" "$c" "$e"
      fi
    done
    printf '%s' "$brows" | while IFS='	' read -r a b c e; do
      [ -z "$a" ] && continue
      printf 'backlog\t%s\t%s\t%s\t%s\n' "$a" "$b" "$c" "$e"
    done
    return 0
  fi

  printf 'WORKS (%s)\n' "$wn"
  if [ "$wn" -gt 0 ]; then
    {
      printf 'work\tticket\tmode\tcurrent\tnext\tdone\tdeps\n'
      printf '%s' "$wrows" | while IFS='	' read -r ty a b c e f g h; do
        [ -z "$ty" ] && continue
        if [ "$ty" = W ]; then
          printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$a" "$b" "$c" "$e" "$f" "$g" "$h"
        else  # S: 子をインデント行で（a=親 b=子 c=current e=done）
          printf '  ↳ %s\t-\t-\t%s\t-\t%s\t-\n' "$b" "$c" "$e"
        fi
      done
    } | fmt_table
  fi
  printf '\n'
  printf 'BACKLOG (未着手 %s 件)\n' "$bn"
  if [ "$bf" -gt 0 ]; then
    { printf 'file\ttodo\tneeds\tinflight\n'; printf '%s' "$brows"; } | fmt_table
  fi
  # 行単位の保持状況。`inflight` はファイル単位の件数しか言えないので、
  # **どの行が空いているか**はここを見る（`--backlog-item` を渡した work だけ載る）
  if [ -n "${HELD_ROWS:-}" ]; then
    # 表にしない。項目は自由文（多バイト・長さまちまち）で、桁揃えは sh と ps1 で
    # 幅の数え方が違い出力が割れる。1 行 1 件の素の並びにする
    printf 'HELD (掴まれている項目)\n'
    printf '%s' "$HELD_ROWS" | LC_ALL=C sort | while IFS='	' read -r _hi _hw _hs; do
      [ -n "$_hi" ] && printf '  - [%s] %s（%s）\n' "$_hs" "$_hi" "$_hw"
    done
    # 同じ項目を 2 本以上が**作業中**で掴んでいたら二重着手（並行の事故）
    _dup=$(printf '%s' "$HELD_ROWS" | grep '	作業中$' | cut -f1 | LC_ALL=C sort | uniq -d) || true
    if [ -n "$_dup" ]; then
      printf '%s\n' "$_dup" | while read -r _di; do
        [ -n "$_di" ] && printf '⚠ 同じ項目を 2 本以上が作業中です（二重着手）: %s\n' "$_di"
      done
    fi
    if printf '%s' "$HELD_ROWS" | grep -q '	着地済$'; then
      printf 'note: state=着地済 は deliver 済み・**未マージ**。[x] は main tree に来ていないので\n'
      printf '      台帳だけ見ると未着手に見える。次に選ぶときはこの表で除くこと\n'
    fi
  fi
}

# --- コマンド: metrics（読み取り専用・metrics.yml から派生指標を集計） ----------------
metrics_awk='
function dse(y,m,d,   yy,era,yoe,doy,doe){
  yy=y-(m<=2); era=int((yy>=0?yy:yy-399)/400); yoe=yy-era*400
  doy=int((153*(m+(m>2?-3:9))+2)/5)+d-1
  doe=yoe*365+int(yoe/4)-int(yoe/100)+doy
  return era*146097+doe-719468
}
function epoch(ts,   y,mo,d,h,mi,s){
  sub(/Z$/,"",ts); sub(/UTC$/,"",ts)
  if(length(ts)<19 || substr(ts,11,1)!="T") return -1
  y=substr(ts,1,4)+0; mo=substr(ts,6,2)+0; d=substr(ts,9,2)+0
  h=substr(ts,12,2)+0; mi=substr(ts,15,2)+0; s=substr(ts,18,2)+0
  return dse(y,mo,d)*86400 + h*3600 + mi*60 + s
}
BEGIN{ first=-1; delivered_e=-1; delivered_flag=0; sback=0 }
/event:/{
  ts=""; ph=""; ev=""
  if(match($0,/ts:[ ]*[^,}]+/)){ ts=substr($0,RSTART+3,RLENGTH-3); gsub(/[ ]/,"",ts) }
  if(match($0,/phase:[ ]*[A-Za-z_]+/)){ ph=substr($0,RSTART+6,RLENGTH-6); gsub(/[ ]/,"",ph) }
  if(match($0,/event:[ ]*[A-Za-z_]+/)){ ev=substr($0,RSTART+6,RLENGTH-6); gsub(/[ ]/,"",ev) }
  if(ph=="" || ev=="") next
  e=epoch(ts)
  if(ev=="start"){
    scount[ph]++
    if(e>=0){ if(first<0||e<first){first=e; firstts=ts}
              if(!(ph in laststart)||e>laststart[ph]){laststart[ph]=e; laststart_ts[ph]=ts}
              # ラウンドごとの開始を覚える。直近の対だけで elapsed を出すと、差し戻しのあった
              # 工程が**最短に見える**（実測で review 654 秒が 216 秒と出た）
              openat[ph]=e }
    if(!(ph in firststart_ts)) firststart_ts[ph]=ts
  } else if(ev=="approved"){
    # `amend: yes`（start を挟まない再承認＝記録の訂正）は**時刻を上書きしない**。
    # 上書きすると approved 列だけ後ろにずれ、同じ行の elapsed と辻褄が合わなくなる
    # （deliver 後の訂正は正規の運用なので必ず起きる）。lead_sec も訂正時刻で伸びていた
    isam = ($0 ~ /amend:[ \t]*yes/)
    if(e>=0 && !isam){ appat[ph]=e; appat_ts[ph]=ts
              if(ph in openat){ elsum[ph]+=e-openat[ph]; delete openat[ph] } }
    if(ph=="deliver"){ delivered_flag=1; if(e>=0 && !isam) delivered_e=e }
  } else if(ev=="sent_back"){
    # `by: unapprove` は原因ではなく結果なので数えない（dbg_sent_backs と同じ規則）
    if($0 !~ /by:[ \t]*unapprove/) sback++
    # 差し戻しも「そのラウンドの終わり」。ここで閉じないと、やり直しぶんが合算から落ちる
    if(e>=0 && (ph in openat)){ elsum[ph]+=e-openat[ph]; delete openat[ph] } }
}
END{
  if(phases=="yes"){
    n=split(PH,arr," ")
    for(i=1;i<=n;i++){ p=arr[i]
      if((p in laststart)||(p in appat)){
        # start は**最初のラウンド**、approved は最後、elapsed は全ラウンドの合計、
        # rounds は start の回数（1 より大きければ差し戻しがあった工程）
        st=(p in firststart_ts)?firststart_ts[p]:"-"
        ap=(p in appat_ts)?appat_ts[p]:"-"
        el="-"; if(p in elsum) el=elsum[p]
        rd=(p in scount)?scount[p]:0
        printf "%s\t%s\t%s\t%s\t%s\t%s\n", name, p, st, ap, el, rd
      }
    }
  } else {
    fs=(first>=0)?firstts:"-"
    dv=(delivered_flag>0)?"yes":"no"
    lead="-"; if(delivered_flag>0 && first>=0 && delivered_e>=0) lead=delivered_e-first
    # `lead_sec` は**暦の上の時間**で、離席すればそのぶん伸びる（実測で 60% が
    # 「次のコマンド待ち」だった work がある）。工程の elapsed 合計を並べて出し、
    # 「実作業に近い時間」と読み分けられるようにする。外部の締切には lead、
    # 工程の重さの比較には work。**どちらも KPI にはしない**（規模あたりの手戻りのほうが頑健）
    work=0; for(p in elsum) work+=elsum[p]
    # 「手戻り回数」（protocol-analysis.md「1.」）＝ **やり直した回数**。工程数で数えると
    # 上限が工程数で飽和し、「規模あたりの手戻り」の分子が頭打ちになる
    rw=0; for(p in scount) if(scount[p]>=2) rw+=scount[p]-1
    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n", name, fs, dv, lead, work, rw, sback+0
  }
}'

# metrics.yml の approved イベントから、被覆の刻印を出現順に "総数 被覆数 AC行欠落数" で出す。
# 出力: "<phase> <gap> <ac_total>" を出現順に。gap = (総数-被覆数) + AC行欠落数（+ AC が0件なら1）。
# **`ac_covered` を持たない刻印は捨てる**——`approve tasks ac_total=5` のように一部だけ手で
# 渡された行を 0 とみなすと、被覆数 0 として gap を捏造する（乖離が無いのに 5 と出る）。
# metrics.yml から「その工程の最後の approved 刻印にある key の値」を取る。
# 追記のみのログなので、最後の刻印が現在の値（差し戻して再承認したら新しい方が正）
mt_last_metric() { # metrics_file phase key
  [ -f "$1" ] || return 0
  grep "phase:[[:space:]]*$2,.*event:[[:space:]]*approved" "$1" 2>/dev/null | tail -n1 \
    | sed -n "s/.*[{,][[:space:]]*$3:[[:space:]]*\([^,}]*\).*/\1/p" | sed 's/[[:space:]]*$//'
}

mt_cov_stamps() { # metrics_file
  [ -f "$1" ] || return 0
  awk '
    function num(s, key,   m) {
      if (match(s, key ":[[:space:]]*[0-9]+")) {
        m = substr(s, RSTART, RLENGTH); sub(/^[^0-9]*/, "", m); return m + 0
      }
      return -1
    }
    /event:[[:space:]]*approved/ {
      t = num($0, "ac_total");   if (t < 0) next
      c = num($0, "ac_covered"); if (c < 0) next
      n = num($0, "tasks_no_ac"); if (n < 0) n = 0
      p = ""
      if (match($0, /phase:[[:space:]]*[a-z]+/)) {
        p = substr($0, RSTART, RLENGTH); sub(/phase:[[:space:]]*/, "", p)
      }
      # AC が 1 件も無いのは「被覆 100%」ではなく測れていない（cov_analyze も cover gap を立てる）
      printf "%s %d %d\n", p, (t - c) + n + (t == 0 ? 1 : 0), t
    }
  ' "$1"
}

cmd_metrics() {
  fmt=table; allf=no; phasesf=no; mslug=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) allf=yes; shift ;;
      --phases) phasesf=yes; shift ;;
      --format) need_arg "$1" $#; fmt=${2:-}; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$mslug" ] && mslug=$1 || die "slug は1つだけ"; shift ;;
    esac
  done
  case "$fmt" in table|tsv) ;; *) die "--format は table|tsv" ;; esac

  dirs=""
  if [ "$allf" = yes ]; then
    # ネスト1段（subtask）まで拾う。top-level だけだと、子の手戻り・差し戻しが
    # 横断集計から丸ごと消える（doctor は既に1段辿っている。数え方を揃える）
    for d in "$AIDEV/works"/*/; do
      [ -d "$d" ] || continue
      dirs="$dirs ${d%/}"
      for sd in "$d"*/; do
        [ -d "$sd" ] && [ -f "${sd}state.yml" ] && dirs="$dirs ${sd%/}"
      done
    done
  elif [ -n "$mslug" ]; then
    [ -d "$AIDEV/works/$mslug" ] || die "work が存在しません: $mslug"
    dirs="$AIDEV/works/$mslug"
  else
    [ -f "$AIDEV/current" ] || die "対象作業が不明です（.aidev/current 無し）。slug 指定か --all を。"
    cur=$(head -n1 "$AIDEV/current" | tr -d '\r\n')
    [ -d "$AIDEV/works/$cur" ] || die "work が存在しません: $cur"
    dirs="$AIDEV/works/$cur"
  fi

  rows=""
  for wd in $dirs; do
    # subtask は <親>/<子> で出す。basename だけだと親の違う同名 subtask が同一に見える
    case "$wd" in
      "$AIDEV/works"/*/*) name="$(basename "$(dirname "$wd")")/$(basename "$wd")" ;;
      *) name=$(basename "$wd") ;;
    esac
    mf="$wd/metrics.yml"
    [ -f "$mf" ] || mf=/dev/null
    out=$(awk -v name="$name" -v phases="$phasesf" -v PH="$PHASES" "$metrics_awk" "$mf")
    # ハーネス版で層別できるよう harnessRev / straddle（着手時と着地時で版が違う）を添える。
    # これが無いと insights は state.yml を grep して手で JOIN するしかなかった
    if [ "$phasesf" = no ] && [ -n "$out" ]; then
      # 受け入れ基準の規模（分母）と、tasks から review までの被覆の乖離。
      # 分母がこれまで実装側（files_changed）と分解側（tasks_planned）しか無く、
      # **要求の大きさ**で正規化できなかった（「AC 1件あたりの手戻り」が出せない）。
      # **2点は工程で選ぶ**（件数で選ぶと、同じ工程を2回 approve しただけの work が
      # 「2点ある＝乖離が測れる」に化け、測れないことを 0 と書いてしまう）。
      # 基準点＝tasks（light では requirements）の**最初**、終点＝review の**最後**。
      _cs=$(mt_cov_stamps "$mf" | sed '/^$/d')
      _f=$(printf '%s\n' "$_cs" | awk '$1=="tasks"||$1=="requirements"{print;exit}')
      _l=$(printf '%s\n' "$_cs" | awk '$1=="review"{r=$0} END{if(r!="")print r}')
      _any=$(printf '%s\n' "$_cs" | tail -n1)
      if [ -z "$_any" ]; then _ac=-; else _ac=$(printf '%s' "$_any" | cut -d' ' -f3); fi
      if [ -n "$_l" ]; then _ac=$(printf '%s' "$_l" | cut -d' ' -f3); fi
      if [ -z "$_f" ] || [ -z "$_l" ]; then _adr=-   # 2点そろわない＝乖離は測れない
      else
        _adr=$(( $(printf '%s' "$_l" | cut -d' ' -f2) - $(printf '%s' "$_f" | cut -d' ' -f2) ))
      fi
      out="$out	$_ac	$_adr"
      _hr=$(hr_get "$wd/state.yml"); [ -n "$_hr" ] || _hr=-
      _hd=$(hr_get "$wd/state.yml" harnessRevDelivered)
      if [ -z "$_hd" ] || [ "$_hr" = - ] || [ "$_hr" = unknown ] || [ "$_hd" = unknown ]; then _sd=-
      elif [ "$_hr" = "$_hd" ]; then _sd=no; else _sd=yes; fi
      out="$out	$_hr	$_sd"
    fi
    [ -n "$out" ] && rows="$rows$out
"
  done

  if [ "$phasesf" = yes ]; then hdr='work	phase	start	approved	elapsed_sec	rounds'
  else hdr='work	first_start	delivered	lead_sec	work_sec	reworks	sent_backs	ac	ac_drift	harnessRev	straddle'; fi

  if [ "$fmt" = tsv ]; then
    printf '%s' "$rows" | sed '/^[[:space:]]*$/d'
  else
    { printf '%s\n' "$hdr"; printf '%s' "$rows" | sed '/^[[:space:]]*$/d'; } | fmt_table
  fi
}

# --- コマンド: worktree（ユーザー責任の並行作業 on-ramp） ----------------------------
# 前提（research.md で実証）: .aidev/current は gitignore 対象＝worktree ローカルで main と非干渉。
# よって worktree 操作は main tree の current を絶対に書き換えない（INV-1）。git は実 exit code を直接判定する。
git_present() { command -v git >/dev/null 2>&1 || die "git が見つかりません"; }

# 既定 worktree パス: <親>/<repo名>-wt/<slug>（リポジトリ外の兄弟）
default_wt_path() { printf '%s/%s-wt/%s' "$(dirname "$ROOT")" "$(basename "$ROOT")" "$1"; }

# worktree 内で state.yml の slug が一致する work dir 名（dated）を列挙（改行区切り）
works_matching_slug() { # path slug
  _p=$1; _s=$2
  [ -d "$_p/.aidev/works" ] || return 0
  for _d in "$_p/.aidev/works"/*/; do
    [ -d "$_d" ] || continue
    [ -f "${_d}state.yml" ] || continue
    [ "$(yget "${_d}state.yml" slug)" = "$_s" ] && basename "${_d%/}"
  done
  return 0  # 最終比較の偽値で関数が非0終了し、set -e で $(...) 代入が落ちるのを防ぐ
}

# git worktree list --porcelain を "path<TAB>branch" 行に整形
wt_porcelain() {
  git worktree list --porcelain | awk '
    function flush(){ if(p!=""){ print p"\t"(b==""?"-":b); p="";b="" } }
    /^worktree /{ flush(); p=substr($0,10) }
    /^branch /{ b=$2; sub(/^refs\/heads\//,"",b) }
    /^detached/{ b="detached" }
    END{ flush() }'
}

# 共有ファイル警告。PJ 固有のファイル名は CLI に埋めず .aidev/config.yml の sharedFiles から生成する
# （基盤は PJ 非依存＝DESIGN「1.」「2.」。機械が言えるのは config にある事実だけで、検証義務のような
#  PJ 規約は散文＝AGENTS.md / protocol-worktree.md の担当。DESIGN「2.6」の線引きと同じ）。
# 既定ブランチ名を返す。読めなければ**空**を返す（推測しない。harness_rev の 'unknown' と同じ態度）。
git_default_branch() { # [repo_dir]
  _gd=${1:-$ROOT}
  _gb=$(git -C "$_gd" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || _gb=""
  _gb=${_gb#origin/}
  if [ -z "$_gb" ]; then
    for _c in main master; do
      if git -C "$_gd" show-ref --verify --quiet "refs/heads/$_c"; then _gb=$_c; break; fi
    done
  fi
  printf '%s' "$_gb"
}

# 直近 N コミットの 1/4 以上が触っているのに sharedFiles に無いファイル（上位 max 件）。
# doctor と worktree add の両方が使う——**同じハーネスの中で、doctor は「この 3 つは共有だ」と
# 言い、worktree add は「共有は storage.py です」と言う**状態を作らないため（実走で発生）。
shared_hot_undeclared() { # max
  _shmax=${1:-3}
  command -v git >/dev/null 2>&1 || return 0
  _shw=$(yget "$AIDEV/config.yml" sharedFilesWindow)
  case "$_shw" in ''|*[!0-9]*) _shw=20 ;; esac
  [ "$_shw" -gt 0 ] 2>/dev/null || return 0
  _shc=$(git -C "$ROOT" rev-list --count HEAD 2>/dev/null) || _shc=0
  case "$_shc" in ''|*[!0-9]*) _shc=0 ;; esac
  [ "$_shc" -lt "$_shw" ] && _shw=$_shc
  SHARED_HOT_WINDOW=$_shw
  # 履歴が浅いうちは黙る。4 コミットだと閾値が 2 に切り上がり、「2 本が触った」だけで
  # 常連になる——**導入直後ほど誤検知が多い**（実測で 5 件中 3 件が生成物だった）。
  # この検査は「宣言が実態から遅れる」を見るものなので、遅れようがない時期には要らない
  [ "$_shw" -ge 10 ] 2>/dev/null || return 0
  _shthr=$(( (_shw + 3) / 4 )); [ "$_shthr" -ge 2 ] || _shthr=2
  _shdecl=" $(ylist "$AIDEV/config.yml" sharedFiles | tr '\n' ' ') "
  _shrel=""; case "$HARNESS/" in "$ROOT"/*) _shrel=${HARNESS#"$ROOT"/} ;; esac
  _shn=0
  _shrows=$(git -C "$ROOT" log -n "$_shw" --name-only --pretty=format:%x00 HEAD 2>/dev/null \
    | awk -v RS='\0' '
        { delete seen
          for (i = 1; i <= NF; i++) if (!($i in seen)) { seen[$i] = 1; c[$i]++ } }
        END { for (f in c) print c[f] "\t" f }' \
    | LC_ALL=C sort -k1,1nr -k2,2)
  _shold=$IFS; IFS='
'
  for row in $_shrows; do
    _shcnt=${row%%	*}; _shf=${row#*	}
    [ "$_shcnt" -ge "$_shthr" ] 2>/dev/null || continue
    [ "$_shn" -ge "$_shmax" ] && continue
    case "$_shf" in .aidev/*) continue ;; esac
    [ -n "$_shrel" ] && case "$_shf" in "$_shrel"/*) continue ;; esac
    case "$_shdecl" in *" $_shf "*) continue ;; esac
    # いま無視されているファイル（ビルド生成物など）は勧めない。過去に誤ってコミットして
    # 履歴に残っていると常連として挙がる（実測: __pycache__/*.pyc が 3 件出た）
    if git -C "$ROOT" check-ignore -q -- "$_shf" 2>/dev/null; then continue; fi
    # 既に無いファイルも勧めない（消えたものを宣言させても仕方がない）
    [ -e "$ROOT/$_shf" ] || continue
    printf '%s\t%s\n' "$_shcnt" "$_shf"
    _shn=$((_shn+1))
  done
  IFS=$_shold
  return 0
}

wt_shared_warn() {
  _sh=$(ylist "$AIDEV/config.yml" sharedFiles | sed 's/^ *//; s/ *$//; s/  */, /g')
  if [ -n "$_sh" ]; then
    printf '⚠ この work が共有ファイル（%s）に触るなら、他 worktree と\n' "$_sh"
    printf '  波及・マージ衝突が起きうる（PJ 規約は AGENTS.md）。並行可否はユーザー判断。\n'
  else
    printf '⚠ この work が他 worktree と共有するもの（ビルド設定・登録テーブル・共有モジュール等）に触るなら、\n'
    printf '  波及・マージ衝突が起きうる（PJ 規約は AGENTS.md。config.yml の sharedFiles で名指しできる）。並行可否はユーザー判断。\n'
  fi
  # 宣言は静的なので実態から遅れる。**同じ CLI が知っている事実**を黙って持っていないこと
  _shot=$(shared_hot_undeclared 3)
  if [ -n "$_shot" ]; then
    printf '  なお sharedFiles に無いが直近 %s コミットの常連（＝重なりやすい）:\n' "${SHARED_HOT_WINDOW:-20}"
    printf '%s\n' "$_shot" | while IFS='	' read -r _c _f; do
      [ -n "$_f" ] && printf '    %s（%s コミット）\n' "$_f" "$_c"
    done
    printf '  いま何が重なっているかは aidev worktree files（宣言の検査は aidev doctor）。\n'
  fi
}

wt_add() {
  slug=""; branch=""; base="HEAD"; wpath=""; mode=interactive; ticket=""; depends=""; backlog=""; profile=""; backlogitem=""; humangates=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --branch)  need_arg "$1" $#; branch=$2; shift 2 ;;
      --base)    need_arg "$1" $#; base=$2; shift 2 ;;
      --path)    need_arg "$1" $#; wpath=$2; shift 2 ;;
      --mode)    need_arg "$1" $#; mode=$2; shift 2 ;;
      --ticket)  need_arg "$1" $#; ticket=$2; shift 2 ;;
      --depends) need_arg "$1" $#; depends=$2; shift 2 ;;
      # 内部の new にそのまま渡す。落とすと backlog 出自の刻印が付かず、
      # **verify の消し込み強制が静かに効かなくなる**（並行経路だけ enforcement が外れる）
      --backlog) need_arg "$1" $#; backlog=$(basename -- "$2"); shift 2 ;;
      --backlog-item) need_arg "$1" $#; backlogitem=$2; shift 2 ;;
      --human-gates) need_arg "$1" $#; humangates=$2; shift 2 ;;
      --profile) need_arg "$1" $#; profile=$2; shift 2 ;;
      --light)   profile=light; shift ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$slug" ] && slug=$1 || die "slug は1つだけ"; shift ;;
    esac
  done
  [ -n "$slug" ] || die "使用法: aidev worktree add <slug> [--branch ..] [--base ..] [--path ..] [--mode ..] [--profile ..|--light] [--ticket ..] [--depends ..] [--backlog <file>] [--backlog-item <text>]"
  git_present
  [ -n "$branch" ] || branch="feature/$slug"
  [ -n "$wpath" ] || wpath=$(default_wt_path "$slug")
  [ -e "$wpath" ] && die "path が既に存在します: $wpath"

  # ブランチ存在で分岐（既存→checkout / 新規→-b で base から作成）。branch は必ず明示（git の basename 自動命名に委ねない）。
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    _wt_newbranch=no
    git worktree add "$wpath" "$branch" || die "git worktree add に失敗（branch=$branch）"
  else
    _wt_newbranch=yes
    git worktree add -b "$branch" "$wpath" "$base" || die "git worktree add に失敗（branch=$branch base=$base）"
  fi
  wpath=$(cd "$wpath" && pwd)  # 以降は絶対パスで扱う

  # ここから先の die は**worktree を作った後**に起きる。ロールバックしないと、
  # 失敗したのに worktree とブランチだけが残り、次の add が「既にある」で弾かれる。
  # 作ったブランチは自分のものなので、この経路でだけ消してよい（既存 branch 指定時は消さない）
  _wt_rollback() { # メッセージ
    git worktree remove --force "$wpath" >/dev/null 2>&1 || true
    if [ "$_wt_newbranch" = yes ]; then git branch -D "$branch" >/dev/null 2>&1 || true; fi
    git worktree prune >/dev/null 2>&1 || true
    # 既定のコンテナ（<repo>-wt/）も空なら掃除する。rm と同じ後始末（非空なら rmdir が失敗して何もしない）
    rmdir "$(dirname "$wpath")" 2>/dev/null || true
    die "$1（作りかけの worktree とブランチは撤去した）"
  }

  # worktree 内で work を確定（main tree の .aidev/current には触れない＝INV-1）
  matches=$(works_matching_slug "$wpath" "$slug")
  mcount=$(printf '%s' "$matches" | grep -c . || true)
  if [ "$mcount" -gt 1 ]; then
    _wt_rollback "worktree 内に slug=$slug の work が複数あります。曖昧なため中断（手動で current 設定を）"
  elif [ "$mcount" -eq 1 ]; then
    printf '%s\n' "$matches" > "$wpath/.aidev/current"
    work_note="既存 work をリンク: $matches（current 設定のみ）"
  else
    # add 内で new: worktree をカレントにして既存 new ロジックに委譲（単一検証経路の維持・DRY）
    set -- new "$slug" --mode "$mode"
    [ -n "$ticket" ]  && set -- "$@" --ticket "$ticket"
    [ -n "$depends" ] && set -- "$@" --depends "$depends"
    [ -n "$backlog" ] && set -- "$@" --backlog "$backlog"
    [ -n "$backlogitem" ] && set -- "$@" --backlog-item "$backlogitem"
    [ -n "$humangates" ] && set -- "$@" --human-gates "$humangates"
    [ -n "$profile" ] && set -- "$@" --profile "$profile"
    # 先に CLI の実在を見る。無いまま委譲すると「コマンドが無い」というシェルのエラーが出て、
    # 本当の原因（skills が worktree に持ち込まれていない＝未追跡・未コミット）が読めない。
    # ps1 側にも同じ事前検査がある（メッセージを揃える）
    _wtbin="$wpath/.claude/skills/aidev-docs/bin/aidev"
    [ -f "$_wtbin" ] || _wt_rollback "worktree 内に CLI がありません: $_wtbin（skills が追跡・コミット済みか確認）"
    ( cd "$wpath" && "$_wtbin" "$@" ) || _wt_rollback "worktree 内の new に失敗"
    work_note="新規 work を作成（add 内で new）"
  fi

  # **枝を切った地点**を state.yml に刻む。deliver「1.5」の既着地検知は
  # `<default>..HEAD` を見るが、base が未マージの枝だと**無関係なコミットが必ず並ぶ**ので、
  # 「空かどうか」という判定基準が成立しない（実測: 実装と無関係な 4 本が出た）。
  # 比べる先を推測させず、**その work が実際に分岐した commit** を記録して渡す。
  # 既定 base を既定ブランチに変えないのは、積み上げ（前の work の上で続ける）が
  # 正当なやり方だから——直すべきは既定値ではなく、比較点が記録されていないこと。
  _wtcur="$wpath/.aidev/current"
  if [ -f "$_wtcur" ]; then
    _wtw=$(head -n1 "$_wtcur" | tr -d '\r\n')
    _wtst="$wpath/.aidev/works/$_wtw/state.yml"
    if [ -n "$_wtw" ] && [ -f "$_wtst" ]; then
      _wtbc=$(git -C "$wpath" rev-parse HEAD 2>/dev/null) || _wtbc=""
      set_or_append "$_wtst" base "base: $base"
      [ -n "$_wtbc" ] && set_or_append "$_wtst" baseCommit "baseCommit: $_wtbc"
    fi
  fi

  printf 'worktree 追加: %s\n' "$wpath"
  # 既定の base は HEAD。`base: HEAD` とだけ出すと、**HEAD が未マージの feature ブランチ**
  # でもそれが見えない（2026-09-04 の並行実走で 3 本すべてが未マージ枝の上に積まれ、
  # deliver「1.5」の既着地検知が無関係なコミットで濁った）。実体を併記し、既定ブランチ
  # から外れているときだけ 1 行足す。既定ブランチが読めない環境では**推測しない**
  _bshown=$base
  if [ "$base" = HEAD ]; then
    _bhead=$(git -C "$ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null) || _bhead=""
    [ -n "$_bhead" ] && _bshown="HEAD (= $_bhead)"
  fi
  printf '  branch: %s / base: %s\n' "$branch" "$_bshown"
  if [ "$base" = HEAD ] && [ -n "${_bhead:-}" ]; then
    _bdef=$(git_default_branch)
    if [ -n "$_bdef" ] && [ "$_bdef" != "$_bhead" ]; then
      printf '  ⚠ base が既定ブランチ(%s)ではなく %s です。未マージの変更の上に積まれます\n' "$_bdef" "$_bhead"
      printf '    （意図した積み上げなら問題ない。意図していないなら --base %s で取り直す）\n' "$_bdef"
      printf '    （deliver「1.5」の既着地検知が %s..HEAD の無関係なコミットで濁る）\n' "$_bdef"
    fi
  fi
  printf '  work:   %s\n' "$work_note"
  wt_shared_warn
  printf '次: cd %s して各工程 skill を実行。\n' "$wpath"
}

wt_list() {
  fmt=table
  while [ $# -gt 0 ]; do
    case "$1" in
      --format) need_arg "$1" $#; fmt=${2:-}; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) die "list は位置引数を取りません: $1" ;;
    esac
  done
  case "$fmt" in table|tsv) ;; *) die "--format は table|tsv" ;; esac
  git_present

  rows=""; wtinfo=$(wt_porcelain)
  MAIN_TREE=$(printf '%s\n' "$wtinfo" | head -n1 | cut -f1)  # porcelain 先頭＝main worktree（wt_rm と同じ判定）
  oldifs=$IFS; IFS='
'
  for line in $wtinfo; do
    path=${line%%	*}; branch=${line#*	}
    # 判定キー: worktree ローカル .aidev/current の有無（branch 名ではない）
    [ -f "$path/.aidev/current" ] || continue
    work=$(head -n1 "$path/.aidev/current" | tr -d '\r\n'); [ -z "$work" ] && work=-
    phase=-
    if [ "$work" != - ] && [ -f "$path/.aidev/works/$work/state.yml" ]; then
      phase=$(yget "$path/.aidev/works/$work/state.yml" current); [ -z "$phase" ] && phase=-
    fi
    # main tree もこの条件を満たす（.aidev/current を持つ）。並行 worktree の一覧として読むと
    # 1 件多く見えるので、種別を列に出す（rm は main を拒否するのに list には出ていた）
    kind=worktree
    [ "$path" = "$MAIN_TREE" ] && kind=main
    rows="$rows$path	$branch	$work	$phase	$kind
"
  done
  IFS=$oldifs

  if [ "$fmt" = tsv ]; then
    printf '%s' "$rows" | while IFS='	' read -r a b c d e; do
      [ -z "$a" ] && continue
      printf 'worktree\t%s\t%s\t%s\t%s\t%s\n' "$a" "$b" "$c" "$d" "$e"
    done
    return 0
  fi
  n=$(printf '%s' "$rows" | grep -c . || true)
  printf 'WORKTREES (%s)\n' "$n"
  if [ "$n" -gt 0 ]; then
    { printf 'path\tbranch\twork\tphase\tkind\n'; printf '%s' "$rows"; } | fmt_table
  fi
}

# その worktree が**他と違えている**ファイル名を1行1件で返す。
# 基点は「main tree の HEAD との merge-base」。既定ブランチにしないのは、worktree が
# 未マージのブランチから切られていると**共通の祖先ぶんまで全員の変更に見える**ため
# （実測: 3 本とも feature 枝から切ったので、共有しているだけの skills 一式が
# 全員の「変更」として並び、本当の重なりが埋もれた）。main tree との merge-base なら
# 共有ぶんが相殺され、残るのはその worktree が足したものだけになる。
wt_changed_files() { # path all_heads
  _wcp=$1; _wcm=$2
  # 基点は「**他の tree との merge-base のうち最も新しいもの**」。
  # - main tree の HEAD 固定にすると、main tree 自身が常に差分ゼロになり
  #   **その未マージの作業が一本も見えない**。
  # - 既定ブランチにすると、同じ枝から切った worktree が共有ぶんまで各自の変更として並ぶ。
  # - 全体の共通祖先（octopus）にすると、**撤去し忘れた古い worktree が 1 本あるだけで
  #   基点が過去へ引きずられ**、共有ぶんが再び全員の変更として並ぶ（実測で回帰した）。
  # 「最も新しい merge-base」なら、共有ぶんは相殺されつつ、その tree だけが持つ分は残る。
  _wcbase=""; _wcbest=-1
  _wch=$(git -C "$_wcp" rev-parse HEAD 2>/dev/null) || _wch=""
  # 呼び出し元（wt_collect_pairs）は IFS を改行にしているので、空白区切りの一覧が
  # そのままでは分割されない。ここで既定に戻して回す（戻し忘れると上位のループが壊れる）
  _wcifs=$IFS; IFS=' '
  for _wco in $_wcm; do
    [ "$_wco" = "$_wch" ] && continue
    _wcmb=$(git -C "$_wcp" merge-base "$_wco" HEAD 2>/dev/null) || continue
    [ -n "$_wcmb" ] || continue
    _wcd=$(git -C "$_wcp" rev-list --count "$_wcmb..HEAD" 2>/dev/null) || continue
    case "$_wcd" in ''|*[!0-9]*) continue ;; esac
    if [ "$_wcbest" -lt 0 ] || [ "$_wcd" -lt "$_wcbest" ]; then _wcbest=$_wcd; _wcbase=$_wcmb; fi
  done
  IFS=$_wcifs
  [ -n "$_wcbase" ] || _wcbase=HEAD   # 比較相手がいなければ未コミットぶんだけ（捏造しない）
  {
    git -C "$_wcp" diff --name-only "$_wcbase" 2>/dev/null
    git -C "$_wcp" ls-files --others --exclude-standard 2>/dev/null
  } | sed 's/\r$//' | grep -v '^$' | sort -u
}

# その work が **これから触ると宣言している** ファイル（tasks.md の `対象:` アンカー）。
# 実差分は「もう書いた後」しか見えないので、3 本が同時に上流工程にいる立ち上がり期は
# 構造的に空になる——`protocol-worktree.md` が「衝突を避ける余地がまだあるうち」と価値を
# 置いた時間帯がまさにそこだった（実走で overlap=0 → deliver 前に 5 と出た）。
# 宣言は tasks の時点で揃うので、こちらは**その時間帯に効く**。
wt_planned_files() { # path work
  _wpf="$1/.aidev/works/$2/tasks.md"
  [ -f "$_wpf" ] || return 0
  awk '
    /^[ \t]*対象:/ { inblk = 1 }
    inblk {
      if ($0 ~ /^[ \t]*(依存|AC):/ || $0 ~ /^[ \t]*- \[/) { inblk = 0; next }
      n = split($0, parts, "`")
      for (i = 2; i <= n; i += 2) if (parts[i] != "") print parts[i]
    }
  ' "$_wpf" | sed 's/:[0-9][0-9-]*$//' \
    | grep -E '^[A-Za-z0-9_][A-Za-z0-9_./-]*\.[A-Za-z0-9]+$' | sort -u
  # backlog の消し込みは deliver の責務なので誰も `対象:` に書かないが、`backlog:` を持つ
  # work は**必ず**そのファイルを触る（`verify` が消し込みを強制するため）。
  # 予告できるのに予告しないと、「必ず衝突する」と分かっている唯一のファイルだけが
  # 予告の外に残る（実走でそうなった）。宣言ではなく**既知の事実**なので機械が足す
  _wpbl=$(yget "$1/.aidev/works/$2/state.yml" backlog 2>/dev/null) || _wpbl=""
  [ -n "$_wpbl" ] && printf '.aidev/backlog/%s\n' "$_wpbl"
  return 0
}

# どのファイルを何本の worktree が触っているかを出す。
# 実走で「触らない storage.py が警告され、全員が触る cli.py は警告されない」という反転が
# 起きた（sharedFiles は人間が書く静的な宣言なので、実態から遅れる）。ここは**実態**を出す。
# 既定は**重なっているものだけ**——大きい PJ で全変更ファイルを出すと重なりが埋もれる。
# 「ファイル<TAB>worktree名」の対を集める。WT_PAIRS / WT_N に入れる（サブシェルにしない）。
# doctor の sharedFiles 検査もこれを使う——履歴の頻度だけだと、実際に衝突するのに
# 常連度が閾値に届かないファイルを取り落とす（実測: tests/test_storage.py が 4/20 で漏れ、
# 実マージでは衝突した）。**いま重なっている**という事実は履歴より強い証拠なので、
# 静的宣言・履歴頻度に次ぐ第三の経路として繋ぐ。
wt_collect_pairs() { # showall planned
  _wcall=$1; _wcpl=$2
  WT_PAIRS=""; WT_N=0
  _wfinfo=$(wt_porcelain)
  _wfmain=$(printf '%s\n' "$_wfinfo" | head -n1 | cut -f1)
  _wfdef=$(git_default_branch)
  # 比較対象の全 tree の HEAD を集めておく。基点は tree ごとに下で決める
  _wfheads=""
  _oi2=$IFS; IFS='
'
  for _wl in $_wfinfo; do
    _wp=${_wl%%	*}
    [ -f "$_wp/.aidev/current" ] || continue
    _wh=$(git -C "$_wp" rev-parse HEAD 2>/dev/null) || continue
    _wfheads="$_wfheads $_wh"
  done
  IFS=$_oi2

  oldifs=$IFS; IFS='
'
  for line in $_wfinfo; do
    path=${line%%	*}
    [ -f "$path/.aidev/current" ] || continue
    _wfw=$(head -n1 "$path/.aidev/current" | tr -d '\r\n')
    # 落とすのは「**既定ブランチにマージ済み**」の worktree だけ。
    # deliver 済みで落とすのは誤り——deliver は PR 作成で終わり、**マージは人間の仕事**なので
    # 未マージのまま deliver した枝はマージ衝突の相手として現役。実測で 3 本が deliver した
    # 瞬間に既定ビューが空になり、「マージ順で相手を壊さないか」を見るという当の用途で
    # 先に deliver した本ほど何も見えなくなった。既定ブランチが読めなければ**落とさない**
    if [ "$_wcall" = no ] && [ -n "$_wfdef" ]; then
      if git -C "$path" merge-base --is-ancestor HEAD "$_wfdef" 2>/dev/null; then continue; fi
    fi
    WT_N=$((WT_N+1))
    _wfname=$(basename "$path")
    if [ "$_wcpl" = yes ]; then _wfsrc=$(wt_planned_files "$path" "$_wfw")
    else _wfsrc=$(wt_changed_files "$path" "$_wfheads"); fi
    for f in $_wfsrc; do
      # 自分の work のディレクトリは構造上ぶつからない（slug が違う）。数えると重なりが埋もれる
      case "$f" in .aidev/works/*) continue ;; esac
      WT_PAIRS="$WT_PAIRS$f	$_wfname
"
    done
  done
  IFS=$oldifs
}

wt_files() {
  fmt=table; showall=no; planned=no
  while [ $# -gt 0 ]; do
    case "$1" in
      --format) need_arg "$1" $#; fmt=${2:-}; shift 2 ;;
      --all) showall=yes; shift ;;
      --planned) planned=yes; shift ;;
      -*) die "未知のオプション: $1" ;;
      *) die "files は位置引数を取りません: $1" ;;
    esac
  done
  case "$fmt" in table|tsv) ;; *) die "--format は table|tsv" ;; esac
  git_present

  _wfdecl=" $(ylist "$AIDEV/config.yml" sharedFiles | tr '\n' ' ') "
  wt_collect_pairs "$showall" "$planned"
  _wfpairs=$WT_PAIRS; _wfn=$WT_N

  # ファイルごとに worktree 名を畳む
  rows=$(printf '%s' "$_wfpairs" | LC_ALL=C sort | awk -F'\t' -v all="$showall" -v decl="$_wfdecl" '
    function flush(   d) {
      if (f == "") return
      if (all == "no" && n < 2) return
      d = (index(decl, " " f " ") > 0) ? "yes" : "no"
      print f "\t" n "\t" d "\t" names
    }
    { if ($1 != f) { flush(); f = $1; n = 0; names = "" }
      n++; names = (names == "") ? $2 : names ", " $2 }
    END { flush() }')

  _wfover=$(printf '%s' "$rows" | awk -F'\t' '$2 >= 2' | grep -c . || true)
  # `.aidev/*` は**必ず衝突するが sharedFiles に足すものではない**——足すと毎回の
  # worktree add で鳴る恒常ノイズになるうえ、`protocol-worktree.md` は
  # 「避けられないのでマージ時に手で解決する前提」と定めている。行は出すが勧めない
  # （doctor 側も同じ除外をしている。同じハーネスが別の答えを言わないため）
  _wfundecl=$(printf '%s' "$rows" | awk -F'\t' '$2 >= 2 && $3 == "no" && $1 !~ /^\.aidev\//' | grep -c . || true)

  if [ "$fmt" = tsv ]; then
    # `rows` は command substitution で作っているので**末尾改行が落ちている**
    # （wt_list の注記と同じ罠）。`printf '%s'` のままだと read が最後の1行を捨て、
    # 行が1件のときは全部消える。ここは改行を足して流す
    printf '%s\n' "$rows" | while IFS='	' read -r a b c d; do
      [ -z "$a" ] && continue
      printf 'file\t%s\t%s\t%s\t%s\n' "$a" "$b" "$c" "$d"
    done
    printf 'files-summary\t%s\t%s\t%s\n' "$_wfn" "$_wfover" "$_wfundecl"
    return 0
  fi
  if [ "$planned" = yes ]; then printf 'worktree files: %s 本の worktree が触ると宣言したファイル（tasks.md の 対象:。着地済み・未マージの宣言も含む）' "$_wfn"
  else printf 'worktree files: %s 本の worktree の変更ファイル' "$_wfn"; fi
  [ "$showall" = no ] && printf '（未マージの worktree・2本以上が重なるものだけ。全件は --all）'
  printf '\n'
  if [ -n "$rows" ]; then
    { printf 'file	worktrees	sharedFiles	where
'; printf '%s\n' "$rows"; } | fmt_table
  fi
  # 既定と --all で母数が違う（未マージだけ / 全部）。同じラベルにすると数が動いた理由が読めない
  if [ "$showall" = yes ]; then _wflbl=worktrees_all; else _wflbl=worktrees_unmerged; fi
  printf 'files-summary: %s=%s overlap=%s undeclared=%s\n' "$_wflbl" "$_wfn" "$_wfover" "$_wfundecl"
  if [ "$_wfundecl" -gt 0 ] 2>/dev/null; then
    printf '⚠ 重なっているのに sharedFiles に無いファイルが %s 件。config.yml に足すと\n' "$_wfundecl"
    printf '  worktree add がその名前で警告できる（並行可否の判断はユーザー）。\n'
  fi
}

wt_rm() {
  target=""; force=no; delbranch=no
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=yes; shift ;;
      --delete-branch) delbranch=yes; shift ;;
      -*) die "未知のオプション: $1" ;;
      *) [ -z "$target" ] && target=$1 || die "対象は1つだけ"; shift ;;
    esac
  done
  [ -n "$target" ] || die "使用法: aidev worktree rm <slug|path> [--force] [--delete-branch]"
  git_present

  # git worktree list は Windows で `C:/Users/...` を返すが MSYS の pwd は `/c/Users/...` を返す。
  # 素の文字列比較だと必ず外れるので、比較する両辺を同じ手（cd && pwd）で正規化する。
  abst=""; [ -d "$target" ] && abst=$(cd "$target" && pwd)
  wtinfo=$(wt_porcelain)
  main_wt=$(printf '%s\n' "$wtinfo" | head -n1 | cut -f1)  # porcelain 先頭＝main worktree（rm 対象外）
  rpath=""; rbranch=""; hit_main=no
  oldifs=$IFS; IFS='
'
  for line in $wtinfo; do
    p=${line%%	*}; b=${line#*	}
    if [ -n "$abst" ]; then
      pn=$(cd "$p" 2>/dev/null && pwd); [ -n "$pn" ] || pn=$p
      [ "$pn" = "$abst" ] && { rpath=$p; rbranch=$b; break; }
    else
      if [ "$(basename "$p")" = "$target" ] || [ "$b" = "feature/$target" ] || [ "$b" = "$target" ]; then
        if [ "$p" = "$main_wt" ]; then hit_main=yes; continue; fi  # slug が main worktree に一致しても対象にしない
        [ -n "$rpath" ] && { IFS=$oldifs; die "対象が複数該当します（path を明示してください）: $target"; }
        rpath=$p; rbranch=$b
      fi
    fi
  done
  IFS=$oldifs
  if [ -z "$rpath" ]; then
    [ "$hit_main" = yes ] && die "'$target' は main worktree（$main_wt）に該当します。main worktree は rm できません（worktree のみ対象）。"
    die "対象 worktree が見つかりません: $target"
  fi

  # 未コミット差分チェック（--force 無しなら拒否）
  if [ "$force" = no ] && [ -n "$(git -C "$rpath" status --porcelain 2>/dev/null)" ]; then
    die "未コミットの変更があります（--force で強制削除）: $rpath"
  fi
  if [ "$force" = yes ]; then
    git worktree remove --force "$rpath" || die "git worktree remove に失敗: $rpath"
  else
    git worktree remove "$rpath" || die "git worktree remove に失敗: $rpath"
  fi
  printf 'worktree 撤去: %s\n' "$rpath"
  rmdir "$(dirname "$rpath")" 2>/dev/null || true  # 既定の <repo>-wt/ コンテナが空なら掃除（非空なら何もしない）

  if [ "$delbranch" = yes ] && [ "$rbranch" != - ] && [ "$rbranch" != detached ]; then
    git branch -D "$rbranch" && printf '  branch 削除: %s\n' "$rbranch" || warn "branch 削除に失敗: $rbranch"
  fi
}

# --- コマンド: use（継続する作業の切り替え） --------------------------------------
# `.aidev/current` を書くのは new と approve(subtask 前進) だけで、**「続きから」で切り替える
# 手段が無かった**（`aidev-00-start`「3.」は current を更新せよと書くが、手で書く前提だった）。
# 存在しない slug を書き込む事故を resolve_work で弾く。
cmd_use() {
  if [ $# -eq 0 ]; then
    [ -f "$AIDEV/current" ] || die "対象作業が不明です（.aidev/current 無し）"
    head -n1 "$AIDEV/current" | tr -d '\r\n'; printf '\n'
    return 0
  fi
  [ $# -eq 1 ] || die "使用法: aidev use [<slug>]"
  resolve_work "$1"
  printf '%s\n' "$SLUG" > "$AIDEV/current"
  printf 'current: %s (%s)\n' "$SLUG" "$(yget "$WORK/state.yml" current)"
  # subtask に切り替えたら親の activeSubtask も合わせる。protocol.md「6.」が
  # 「activeSubtask は .aidev/current の冗長コピー」と定義しているので、片方だけ動かすと
  # その定義が破れる（60-review の差し戻し手順が要求する「親 activeSubtask を戻す」も、
  # これが無いと手段が無い）
  _upar=$(yget "$WORK/state.yml" parent)
  if [ -n "$_upar" ] && [ -d "$AIDEV/works/$_upar" ]; then
    set_or_append "$AIDEV/works/$_upar/state.yml" activeSubtask "activeSubtask: $(basename "$WORK")"
    printf 'cursor: 親 %s の activeSubtask を %s に同期\n' "$_upar" "$(basename "$WORK")"
  fi
}

# --- コマンド: backlog --------------------------------------------------------
# **積む/退避する**だけを持たせる。消し込み（[x] 化と根拠の併記）は行の同定と文面の判断が
# 要るので CLI にしない（verify は [x] 行とその継続行に slug があるかだけを見る。protocol「2.9」）。
cmd_backlog() {
  [ $# -ge 1 ] || die "使用法: aidev backlog <new|archive|compact> ..."
  sub=$1; shift
  case "$sub" in
    new)     bl_new "$@" ;;
    archive) bl_do_archive "$@" ;;
    compact) bl_compact "$@" ;;
    *) die "未知の backlog サブコマンド: $sub（new|archive|compact）" ;;
  esac
}

# standing（また積まれる）backlog は archive されないので [x] 行が増える一方になり、
# propose/insights の重複排除入力が周回ごとに膨らむ。消化済み項目だけを archive/<name>-done.md へ
# 移して active を薄く保つ。verify の消し込み検査は -done.md も見るので、過去 work の検査は壊れない
bl_compact() {
  targets=""; explicit=yes
  while [ $# -gt 0 ]; do
    case "$1" in
      -*) die "未知のオプション: $1" ;;
      *) targets="$targets $(basename "$1")"; shift ;;
    esac
  done
  [ -d "$AIDEV/backlog" ] || die "backlog がありません"
  if [ -z "$targets" ]; then
    explicit=no
    for f in "$AIDEV/backlog"/*.md; do
      [ -f "$f" ] || continue
      bl_stat "$f"
      if [ "$BL_KIND" = standing ] && [ "$BL_DN" -gt 0 ]; then targets="$targets $(basename "$f")"; fi
    done
  fi
  moved=0
  for t in $targets; do
    f="$AIDEV/backlog/$t"
    if [ ! -f "$f" ]; then printf 'skip %s: active にありません\n' "$t"; continue; fi
    bl_stat "$f"
    if [ "$BL_DN" -eq 0 ]; then
      if [ "$explicit" = yes ]; then printf 'skip %s: 消化済み項目がありません\n' "$t"; fi
      continue
    fi
    mkdir -p "$AIDEV/backlog/archive"
    dn="$AIDEV/backlog/archive/${t%.md}-done.md"
    if [ ! -f "$dn" ]; then
      printf '# %s (done)\n\n<!-- aidev backlog compact が退避した消化済み項目。verify の消し込み検査はここも見る -->\n' "${t%.md}" > "$dn"
    fi
    # [x] 行とその継続行（次の項目・見出し・空行まで）を done ファイルへ移し、残りを書き戻す
    # 行末の CR は落として LF に揃える（ps1 は常に LF で書き戻す。両実装で同じファイルを作る）
    awk -v out="$dn" '
      { sub(/\r$/, "") }
      /^[[:space:]]*- \[[xX]\]/ { inx=1 }
      /^[[:space:]]*- \[[^xX]\]/ || /^#/ || /^[[:space:]]*$/ { inx=0 }
      inx { print >> out; next }
      { print }' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    printf 'compacted: %s -> archive/%s (%s 件)\n' "$t" "$(basename "$dn")" "$BL_DN"
    moved=$((moved+BL_DN))
  done
  printf 'compact-summary: moved=%s\n' "$moved"
}

bl_new() {
  name=""; kind=""; parent=""; priority=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --kind)     need_arg "$1" $#; kind=${2:-}; shift 2 ;;
      --parent)   need_arg "$1" $#; parent=${2:-}; shift 2 ;;
      --priority) need_arg "$1" $#; priority=${2:-}; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) if [ -z "$name" ]; then name=$1; else die "名前は1つだけ"; fi; shift ;;
    esac
  done
  [ -n "$name" ] || die "使用法: aidev backlog new <name> --kind standing|split|topic [--parent <slug>] [--priority <n>]"
  name=$(basename "$name" .md)
  # kind はファイルの一生の宣言。ここで必須にして「後で書く」を無くす（欠落が常態化していた）
  case "$kind" in
    standing|topic) ;;
    split) [ -n "$parent" ] || die "kind: split には --parent が要ります（親 work slug / チケット）" ;;
    "") die "--kind は必須です（standing|split|topic）" ;;
    *) die "未知の kind: $kind（standing|split|topic）" ;;
  esac
  mkdir -p "$AIDEV/backlog"
  f="$AIDEV/backlog/$name.md"
  if [ -e "$f" ]; then die "すでにあります: .aidev/backlog/$name.md"; fi
  {
    printf '%s\n' '---'
    printf 'backlog: %s\n' "$name"
    printf 'kind: %s\n' "$kind"
    if [ -n "$parent" ];   then printf 'parent: %s\n' "$parent"; fi
    if [ -n "$priority" ]; then printf 'priority: %s\n' "$priority"; fi
    printf '%s\n\n' '---'
    printf '# %s\n\n' "$name"
    printf '%s\n' '<!-- 項目は行頭の `- [ ]` で書く（見出しに書くと aidev status の未着手件数から漏れる） -->'
  } > "$f"
  printf 'created: .aidev/backlog/%s.md (kind %s)\n' "$name" "$kind"
}

bl_do_archive() {
  force=no; targets=""; explicit=yes
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=yes; shift ;;
      -*) die "未知のオプション: $1" ;;
      *) targets="$targets $(basename "$1")"; shift ;;
    esac
  done
  [ -d "$AIDEV/backlog" ] || die "backlog がありません"
  # 無指定なら**退避条件を満たすものだけ**を対象にする（満たさないものを skip 報告しない）
  if [ -z "$targets" ]; then
    explicit=no
    for f in "$AIDEV/backlog"/*.md; do
      [ -f "$f" ] || continue
      if bl_archivable "$f"; then targets="$targets $(basename "$f")"; fi
    done
  fi

  moved=0; skipped=0
  for t in $targets; do
    f="$AIDEV/backlog/$t"
    if [ ! -f "$f" ]; then
      printf 'skip %s: active にありません\n' "$t"; skipped=$((skipped+1)); continue
    fi
    if [ "$force" = no ] && ! bl_archivable "$f"; then
      if [ "$explicit" = yes ]; then
        printf 'skip %s: 退避条件を満たしません (kind=%s todo=%s done=%s)\n' \
          "$t" "${BL_KIND:--}" "$BL_TODO" "$BL_DN"
      fi
      skipped=$((skipped+1)); continue
    fi
    mkdir -p "$AIDEV/backlog/archive"
    if [ -e "$AIDEV/backlog/archive/$t" ]; then
      printf 'skip %s: archive/ に同名があります\n' "$t"; skipped=$((skipped+1)); continue
    fi
    mv "$f" "$AIDEV/backlog/archive/$t"
    printf 'archived: %s\n' "$t"; moved=$((moved+1))
  done
  printf 'summary: archived=%s skipped=%s\n' "$moved" "$skipped"
  # git は触らない（破壊的 git 操作は CLI に持たせない。DESIGN「2.6」の verify && commit 方針）
  if [ "$moved" -gt 0 ]; then
    printf 'note: git 未反映（`git add -A .aidev/backlog` でリネームとして拾われる）\n'
  fi
}

# --- 索引（AGENTS.md の aidev:conventions ブロック）------------------------------
# AGENTS.md / CLAUDE.md は**自動読込**されるが条項ディレクトリはされない。索引に載っていない条項は
# **読まれないまま**works が流れ、効果検証で「効かなかった」と誤判定される——条項の内容の問題ではなく
# 単に届いていないだけなのに。CLI が「索引に足せ」と言うだけで誰も見ていないと、この誤判定が
# 静かに積み上がる。そこで doctor が索引を突き合わせる。
CV_IDX_OPEN='<!-- aidev:conventions -->'
CV_IDX_CLOSE='<!-- /aidev:conventions -->'

# 索引ファイルの決定。PJ 固有ファイル名を CLI に埋めないため config を優先し、
# 未設定のときだけ慣行（AGENTS.md → CLAUDE.md）にフォールバックする。
cv_index_file() {
  f=$(yget "$AIDEV/config.yml" conventionsIndex)
  if [ -n "$f" ]; then
    case "$f" in /*) printf '%s' "$f" ;; *) printf '%s/%s' "$ROOT" "$f" ;; esac
    return 0
  fi
  for c in AGENTS.md CLAUDE.md; do
    [ -f "$ROOT/$c" ] && { printf '%s' "$ROOT/$c"; return 0; }
  done
  printf ''
}

# 索引ファイルの**表示名**。config も慣行も外れている PJ に「AGENTS.md に足せ」と言うと、
# 存在しないファイルを名指しすることになる。決まっていないなら決まっていないと言い、
# どこで決めるか（conventionsIndex）を示す。
cv_index_label() {
  _f=$(cv_index_file)
  if [ -n "$_f" ]; then
    basename "$_f"
  else
    printf '索引ファイル（.aidev/config.yml の conventionsIndex。未設定なら AGENTS.md → CLAUDE.md を探す）'
  fi
}

# 索引ブロックの中身だけを取り出す（マーカー外は PJ のもので、harness は見ない）。
cv_index_block() { # file
  [ -f "$1" ] || return 0
  awk -v o="$CV_IDX_OPEN" -v c="$CV_IDX_CLOSE" '
    index($0,o) {inb=1; next}
    index($0,c) {inb=0; next}
    inb {print}' "$1" 2>/dev/null
}

# 条項ディレクトリの ROOT 相対表記（索引に書かれるリンクの形）。
cv_dir_rel() {
  d=$(cv_dir)
  case "$d" in "$ROOT"/*) printf '%s' "${d#"$ROOT"/}" ;; *) printf '%s' "$d" ;; esac
}

# --- コマンド: convention -----------------------------------------------------
# **起こす／状態を進める／退避する**だけを持たせる。本文を PJ ドキュメントへ実際に移す作業は
# 文体・配置・既存章との統合という判断なので CLI にしない（backlog の消し込み本体と同じ線引き）。
cmd_convention() {
  [ $# -ge 1 ] || die "使用法: aidev convention <new|confirm|retire|defer|promote|status> ..."
  sub=$1; shift
  case "$sub" in
    new)     cv_new "$@" ;;
    defer)   cv_defer "$@" ;;
    confirm) cv_confirm "$@" ;;
    retire)  cv_retire "$@" ;;
    promote) cv_promote "$@" ;;
    status)  cv_do_status "$@" ;;
    *) die "未知の convention サブコマンド: $sub（new|confirm|retire|promote|status）" ;;
  esac
}

cv_new() {
  id=""; hyp=""; src=""; va=""; base=""; scope=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --hypothesis)   need_arg "$1" $#; hyp=${2:-}; shift 2 ;;
      --baseline)     need_arg "$1" $#; base=${2:-}; shift 2 ;;
      --source)       need_arg "$1" $#; src=${2:-}; shift 2 ;;
      --scope)        need_arg "$1" $#; scope=${2:-}; shift 2 ;;
      --verify-after) need_arg "$1" $#; va=${2:-}; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) if [ -z "$id" ]; then id=$1; else die "id は1つだけ"; fi; shift ;;
    esac
  done
  [ -n "$id" ] || die "使用法: aidev convention new <id> --hypothesis <text> --baseline <text> [--scope <text>] [--source <path>] [--verify-after <n>]"
  id=$(basename "$id" .md)
  # 仮説を必須にするのが**この層の入口ゲート**。「どの指標がどう動けば成功か」を書けない条項は
  # 後から検証できず、事後の物語作りにしかならない。書けないなら条項にすべきでない
  [ -n "$hyp" ] || die "--hypothesis は必須です（何がどう動けば効果ありと判定するか。書けない条項は検証できない）"
  # baseline も必須。**条項 id は今この瞬間に生まれる**ので、導入前の review.md にその id は
  # 決して現れない。id 別の件数は 0 -> N と増える方向にしか動かず、前後比較にならない。
  # 「前」を作れるのは、起票時に**観点で**数えて刻んでおく道だけ。変更前に書くから事後の物語作りにならない。
  # 履歴が無くて数えられないなら、その事実を値として書く（捏造も空欄も不可。protocol.md「8.」）
  [ -n "$base" ] || die "--baseline は必須です（導入前にこの観点の指摘が何件あったか。数えられないならその事実を書く。例: '直近10 works で must 2 / should 5' / '0件（review.md が無く前を作れない）'）"
  [ -n "$va" ] || va=5
  case "$va" in ''|*[!0-9]*) die "--verify-after は整数（母集団の最低件数）" ;; esac
  # 0 は受理すると永久に ready=no（判定側が va>0 を要求する）。入口で弾く
  [ "$va" -gt 0 ] || die "--verify-after は 1 以上（0 だと母集団が揃わず永久に判定できない）"
  d=$(cv_dir)
  mkdir -p "$d"
  f="$d/$id.md"
  [ -e "$f" ] && die "すでにあります: $f"
  if [ -f "$d/archive/$id.md" ]; then
    die "同じ id が archive にあります（$d/archive/$id.md）。移送済み条項の再提案は重複です"
  fi
  {
    printf '%s\n' '---'
    printf 'convention: %s\n' "$id"
    printf 'status: pending\n'
    printf 'introduced: %s\n' "$(now)"
    if [ -n "$src" ]; then printf 'source: %s\n' "$src"; fi
    if [ -n "$scope" ]; then printf 'scope: %s\n' "$scope"; fi
    printf 'hypothesis: %s\n' "$hyp"
    printf 'baseline: %s\n' "$base"
    printf 'verify_after: %s\n' "$va"
    printf '%s\n\n' '---'
    printf '# %s\n\n' "$id"
    printf '%s\n\n' '<!-- 条項の本文。PJ ドキュメントへ移送(promote)するまではここが唯一の在処。 -->'
    printf '%s\n\n' '## 規約'
    printf '%s\n\n' '<!-- 何を守るか。レビューで指摘するときの根拠になる粒度で書く。 -->'
    printf '%s\n\n' '## 背景'
    printf '%s\n' '<!-- どのレビュー指摘/分析から起こしたか（source を人間向けに補足）。 -->'
  } > "$f"
  printf 'created: %s (status pending, verify_after %s)\n' "$f" "$va"
  # scope が無いと、母集団に「条項の対象外の work」と「条項自身を適用した work」が混ざる。
  # 機械で絞れないので、せめて宣言させて判定側が外せるようにする（実走で pop 3 のうち対象 1 だった）
  [ -n "$scope" ] || printf 'warn: --scope が未指定です（どんな work がこの条項の対象か）。母集団に対象外の work が混ざったまま判定することになります\n'
  # 索引に載せないと自動読込されない＝読まれない。doctor も見るが、まずここで促す
  _rel="$(cv_dir_rel)/$id.md"
  _idxl=$(cv_index_label)
  printf 'next: %s の索引ブロックに1行足すこと（読む条件つき。無いと読まれない。protocol.md「12.」）\n' "$_idxl"
  printf '      - <いつ参照するか> → %s\n' "$_rel"
  # 入口の重複排除。どこを見るかは PJ が config で申告する（探索範囲の決定は判断なので CLI はしない）
  _dr=$(ylist "$AIDEV/config.yml" docsRoots | sed 's/^ *//; s/ *$//; s/  */, /g')
  if [ -n "$_dr" ]; then
    printf 'check: 同じ規約が既存 docs に無いか確認すること（docsRoots: %s）\n' "$_dr"
  else
    printf 'check: .aidev/config.yml に docsRoots が未設定です。既存 docs との重複を機械的に絞れないので、\n'
    printf '       確認していない旨を retro/insights に明記すること（捏造で埋めない。protocol.md「8.」）\n'
  fi
}

# 出口ゲート: 母集団が verify_after に達していない条項は判定させない。入口（new）に仮説の関門が
# あっても、出口で何も止まらなければ「事後の物語作り」は判定側で起きる（pop=0 の confirm が通っていた）。
# --force は理由必須の非常口で、frontmatter に `forced: true` が残る（後から読む人が「揃う前の判定」と分かる）。
# 呼び出し側が forced を刻む（status/result の後ろに置いて frontmatter の並びを両実装で揃える）
CV_FORCED=""
cv_exit_gate() { # file force(yes|no) 動詞
  CV_FORCED=""
  _va=$(cv_get "$1" verify_after)
  case "$_va" in ''|*[!0-9]*) _va=0 ;; esac
  [ "$_va" -gt 0 ] || return 0
  _in=$(cv_get "$1" introduced)
  _pop=0
  if [ -n "$_in" ]; then _pop=$(cv_pop "$_in"); fi
  [ "$_pop" -ge "$_va" ] && return 0
  if [ "$2" = yes ]; then
    printf 'warn: 母集団が揃っていません(pop %s / need %s)。--force により %s します（forced: true を刻む）\n' "$_pop" "$_va" "$3"
    CV_FORCED=yes
    return 0
  fi
  die "母集団が揃っていません(pop $_pop / need $_va)。判定は揃ってから（aidev convention status）。それでも $3 するなら --force（理由を --result/--note に書く）"
}

# 判定を先送りする。「示せないなら pending のまま置く」は正規の選択肢なのに、その後は
# doctor の WARN と deliver の到達通知を止める手段が frontmatter の手編集しか無かった。
# 必要件数を積み増して、次に揃うまで黙らせる（理由必須。理由の無い先送りは滞留と区別できない）
cv_defer() {
  id=""; va=""; note=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --verify-after) need_arg "$1" $#; va=${2:-}; shift 2 ;;
      --note) need_arg "$1" $#; note=${2:-}; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) if [ -z "$id" ]; then id=$1; else die "id は1つだけ"; fi; shift ;;
    esac
  done
  [ -n "$id" ] || die "使用法: aidev convention defer <id> --verify-after <n> --note <text>"
  case "$va" in ''|*[!0-9]*) die "--verify-after は整数（先送り後に必要な母集団件数）" ;; esac
  [ -n "$note" ] || die "--note は必須です（なぜ先送りするか。理由の無い先送りは pending の滞留と区別できない）"
  f=$(cv_find "$id") || die "条項がありません: $id"
  case "$f" in *"/archive/"*) die "退避済みの条項は変更できません: $id" ;; esac
  cv_require "$f" "$id"
  [ "$(cv_get "$f" status)" = pending ] || die "pending の条項だけ先送りできます: $id"
  _in=$(cv_get "$f" introduced)
  _pop=0
  if [ -n "$_in" ]; then _pop=$(cv_pop "$_in"); fi
  [ "$va" -gt "$_pop" ] || die "--verify-after $va は現在の母集団 $_pop 以下なので黙りません（$((_pop+1)) 以上を指定）"
  cv_set "$f" verify_after "$va"
  cv_set "$f" deferred "$(now)"
  cv_set "$f" defer_note "$note"
  printf 'deferred: %s (verify_after %s, pop %s)\n' "$id" "$va" "$_pop"
}

cv_confirm() {
  id=""; result=""; force=no
  while [ $# -gt 0 ]; do
    case "$1" in
      --result) need_arg "$1" $#; result=${2:-}; shift 2 ;;
      --force)  force=yes; shift ;;
      -*) die "未知のオプション: $1" ;;
      *) if [ -z "$id" ]; then id=$1; else die "id は1つだけ"; fi; shift ;;
    esac
  done
  [ -n "$id" ] || die "使用法: aidev convention confirm <id> --result <text> [--force]"
  # 内訳の無い confirm は後から検証できない（何と何を比べて「効いた」としたのかが残らない）
  [ -n "$result" ] || die "--result は必須です（判定の内訳: baseline と導入後の件数、母集団の work 数。書けない判定は残せない）"
  f=$(cv_find "$id") || die "条項がありません: $id"
  case "$f" in *"/archive/"*) die "退避済みの条項は変更できません: $id" ;; esac
  cv_require "$f" "$id"
  cv_exit_gate "$f" "$force" confirm
  cv_set "$f" status confirmed
  cv_set "$f" result "$result"
  if [ "$CV_FORCED" = yes ]; then cv_set "$f" forced true; fi
  printf 'confirmed: %s\n' "$id"
  printf 'next: 本文を PJ ドキュメントへ移し、`aidev convention promote %s --to <path#anchor>` で tombstone 化する\n' "$id"
}

cv_retire() {
  id=""; st=""; note=""; force=no
  while [ $# -gt 0 ]; do
    case "$1" in
      --status) need_arg "$1" $#; st=${2:-}; shift 2 ;;
      --note)   need_arg "$1" $#; note=${2:-}; shift 2 ;;
      --force)  force=yes; shift ;;
      -*) die "未知のオプション: $1" ;;
      *) if [ -z "$id" ]; then id=$1; else die "id は1つだけ"; fi; shift ;;
    esac
  done
  [ -n "$id" ] || die "使用法: aidev convention retire <id> --status ineffective|superseded --note <text> [--force]"
  case "$st" in
    ineffective|superseded) ;;
    "") die "--status は必須です（ineffective|superseded）" ;;
    *) die "未知の status: $st（ineffective|superseded）" ;;
  esac
  # 理由の無い退役は tombstone に何も残さず、同じ観点の再提案を弾く根拠にならない
  [ -n "$note" ] || die "--note は必須です（退役理由。ineffective なら何が効かなかったか、superseded なら何に置き換わったか）"
  f=$(cv_find "$id") || die "条項がありません: $id"
  case "$f" in *"/archive/"*) die "すでに退避済みです: $id" ;; esac
  cv_require "$f" "$id"
  # superseded は「別の条項に置き換わった」なので母集団は要らない。ineffective は効果判定なので要る
  if [ "$st" = ineffective ]; then cv_exit_gate "$f" "$force" retire; fi
  cv_set "$f" status "$st"
  cv_set "$f" note "$note"
  if [ "$CV_FORCED" = yes ]; then cv_set "$f" forced true; fi
  cv_archive_file "$f"
  printf 'retired: %s (%s)\n' "$id" "$st"
  # 退役しても索引ブロックの行は残る（promote の張り替えと同じ「後始末」）。
  # 残ると索引が存在しないファイルを指し続ける。doctor も検査するが、まずここで促す
  printf 'next: %s の索引ブロックから %s の行を消すこと\n' "$(cv_index_label)" "$(cv_dir_rel)/$id.md"
  if [ "$st" = ineffective ]; then
    printf 'note: 「効かなかった」は「条項が誤り」とは限らない。散文層の限界なら CLI/フック層へ寄せることを検討（DESIGN「2.6」）\n'
  fi
}

cv_promote() {
  id=""; to=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) need_arg "$1" $#; to=${2:-}; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) if [ -z "$id" ]; then id=$1; else die "id は1つだけ"; fi; shift ;;
    esac
  done
  [ -n "$id" ] || die "使用法: aidev convention promote <id> --to <path#anchor>"
  [ -n "$to" ] || die "--to は必須です（移送先の PJ ドキュメント。例 docs/coding-standards.md#naming）"
  f=$(cv_find "$id") || die "条項がありません: $id"
  case "$f" in *"/archive/"*) die "すでに退避済みです: $id" ;; esac
  cv_require "$f" "$id"
  # 移送先の実在を確かめる。dangling な promoted_to を作ると索引が壊れ、
  # 「本文がどこにも無い」という二重管理より悪い状態になる（アンカーまでは見ない）
  tgt=${to%%#*}
  case "$tgt" in /*) tpath=$tgt ;; *) tpath="$ROOT/$tgt" ;; esac
  [ -f "$tpath" ] || die "移送先が見つかりません: $tgt（先に本文を移してから promote する）"
  # **破壊の前に**退避先の衝突を見る。後ろで見ると、本文を捨てた後に失敗して
  # 「tombstone だけが active に残る」という直せない状態になる
  cv_archive_free "$f"
  cv_set "$f" status promoted
  cv_set "$f" promoted_to "$to"
  cv_set "$f" promoted_at "$(date -u +%F)"
  cv_tombstone "$f" "本文は promoted_to へ移送済み。ここには置かない（本文の在処は常に1箇所）。"
  cv_archive_file "$f"
  printf 'promoted: %s -> %s\n' "$id" "$to"
  printf 'next: %s の索引ブロックのリンク先を %s に張り替えること\n' "$(cv_index_label)" "$to"
}

# 退避先が空いているか。**破壊的な操作の前に**呼べるよう、移動本体と分けてある。
cv_archive_free() { # path
  _d=$(cv_dir)
  _b=$(basename "$1")
  if [ -e "$_d/archive/$_b" ]; then die "archive に同名があります: $_d/archive/$_b"; fi
}

cv_archive_file() { # path
  d=$(cv_dir)
  cv_archive_free "$1"
  mkdir -p "$d/archive"
  b=$(basename "$1")
  mv "$1" "$d/archive/$b"
  printf 'archived: %s\n' "$d/archive/$b"
}

# 母集団のメンバー一覧。`pop` は件数しか出さないので、判定側は「どの work を数えたか」を
# state.yml/metrics.yml を自分で読んで復元するしかなく、review.md のタグ集計（分子）を
# 母集団（分母）と同じ集合に絞れなかった。ここで work 名・着手・deliver・タグ件数を同じ集合で出す。
# タグは subtask の review.md も含めて数える（subtask は親に属する。母集団は top-level だけ）
# review.md のタグ集計。**指摘行（`- [` 始まり）だけ**を対象にする。
# mode=any は `[conv:<id>]` と `[conv:<id>!]` の両方、viol は `!` 付き（＝違反）だけ。
# subtask の review.md も含める（subtask は親に属する）
cv_count_tags() { # work_dir id any|viol
  case "$3" in
    viol) _pat="\[conv:$2!\]" ;;
    *)    _pat="\[conv:$2!\]\|\[conv:$2\]" ;;
  esac
  find "$1" -name review.md -exec grep -h '^[[:space:]]*- \[' {} + 2>/dev/null \
    | grep -o "$_pat" | wc -l | tr -d ' '
}

cv_members() { # id fmt
  f=$(cv_find "$1") || die "条項がありません: $1"
  _id=$(cv_id "$1")
  _in=$(cv_get "$f" introduced)
  [ -n "$_in" ] || die "introduced が無い条項です: $_id"
  _b=$(cv_ts_key "$_in") || die "introduced が不正です: $_in"
  rows=""; n=0; tsum=0; vsum=0
  if [ -d "$AIDEV/works" ]; then
    for _pd in "$AIDEV/works"/*/; do
      [ -d "$_pd" ] || continue
      _pf="${_pd}metrics.yml"
      [ -f "$_pf" ] || continue
      ylist "${_pd}state.yml" approved | grep -qw deliver || continue
      _pts=$(cv_first_ts "$_pf")
      [ -n "$_pts" ] || continue
      _a=$(cv_ts_key "$_pts") || continue
      [ "$_a" -ge "$_b" ] || continue
      # ts を持つ deliver approved 行のうち最後のもの（ps1 と同じ選び方。手編集で ts の無い行があっても揃う）
      _dts=$(sed -n '/phase: deliver, event: approved/s/^[^{]*{[[:space:]]*ts:[[:space:]]*\([0-9][0-9:TZ.-]*\).*/\1/p' "$_pf" | tail -n1)
      [ -n "$_dts" ] || _dts="-"
      # 数えるのは**指摘行（`- [` 始まり）のタグだけ**。本文中の言及まで数えると、
      # 「この条項の指摘は 0 件だった」と書いた行が 1 件として計上される（実測で起きた）
      _tg=$(cv_count_tags "$_pd" "$_id" any)
      # 違反（`[conv:<id>!]`）だけを別に数える。タグは「この条項に関係する指摘」に付くので、
      # 条項が効くほどタグは増える。仮説（違反が減る）を falsify できるのは違反だけ
      _vi=$(cv_count_tags "$_pd" "$_id" viol)
      n=$((n+1)); tsum=$((tsum+_tg)); vsum=$((vsum+_vi))
      rows="${rows}$(basename "$_pd")	${_pts}	${_dts}	${_tg}	${_vi}
"
    done
  fi
  if [ "$2" = tsv ]; then
    printf '%s' "$rows" | while IFS='	' read -r a b c e g; do
      [ -n "$a" ] || continue
      printf 'member	%s	%s	%s	%s	%s\n' "$a" "$b" "$c" "$e" "$g"
    done
  else
    { printf 'work	started	delivered	conv_tags	violations\n'; printf '%s' "$rows"; } | fmt_table
  fi
  printf 'members-summary: id=%s pop=%s conv_tags=%s violations=%s\n' "$_id" "$n" "$tsum" "$vsum"
  _sc=$(cv_get "$f" scope)
  if [ -n "$_sc" ]; then
    printf 'scope: %s\n' "$_sc"
    printf 'note: 母集団は introduced 以降の全 work。scope の外の work と条項自身を適用した work は判定から外すこと\n'
  else
    printf 'note: scope 未宣言。どの work が仮説の対象かを条項に書くこと（aidev convention new --scope）\n'
  fi
}

cv_do_status() {
  fmt=table; members=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --format)  need_arg "$1" $#; fmt=${2:-}; shift 2 ;;
      --members) need_arg "$1" $#; members=${2:-}; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) die "余分な引数: $1" ;;
    esac
  done
  case "$fmt" in table|tsv) ;; *) die "--format は table|tsv" ;; esac
  d=$(cv_dir)
  # 条項ゼロは**正常な状態**（PJ の出発点）。読み取り専用コマンドをここで落とすと、
  # review/retro/insights/propose が「毎回エラー経路を踏む」ことになる（実走で 4 工程が踏んだ）
  if [ ! -d "$d" ]; then
    if [ "$fmt" = table ]; then printf 'id	status	introduced	pop	need	ready	index	promoted_to\n' | fmt_table; fi
    printf 'convention-summary: pending=0 ready=0 confirmed(未移送)=0 索引漏れ=0\n'
    printf 'note: 条項がまだありません（%s は未作成）。aidev convention new で起こす\n' "$(cv_dir_rel)"
    return 0
  fi
  if [ -n "$members" ]; then cv_members "$members" "$fmt"; return 0; fi
  # 行は status と同じく「タブ区切り文字列を積んで最後に fmt_table へ流す」形にする
  # （command substitution は末尾改行を落とすので、行の組み立てに $( ) を使わない）
  CV_IDXF=$(cv_index_file)
  CV_IDXB=""
  if [ -n "$CV_IDXF" ]; then CV_IDXB=$(cv_index_block "$CV_IDXF"); fi
  CV_REL=$(cv_dir_rel)
  cv_pop_prime   # 親シェルで1回。ループ内の $(cv_pop) はサブシェルなので、ここで積まないと毎回走査する
  rows=""; npend=0; nready=0; nconf=0; nidx=0
  for f in "$d"/*.md "$d/archive"/*.md; do
    [ -f "$f" ] || continue
    id=$(basename "$f" .md)
    st=$(cv_get "$f" status); [ -n "$st" ] || st="-"
    intro=$(cv_get "$f" introduced); [ -n "$intro" ] || intro="-"
    va=$(cv_get "$f" verify_after)
    case "$va" in ''|*[!0-9]*) va=0 ;; esac
    pt=$(cv_get "$f" promoted_to); [ -n "$pt" ] || pt="-"
    # archive 済みの pop は意味を持たない（判定は済んでいる）ので計算も表示もしない
    case "$f" in
      "$d/archive/"*) pop="-" ;;
      *) if [ "$intro" = "-" ]; then pop=0; else pop=$(cv_pop "$intro"); fi ;;
    esac
    ready="-"
    if [ "$st" = pending ]; then
      npend=$((npend+1))
      if [ "$pop" != "-" ] && [ "$va" -gt 0 ] && [ "$pop" -ge "$va" ]; then ready=yes; nready=$((nready+1)); else ready=no; fi
    fi
    if [ "$st" = confirmed ]; then nconf=$((nconf+1)); fi
    # index 列: active な条項が索引に載っているか。載っていない＝自動読込されない＝読まれない。
    # 読まれていないだけの条項を「効かなかった」と判定しないための可視化。
    idx="-"
    case "$f" in
      "$d/archive/"*) ;;
      *) case "$st" in
           pending|confirmed)
             if [ -n "$CV_IDXF" ] && printf '%s' "$CV_IDXB" | grep -qF "$CV_REL/$(basename "$f")"; then
               idx=yes
             else
               idx=no; nidx=$((nidx+1))
             fi ;;
         esac ;;
    esac
    rows="${rows}${id}	${st}	${intro}	${pop}	${va}	${ready}	${idx}	${pt}
"
  done
  if [ "$fmt" = tsv ]; then
    printf '%s' "$rows" | while IFS='	' read -r a b c e f g h i; do
      [ -n "$a" ] || continue
      printf 'convention	%s	%s	%s	%s	%s	%s	%s	%s\n' "$a" "$b" "$c" "$e" "$f" "$g" "$h" "$i"
    done
  else
    { printf 'id	status	introduced	pop	need	ready	index	promoted_to\n'; printf '%s' "$rows"; } | fmt_table
  fi
  printf 'convention-summary: pending=%s ready=%s confirmed(未移送)=%s 索引漏れ=%s\n' \
    "$npend" "$nready" "$nconf" "$nidx"
}

# 条項ファイルの一生を見る（backlog と同じく**持ち主の work がいない**ので verify では硬ゲートにできない）。
# 見るのは4つ: frontmatter の欠落・未知 status / 判定可能なのに未判定 / confirmed の移送漏れ / 終状態の退避漏れ。
doctor_conventions() {
  d=$(cv_dir)
  [ -d "$d" ] || return 0
  # 索引はファイル単位で1回だけ読む（条項ごとに読み直さない）
  CV_IDXF=$(cv_index_file)
  CV_IDXB=""
  CV_IDXL="-"
  if [ -n "$CV_IDXF" ]; then
    CV_IDXB=$(cv_index_block "$CV_IDXF")
    CV_IDXL=$(basename "$CV_IDXF")
  fi
  cv_pop_prime   # 親シェルで1回（理由は cv_do_status と同じ）
  cfiles=0; carch=0; cwarn=0; cout=""
  for f in "$d"/*.md "$d/archive"/*.md; do
    [ -f "$f" ] || continue
    case "$f" in
      "$d/archive/"*) arch=yes; label="archive/$(basename "$f")"; carch=$((carch+1)) ;;
      *)              arch=no;  label=$(basename "$f");           cfiles=$((cfiles+1)) ;;
    esac
    st=$(cv_get "$f" status)
    intro=$(cv_get "$f" introduced)
    va=$(cv_get "$f" verify_after)
    _rel="$(cv_dir_rel)/$(basename "$f")"
    _inidx=no
    if [ -n "$CV_IDXF" ] && printf '%s' "$CV_IDXB" | grep -qF "$_rel"; then _inidx=yes; fi
    w=""
    case "$st" in
      "")
        w="$w    WARN frontmatter(status)が無い: 検証の進み方が決まらない（pending/confirmed/promoted/ineffective/superseded）
" ;;
      pending)
        if [ "$arch" = yes ]; then
          w="$w    WARN 退避済みだが status=pending: 判定前に退避されている
"
        else
          case "$va" in ''|*[!0-9]*) va=0 ;; esac
          if [ -n "$intro" ] && [ "$va" -gt 0 ]; then
            pop=$(cv_pop "$intro")
            # 索引に無い条項は読まれていないので判定させない（insights も「判定しない」と書く。
            # ここで催促すると、届いていないだけの条項が ineffective にされる）。索引漏れ自体は下で WARN する
            if [ "$pop" -ge "$va" ] && [ "$_inidx" = yes ]; then
              w="$w    WARN 母集団が揃った(${pop}/${va})のに未判定: insights で効果を判定すること
"
            elif [ "$pop" -ge "$va" ]; then
              w="$w    note 母集団は揃った(${pop}/${va})が索引に無いので判定しない: 索引に足してから aidev convention defer で必要件数を積み増し、読まれた work で数え直す
"
            fi
          fi
        fi ;;
      confirmed)
        if [ "$arch" = no ]; then
          # 効果が確認された条項が条項ディレクトリに居座ると、PJ ドキュメントと二重管理になる
          w="$w    WARN confirmed だが未移送: PJ ドキュメントへ移して promote すること
"
        fi ;;
      promoted)
        if [ -z "$(cv_get "$f" promoted_to)" ]; then
          w="$w    WARN promoted だが promoted_to が無い: 本文の行き先が辿れない
"
        fi
        if [ "$arch" = no ]; then
          w="$w    WARN promoted だが未退避: active に残ると重複提案の検査対象からずれる
"
        fi ;;
      ineffective|superseded)
        if [ "$arch" = no ]; then
          w="$w    WARN $st だが未退避: archive/ へ移すこと
"
        fi ;;
      *)
        w="$w    WARN 未知の status: $st（pending/confirmed/promoted/ineffective/superseded）
" ;;
    esac
    # 本文が未記入（起票テンプレのコメントが残ったまま）の active な条項。索引に載れば「読まれる」が
    # 中身が無い＝タグは付くのに規約は無い、という空回りの母集団ができる。誰の手順にも「本文を書く」段が
    # 無かったので、ここで拾う
    if [ "$arch" = no ]; then
      case "$st" in pending|confirmed)
        if grep -qF '<!-- 何を守るか。' "$f" 2>/dev/null; then
          w="$w    WARN 本文が未記入（起票テンプレのまま）: ## 規約 を書くこと。索引に載っても中身が無ければ効かない
"
        fi ;;
      esac
    fi
    # 索引の突き合わせ（active な条項＝読まれる必要があるもの、と移送済みの張り替え漏れ）
    case "$st" in
      pending|confirmed)
        if [ "$arch" = no ]; then
          if [ -z "$CV_IDXF" ]; then
            w="$w    WARN 索引ファイルが無い: 条項が自動読込されず、読まれないまま「効かなかった」と誤判定される
"
          elif ! printf '%s' "$CV_IDXB" | grep -qF "$_rel"; then
            w="$w    WARN 索引に無い（$CV_IDXL）: 自動読込されないので読まれない。ブロック内に足すこと
"
            w="$w         例: - <いつ参照するか> → $_rel
"
          fi
        fi ;;
      promoted)
        pt=$(cv_get "$f" promoted_to)
        if [ -n "$CV_IDXF" ] && [ -n "$pt" ]; then
          if printf '%s' "$CV_IDXB" | grep -qF "$_rel"; then
            w="$w    WARN 索引が移送前を指したまま（$CV_IDXL）: $_rel → $pt に張り替えること
"
          fi
        fi ;;
      ineffective|superseded)
        # 退役した条項の行が索引に残ると、存在しないファイルを指し続ける（dangling）。
        # promote の張り替え漏れと同じ型の後始末漏れ
        if [ "$arch" = yes ] && [ -n "$CV_IDXF" ] && printf '%s' "$CV_IDXB" | grep -qF "$_rel"; then
          w="$w    WARN 索引が退役済み条項を指したまま（$CV_IDXL）: $_rel の行を消すこと
"
        fi ;;
    esac
    if [ -n "$w" ]; then
      cwarn=$((cwarn+1))
      cout="$cout- $label (status=${st:--})
$w"
    fi
  done
  printf 'convention: 条項ファイル横断検査\n'
  if [ -n "$cout" ]; then printf '%s' "$cout"; fi
  printf 'convention-summary: files=%s archived=%s warn=%s\n' "$cfiles" "$carch" "$cwarn"
}

# --- ハーネス改修の仮説登録（.aidev/harness/<id>.md） -----------------------------
# 条項には入口（仮説・baseline 必須）と出口（母集団ゲート）があるのに、ハーネス自身の
# 改修には仮説を受ける口が無く、DESIGN が最も警戒する「事後の物語作り」がそのまま起きていた。
# 同じ型の記録を PJ の .aidev/harness/ に置く（この PJ で回した work を母集団にする）。
# 母集団 = introduced 以降に着手し、deliver 済みで、**またがっていない**（harnessRev == harnessRevDelivered）
# top-level work。またがり work は改修の効果を半分しか受けていないので数えない。
hv_dir() { printf '%s/harness' "$AIDEV"; }
hv_find() { # id -> path（active 優先、無ければ archive）。無ければ 1
  _i=$(cv_id "$1")
  if [ -f "$(hv_dir)/$_i.md" ]; then printf '%s' "$(hv_dir)/$_i.md"; return 0; fi
  if [ -f "$(hv_dir)/archive/$_i.md" ]; then printf '%s' "$(hv_dir)/archive/$_i.md"; return 0; fi
  return 1
}
hv_require() { # path id
  if [ -z "$(cv_get "$1" harness)" ] && [ -z "$(cv_get "$1" status)" ]; then
    die "ハーネス改修の記録ではありません（harness / status がどちらも無い）: $1"
  fi
}
hv_pop_prime() {
  [ "${HV_TS_READY:-}" = yes ] && return 0
  HV_TS_READY=yes; HV_TS=""
  [ -d "$AIDEV/works" ] || return 0
  for _pd in "$AIDEV/works"/*/; do
    [ -d "$_pd" ] || continue
    _pf="${_pd}metrics.yml"; _ps="${_pd}state.yml"
    [ -f "$_pf" ] && [ -f "$_ps" ] || continue
    ylist "$_ps" approved | grep -qw deliver || continue
    _hr=$(hr_get "$_ps"); _hd=$(hr_get "$_ps" harnessRevDelivered)
    [ -n "$_hr" ] && [ "$_hr" != unknown ] || continue
    if [ -n "$_hd" ] && [ "$_hd" != "$_hr" ]; then continue; fi
    _pts=$(cv_first_ts "$_pf"); [ -n "$_pts" ] || continue
    _a=$(cv_ts_key "$_pts") || continue
    HV_TS="$HV_TS $_a"
  done
}
hv_pop() { # introduced -> 件数
  n=0
  _b=$(cv_ts_key "$1") || { printf '0'; return 0; }
  hv_pop_prime
  for _a in $HV_TS; do [ "$_a" -ge "$_b" ] && n=$((n+1)); done
  printf '%s' "$n"
}
HV_FORCED=""
hv_exit_gate() { # file force 動詞
  HV_FORCED=""
  _va=$(cv_get "$1" verify_after)
  case "$_va" in ''|*[!0-9]*) _va=0 ;; esac
  [ "$_va" -gt 0 ] || return 0
  _in=$(cv_get "$1" introduced)
  _pop=0
  if [ -n "$_in" ]; then _pop=$(hv_pop "$_in"); fi
  [ "$_pop" -ge "$_va" ] && return 0
  if [ "$2" = yes ]; then
    printf 'warn: 母集団が揃っていません(pop %s / need %s)。--force により %s します（forced: true を刻む）\n' "$_pop" "$_va" "$3"
    HV_FORCED=yes
    return 0
  fi
  die "母集団が揃っていません(pop $_pop / need $_va)。判定は揃ってから（aidev harness status）。それでも $3 するなら --force（理由を --result/--note に書く）"
}
hv_ready_notice() {
  d=$(hv_dir)
  [ -d "$d" ] || return 0
  hv_pop_prime
  for f in "$d"/*.md; do
    [ -f "$f" ] || continue
    [ "$(cv_get "$f" status)" = pending ] || continue
    intro=$(cv_get "$f" introduced); [ -n "$intro" ] || continue
    va=$(cv_get "$f" verify_after)
    case "$va" in ''|*[!0-9]*) continue ;; esac
    [ "$va" -gt 0 ] || continue
    pop=$(hv_pop "$intro")
    # 条項側（cv_ready_notice）と同じ理由で `-ge`。見ているのは pending だけなので、
    # 鳴り続けるのは未判定のものだけ＝判定すれば止まる催促
    if [ "$pop" -ge "$va" ]; then
      printf 'note: ハーネス改修 %s の母集団が揃っています(%s/%s)。insights で効果を判定してください（判定するまで毎回出ます）\n' \
        "$(basename "$f" .md)" "$pop" "$va"
    fi
  done
}
hv_archive() { # path
  d=$(hv_dir)
  mkdir -p "$d/archive"
  [ ! -e "$d/archive/$(basename "$1")" ] || die "退避先が埋まっています: $d/archive/$(basename "$1")"
  mv "$1" "$d/archive/$(basename "$1")"
}
hv_new() {
  id=""; hyp=""; src=""; va=""; base=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --hypothesis)   need_arg "$1" $#; hyp=${2:-}; shift 2 ;;
      --baseline)     need_arg "$1" $#; base=${2:-}; shift 2 ;;
      --source)       need_arg "$1" $#; src=${2:-}; shift 2 ;;
      --verify-after) need_arg "$1" $#; va=${2:-}; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) if [ -z "$id" ]; then id=$1; else die "id は1つだけ"; fi; shift ;;
    esac
  done
  [ -n "$id" ] || die "使用法: aidev harness new <id> --hypothesis <text> --baseline <text> [--source <path>] [--verify-after <n>]"
  id=$(cv_id "$id")
  [ -n "$hyp" ] || die "--hypothesis は必須です（どの指標がどう動けば効果ありと判定するか。書けない改修は効果を主張できない）"
  [ -n "$base" ] || die "--baseline は必須です（改修前の値。例: '直近 10 works の reworks 平均 1.4' / '0件（前を作れない）'）"
  [ -n "$va" ] || va=5
  case "$va" in ''|*[!0-9]*) die "--verify-after は整数（母集団の最低件数）" ;; esac
  [ "$va" -gt 0 ] || die "--verify-after は 1 以上"
  d=$(hv_dir); mkdir -p "$d"
  f="$d/$id.md"
  [ ! -e "$f" ] || die "すでにあります: $f"
  [ ! -f "$d/archive/$id.md" ] || die "同じ id が archive にあります（$d/archive/$id.md）。判定済み改修の再登録は重複です"
  rev=$(harness_rev)
  {
    printf -- '---\n'
    printf 'harness: %s\n' "$id"
    printf 'status: pending\n'
    printf 'introduced: %s\n' "$(now)"
    printf 'introduced_rev: %s\n' "$rev"
    if [ -n "$src" ]; then printf 'source: %s\n' "$src"; fi
    printf 'hypothesis: %s\n' "$hyp"
    printf 'baseline: %s\n' "$base"
    printf 'verify_after: %s\n' "$va"
    printf -- '---\n\n'
    printf '# %s\n\n' "$id"
    printf '## 改修内容\n\n<!-- aidev-* のどこをどう変えたか。改修 PR/コミットへの参照 -->\n\n'
    printf '## 判定メモ\n\n<!-- confirm/retire 時の内訳の補足（frontmatter の result/note が正） -->\n'
  } > "$f"
  printf 'created: %s (status pending, verify_after %s, introduced_rev %s)\n' "$f" "$va" "$rev"
  [ "$rev" != unknown ] || printf 'warn: harness_rev が取れない環境です（git 不在か aidev-* が未コミット）。harnessRev が unknown の work は母集団に数えないので、このままでは判定できません\n'
  printf 'next: ## 改修内容 を書く。母集団は導入後に着手し、またがらずに deliver した work（aidev harness status）\n'
}
hv_confirm() {
  id=""; result=""; force=no
  while [ $# -gt 0 ]; do
    case "$1" in
      --result) need_arg "$1" $#; result=${2:-}; shift 2 ;;
      --force)  force=yes; shift ;;
      -*) die "未知のオプション: $1" ;;
      *) if [ -z "$id" ]; then id=$1; else die "id は1つだけ"; fi; shift ;;
    esac
  done
  [ -n "$id" ] || die "使用法: aidev harness confirm <id> --result <text> [--force]"
  [ -n "$result" ] || die "--result は必須です（判定の内訳: baseline と導入後の値、母集団の work 数）"
  f=$(hv_find "$id") || die "ハーネス改修の記録がありません: $id"
  case "$f" in *"/archive/"*) die "判定済みです: $id" ;; esac
  hv_require "$f" "$id"
  hv_exit_gate "$f" "$force" confirm
  cv_set "$f" status confirmed
  cv_set "$f" result "$result"
  if [ "$HV_FORCED" = yes ]; then cv_set "$f" forced true; fi
  hv_archive "$f"
  printf 'confirmed: %s（archive へ退避）\n' "$id"
}
hv_retire() {
  id=""; st=""; note=""; force=no
  while [ $# -gt 0 ]; do
    case "$1" in
      --status) need_arg "$1" $#; st=${2:-}; shift 2 ;;
      --note)   need_arg "$1" $#; note=${2:-}; shift 2 ;;
      --force)  force=yes; shift ;;
      -*) die "未知のオプション: $1" ;;
      *) if [ -z "$id" ]; then id=$1; else die "id は1つだけ"; fi; shift ;;
    esac
  done
  [ -n "$id" ] || die "使用法: aidev harness retire <id> --status ineffective|superseded --note <text> [--force]"
  case "$st" in
    ineffective|superseded) ;;
    "") die "--status は必須です（ineffective|superseded）" ;;
    *) die "未知の status: $st（ineffective|superseded）" ;;
  esac
  [ -n "$note" ] || die "--note は必須です（退役理由）"
  f=$(hv_find "$id") || die "ハーネス改修の記録がありません: $id"
  case "$f" in *"/archive/"*) die "判定済みです: $id" ;; esac
  hv_require "$f" "$id"
  if [ "$st" = ineffective ]; then hv_exit_gate "$f" "$force" retire; fi
  cv_set "$f" status "$st"
  cv_set "$f" note "$note"
  if [ "$HV_FORCED" = yes ]; then cv_set "$f" forced true; fi
  hv_archive "$f"
  printf 'retired: %s (%s)\n' "$id" "$st"
}
hv_status() {
  fmt=table
  while [ $# -gt 0 ]; do
    case "$1" in
      --format) need_arg "$1" $#; fmt=${2:-}; shift 2 ;;
      -*) die "未知のオプション: $1" ;;
      *) die "余分な引数: $1" ;;
    esac
  done
  case "$fmt" in table|tsv) ;; *) die "--format は table|tsv" ;; esac
  d=$(hv_dir)
  # 記録ゼロは正常な状態（cv_do_status と同じ理由）
  if [ ! -d "$d" ]; then
    if [ "$fmt" = table ]; then printf 'id	status	introduced	introduced_rev	pop	need	ready\n' | fmt_table; fi
    printf 'harness-summary: pending=0 ready=0\n'
    printf 'note: ハーネス改修の記録がまだありません（.aidev/harness 未作成）。aidev harness new で登録する\n'
    return 0
  fi
  hv_pop_prime
  rows=""; npend=0; nready=0
  for f in "$d"/*.md "$d/archive"/*.md; do
    [ -f "$f" ] || continue
    id=$(basename "$f" .md)
    st=$(cv_get "$f" status); [ -n "$st" ] || st="-"
    intro=$(cv_get "$f" introduced); [ -n "$intro" ] || intro="-"
    rev=$(cv_get "$f" introduced_rev); [ -n "$rev" ] || rev="-"
    va=$(cv_get "$f" verify_after)
    case "$va" in ''|*[!0-9]*) va=0 ;; esac
    case "$f" in
      "$d/archive/"*) pop="-" ;;
      *) if [ "$intro" = "-" ]; then pop=0; else pop=$(hv_pop "$intro"); fi ;;
    esac
    ready="-"
    if [ "$st" = pending ]; then
      npend=$((npend+1))
      if [ "$pop" != "-" ] && [ "$va" -gt 0 ] && [ "$pop" -ge "$va" ]; then ready=yes; nready=$((nready+1)); else ready=no; fi
    fi
    rows="${rows}${id}	${st}	${intro}	${rev}	${pop}	${va}	${ready}
"
  done
  if [ "$fmt" = tsv ]; then
    printf '%s' "$rows" | while IFS='	' read -r a b c e f g h; do
      [ -n "$a" ] || continue
      printf 'harness	%s	%s	%s	%s	%s	%s	%s\n' "$a" "$b" "$c" "$e" "$f" "$g" "$h"
    done
  else
    { printf 'id	status	introduced	introduced_rev	pop	need	ready\n'; printf '%s' "$rows"; } | fmt_table
  fi
  printf 'harness-summary: pending=%s ready=%s\n' "$npend" "$nready"
}
doctor_harness() {
  d=$(hv_dir)
  # 0 件でも節見出しを出す（条項側と同じ）。無音で返すと、doctor だけを見ている人には
  # **その検査が走ったのかどうかが分からない**——「検査が無い」と「検査して 0 件」は別の情報
  if [ ! -d "$d" ]; then
    printf 'harness: ハーネス改修の記録検査\n'
    printf 'harness-summary: files=0 archived=0 warn=0\n'
    printf 'note: ハーネス改修の記録がまだありません。aidev harness new で起こす\n'
    return 0
  fi
  hv_pop_prime
  hfiles=0; harch=0; hwarn=0; hout=""
  for f in "$d"/*.md "$d/archive"/*.md; do
    [ -f "$f" ] || continue
    case "$f" in
      "$d/archive/"*) arch=yes; label="archive/$(basename "$f")"; harch=$((harch+1)) ;;
      *)              arch=no;  label=$(basename "$f");           hfiles=$((hfiles+1)) ;;
    esac
    st=$(cv_get "$f" status); intro=$(cv_get "$f" introduced); va=$(cv_get "$f" verify_after)
    w=""
    case "$st" in
      "") w="$w    WARN frontmatter(status)が無い: pending/confirmed/ineffective/superseded
" ;;
      pending)
        if [ "$arch" = yes ]; then
          w="$w    WARN 退避済みだが status=pending: 判定前に退避されている
"
        else
          case "$va" in ''|*[!0-9]*) va=0 ;; esac
          if [ -n "$intro" ] && [ "$va" -gt 0 ]; then
            pop=$(hv_pop "$intro")
            if [ "$pop" -ge "$va" ]; then
              w="$w    WARN 母集団が揃った(${pop}/${va})のに未判定: insights で効果を判定すること（aidev harness confirm|retire）
"
            fi
          fi
        fi ;;
      confirmed|ineffective|superseded)
        if [ "$arch" = no ]; then
          w="$w    WARN $st だが未退避: archive/ へ移すこと（confirm/retire は CLI で打てば退避される）
"
        fi ;;
      *) w="$w    WARN 未知の status: $st（pending/confirmed/ineffective/superseded）
" ;;
    esac
    if [ -n "$w" ]; then
      hwarn=$((hwarn+1))
      hout="$hout- $label (status=${st:--})
$w"
    fi
  done
  printf 'harness: ハーネス改修の記録検査\n'
  if [ -n "$hout" ]; then printf '%s' "$hout"; fi
  printf 'harness-summary: files=%s archived=%s warn=%s\n' "$hfiles" "$harch" "$hwarn"
}
# 起動確認の設定を PJ 単位で1行だけ検査する。
# **work ごとに鳴らさない**——未設定は work の問題ではなく PJ の設定漏れなので、
# 100 works ある PJ で 100 行出すと直せる WARN がノイズに埋もれる（straddle で学んだ形）。
# sharedFiles の妥当性を PJ 単位で検査する。
# 実走で「触らない storage.py が名指しされ、全 work が触る cli.py は名指しされない」という
# **反転**が起きた。CLI が名指しできるのは config に書かれた事実だけ（設計どおり）だが、
# その事実が実態から遅れていることを**誰も見ていなかった**——書くのは人間、でも
# 古びていることは機械が言える。判定は履歴（直近 N コミットのうち何本がそのファイルに触ったか）。
# 直すのは人間なので WARN 止まり。
# main worktree が既定ブランチに載っていないことを PJ 単位で 1 行だけ知らせる。
# `worktree add` は新しい枝を切るときにしか警告しないので、**既に載っている状態**は誰も言わない。
# この状態だと deliver「1.5」の既着地検知と `worktree files` の基点がどちらも素直でなくなる。
# H1（`ls-tree` が空でも空 blob のハッシュが返る）が直る前に刻まれた work は、
# **全環境で同じ値**を持つので効果検証に使えない。読む側では unknown に正規化しているが、
# `state.yml` には値が残るので「state に値があるのに metrics が unknown」に見える（retro が実測）。
# 何が起きているかを 1 行で言う——直せないが、混乱は防げる
# `.aidev/current` は **gitignore 対象である前提**で worktree 機能が成り立っている
# （DESIGN「INV-1」: worktree ローカルで main と非干渉）。追跡されていると deliver 手順の
# `git add -A` が current を巻き込み、前提が静かに崩れる（実走で発生）。導入手順 5 の自己診断
doctor_gitignore() {
  command -v git >/dev/null 2>&1 || return 0
  git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 || return 0
  _dgc=${AIDEV#"$ROOT"/}/current
  if git -C "$ROOT" ls-files --error-unmatch "$_dgc" >/dev/null 2>&1; then
    printf 'gitignore: 実行時状態の追跡\n'
    printf '    WARN %s が git に追跡されています: worktree は current が worktree ローカルであることに乗っています\n' "$_dgc"
    printf '         .gitignore に %s を足し、git rm --cached %s で外すこと（導入手順）\n' "$_dgc" "$_dgc"
  fi
  return 0
}

# ハーネスが git 管理下にないと `harness_rev` は常に `unknown` を返す。すると
# `harnessRev` も `harnessRevDelivered` も `unknown` になり、**両端が同じなので差が出ず、
# またがり（straddle）の判定が原理的に成立しない**（改訂版 retro が実測）。
# **版名を捏造してまで埋めない**——mtime や内容ハッシュで代用すると、無関係な touch で
# 誤検知し、誤検知はそのまま効果検証の母集団を痩せさせる（`harness_rev` を aidev-* に
# 絞ったのと同じ理由）。代わりに**検知が効かない環境であることを言う**。直し方は 1 つしかない
doctor_hrstraddle() {
  [ "$(harness_rev)" = unknown ] || return 0
  printf 'harnessRev: またがり検知\n'
  printf '    note: ハーネス(%s)が git 管理下にないため版名が取れません。\n' "$HARNESS"
  printf '          harnessRev / harnessRevDelivered の両端が unknown になり、**またがり判定が成立しません**\n'
  printf '          （版をまたいだ work は規約と実装の対応がずれた状態で記録されるので、層別から外せない）。\n'
  printf '          ハーネスの置き場を git 管理下に置けば有効になります\n'
  return 0
}

doctor_hrsentinel() {
  _dhn=0
  for _dhd in "$AIDEV/works"/*/; do
    [ -f "$_dhd/state.yml" ] || continue
    [ "$(yget "$_dhd/state.yml" harnessRev)" = "$HR_EMPTY" ] && _dhn=$((_dhn+1))
  done
  if [ "$_dhn" -gt 0 ] 2>/dev/null; then
    printf 'harnessRev: 効果検証の母集団\n'
    printf '    note: %s 本が %s（空 blob のハッシュ）を刻んでいます。ハーネスが git 管理外だった頃の値で、\n' "$_dhn" "$HR_EMPTY"
    printf '          全環境で同じ値になるため母集団には使えません。読む側は unknown に正規化しています（直す必要はありません）\n'
  fi
  return 0
}

doctor_branch() {
  command -v git >/dev/null 2>&1 || return 0
  # **linked worktree では検査しない**。aidev の worktree は定義上 `feature/<slug>` に載っている
  # （`worktree add` がそう作る）ので、ここで鳴らすと 100% 誤警告になる。
  # 見出しどおり「main worktree の位置」を見る検査なので、main worktree でだけ意味がある
  _dbg=$(git -C "$ROOT" rev-parse --git-dir 2>/dev/null) || _dbg=""
  _dbc=$(git -C "$ROOT" rev-parse --git-common-dir 2>/dev/null) || _dbc=""
  if [ -n "$_dbg" ] && [ -n "$_dbc" ] && [ "$_dbg" != "$_dbc" ]; then return 0; fi
  _dbcur=$(git -C "$ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null) || _dbcur=""
  [ -n "$_dbcur" ] || return 0
  _dbdef=$(git_default_branch)
  [ -n "$_dbdef" ] || return 0
  if [ "$_dbcur" != "$_dbdef" ]; then
    printf 'branch: main worktree の位置\n'
    printf '    WARN 既定ブランチ(%s)ではなく %s に載っています: 新しい work はこの上に積まれ、\n' "$_dbdef" "$_dbcur"
    printf '         deliver「1.5」の既着地検知が濁ります（work は state.yml の baseCommit と比べること）。\n'
    printf '         remote 無しで作業ブランチに着地して人を待っている状態ならこれが正常です——マージ後に %s へ戻すこと\n' "$_dbdef"
    printf 'branch-summary: current=%s default=%s\n' "$_dbcur" "$_dbdef"
  fi
  return 0
}

doctor_shared() {
  printf 'sharedFiles: 並行作業で名指しする共有ファイルの検査\n'
  _dsdecl=$(ylist "$AIDEV/config.yml" sharedFiles)
  _dsn=0; _dsstale=0; _dsmiss=0
  _dsdecls=" $(printf '%s' "$_dsdecl" | tr '\n' ' ') "
  _dsseen=""   # (b) で既に挙げた名前。(c) で二重に鳴らさない（同じ 1 件を 2 回直させない）
  # ハーネス自身の置き場を ROOT からの相対で求める（配置を変えても効くように）
  _dshrel=""; case "$HARNESS/" in "$ROOT"/*) _dshrel=${HARNESS#"$ROOT"/} ;; esac
  # (a) 宣言してあるのに実在しない＝誤記か、消えたファイルの残骸。これは無条件に言える
  for f in $_dsdecl; do
    [ -n "$f" ] || continue
    _dsn=$((_dsn+1))
    if [ ! -e "$ROOT/$f" ]; then
      printf '    WARN 宣言されているが実在しません: %s（誤記か、消えたファイルの残骸）\n' "$f"
      _dsstale=$((_dsstale+1))
    fi
  done
  # (b) 実態のほうが先に進んでいる＝多くのコミットが触っているのに宣言が無い。
  #     判定は worktree add の警告と**同じ関数**（同じハーネスが別々の答えを言わないため）
  _dshot=$(shared_hot_undeclared 5)
  if [ -n "$_dshot" ]; then
    _dsold=$IFS; IFS='
'
    for row in $_dshot; do
      _dscnt=${row%%	*}; _dsf=${row#*	}
      printf '    WARN %s/%s コミットが触っているのに sharedFiles に無い: %s\n' \
        "$_dscnt" "${SHARED_HOT_WINDOW:-20}" "$_dsf"
      _dsseen="$_dsseen $_dsf"
      _dsmiss=$((_dsmiss+1))
    done
    IFS=$_dsold
  fi
  # (c) いま未マージの worktree が 2 本以上触っているのに未宣言。履歴の頻度より強い証拠
  #     （実測: tests/test_storage.py は 4/20 で (b) に届かないが、実マージでは衝突した）
  if command -v git >/dev/null 2>&1; then
    wt_collect_pairs no no 2>/dev/null || true
    if [ -n "${WT_PAIRS:-}" ]; then
      _dsnow=$(printf '%s' "$WT_PAIRS" | LC_ALL=C sort | awk -F'\t' '
        function flush() { if (f != "" && n >= 2) print n "\t" f }
        { if ($1 != f) { flush(); f = $1; n = 0 } n++ }
        END { flush() }' | LC_ALL=C sort -k1,1nr -k2,2)
      _dsold2=$IFS; IFS='
'
      for row in $_dsnow; do
        _dscnt=${row%%	*}; _dsf=${row#*	}
        case "$_dsf" in .aidev/*) continue ;; esac
        [ -n "$_dshrel" ] && case "$_dsf" in "$_dshrel"/*) continue ;; esac
        case "$_dsdecls" in *" $_dsf "*) continue ;; esac
        case " $_dsseen " in *" $_dsf "*) continue ;; esac
        printf '    WARN いま %s 本の未マージ worktree が触っているのに sharedFiles に無い: %s\n' \
          "$_dscnt" "$_dsf"
        _dsmiss=$((_dsmiss+1))
      done
      IFS=$_dsold2
    fi
  fi
  if [ "$_dsn" -eq 0 ] && [ "$_dsmiss" -eq 0 ]; then
    printf 'note: sharedFiles 未設定。並行作業の警告が汎用文言になります（config.yml で名指しできる）\n'
  fi
  printf 'sharedFiles-summary: declared=%s 実在しない=%s 未宣言の常連=%s\n' "$_dsn" "$_dsstale" "$_dsmiss"
}

# 起動確認の宣言が**成果物の成長に置いていかれていないか**。
# 実走で `stats` / `rename-tag` / `--json` を足した 3 本のどれも smoke を通らないまま
# `smoke: pass` になった——「テストが緑なだけでは着地の根拠にしない」と言いながら、
# 起動確認の側が現在の成果物を代表していない。sharedFiles と同じ「静的な宣言が実態から
# 遅れる」型なので、同じ扱いにする: 直すのは人間、古びていることは機械が言う。
smoke_stale_warn() {
  command -v git >/dev/null 2>&1 || return 0
  _ssn=$(yget "$AIDEV/config.yml" smokeStaleAfter)
  case "$_ssn" in ''|*[!0-9]*) _ssn=5 ;; esac
  [ "$_ssn" -gt 0 ] 2>/dev/null || return 0
  # 宣言が最後に変わったコミットの日時。
  # **`-S smokeCommand` の pickaxe では駄目**——`-S` は文字列の**出現回数の変化**しか見ないので、
  # `smokeCommands:` の下に行を足しても出現数は 1 のまま＝基準日が導入コミットから動かない。
  # 「起動確認は成果物と一緒に育てる」ための検査が、育てても古い WARN を出し続ける（実測）。
  # config.yml を触ったコミットを新しい順に辿り、**宣言そのものが変わった**最初の点を採る。
  _sscur=$(smoke_decl_of "$AIDEV/config.yml")
  _sscfg=${AIDEV#"$ROOT"/}/config.yml
  # **`set -u` の下ではループ内で初めて代入する変数も事前に初期化する**。
  # 1 周目で宣言が食い違うと代入前に参照して `parameter not set` でプロセスごと落ちた
  # ——しかも落ちる条件は「宣言を編集してまだコミットしていない」＝`aidev-50-test`「3.2」が
  # 作れと指示している当の状態で、**規約に素直に従うと doctor が壊れる**区間ができていた（実走で発覚）。
  # ps1 は最初から両方初期化してあり、ここでも sh だけが落ちていた
  _sscut=""; _sscut0=""
  # 一時ファイルは **`.aidev` の外**に置く。中に置くと、落ちたときの残骸を
  # deliver 手順の `git add -A` がそのまま拾う（実走で 3 個コミットされかけた）
  _sstmp=${TMPDIR:-/tmp}/aidev-smoke.$$
  for _ssc in $(git -C "$ROOT" log --format=%H -n 50 -- "$_sscfg" 2>/dev/null); do
    git -C "$ROOT" show "$_ssc:$_sscfg" > "$_sstmp" 2>/dev/null || { rm -f "$_sstmp"; break; }
    if [ "$(smoke_decl_of "$_sstmp")" != "$_sscur" ]; then
      # この版で違う＝**1 つ後**のコミットが宣言を変えた点。そこを基準にする
      [ -n "$_sscut0" ] && _sscut=$_sscut0
      break
    fi
    _sscut0=$(TZ=UTC git -C "$ROOT" log -1 --format=%cd --date=format-local:%Y-%m-%dT%H:%M:%SZ "$_ssc" 2>/dev/null) || _sscut0=""
    _sscut=$_sscut0
  done
  rm -f "$_sstmp"
  [ -n "$_sscut" ] || return 0   # 履歴が無い/読めないなら黙る（推測で急かさない）
  _sscnt=0
  for _ssd in "$AIDEV/works"/*/; do
    [ -f "$_ssd/metrics.yml" ] || continue
    _ssts=$(grep 'phase:[[:space:]]*deliver,.*event:[[:space:]]*approved' "$_ssd/metrics.yml" 2>/dev/null \
             | tail -n1 | sed -n 's/.*ts:[[:space:]]*\([0-9TZ:-]*\).*/\1/p')
    [ -n "$_ssts" ] || continue
    # ISO・UTC・同じ桁なので辞書順で比較できる
    if [ "$(printf '%s\n%s\n' "$_sscut" "$_ssts" | LC_ALL=C sort | tail -n1)" = "$_ssts" ] \
       && [ "$_ssts" != "$_sscut" ]; then
      _sscnt=$((_sscnt+1))
    fi
  done
  if [ "$_sscnt" -ge "$_ssn" ] 2>/dev/null; then
    printf '    WARN 起動確認の宣言を最後に変えてから %s 本が着地しています（しきい値 %s）: 足した表面が一度も起動されていない可能性\n' \
      "$_sscnt" "$_ssn"
    printf '         smokeCommands: の下に 1 行足せば増やせる（起動確認は成果物と一緒に育てる）\n'
  fi
  return 0
}

# `smokeCommands:` ブロックの**外**にある `- ` 行の本数。awk は非リスト行でブロックを閉じるので、
# 末尾に追記した行などは黙って捨てられる——`smoke` は pass、`doctor` は configured=yes と言うだけで、
# 「足した表面を一度も起動しないまま pass」というこの機能が塞ぐはずの事故が、
# **設定の書き間違いという別の入口から再現する**（実走で発生）
smoke_orphan_lines() {
  [ -f "$AIDEV/config.yml" ] || { printf '0'; return 0; }
  _son=$(awk '
    /^smokeCommands:[ \t]*$/ { inblk = 1; next }
    inblk {
      if (match($0, /^[ \t]+-[ \t]+/)) next
      if ($0 ~ /^[ \t]*$/) next
      inblk = 0
    }
    !inblk && match($0, /^[ \t]+-[ \t]+/) { n++ }
    END { print n+0 }
  ' "$AIDEV/config.yml" 2>/dev/null) || _son=0
  case "$_son" in ''|*[!0-9]*) _son=0 ;; esac
  printf '%s' "$_son"
}

doctor_smoke() {
  _dsc=$(smoke_cmd)
  _dscl=$(smoke_list)
  [ -n "$_dscl" ] && _dsc=$(printf '%s\n' "$_dscl" | head -n1)
  printf 'smoke: 起動確認の設定\n'
  if [ -z "$_dsc" ]; then
    printf '    WARN smokeCommand が .aidev/config.yml にありません: **テストが緑でも成果物が起動するかは誰も見ていません**\n'
    printf '         「最初の使える状態まで到達する」ことを確かめる終了するコマンドを設定するか、\n'
    printf '         対象が無い PJ なら smokeCommand: none と明示すること\n'
    printf 'smoke-summary: configured=no\n'
  elif [ "$_dsc" = none ]; then
    printf 'smoke-summary: configured=none（起動確認の対象外と宣言済み）\n'
  else
    _dso=$(smoke_orphan_lines)
  if [ "$_dso" -gt 0 ] 2>/dev/null; then
    printf '    WARN smokeCommands: ブロックの外に `- ` 行が %s 本あります: **黙って無視されます**\n' "$_dso"
    printf '         足す行は smokeCommands: の直下に、同じ字下げで並べること（末尾に追記すると外れる）\n'
  fi
  smoke_stale_warn
    _dsn=$(printf '%s\n' "$_dscl" | grep -c . || true)
    printf 'smoke-summary: configured=yes commands=%s\n' "$_dsn"
  fi
  return 0
}

cmd_harness() {
  [ $# -ge 1 ] || die "使用法: aidev harness <new|confirm|retire|status> ..."
  sub=$1; shift
  case "$sub" in
    new)     hv_new "$@" ;;
    confirm) hv_confirm "$@" ;;
    retire)  hv_retire "$@" ;;
    status)  hv_status "$@" ;;
    *) die "未知の harness サブコマンド: $sub（new|confirm|retire|status）" ;;
  esac
}

cmd_worktree() {
  [ $# -ge 1 ] || die "使用法: aidev worktree <add|list|files|rm> ..."
  sub=$1; shift
  case "$sub" in
    add)  wt_add "$@" ;;
    list) wt_list "$@" ;;
    files) wt_files "$@" ;;
    rm)   wt_rm "$@" ;;
    *) die "未知の worktree サブコマンド: $sub（add|list|files|rm）" ;;
  esac
}

usage() {
  # 先頭(2行目以降)の連続するコメント行のみを出力（コメント末尾で停止。範囲ズレに強い）
  awk 'NR==1{next} /^#/{sub(/^#[[:space:]]?/,"");print;next} {exit}' "$0"
}

[ $# -ge 1 ] || { usage; exit 1; }
cmd=$1; shift
case "$cmd" in
  new)     cmd_new "$@" ;;
  event)   cmd_event "$@" ;;
  approve) cmd_approve "$@" ;;
  unapprove) cmd_unapprove "$@" ;;
  guard)   cmd_guard "$@" ;;
  verify)  cmd_verify "$@" ;;
  coverage) cmd_coverage "$@" ;;
  smoke)   cmd_smoke "$@" ;;
  debug)   cmd_debug "$@" ;;
  taskcheck) cmd_taskcheck "$@" ;;
  doccheck) cmd_doccheck "$@" ;;
  limits)  cmd_limits "$@" ;;
  escalate) cmd_escalate "$@" ;;
  doctor)  cmd_doctor "$@" ;;
  status)  cmd_status "$@" ;;
  metrics) cmd_metrics "$@" ;;
  use)     cmd_use "$@" ;;
  backlog) cmd_backlog "$@" ;;
  convention) cmd_convention "$@" ;;
  harness) cmd_harness "$@" ;;

  worktree) cmd_worktree "$@" ;;
  help|-h|--help) usage ;;
  *) die "未知のコマンド: $cmd（aidev help）" ;;
esac
